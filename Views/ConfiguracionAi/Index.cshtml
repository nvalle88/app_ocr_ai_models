@model List<app_tramites.Models.ModelAi.OPAIConfiguration>
@section Migas {
    <li><a asp-action="Index" onclick="cargando()">Configuraciones AI</a></li>
    <li class="active">Lista</li>
}

<div class="row">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
        <a asp-action="Manage" onclick="cargando()" class="btn btn-primary"><strong><i class="fa fa-plus"></i> Nueva Configuración</strong></a>
    </div>
    <div class="col-xs-12 col-sm-5 col-md-5 col-lg-12"><br /></div>
</div>

<section id="widget-grid" class="">
    <div class="row">
        <article class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
            <div class="jarviswidget jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false">
                <header>
                    <span class="widget-icon"><i class="fa fa-cog"></i></span>
                    <h2>Configuraciones AI</h2>
                </header>
                <div>
                    <div class="widget-body no-padding">
                        <table id="dt_basic" class="table table-striped table-bordered table-hover" width="100%">
                            <thead>
                                <tr>
                                    <th>Código</th>
                                    <th data-class="expand">Nombre</th>
                                    <th>Tipo</th>
                                    <th data-hide="phone">Endpoint</th>
                                    <th data-hide="phone,tablet">Creado</th>
                                    <th data-hide="phone,tablet">Estado</th>
                                    <th data-hide="phone,tablet">Opciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td><strong>@item.Code</strong></td>
                                        <td>@item.Name</td>
                                        <td>
                                            <span class="label label-info">@item.ConfigType</span>
                                        </td>
                                        <td>
                                            <small class="text-muted">@(item.EndpointUrl?.Length > 40 ? item.EndpointUrl.Substring(0, 40) + "..." : item.EndpointUrl)</small>
                                        </td>
                                        <td>@item.CreatedDate.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            @if (item.IsActive)
                                            {
                                                <span class="badge badge-success" style="background-color:#5cb85c">Activo</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-danger" style="background-color:#d9534f">Inactivo</span>
                                            }
                                        </td>
                                        <td align="center">
                                            <a asp-action="Manage" onclick="cargando()" class="fa fa-edit txt-color-blue" asp-route-id="@item.Code" title="Editar"></a> &nbsp;|&nbsp;
                                            <a href="javascript:void(0);" class="fa fa-trash-o txt-color-red" onclick="Delete(this)" id="@item.Code" data-descripcion="¿Desea eliminar la configuración '@item.Name'?"></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </article>
    </div>
</section>

@section Scripts {
    @{ await Html.RenderPartialAsync("_BootboxPartial"); }
    @{ await Html.RenderPartialAsync("_DateTablePartial"); }
    <script>
        function Delete(e) {
            var btn = $(e);
            bootbox.confirm({
                title: "¿ Eliminar ?",
                message: btn.data("descripcion"),
                buttons: {
                    cancel: { label: '<i class="fa fa-times"></i> Cancelar' },
                    confirm: { label: '<i class="fa fa-check"></i> OK' }
                },
                callback: function (result) {
                    if (result) {
                        mostrarLoadingPanel("content", "");
                        $.ajax({
                            type: "GET",
                            url: '@Url.Action("Delete", "ConfiguracionAi")' + '?id=' + btn.prop("id"),
                            contentType: "application/json; charset=utf-8",
                            datatype: "json",
                            timeout: 500000,
                            success: function (data) {
                                if (data.estado == 'Error') {
                                    mostrarNotificacion("Error", data.mensaje);
                                    $("#content").waitMe("hide");
                                } else {
                                    window.location = '@Url.Action("Index", "ConfiguracionAi")';
                                }
                            },
                            error: function () {
                                $("#content").waitMe("hide");
                                mostrarNotificacion("Error", "No se pudo eliminar el registro.");
                            }
                        });
                    }
                }
            });
        }
    </script>
}
