@model app_ocr_ai_models.Models.ViewModel.MantenedorConfigViewModel
@using System.Text.Json

@section Migas {
    <li><a asp-controller="Nexus" asp-action="Index" onclick="cargando()">Nexus</a></li>
    <li><a asp-controller="Mantenedores" asp-action="Index" onclick="cargando()">Configuración</a></li>
    <li class="active">Vista Unificada</li>
}

@section Styles {
<style>
.cfg-shell { display:flex; gap:0; height:calc(100vh - 130px); min-height:500px; }

.cfg-nav {
    flex: 0 0 210px; width:210px;
    background:#1e293b;
    border-radius:8px 0 0 8px;
    overflow-y:auto;
    padding:12px 0 20px;
}
.cfg-nav-brand {
    padding:10px 16px 14px;
    font-size:0.78rem; font-weight:800;
    color:#94a3b8; text-transform:uppercase; letter-spacing:.08em;
    border-bottom:1px solid rgba(255,255,255,.07);
    margin-bottom:8px;
}
.cfg-nav-group { margin-bottom:4px; }
.cfg-nav-label {
    padding:8px 16px 4px;
    font-size:0.63rem; font-weight:700;
    color:#475569; text-transform:uppercase; letter-spacing:.1em;
}
.cfg-nav-link {
    display:flex; align-items:center; gap:8px;
    padding:7px 16px;
    color:#94a3b8; font-size:0.82rem;
    text-decoration:none; cursor:pointer;
    transition:background .12s, color .12s;
    border-left:3px solid transparent;
}
.cfg-nav-link:hover { background:rgba(255,255,255,.05); color:#e2e8f0; text-decoration:none; }
.cfg-nav-link.active { background:rgba(59,130,246,.15); color:#60a5fa; border-left-color:#3b82f6; }
.cfg-nav-link i { width:14px; text-align:center; flex-shrink:0; }
.cfg-nav-count {
    margin-left:auto;
    background:rgba(255,255,255,.1);
    color:#94a3b8; font-size:0.65rem; font-weight:700;
    padding:1px 6px; border-radius:10px;
}
.cfg-nav-link.active .cfg-nav-count { background:rgba(59,130,246,.3); color:#93c5fd; }

.cfg-content {
    flex:1; min-width:0;
    background:#fff;
    border:1px solid #e2e8f0;
    border-left:none;
    border-radius:0 8px 8px 0;
    overflow:hidden;
    display:flex; flex-direction:column;
}
.cfg-panel { display:none; flex:1; flex-direction:column; overflow:hidden; }
.cfg-panel.active { display:flex; }

.cfg-panel-topbar {
    display:flex; align-items:center; justify-content:space-between;
    padding:14px 20px;
    background:#f8fafc;
    border-bottom:1px solid #e2e8f0;
    flex-shrink:0;
}
.cfg-panel-title { margin:0; font-size:1rem; font-weight:700; color:#1e293b; display:flex; align-items:center; gap:8px; }
.cfg-panel-title i { color:#3b82f6; }
.cfg-panel-body { flex:1; overflow-y:auto; padding:16px 20px; }

.cfg-table { font-size:0.81rem; }
.cfg-table th { font-size:0.7rem; text-transform:uppercase; letter-spacing:.05em; color:#64748b; font-weight:700; }
.cfg-badge { padding:2px 8px; border-radius:12px; font-size:0.7rem; font-weight:600; color:#fff; }

/* Modal sub-sections */
.cfg-modal-section {
    margin-top:16px; padding-top:12px;
    border-top:2px solid #e2e8f0;
}
.cfg-modal-section-title {
    font-size:0.8rem; font-weight:700; color:#475569;
    text-transform:uppercase; letter-spacing:.06em;
    margin-bottom:10px;
    display:flex; align-items:center; gap:6px;
}
.cfg-modal-section-title i { color:#3b82f6; }
.cfg-check-grid {
    display:grid; grid-template-columns: repeat(auto-fill, minmax(160px,1fr));
    gap:6px 16px; max-height:160px; overflow-y:auto;
    padding:8px; background:#f8fafc; border-radius:6px; border:1px solid #e2e8f0;
}
.cfg-check-item { display:flex; align-items:center; gap:6px; font-size:0.82rem; }
.cfg-check-item input[type=checkbox] { flex-shrink:0; }
.cfg-rel-table { font-size:0.79rem; margin-bottom:8px; }
.cfg-rel-table th { background:#f1f5f9; }
.cfg-page-header {
    display:flex; align-items:center; justify-content:space-between;
    padding:10px 0 12px; border-bottom:1px solid #e2e8f0; margin-bottom:14px;
}
</style>
}

<div class="cfg-page-header">
    <h2 class="mant-page-title">
        <i class="fa fa-cogs txt-color-blueDark"></i>&nbsp; Configuración Unificada
    </h2>
    <div style="display:flex;gap:8px">
        <a asp-controller="Mantenedores" asp-action="Index" onclick="cargando()" class="btn btn-default btn-sm">
            <i class="fa fa-th-large"></i>&nbsp; Panel
        </a>
        <a asp-controller="Nexus" asp-action="Index" onclick="cargando()" class="btn btn-default btn-sm">
            <i class="fa fa-arrow-left"></i>&nbsp; Nexus
        </a>
    </div>
</div>

<div class="cfg-shell">

    <!-- ══ SIDEBAR ══ -->
    <nav class="cfg-nav">
        <div class="cfg-nav-brand"><i class="fa fa-cogs"></i>&nbsp; Sistema</div>

        <div class="cfg-nav-group">
            <div class="cfg-nav-label">IA y Modelos</div>
            <a class="cfg-nav-link active" data-panel="configai">
                <i class="fa fa-sliders"></i> Config AI
                <span class="cfg-nav-count">@Model.Configuraciones.Count</span>
            </a>
            <a class="cfg-nav-link" data-panel="agentes">
                <i class="fa fa-android"></i> Agentes
                <span class="cfg-nav-count">@Model.Agentes.Count</span>
            </a>
            <a class="cfg-nav-link" data-panel="prompts">
                <i class="fa fa-file-text-o"></i> Prompts
                <span class="cfg-nav-count">@Model.Prompts.Count</span>
            </a>
        </div>

        <div class="cfg-nav-group">
            <div class="cfg-nav-label">Procesos</div>
            <a class="cfg-nav-link" data-panel="procesos">
                <i class="fa fa-random"></i> Procesos
                <span class="cfg-nav-count">@Model.Procesos.Count</span>
            </a>
        </div>

        <div class="cfg-nav-group">
            <div class="cfg-nav-label">Acceso y Seguridad</div>
            <a class="cfg-nav-link" data-panel="politicas">
                <i class="fa fa-shield"></i> Políticas
                <span class="cfg-nav-count">@Model.ListaPolicys.Count</span>
            </a>
            <a class="cfg-nav-link" data-panel="usuarios">
                <i class="fa fa-users"></i> Usuarios
                <span class="cfg-nav-count">@Model.Usuarios.Count</span>
            </a>
            <a class="cfg-nav-link" data-panel="azureblob">
                <i class="fa fa-cloud"></i> Azure Blob
                <span class="cfg-nav-count">@Model.BlobConfs.Count</span>
            </a>
        </div>
    </nav>

    <!-- ══ CONTENT ══ -->
    <div class="cfg-content">

        <!-- ─── Configuraciones AI ─── -->
        <div class="cfg-panel active" id="panel-configai">
            <div class="cfg-panel-topbar">
                <h3 class="cfg-panel-title"><i class="fa fa-sliders"></i> Configuraciones AI</h3>
                <button class="btn btn-primary btn-sm" onclick="cfgOpenNew('configai')">
                    <i class="fa fa-plus"></i> Nueva
                </button>
            </div>
            <div class="cfg-panel-body">
                <table id="dt-configai" class="table table-striped table-hover table-bordered cfg-table" width="100%">
                    <thead><tr><th>Código</th><th>Nombre</th><th>Tipo</th><th>Endpoint</th><th>Estado</th><th style="width:80px"></th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.Configuraciones)
                    {
                        <tr>
                            <td><strong>@item.Code</strong></td>
                            <td>@item.Name</td>
                            <td><span class="cfg-badge" style="background:#0369a1">@item.ConfigType</span></td>
                            <td><small class="text-muted">@item.EndpointUrl</small></td>
                            <td>@if(item.IsActive){<span class="cfg-badge" style="background:#16a34a">Activo</span>}else{<span class="cfg-badge" style="background:#dc2626">Inactivo</span>}</td>
                            <td class="text-center">
                                <a onclick='cfgEdit("configai",@Html.Raw(JsonSerializer.Serialize(new{item.Code,item.Name,item.EndpointUrl,item.ApiKey,item.ConfigType,item.IsActive,item.Notes})))' class="fa fa-edit txt-color-blue" style="cursor:pointer"></a>
                                &nbsp;<a onclick='cfgDelete("ConfiguracionAi","@item.Code",this)' class="fa fa-trash-o txt-color-red" style="cursor:pointer"></a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ─── Agentes (con prompts + procesos) ─── -->
        <div class="cfg-panel" id="panel-agentes">
            <div class="cfg-panel-topbar">
                <h3 class="cfg-panel-title"><i class="fa fa-android"></i> Agentes</h3>
                <button class="btn btn-primary btn-sm" onclick="cfgOpenNew('agentes')">
                    <i class="fa fa-plus"></i> Nuevo Agente
                </button>
            </div>
            <div class="cfg-panel-body">
                <table id="dt-agentes" class="table table-striped table-hover table-bordered cfg-table" width="100%">
                    <thead><tr><th>Código</th><th>Nombre</th><th>Config AI</th><th>Prompts</th><th>Procesos</th><th>Estado</th><th style="width:80px"></th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.Agentes)
                    {
                        var agPrompts  = Model.Asignaciones.Where(a => a.ModelCode == item.Code).ToList();
                        var agProcesos = Model.AgentProcesos.Where(ap => ap.AgentCode == item.Code).ToList();
                        <tr>
                            <td><strong>@item.Code</strong></td>
                            <td>@item.Name</td>
                            <td><small>@(item.AgentConfig?.Name ?? item.ConfigCode)</small></td>
                            <td><span class="cfg-badge" style="background:#6366f1">@agPrompts.Count prompts</span></td>
                            <td><span class="cfg-badge" style="background:#0f766e">@agProcesos.Count procesos</span></td>
                            <td>@if(item.IsActive){<span class="cfg-badge" style="background:#16a34a">Activo</span>}else{<span class="cfg-badge" style="background:#dc2626">Inactivo</span>}</td>
                            <td class="text-center">
                                <a onclick='cfgEdit("agentes",@Html.Raw(JsonSerializer.Serialize(new{
                                    item.Code,item.Name,item.ConfigCode,item.VersionNumber,item.Description,item.IsActive,
                                    Prompts=agPrompts.Select(p=>new{p.PromptCode,p.Order,p.IsDefault}).ToList(),
                                    Procesos=agProcesos.Select(ap=>ap.DefinitionCode).ToList()
                                })))' class="fa fa-edit txt-color-blue" style="cursor:pointer"></a>
                                &nbsp;<a onclick='cfgDelete("Agente","@item.Code",this)' class="fa fa-trash-o txt-color-red" style="cursor:pointer"></a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ─── Prompts ─── -->
        <div class="cfg-panel" id="panel-prompts">
            <div class="cfg-panel-topbar">
                <h3 class="cfg-panel-title"><i class="fa fa-file-text-o"></i> Prompts</h3>
                <button class="btn btn-primary btn-sm" onclick="cfgOpenNew('prompts')">
                    <i class="fa fa-plus"></i> Nuevo Prompt
                </button>
            </div>
            <div class="cfg-panel-body">
                <table id="dt-prompts" class="table table-striped table-hover table-bordered cfg-table" width="100%">
                    <thead><tr><th>Código</th><th>Contenido</th><th>Versión</th><th>Modificado</th><th>Estado</th><th style="width:80px"></th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.Prompts)
                    {
                        <tr>
                            <td><strong>@item.Code</strong></td>
                            <td><small class="text-muted">@(item.Content?.Length > 80 ? item.Content.Substring(0,80)+"…" : item.Content)</small></td>
                            <td><span class="cfg-badge" style="background:#5bc0de">v@(item.VersionNumber)</span></td>
                            <td><small>@item.ModifiedDate.ToString("dd/MM/yy HH:mm")</small></td>
                            <td>@if(item.IsActive){<span class="cfg-badge" style="background:#16a34a">Activo</span>}else{<span class="cfg-badge" style="background:#dc2626">Inactivo</span>}</td>
                            <td class="text-center">
                                <a onclick='cfgEdit("prompts",@Html.Raw(JsonSerializer.Serialize(new{item.Code,item.Content,item.VersionNumber,item.IsActive})))' class="fa fa-edit txt-color-blue" style="cursor:pointer"></a>
                                &nbsp;<a onclick='cfgDelete("Prompt","@item.Code",this)' class="fa fa-trash-o txt-color-red" style="cursor:pointer"></a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ─── Procesos (con agentes) ─── -->
        <div class="cfg-panel" id="panel-procesos">
            <div class="cfg-panel-topbar">
                <h3 class="cfg-panel-title"><i class="fa fa-random"></i> Procesos</h3>
                <button class="btn btn-primary btn-sm" onclick="cfgOpenNew('procesos')">
                    <i class="fa fa-plus"></i> Nuevo Proceso
                </button>
            </div>
            <div class="cfg-panel-body">
                <table id="dt-procesos" class="table table-striped table-hover table-bordered cfg-table" width="100%">
                    <thead><tr><th>Código</th><th>Nombre</th><th>Descripción</th><th>Agentes</th><th style="width:80px"></th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.Procesos)
                    {
                        var procAgentes = Model.AgentProcesos.Where(ap => ap.DefinitionCode == item.Code).ToList();
                        <tr>
                            <td><strong>@item.Code</strong></td>
                            <td>@item.Name</td>
                            <td><small class="text-muted">@item.Description</small></td>
                            <td>
                                @foreach (var ap in procAgentes)
                                {
                                    <span class="cfg-badge" style="background:#0f766e;margin:1px">@(ap.Agent?.Name ?? ap.AgentCode)</span>
                                }
                            </td>
                            <td class="text-center">
                                <a onclick='cfgEdit("procesos",@Html.Raw(JsonSerializer.Serialize(new{
                                    item.Code,item.Name,item.Description,
                                    Agentes=procAgentes.Select(ap=>ap.AgentCode).ToList()
                                })))' class="fa fa-edit txt-color-blue" style="cursor:pointer"></a>
                                &nbsp;<a onclick='cfgDelete("Proceso","@item.Code",this)' class="fa fa-trash-o txt-color-red" style="cursor:pointer"></a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ─── Políticas (con coberturas) ─── -->
        <div class="cfg-panel" id="panel-politicas">
            <div class="cfg-panel-topbar">
                <h3 class="cfg-panel-title"><i class="fa fa-shield"></i> Políticas de Acceso</h3>
                <button class="btn btn-primary btn-sm" onclick="cfgOpenNew('politicas')">
                    <i class="fa fa-plus"></i> Nueva Política
                </button>
            </div>
            <div class="cfg-panel-body">
                <table id="dt-politicas" class="table table-striped table-hover table-bordered cfg-table" width="100%">
                    <thead><tr><th>Código</th><th>Nombre Política</th><th>Coberturas (Agente→Proceso)</th><th>Usuarios</th><th style="width:80px"></th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.ListaPolicys)
                    {
                        var coberturas = Model.Politicas.Where(p => p.PolicyCode == item.Code).ToList();
                        var usuarios   = Model.PolicyUsers.Where(pu => pu.PolicyCode == item.Code).Count();
                        <tr>
                            <td><strong>@item.Code</strong></td>
                            <td>@item.PolicyName</td>
                            <td>
                                @foreach (var c in coberturas)
                                {
                                    <span class="cfg-badge" style="background:#7c3aed;margin:1px">@(c.AgentProcess?.Agent?.Name ?? "?") → @(c.AgentProcess?.Process?.Name ?? "?")</span>
                                }
                                @if (!coberturas.Any()) { <small class="text-muted">Sin coberturas</small> }
                            </td>
                            <td><span class="cfg-badge" style="background:#0369a1">@usuarios usuarios</span></td>
                            <td class="text-center">
                                <a onclick='cfgEdit("politicas",@Html.Raw(JsonSerializer.Serialize(new{
                                    item.Code,item.PolicyName,
                                    AgentProcessIds=coberturas.Select(c=>c.AgentProcessId).ToList()
                                })))' class="fa fa-edit txt-color-blue" style="cursor:pointer"></a>
                                &nbsp;<a onclick='cfgDeletePolitica("@item.Code",this)' class="fa fa-trash-o txt-color-red" style="cursor:pointer"></a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ─── Usuarios (con políticas) ─── -->
        <div class="cfg-panel" id="panel-usuarios">
            <div class="cfg-panel-topbar">
                <h3 class="cfg-panel-title"><i class="fa fa-users"></i> Usuarios</h3>
                <button class="btn btn-primary btn-sm" onclick="cfgOpenNew('usuarios')">
                    <i class="fa fa-plus"></i> Nuevo Usuario
                </button>
            </div>
            <div class="cfg-panel-body">
                <table id="dt-usuarios" class="table table-striped table-hover table-bordered cfg-table" width="100%">
                    <thead><tr><th>Email</th><th>Confirmado</th><th>Políticas asignadas</th><th>Bloqueado</th><th style="width:80px"></th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.Usuarios)
                    {
                        var usrPolicies = Model.PolicyUsers.Where(pu => pu.UserId == item.Id).ToList();
                        <tr>
                            <td><strong>@item.Email</strong></td>
                            <td>@if(item.EmailConfirmed){<span class="cfg-badge" style="background:#16a34a">Sí</span>}else{<span class="cfg-badge" style="background:#f59e0b">No</span>}</td>
                            <td>
                                @foreach (var pu in usrPolicies)
                                {
                                    var pol = Model.ListaPolicys.FirstOrDefault(p => p.Code == pu.PolicyCode);
                                    <span class="cfg-badge" style="background:#7c3aed;margin:1px">@(pol?.PolicyName ?? pu.PolicyCode)</span>
                                }
                                @if (!usrPolicies.Any()) { <small class="text-muted">Sin políticas</small> }
                            </td>
                            <td>
                                @if(item.LockoutEnd.HasValue && item.LockoutEnd > DateTimeOffset.Now)
                                { <span class="cfg-badge" style="background:#dc2626">@item.LockoutEnd.Value.ToString("dd/MM/yy")</span> }
                                else { <small class="text-muted">—</small> }
                            </td>
                            <td class="text-center">
                                <a onclick='cfgEdit("usuarios",@Html.Raw(JsonSerializer.Serialize(new{
                                    item.Id,item.Email,
                                    PolicyCodes=usrPolicies.Select(pu=>pu.PolicyCode).ToList()
                                })))' class="fa fa-edit txt-color-blue" style="cursor:pointer"></a>
                                &nbsp;<a onclick='cfgDeleteUsuario("@item.Id",this)' class="fa fa-trash-o txt-color-red" style="cursor:pointer"></a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ─── Azure Blob ─── -->
        <div class="cfg-panel" id="panel-azureblob">
            <div class="cfg-panel-topbar">
                <h3 class="cfg-panel-title"><i class="fa fa-cloud"></i> Azure Blob Storage</h3>
                <button class="btn btn-primary btn-sm" onclick="cfgOpenNew('azureblob')">
                    <i class="fa fa-plus"></i> Nueva Config
                </button>
            </div>
            <div class="cfg-panel-body">
                <table id="dt-azureblob" class="table table-striped table-hover table-bordered cfg-table" width="100%">
                    <thead><tr><th>Código</th><th>Container</th><th>Connection String</th><th style="width:80px"></th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.BlobConfs)
                    {
                        <tr>
                            <td><strong>@item.Codigo</strong></td>
                            <td>@item.ContainerName</td>
                            <td><small class="text-muted">@(item.ConnectionString?.Length > 60 ? item.ConnectionString.Substring(0,60)+"…" : item.ConnectionString)</small></td>
                            <td class="text-center">
                                <a onclick='cfgEdit("azureblob",@Html.Raw(JsonSerializer.Serialize(new{item.Codigo,item.ConnectionString,item.ContainerName})))' class="fa fa-edit txt-color-blue" style="cursor:pointer"></a>
                                &nbsp;<a onclick='cfgDelete("AzureBlobConf","@item.Codigo",this)' class="fa fa-trash-o txt-color-red" style="cursor:pointer"></a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

    </div><!-- /cfg-content -->
</div><!-- /cfg-shell -->

<!-- ══════════════════ MODALES ══════════════════ -->

<!-- Modal: Configuracion AI -->
<div id="modal-configai" class="modal fade" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header"><button type="button" class="close" data-dismiss="modal">&times;</button><h4 class="modal-title"><i class="fa fa-sliders"></i> Configuración AI</h4></div>
      <div class="modal-body">
        <div class="row">
          <div class="col-sm-4"><div class="form-group"><label>Código *</label><input type="text" class="form-control" id="cai-Code" /></div></div>
          <div class="col-sm-8"><div class="form-group"><label>Nombre *</label><input type="text" class="form-control" id="cai-Name" /></div></div>
          <div class="col-sm-12"><div class="form-group"><label>Endpoint URL *</label><input type="text" class="form-control" id="cai-EndpointUrl" /></div></div>
          <div class="col-sm-12"><div class="form-group"><label>API Key</label><input type="password" class="form-control" id="cai-ApiKey" /></div></div>
          <div class="col-sm-6"><div class="form-group"><label>Tipo</label>
            <select class="form-control" id="cai-ConfigType"><option>AzureOpenAI</option><option>OpenAI</option><option>Custom</option></select>
          </div></div>
          <div class="col-sm-6"><div class="form-group"><label>Estado</label>
            <select class="form-control" id="cai-IsActive"><option value="true">Activo</option><option value="false">Inactivo</option></select>
          </div></div>
          <div class="col-sm-12"><div class="form-group"><label>Notas</label><textarea class="form-control" id="cai-Notes" rows="2"></textarea></div></div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-default" data-dismiss="modal">Cancelar</button>
        <button class="btn btn-primary" onclick="cfgSaveConfigAi()"><i class="fa fa-save"></i> Guardar</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal: Agente (INTEGRADO — prompts + procesos) -->
<div id="modal-agentes" class="modal fade" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header"><button type="button" class="close" data-dismiss="modal">&times;</button><h4 class="modal-title"><i class="fa fa-android"></i> Agente</h4></div>
      <div class="modal-body" style="max-height:75vh;overflow-y:auto">

        <div class="row">
          <div class="col-sm-4"><div class="form-group"><label>Código *</label><input type="text" class="form-control" id="ag-Code" /></div></div>
          <div class="col-sm-8"><div class="form-group"><label>Nombre *</label><input type="text" class="form-control" id="ag-Name" /></div></div>
          <div class="col-sm-7"><div class="form-group"><label>Configuración AI *</label>
            <select class="form-control" id="ag-ConfigCode">
              @foreach (var c in Model.Configuraciones) { <option value="@c.Code">@c.Name</option> }
            </select>
          </div></div>
          <div class="col-sm-2"><div class="form-group"><label>Versión</label><input type="number" class="form-control" id="ag-VersionNumber" value="1" min="1" /></div></div>
          <div class="col-sm-3"><div class="form-group"><label>Estado</label>
            <select class="form-control" id="ag-IsActive"><option value="true">Activo</option><option value="false">Inactivo</option></select>
          </div></div>
          <div class="col-sm-12"><div class="form-group"><label>Descripción</label><textarea class="form-control" id="ag-Description" rows="2"></textarea></div></div>
        </div>

        <!-- Prompts section -->
        <div class="cfg-modal-section">
          <div class="cfg-modal-section-title"><i class="fa fa-file-text-o"></i> Prompts asignados a este agente</div>
          <table class="table table-condensed cfg-rel-table">
            <thead><tr><th>Prompt</th><th style="width:70px">Orden</th><th style="width:80px">Default</th><th style="width:40px"></th></tr></thead>
            <tbody id="ag-prompts-tbody"></tbody>
          </table>
          <div class="row">
            <div class="col-sm-5">
              <select class="form-control input-sm" id="ag-newPromptCode">
                @foreach (var p in Model.Prompts) { <option value="@p.Code">@p.Code</option> }
              </select>
            </div>
            <div class="col-sm-2"><input type="number" class="form-control input-sm" id="ag-newPromptOrder" value="1" min="1" placeholder="Orden" /></div>
            <div class="col-sm-3">
              <select class="form-control input-sm" id="ag-newIsDefault">
                <option value="false">No default</option><option value="true">Default</option>
              </select>
            </div>
            <div class="col-sm-2">
              <button class="btn btn-success btn-sm btn-block" onclick="agAddPrompt()"><i class="fa fa-plus"></i> Agregar</button>
            </div>
          </div>
        </div>

        <!-- Procesos section -->
        <div class="cfg-modal-section">
          <div class="cfg-modal-section-title"><i class="fa fa-random"></i> Procesos que ejecuta este agente</div>
          <div class="cfg-check-grid" id="ag-procesos-grid">
            @foreach (var p in Model.Procesos)
            {
              <label class="cfg-check-item">
                <input type="checkbox" class="ag-proceso-check" value="@p.Code" />
                <span>@p.Name</span>
              </label>
            }
          </div>
          @if (!Model.Procesos.Any()) { <small class="text-muted">No hay procesos creados aún.</small> }
        </div>

      </div>
      <div class="modal-footer">
        <button class="btn btn-default" data-dismiss="modal">Cancelar</button>
        <button class="btn btn-primary" onclick="cfgSaveAgenteFull()"><i class="fa fa-save"></i> Guardar Todo</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal: Prompt -->
<div id="modal-prompts" class="modal fade" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header"><button type="button" class="close" data-dismiss="modal">&times;</button><h4 class="modal-title"><i class="fa fa-file-text-o"></i> Prompt</h4></div>
      <div class="modal-body">
        <div class="row">
          <div class="col-sm-4"><div class="form-group"><label>Código *</label><input type="text" class="form-control" id="pr-Code" /></div></div>
          <div class="col-sm-4"><div class="form-group"><label>Versión</label><input type="number" class="form-control" id="pr-VersionNumber" value="1" min="1" /></div></div>
          <div class="col-sm-4"><div class="form-group"><label>Estado</label>
            <select class="form-control" id="pr-IsActive"><option value="true">Activo</option><option value="false">Inactivo</option></select>
          </div></div>
          <div class="col-sm-12"><div class="form-group"><label>Contenido *</label><textarea class="form-control" id="pr-Content" rows="9" style="font-family:monospace;font-size:0.8rem"></textarea></div></div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-default" data-dismiss="modal">Cancelar</button>
        <button class="btn btn-primary" onclick="cfgSavePrompt()"><i class="fa fa-save"></i> Guardar</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal: Proceso (INTEGRADO — agentes) -->
<div id="modal-procesos" class="modal fade" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header"><button type="button" class="close" data-dismiss="modal">&times;</button><h4 class="modal-title"><i class="fa fa-random"></i> Proceso</h4></div>
      <div class="modal-body">

        <div class="row">
          <div class="col-sm-4"><div class="form-group"><label>Código *</label><input type="text" class="form-control" id="pc-Code" /></div></div>
          <div class="col-sm-8"><div class="form-group"><label>Nombre *</label><input type="text" class="form-control" id="pc-Name" /></div></div>
          <div class="col-sm-12"><div class="form-group"><label>Descripción</label><textarea class="form-control" id="pc-Description" rows="2"></textarea></div></div>
        </div>

        <div class="cfg-modal-section">
          <div class="cfg-modal-section-title"><i class="fa fa-android"></i> Agentes que ejecutan este proceso</div>
          <div class="cfg-check-grid">
            @foreach (var a in Model.Agentes)
            {
              <label class="cfg-check-item">
                <input type="checkbox" class="pc-agente-check" value="@a.Code" />
                <span>@a.Name</span>
              </label>
            }
          </div>
          @if (!Model.Agentes.Any()) { <small class="text-muted">No hay agentes creados aún.</small> }
        </div>

      </div>
      <div class="modal-footer">
        <button class="btn btn-default" data-dismiss="modal">Cancelar</button>
        <button class="btn btn-primary" onclick="cfgSaveProcesoFull()"><i class="fa fa-save"></i> Guardar Todo</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal: Política (INTEGRADO — coberturas AgentProcess) -->
<div id="modal-politicas" class="modal fade" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header"><button type="button" class="close" data-dismiss="modal">&times;</button><h4 class="modal-title"><i class="fa fa-shield"></i> Política de Acceso</h4></div>
      <div class="modal-body">

        <div class="row">
          <div class="col-sm-4"><div class="form-group"><label>Código *</label><input type="text" class="form-control" id="pol-Code" /></div></div>
          <div class="col-sm-8"><div class="form-group"><label>Nombre de la Política *</label><input type="text" class="form-control" id="pol-PolicyName" /></div></div>
        </div>

        <div class="cfg-modal-section">
          <div class="cfg-modal-section-title"><i class="fa fa-exchange"></i> Agente → Proceso que cubre esta política</div>
          <div class="cfg-check-grid">
            @foreach (var ap in Model.AgentProcesos)
            {
              <label class="cfg-check-item">
                <input type="checkbox" class="pol-cobertura-check" value="@ap.Id" />
                <span><strong>@(ap.Agent?.Name ?? ap.AgentCode)</strong> → @(ap.Process?.Name ?? ap.DefinitionCode)</span>
              </label>
            }
          </div>
          @if (!Model.AgentProcesos.Any()) { <small class="text-muted">No hay relaciones Agente-Proceso creadas aún.</small> }
        </div>

      </div>
      <div class="modal-footer">
        <button class="btn btn-default" data-dismiss="modal">Cancelar</button>
        <button class="btn btn-primary" onclick="cfgSavePoliciaFull()"><i class="fa fa-save"></i> Guardar Todo</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal: Usuario (INTEGRADO — políticas) -->
<div id="modal-usuarios" class="modal fade" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header"><button type="button" class="close" data-dismiss="modal">&times;</button><h4 class="modal-title"><i class="fa fa-user"></i> Usuario</h4></div>
      <div class="modal-body">
        <input type="hidden" id="usr-Id" />
        <div class="row">
          <div class="col-sm-12"><div class="form-group"><label>Email *</label><input type="email" class="form-control" id="usr-Email" /></div></div>
          <div class="col-sm-12"><div class="form-group">
            <label id="usr-pass-label">Contraseña *</label>
            <input type="password" class="form-control" id="usr-Password" placeholder="Dejar en blanco para no cambiar" />
          </div></div>
        </div>

        <div class="cfg-modal-section">
          <div class="cfg-modal-section-title"><i class="fa fa-shield"></i> Políticas asignadas a este usuario</div>
          <div class="cfg-check-grid">
            @foreach (var p in Model.ListaPolicys)
            {
              <label class="cfg-check-item">
                <input type="checkbox" class="usr-politica-check" value="@p.Code" />
                <span>@p.PolicyName</span>
              </label>
            }
          </div>
          @if (!Model.ListaPolicys.Any()) { <small class="text-muted">No hay políticas creadas aún.</small> }
        </div>

      </div>
      <div class="modal-footer">
        <button class="btn btn-default" data-dismiss="modal">Cancelar</button>
        <button class="btn btn-primary" onclick="cfgSaveUsuarioFull()"><i class="fa fa-save"></i> Guardar Todo</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal: Azure Blob -->
<div id="modal-azureblob" class="modal fade" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header"><button type="button" class="close" data-dismiss="modal">&times;</button><h4 class="modal-title"><i class="fa fa-cloud"></i> Azure Blob Storage</h4></div>
      <div class="modal-body">
        <div class="row">
          <div class="col-sm-4"><div class="form-group"><label>Código *</label><input type="text" class="form-control" id="az-Codigo" /></div></div>
          <div class="col-sm-8"><div class="form-group"><label>Container Name *</label><input type="text" class="form-control" id="az-ContainerName" /></div></div>
          <div class="col-sm-12"><div class="form-group"><label>Connection String *</label><input type="password" class="form-control" id="az-ConnectionString" /></div></div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-default" data-dismiss="modal">Cancelar</button>
        <button class="btn btn-primary" onclick="cfgSaveAzureBlob()"><i class="fa fa-save"></i> Guardar</button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
@{ await Html.RenderPartialAsync("_BootboxPartial"); }
@{ await Html.RenderPartialAsync("_DateTablePartial"); }
<script>
// ── Estado en memoria para prompts del agente ──────────────────────────────
var agPrompts = [];

// ── Navegación sidebar ─────────────────────────────────────────────────────
$(function () {
    ['configai','agentes','prompts','procesos','politicas','usuarios','azureblob'].forEach(function(id) {
        var el = document.getElementById('dt-' + id);
        if (el) $(el).DataTable({ pageLength:15, dom:'<"row"<"col-sm-6"l><"col-sm-6"f>>tp', language:{ url:'' } });
    });

    var hash = window.location.hash.replace('#','');
    if (hash) activatePanel(hash);

    $('.cfg-nav-link').on('click', function(e) {
        e.preventDefault();
        var panel = $(this).data('panel');
        activatePanel(panel);
        window.location.hash = panel;
    });
});

function activatePanel(id) {
    $('.cfg-nav-link').removeClass('active');
    $('.cfg-panel').removeClass('active');
    $('[data-panel="' + id + '"]').addClass('active');
    $('#panel-' + id).addClass('active');
}

// ── Abrir modal nuevo ──────────────────────────────────────────────────────
function cfgOpenNew(entity) {
    switch(entity) {
        case 'configai':
            $('#cai-Code').val('').prop('readonly',false);
            $('#cai-Name,#cai-EndpointUrl,#cai-ApiKey,#cai-Notes').val('');
            $('#cai-ConfigType').val('AzureOpenAI'); $('#cai-IsActive').val('true');
            $('#modal-configai').modal('show'); break;

        case 'agentes':
            $('#ag-Code').val('').prop('readonly',false);
            $('#ag-Name,#ag-Description').val('');
            $('#ag-VersionNumber').val(1); $('#ag-IsActive').val('true');
            agPrompts = []; renderAgPrompts();
            $('.ag-proceso-check').prop('checked',false);
            $('#modal-agentes').modal('show'); break;

        case 'prompts':
            $('#pr-Code').val('').prop('readonly',false);
            $('#pr-Content').val(''); $('#pr-VersionNumber').val(1); $('#pr-IsActive').val('true');
            $('#modal-prompts').modal('show'); break;

        case 'procesos':
            $('#pc-Code').val('').prop('readonly',false);
            $('#pc-Name,#pc-Description').val('');
            $('.pc-agente-check').prop('checked',false);
            $('#modal-procesos').modal('show'); break;

        case 'politicas':
            $('#pol-Code').val('').prop('readonly',false);
            $('#pol-PolicyName').val('');
            $('.pol-cobertura-check').prop('checked',false);
            $('#modal-politicas').modal('show'); break;

        case 'usuarios':
            $('#usr-Id').val(''); $('#usr-Email,#usr-Password').val('');
            $('#usr-pass-label').text('Contraseña *');
            $('.usr-politica-check').prop('checked',false);
            $('#modal-usuarios').modal('show'); break;

        case 'azureblob':
            $('#az-Codigo').val('').prop('readonly',false);
            $('#az-ContainerName,#az-ConnectionString').val('');
            $('#modal-azureblob').modal('show'); break;
    }
}

// ── Abrir modal editar ─────────────────────────────────────────────────────
function cfgEdit(entity, d) {
    switch(entity) {
        case 'configai':
            $('#cai-Code').val(d.Code).prop('readonly',true);
            $('#cai-Name').val(d.Name); $('#cai-EndpointUrl').val(d.EndpointUrl);
            $('#cai-ApiKey').val(d.ApiKey); $('#cai-ConfigType').val(d.ConfigType);
            $('#cai-IsActive').val(d.IsActive ? 'true' : 'false'); $('#cai-Notes').val(d.Notes);
            $('#modal-configai').modal('show'); break;

        case 'agentes':
            $('#ag-Code').val(d.Code).prop('readonly',true);
            $('#ag-Name').val(d.Name); $('#ag-ConfigCode').val(d.ConfigCode);
            $('#ag-VersionNumber').val(d.VersionNumber); $('#ag-Description').val(d.Description);
            $('#ag-IsActive').val(d.IsActive ? 'true' : 'false');
            agPrompts = (d.Prompts || []).map(function(p){ return { promptCode:p.PromptCode, order:p.Order, isDefault:p.IsDefault }; });
            renderAgPrompts();
            $('.ag-proceso-check').prop('checked',false);
            (d.Procesos || []).forEach(function(code){ $('.ag-proceso-check[value="' + code + '"]').prop('checked',true); });
            $('#modal-agentes').modal('show'); break;

        case 'prompts':
            $('#pr-Code').val(d.Code).prop('readonly',true);
            $('#pr-Content').val(d.Content); $('#pr-VersionNumber').val(d.VersionNumber);
            $('#pr-IsActive').val(d.IsActive ? 'true' : 'false');
            $('#modal-prompts').modal('show'); break;

        case 'procesos':
            $('#pc-Code').val(d.Code).prop('readonly',true);
            $('#pc-Name').val(d.Name); $('#pc-Description').val(d.Description);
            $('.pc-agente-check').prop('checked',false);
            (d.Agentes || []).forEach(function(code){ $('.pc-agente-check[value="' + code + '"]').prop('checked',true); });
            $('#modal-procesos').modal('show'); break;

        case 'politicas':
            $('#pol-Code').val(d.Code).prop('readonly',true);
            $('#pol-PolicyName').val(d.PolicyName);
            $('.pol-cobertura-check').prop('checked',false);
            (d.AgentProcessIds || []).forEach(function(id){ $('.pol-cobertura-check[value="' + id + '"]').prop('checked',true); });
            $('#modal-politicas').modal('show'); break;

        case 'usuarios':
            $('#usr-Id').val(d.Id); $('#usr-Email').val(d.Email); $('#usr-Password').val('');
            $('#usr-pass-label').text('Nueva Contraseña (dejar en blanco para no cambiar)');
            $('.usr-politica-check').prop('checked',false);
            (d.PolicyCodes || []).forEach(function(code){ $('.usr-politica-check[value="' + code + '"]').prop('checked',true); });
            $('#modal-usuarios').modal('show'); break;

        case 'azureblob':
            $('#az-Codigo').val(d.Codigo).prop('readonly',true);
            $('#az-ContainerName').val(d.ContainerName); $('#az-ConnectionString').val(d.ConnectionString);
            $('#modal-azureblob').modal('show'); break;
    }
}

// ── Prompts del agente (tabla dinámica) ───────────────────────────────────
function agAddPrompt() {
    var code = $('#ag-newPromptCode').val();
    if (!code) return;
    if (agPrompts.some(function(p){ return p.promptCode === code; })) {
        mostrarNotificacion('Aviso','Este prompt ya fue agregado.'); return;
    }
    agPrompts.push({
        promptCode: code,
        order: parseInt($('#ag-newPromptOrder').val()) || 1,
        isDefault: $('#ag-newIsDefault').val() === 'true'
    });
    renderAgPrompts();
}
function agRemovePrompt(i) { agPrompts.splice(i,1); renderAgPrompts(); }
function renderAgPrompts() {
    var tbody = $('#ag-prompts-tbody'); tbody.empty();
    if (!agPrompts.length) {
        tbody.append('<tr><td colspan="4" class="text-center text-muted"><em>Sin prompts asignados</em></td></tr>');
        return;
    }
    $.each(agPrompts, function(i, p) {
        tbody.append('<tr>' +
            '<td><strong>' + p.promptCode + '</strong></td>' +
            '<td>' + p.order + '</td>' +
            '<td>' + (p.isDefault ? '<span class="cfg-badge" style="background:#16a34a">Sí</span>' : '<span class="text-muted">No</span>') + '</td>' +
            '<td><a onclick="agRemovePrompt(' + i + ')" class="fa fa-times txt-color-red" style="cursor:pointer" title="Quitar"></a></td>' +
            '</tr>');
    });
}

// ── Delete genérico ────────────────────────────────────────────────────────
function cfgDelete(ctrl, id, el) {
    bootbox.confirm({ title:'¿Eliminar?', message:'Esta acción no se puede deshacer.',
        buttons:{ cancel:{ label:'<i class="fa fa-times"></i> Cancelar' }, confirm:{ label:'<i class="fa fa-trash"></i> Eliminar', className:'btn-danger' } },
        callback: function(ok) {
            if (!ok) return;
            $.get('/' + ctrl + '/Delete?id=' + encodeURIComponent(id), function(r) {
                if (r.Estado === 'OK') $(el).closest('tr').fadeOut(300, function(){ $(this).remove(); });
                else mostrarNotificacion('Error', r.Mensaje);
            });
        }
    });
}
function cfgDeletePolitica(code, el) {
    bootbox.confirm({ title:'¿Eliminar política?', message:'Se eliminarán también sus coberturas y asignaciones a usuarios.',
        buttons:{ cancel:{ label:'Cancelar' }, confirm:{ label:'Eliminar', className:'btn-danger' } },
        callback: function(ok) {
            if (!ok) return;
            $.get('/Mantenedores/DeleteMantPolitica?code=' + encodeURIComponent(code), function(r) {
                if (r.Estado === 'OK') $(el).closest('tr').fadeOut(300, function(){ $(this).remove(); });
                else mostrarNotificacion('Error', r.Mensaje);
            });
        }
    });
}
function cfgDeleteUsuario(id, el) {
    bootbox.confirm({ title:'¿Eliminar usuario?', message:'Esta acción no se puede deshacer.',
        buttons:{ cancel:{ label:'Cancelar' }, confirm:{ label:'Eliminar', className:'btn-danger' } },
        callback: function(ok) {
            if (!ok) return;
            $.get('/Mantenedores/DeleteMantUsuario?id=' + encodeURIComponent(id), function(r) {
                if (r.Estado === 'OK') $(el).closest('tr').fadeOut(300, function(){ $(this).remove(); });
                else mostrarNotificacion('Error', r.Mensaje);
            });
        }
    });
}

// ── Helpers AJAX ──────────────────────────────────────────────────────────
function cfgPost(url, data) {
    return $.ajax({ type:'POST', url:url, contentType:'application/json', data:JSON.stringify(data) });
}
function cfgSaveOk(modal) {
    $(modal).modal('hide');
    mostrarNotificacion('OK', 'Guardado correctamente.');
    setTimeout(function(){ location.reload(); }, 900);
}
function cfgSaveErr(r) { mostrarNotificacion('Error', r.Mensaje || 'Error al guardar.'); }

// ── Saves ─────────────────────────────────────────────────────────────────
function cfgSaveConfigAi() {
    cfgPost('/Mantenedores/SaveConfiguracionAi', {
        Code: $('#cai-Code').val(), Name: $('#cai-Name').val(),
        EndpointUrl: $('#cai-EndpointUrl').val(), ApiKey: $('#cai-ApiKey').val(),
        ConfigType: $('#cai-ConfigType').val(), IsActive: $('#cai-IsActive').val()==='true', Notes: $('#cai-Notes').val()
    }).done(function(r){ r.Estado==='OK' ? cfgSaveOk('#modal-configai') : cfgSaveErr(r); });
}

function cfgSaveAgenteFull() {
    cfgPost('/Mantenedores/SaveAgenteFull', {
        Code: $('#ag-Code').val(), Name: $('#ag-Name').val(), ConfigCode: $('#ag-ConfigCode').val(),
        VersionNumber: parseInt($('#ag-VersionNumber').val()), Description: $('#ag-Description').val(),
        IsActive: $('#ag-IsActive').val()==='true',
        Prompts: agPrompts.map(function(p){ return { PromptCode:p.promptCode, Order:p.order, IsDefault:p.isDefault }; }),
        Procesos: $('.ag-proceso-check:checked').map(function(){ return this.value; }).get()
    }).done(function(r){ r.Estado==='OK' ? cfgSaveOk('#modal-agentes') : cfgSaveErr(r); });
}

function cfgSavePrompt() {
    cfgPost('/Mantenedores/SavePrompt', {
        Code: $('#pr-Code').val(), Content: $('#pr-Content').val(),
        VersionNumber: parseInt($('#pr-VersionNumber').val()), IsActive: $('#pr-IsActive').val()==='true'
    }).done(function(r){ r.Estado==='OK' ? cfgSaveOk('#modal-prompts') : cfgSaveErr(r); });
}

function cfgSaveProcesoFull() {
    cfgPost('/Mantenedores/SaveProcesoFull', {
        Code: $('#pc-Code').val(), Name: $('#pc-Name').val(), Description: $('#pc-Description').val(),
        Agentes: $('.pc-agente-check:checked').map(function(){ return this.value; }).get()
    }).done(function(r){ r.Estado==='OK' ? cfgSaveOk('#modal-procesos') : cfgSaveErr(r); });
}

function cfgSavePoliciaFull() {
    cfgPost('/Mantenedores/SavePoliciaFull', {
        Code: $('#pol-Code').val(), PolicyName: $('#pol-PolicyName').val(),
        AgentProcessIds: $('.pol-cobertura-check:checked').map(function(){ return parseInt(this.value); }).get()
    }).done(function(r){ r.Estado==='OK' ? cfgSaveOk('#modal-politicas') : cfgSaveErr(r); });
}

function cfgSaveUsuarioFull() {
    cfgPost('/Mantenedores/SaveUsuarioFull', {
        Id: $('#usr-Id').val() || null, Email: $('#usr-Email').val(),
        Password: $('#usr-Password').val() || null,
        PolicyCodes: $('.usr-politica-check:checked').map(function(){ return this.value; }).get()
    }).done(function(r){ r.Estado==='OK' ? cfgSaveOk('#modal-usuarios') : cfgSaveErr(r); });
}

function cfgSaveAzureBlob() {
    cfgPost('/Mantenedores/SaveAzureBlob', {
        Codigo: $('#az-Codigo').val(), ContainerName: $('#az-ContainerName').val(),
        ConnectionString: $('#az-ConnectionString').val()
    }).done(function(r){ r.Estado==='OK' ? cfgSaveOk('#modal-azureblob') : cfgSaveErr(r); });
}
</script>
}
