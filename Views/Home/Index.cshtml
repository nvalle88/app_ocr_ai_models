@{
    ViewData["Title"] = "Nexus";

    // La portada. Antes aquí vivían 1.644 líneas del dashboard de demo de
    // SmartAdmin —"My Income $47.171", gráficas inventadas— que ni siquiera se
    // renderizaban, porque el controlador redirigía a Nexus antes de llegar.
    //
    // Sólo entran las pantallas que se usan. La aplicación arrastra la plantilla
    // entera: blog, galería, comercio, foro, plantillas de correo, iconos,
    // gráficas y formularios de demo, más de cincuenta pantallas que no son de
    // nadie. Enseñarlas no es neutral: obliga a cada persona a aprender por su
    // cuenta cuáles importan, y eso se aprende equivocándose.
}

<style>
    :root {
        --nx-azul:  #002F87;   /* el azul institucional */
        --nx-suave: #eaf0fb;
        --nx-tinta: #1f2733;
        --nx-gris:  #6b7684;
        --nx-linea: #dde3ec;
    }

    .nx-portada { max-width: 1100px; margin: 0 auto; padding: 8px 16px 48px; color: var(--nx-tinta); }

    .nx-cab { padding: 22px 0 26px; border-bottom: 1px solid var(--nx-linea); margin-bottom: 26px; }
    .nx-cab h1 { font-size: 30px; font-weight: 700; color: var(--nx-azul); margin: 0 0 6px; }
    .nx-cab p  { font-size: 14.5px; color: var(--nx-gris); margin: 0; max-width: 640px; line-height: 1.55; }

    /* Las cifras: pocas y reales. */
    .nx-cifras { display: flex; flex-wrap: wrap; gap: 30px; margin: 0 0 30px; }
    .nx-cifra .val { display: block; font-size: 26px; font-weight: 700; color: var(--nx-azul); line-height: 1.1; }
    .nx-cifra .lbl { display: block; font-size: 11.5px; color: var(--nx-gris);
                     text-transform: uppercase; letter-spacing: .4px; margin-top: 3px; }

    .nx-grupo { margin-bottom: 30px; }
    .nx-grupo-tit {
        font-size: 12px; font-weight: 700; color: var(--nx-gris);
        text-transform: uppercase; letter-spacing: .6px; margin: 0 0 12px;
    }

    .nx-tarjetas { display: grid; grid-template-columns: repeat(auto-fill, minmax(268px, 1fr)); gap: 14px; }

    .nx-tarjeta {
        display: flex; gap: 14px; align-items: flex-start;
        background: #fff; border: 1px solid var(--nx-linea); border-radius: 10px;
        padding: 17px 19px; text-decoration: none; color: inherit;
        transition: border-color .12s, box-shadow .12s, transform .12s;
    }
    .nx-tarjeta:hover {
        border-color: var(--nx-azul); box-shadow: 0 3px 14px rgba(0,47,135,.10);
        transform: translateY(-1px); text-decoration: none; color: inherit;
    }
    .nx-tarjeta-icono {
        flex: 0 0 auto; width: 40px; height: 40px; border-radius: 9px;
        background: var(--nx-suave); color: var(--nx-azul);
        display: flex; align-items: center; justify-content: center; font-size: 17px;
    }
    .nx-tarjeta-txt { min-width: 0; }
    .nx-tarjeta-tit  { display: block; font-size: 15px; font-weight: 600; color: var(--nx-tinta); margin-bottom: 3px; }
    .nx-tarjeta-sub  { display: block; font-size: 12.5px; color: var(--nx-gris); line-height: 1.5; }
    .nx-tarjeta-dato { display: inline-block; font-size: 11.5px; font-weight: 700; color: var(--nx-azul);
                       background: var(--nx-suave); border-radius: 999px; padding: 1px 9px; margin-top: 7px; }

    /* Un aviso sólo aparece cuando hay algo que avisar. */
    .nx-aviso {
        display: flex; gap: 11px; align-items: flex-start;
        background: #fff6e0; border: 1px solid #f0dfae; border-left: 3px solid #8a6100;
        border-radius: 8px; padding: 13px 16px; margin-bottom: 26px; color: #8a6100;
    }
    .nx-aviso strong { display: block; font-size: 13.5px; margin-bottom: 2px; }
    .nx-aviso span   { display: block; font-size: 12.5px; line-height: 1.5; }
    .nx-aviso a      { color: #8a6100; font-weight: 600; text-decoration: underline; }

    @@media (max-width: 640px) {
        .nx-cifras { gap: 20px; }
        .nx-tarjetas { grid-template-columns: 1fr; }
    }
</style>

<div class="nx-portada">

    <div class="nx-cab">
        <h1>Nexus</h1>
        <p>
            Revisión de reembolsos asistida. Cada caso pasa por los mismos cuatro pasos
            —identificar los documentos, ordenar el expediente, revisar lo médico y aplicar el plan—
            tanto si entra por la bandeja del auditor como si lo presenta el afiliado desde su portal.
        </p>
    </div>

    <div class="nx-cifras">
        <div class="nx-cifra">
            <span class="val">@(((int)ViewBag.Casos).ToString("N0"))</span>
            <span class="lbl">Casos procesados</span>
        </div>
        <div class="nx-cifra">
            <span class="val">@ViewBag.Solicitudes</span>
            <span class="lbl">Solicitudes del portal</span>
        </div>
        <div class="nx-cifra">
            <span class="val">@ViewBag.Agentes</span>
            <span class="lbl">Agentes activos</span>
        </div>
        <div class="nx-cifra">
            <span class="val">@ViewBag.Tools</span>
            <span class="lbl">Herramientas</span>
        </div>
    </div>

    @if (ViewBag.ProcesosSinPasos > 0)
    {
        <div class="nx-aviso">
            <i class="fa fa-exclamation-triangle" style="font-size:16px;margin-top:2px"></i>
            <div>
                <strong>@ViewBag.ProcesosSinPasos proceso(s) sin ningún paso definido</strong>
                <span>
                    Un proceso sin pasos existe y no hace nada: el orquestador recorre una lista
                    vacía y devuelve texto vacío, sin error.
                    <a href="/Mantenedores/Config#pasos">Revisar los pasos</a>
                </span>
            </div>
        </div>
    }

    <div class="nx-grupo">
        <h2 class="nx-grupo-tit">Reembolsos</h2>
        <div class="nx-tarjetas">

            <a class="nx-tarjeta" href="/Studio/Sobres">
                <span class="nx-tarjeta-icono"><i class="fa fa-inbox"></i></span>
                <span class="nx-tarjeta-txt">
                    <span class="nx-tarjeta-tit">Bandeja de sobres</span>
                    <span class="nx-tarjeta-sub">Los casos que esperan revisión, con lo que el motor ya dedujo de cada documento.</span>
                </span>
            </a>

            <a class="nx-tarjeta" href="/Studio/Sobres/ImportarArmonix">
                <span class="nx-tarjeta-icono"><i class="fa fa-download"></i></span>
                <span class="nx-tarjeta-txt">
                    <span class="nx-tarjeta-tit">Importar desde Armonix</span>
                    <span class="nx-tarjeta-sub">Traer un sobre con sus documentos para revisarlo aquí.</span>
                </span>
            </a>

            <a class="nx-tarjeta" href="/Studio/Cliente">
                <span class="nx-tarjeta-icono"><i class="fa fa-user"></i></span>
                <span class="nx-tarjeta-txt">
                    <span class="nx-tarjeta-tit">Portal del afiliado</span>
                    <span class="nx-tarjeta-sub">Lo que ve el afiliado: adjunta sus documentos y se le explica qué le cubre y por qué.</span>
                    <span class="nx-tarjeta-dato">@ViewBag.Solicitudes solicitudes</span>
                </span>
            </a>

        </div>
    </div>

    <div class="nx-grupo">
        <h2 class="nx-grupo-tit">Consulta</h2>
        <div class="nx-tarjetas">

            <a class="nx-tarjeta" href="/Nexus">
                <span class="nx-tarjeta-icono"><i class="fa fa-folder-open-o"></i></span>
                <span class="nx-tarjeta-txt">
                    <span class="nx-tarjeta-tit">Casos</span>
                    <span class="nx-tarjeta-sub">Buscar un caso y ver su historia: qué se le pidió al motor y qué contestó.</span>
                </span>
            </a>

            <a class="nx-tarjeta" href="/Studio/Analizar">
                <span class="nx-tarjeta-icono"><i class="fa fa-search-plus"></i></span>
                <span class="nx-tarjeta-txt">
                    <span class="nx-tarjeta-tit">Analizar</span>
                    <span class="nx-tarjeta-sub">Pasar documentos por el motor sin abrir un caso.</span>
                </span>
            </a>

            <a class="nx-tarjeta" href="/Studio/Chat">
                <span class="nx-tarjeta-icono"><i class="fa fa-comments-o"></i></span>
                <span class="nx-tarjeta-txt">
                    <span class="nx-tarjeta-tit">Chat</span>
                    <span class="nx-tarjeta-sub">Preguntar al agente con las mismas herramientas que usa en un caso.</span>
                </span>
            </a>

        </div>
    </div>

    <div class="nx-grupo">
        <h2 class="nx-grupo-tit">Configuración</h2>
        <div class="nx-tarjetas">

            <a class="nx-tarjeta" href="/Mantenedores/Config">
                <span class="nx-tarjeta-icono"><i class="fa fa-cogs"></i></span>
                <span class="nx-tarjeta-txt">
                    <span class="nx-tarjeta-tit">Configuración del sistema</span>
                    <span class="nx-tarjeta-sub">Agentes, prompts, herramientas, skills, procesos y sus pasos, accesos y usuarios.</span>
                    <span class="nx-tarjeta-dato">@ViewBag.Agentes agentes · @ViewBag.Tools herramientas</span>
                </span>
            </a>

        </div>
    </div>

</div>
