@model app_tramites.Models.ModelAi.Process

@section Migas {
    <li><a asp-action="Index" onclick="cargando()">Procesos</a></li>
    <li class="active">@ViewData["accion"]</li>
}

<div class="row">
    <div class="col-xs-12 col-sm-7 col-md-7 col-lg-9 margin-top-0">
        <h1 class="page-title text-align-center txt-color-blueDark"><b>&nbsp;</b></h1>
    </div>
    <div class="col-xs-12 col-sm-5 col-md-5 col-lg-3 margin-top-0">
        <ul id="sparks">
            <li class="sparks-info">
                <a class="btn btn-primary" onclick="cargando()" asp-action="Index">
                    <i class="fa fa-arrow-left"></i> Volver
                </a>
            </li>
        </ul>
    </div>
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
        <div id="content" class="well no-padding">
            <form asp-action="Manage" method="post" novalidate="novalidate" class="smart-form client-form">
                <header>
                    <i class="fa fa-random"></i> &nbsp;<b>@ViewData["accion"] Proceso</b>
                </header>
                <fieldset>
                    <section>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    </section>

                    <section class="col col-sm-3">
                        <label class="label">Código <span class="text-danger">*</span></label>
                        <label class="input">
                            <i class="icon-append fa fa-key"></i>
                            <input type="text" asp-for="Code" placeholder="Ej: OCR-FACTURAS" class="text-uppercase">
                            <span asp-validation-for="Code" class="text-danger"></span>
                        </label>
                    </section>
                    <section class="col col-sm-9">
                        <label class="label">Nombre <span class="text-danger">*</span></label>
                        <label class="input">
                            <i class="icon-append fa fa-font"></i>
                            <input type="text" asp-for="Name" placeholder="Nombre del proceso">
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </label>
                    </section>
                    <section class="col col-sm-12">
                        <label class="label">Descripción</label>
                        <label class="textarea">
                            <textarea rows="5" asp-for="Description" placeholder="Describe el propósito y flujo de este proceso..."></textarea>
                        </label>
                    </section>
                </fieldset>
                <footer>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-save"></i> Guardar
                    </button>
                    <a asp-action="Index" onclick="cargando()" class="btn btn-default">
                        <i class="fa fa-times"></i> Cancelar
                    </a>
                </footer>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
