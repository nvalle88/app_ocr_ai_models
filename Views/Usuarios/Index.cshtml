@model List<Microsoft.AspNetCore.Identity.IdentityUser>
@section Migas {
    <li><a asp-action="Index" onclick="cargando()">Usuarios</a></li>
    <li class="active">Lista</li>
}

<div class="row">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
        <a asp-action="Manage" onclick="cargando()" class="btn btn-primary"><strong><i class="fa fa-user-plus"></i> Nuevo Usuario</strong></a>
    </div>
    <div class="col-xs-12 col-sm-5 col-md-5 col-lg-12"><br /></div>
</div>

<section id="widget-grid" class="">
    <div class="row">
        <article class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
            <div class="jarviswidget jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false">
                <header>
                    <span class="widget-icon"><i class="fa fa-users"></i></span>
                    <h2>Gestión de Usuarios</h2>
                </header>
                <div>
                    <div class="widget-body no-padding">
                        <table id="dt_basic" class="table table-striped table-bordered table-hover" width="100%">
                            <thead>
                                <tr>
                                    <th data-class="expand">Email</th>
                                    <th data-hide="phone">Email Confirmado</th>
                                    <th data-hide="phone">Bloqueo</th>
                                    <th data-hide="phone,tablet">Fin de Bloqueo</th>
                                    <th data-hide="phone,tablet">Opciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    bool bloqueado = item.LockoutEnd.HasValue && item.LockoutEnd > DateTimeOffset.UtcNow;
                                    <tr>
                                        <td>
                                            <i class="fa fa-user txt-color-blue"></i>
                                            <strong>@item.Email</strong>
                                        </td>
                                        <td>
                                            @if (item.EmailConfirmed)
                                            {
                                                <span class="badge" style="background-color:#5cb85c"><i class="fa fa-check"></i> Confirmado</span>
                                            }
                                            else
                                            {
                                                <span class="badge" style="background-color:#f0ad4e"><i class="fa fa-clock-o"></i> Pendiente</span>
                                            }
                                        </td>
                                        <td>
                                            @if (bloqueado)
                                            {
                                                <span class="badge" style="background-color:#d9534f"><i class="fa fa-lock"></i> Bloqueado</span>
                                            }
                                            else
                                            {
                                                <span class="badge" style="background-color:#5cb85c"><i class="fa fa-unlock"></i> Activo</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.LockoutEnd.HasValue && bloqueado)
                                            {
                                                <small class="text-danger">@item.LockoutEnd.Value.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</small>
                                            }
                                            else
                                            {
                                                <small class="text-muted">—</small>
                                            }
                                        </td>
                                        <td align="center">
                                            <a asp-action="Manage" onclick="cargando()" class="fa fa-edit txt-color-blue" asp-route-id="@item.Id" title="Editar"></a>
                                            &nbsp;|&nbsp;
                                            <a href="javascript:void(0);" class="fa @(bloqueado ? "fa-unlock txt-color-green" : "fa-lock txt-color-orange")"
                                               onclick="ToggleLock(this)" id="@item.Id"
                                               title="@(bloqueado ? "Desbloquear" : "Bloquear")"></a>
                                            &nbsp;|&nbsp;
                                            <a href="javascript:void(0);" class="fa fa-trash-o txt-color-red" onclick="Delete(this)"
                                               id="@item.Id" data-email="@item.Email"
                                               data-descripcion="¿Desea eliminar el usuario '@item.Email'? Esta acción no se puede deshacer."></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </article>
    </div>
</section>

@section Scripts {
    @{ await Html.RenderPartialAsync("_BootboxPartial"); }
    @{ await Html.RenderPartialAsync("_DateTablePartial"); }
    <script>
        function Delete(e) {
            var btn = $(e);
            bootbox.confirm({
                title: "¿ Eliminar usuario ?",
                message: btn.data("descripcion"),
                buttons: {
                    cancel: { label: '<i class="fa fa-times"></i> Cancelar' },
                    confirm: { label: '<i class="fa fa-trash-o"></i> Eliminar', className: 'btn-danger' }
                },
                callback: function (result) {
                    if (result) {
                        mostrarLoadingPanel("content", "");
                        $.ajax({
                            type: "GET",
                            url: '@Url.Action("Delete", "Usuarios")' + '?id=' + btn.prop("id"),
                            datatype: "json",
                            timeout: 500000,
                            success: function (data) {
                                if (data.estado == 'Error') {
                                    mostrarNotificacion("Error", data.mensaje);
                                    $("#content").waitMe("hide");
                                } else {
                                    window.location = '@Url.Action("Index", "Usuarios")';
                                }
                            },
                            error: function () {
                                $("#content").waitMe("hide");
                                mostrarNotificacion("Error", "No se pudo eliminar el usuario.");
                            }
                        });
                    }
                }
            });
        }

        function ToggleLock(e) {
            var btn = $(e);
            var id = btn.prop("id");
            mostrarLoadingPanel("content", "");
            $.ajax({
                type: "GET",
                url: '@Url.Action("ToggleLock", "Usuarios")' + '?id=' + id,
                datatype: "json",
                timeout: 500000,
                success: function (data) {
                    $("#content").waitMe("hide");
                    if (data.estado == 'Error') {
                        mostrarNotificacion("Error", data.mensaje);
                    } else {
                        mostrarNotificacion("OK", data.mensaje);
                        setTimeout(function() { window.location.reload(); }, 1200);
                    }
                },
                error: function () {
                    $("#content").waitMe("hide");
                    mostrarNotificacion("Error", "No se pudo cambiar el estado del usuario.");
                }
            });
        }
    </script>
}
