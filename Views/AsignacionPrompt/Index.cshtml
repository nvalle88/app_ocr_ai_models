@model List<app_tramites.Models.ModelAi.OPAIModelPrompt>
@section Migas {
    <li><a asp-action="Index" onclick="cargando()">Asignación Prompts</a></li>
    <li class="active">Lista</li>
}

<div class="row">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
        <a asp-action="Manage" onclick="cargando()" class="btn btn-primary"><strong><i class="fa fa-plus"></i> Nueva Asignación</strong></a>
    </div>
    <div class="col-xs-12 col-sm-5 col-md-5 col-lg-12"><br /></div>
</div>

<section id="widget-grid" class="">
    <div class="row">
        <article class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
            <div class="jarviswidget jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false">
                <header>
                    <span class="widget-icon"><i class="fa fa-link"></i></span>
                    <h2>Asignación de Prompts a Agentes</h2>
                </header>
                <div>
                    <div class="widget-body no-padding">
                        <table id="dt_basic" class="table table-striped table-bordered table-hover" width="100%">
                            <thead>
                                <tr>
                                    <th data-class="expand">Agente</th>
                                    <th>Prompt</th>
                                    <th>Orden</th>
                                    <th data-hide="phone,tablet">Opciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <strong>@(item.ModelCodeNavigation?.Name ?? item.ModelCode)</strong>
                                            <br /><small class="text-muted">@item.ModelCode</small>
                                        </td>
                                        <td>
                                            <span class="label label-default">@item.PromptCode</span>
                                        </td>
                                        <td>
                                            <span class="badge" style="background-color:#f0ad4e">@item.Order</span>
                                        </td>
                                        <td align="center">
                                            <a asp-action="Manage" onclick="cargando()" class="fa fa-edit txt-color-blue"
                                               asp-route-modelCode="@item.ModelCode" asp-route-promptCode="@item.PromptCode" title="Editar"></a>
                                            &nbsp;|&nbsp;
                                            <a href="javascript:void(0);" class="fa fa-trash-o txt-color-red" onclick="Delete(this)"
                                               data-model="@item.ModelCode" data-prompt="@item.PromptCode"
                                               data-descripcion="¿Desea eliminar la asignación de '@item.PromptCode' al agente '@(item.ModelCodeNavigation?.Name ?? item.ModelCode)'?"></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </article>
    </div>
</section>

@section Scripts {
    @{ await Html.RenderPartialAsync("_BootboxPartial"); }
    @{ await Html.RenderPartialAsync("_DateTablePartial"); }
    <script>
        function Delete(e) {
            var btn = $(e);
            bootbox.confirm({
                title: "¿ Eliminar ?",
                message: btn.data("descripcion"),
                buttons: {
                    cancel: { label: '<i class="fa fa-times"></i> Cancelar' },
                    confirm: { label: '<i class="fa fa-check"></i> OK' }
                },
                callback: function (result) {
                    if (result) {
                        mostrarLoadingPanel("content", "");
                        $.ajax({
                            type: "GET",
                            url: '@Url.Action("Delete", "AsignacionPrompt")',
                            data: { modelCode: btn.data("model"), promptCode: btn.data("prompt") },
                            contentType: "application/json; charset=utf-8",
                            datatype: "json",
                            timeout: 500000,
                            success: function (data) {
                                if (data.estado == 'Error') {
                                    mostrarNotificacion("Error", data.mensaje);
                                    $("#content").waitMe("hide");
                                } else {
                                    window.location = '@Url.Action("Index", "AsignacionPrompt")';
                                }
                            },
                            error: function () {
                                $("#content").waitMe("hide");
                                mostrarNotificacion("Error", "No se pudo eliminar el registro.");
                            }
                        });
                    }
                }
            });
        }
    </script>
}
