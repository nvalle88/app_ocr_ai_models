@{
    // La barra de siempre.
    //
    // Antes el header tenía el logo y el botón de salir, y nada más: no había
    // menú en ninguna parte —el _Navigation.cshtml de la plantilla, 630 líneas,
    // está entero comentado—. Sin un sitio común, cada pantalla se inventó su
    // propia navegación: por Resolución sales a un lado, por abrir caso a otro,
    // y aprenderse la aplicación se convierte en aprenderse cada pantalla.
    //
    // Aquí van sólo los cuatro sitios que existen de verdad. La aplicación
    // arrastra la plantilla SmartAdmin completa —blog, galería, comercio, foro,
    // plantillas de correo, iconos, gráficas y formularios de demo, más de
    // cincuenta pantallas— que no se enlazan a propósito.

    var ctrl = (ViewContext.RouteData.Values["controller"] ?? "").ToString();
    var area = (ViewContext.RouteData.Values["area"] ?? "").ToString();

    // Qué sección está activa, para que siempre se sepa dónde se está.
    // Nexus queda sin marcar a proposito: es la lista de casos, no la bandeja.
    // Marcar "Sobres" mientras estas en otro sitio es peor que no marcar nada,
    // porque la barra deja de ser fiable para orientarse.
    string seccion =
        ctrl == "Mantenedores" ? "config"
        : ctrl == "Cliente"    ? "portal"
        : area == "Studio"     ? "trabajo"
        : ctrl == "Home"       ? "inicio"
        : "";

    string Activa(string s) => seccion == s ? " nx-nav-link--activa" : "";
}

<style>
    #header { display: flex; align-items: center; }

    .nx-nav { display: flex; align-items: center; gap: 2px; margin-left: 26px; }
    .nx-nav-link {
        display: inline-flex; align-items: center; gap: 7px;
        padding: 8px 14px; border-radius: 7px;
        font-size: 13.5px; font-weight: 600; color: #4a5568;
        text-decoration: none; white-space: nowrap;
        border-bottom: 2px solid transparent;
    }
    .nx-nav-link:hover { background: #eaf0fb; color: #002F87; text-decoration: none; }
    .nx-nav-link--activa { color: #002F87; background: #eaf0fb; }
    .nx-nav-link i { font-size: 13px; opacity: .85; }

    @@media (max-width: 720px) {
        .nx-nav { margin-left: 10px; gap: 0; }
        .nx-nav-link { padding: 8px 9px; }
        .nx-nav-link span { display: none; }   /* en móvil sólo el icono */
    }
</style>

<!-- HEADER -->
<header id="header">
    <div>
        <span id="logo">
            <a href="/">
                <img src="~/img/logo_saludsa_home.svg" alt="Saludsa" />
            </a>
        </span>
    </div>

    <nav class="nx-nav">
        <a class="nx-nav-link@(Activa("inicio"))" href="/" title="Inicio">
            <i class="fa fa-home"></i> <span>Inicio</span>
        </a>
        <a class="nx-nav-link@(Activa("trabajo"))" href="/Studio/Sobres" title="Sobres de reembolso">
            <i class="fa fa-inbox"></i> <span>Sobres</span>
        </a>
        <a class="nx-nav-link@(Activa("portal"))" href="/Studio/Cliente" title="Portal del afiliado">
            <i class="fa fa-user"></i> <span>Portal del afiliado</span>
        </a>
        <a class="nx-nav-link@(Activa("config"))" href="/Mantenedores/Config" title="Configuración del sistema">
            <i class="fa fa-cogs"></i> <span>Configuración</span>
        </a>
    </nav>

    <div class="pull-right" style="margin-left:auto">
        <div id="logout" class="btn-header transparent pull-right">
            <span>
                <a asp-controller="Account" asp-action="Logout" title="Salir" data-action="userLogout"
                   data-logout-msg="Cierre también el navegador para mayor seguridad.">
                    <i class="fa fa-sign-out"></i>
                </a>
            </span>
        </div>
    </div>
</header>
