                function autoResize(el) {
                    if (!el) return;
                    el.style.height = 'auto';
                    const max = 320;
                    const newH = Math.min(el.scrollHeight, max);
                    el.style.height = newH + 'px';
                    positionChatInput();
                }
                if (textarea) {
                    autoResize(textarea);
                    textarea.addEventListener('input', () => {
                        stopThinking();
                        setBtnLoading(false);
                        autoResize(textarea);
                    });

                    textarea.addEventListener('focus', () => {
                        if (chatInner) chatInner.classList.add('has-focus');
                    });
                    textarea.addEventListener('blur', () => {
                        if (chatInner) chatInner.classList.remove('has-focus');
                    });

                    textarea.addEventListener('keydown', (e) => {
                        if (e.key === 'Enter' && !e.shiftKey) {
                            e.preventDefault();
                            sendBtn.click();
                        }
                    });
                }

                if (attachTransientBtn && chatFilesInput) {
                    chatFilesInput.addEventListener('change', async () => {
                        try {
                            const payloads = await filesToPayload(chatFilesInput.files);
                            transientAttachments = transientAttachments.concat(payloads.map((payload, index) => ({
                                fileName: chatFilesInput.files[index].name,
                                extension: payload.Extension,
                                payload
                            })));
                            renderTransientAttachments();
                            positionChatInput();
                        } catch (err) {
                            console.error('temporary attachments error', err);
                            Swal.fire({
                                icon: 'warning',
                                title: 'Advertencia',
                                text: err.message || 'No se pudieron adjuntar los archivos temporales.'
                            });
                        } finally {
                            chatFilesInput.value = '';
                            chatFilesInput.accept = transientFileAccept;
                        }
                    });
                }

