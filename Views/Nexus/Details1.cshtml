            });

            exportMdBtn?.addEventListener('click', async (ev) => {
                ev.preventDefault();
                try {
                    await window.NexusDetails1Exports?.downloadConversationMarkdown?.(exportMdBtn);
                } catch (err) {
                    console.error('conversation markdown export error', err);
                    Swal.fire({
                        icon: 'warning',
                        title: 'Advertencia',
                        text: 'No se pudo descargar la conversación en Markdown: ' + (err && err.message ? err.message : err),
                    });
                }
            });
        });
    </script>

    <script>


        (function () {
            let __pdfRenderToken = 0;
            let __typeToken = 0;
            let __thinkingToken = 0;
            let __currentThinking = null;
            let __lastManualScrollAt = 0;
            document.addEventListener('scroll', (ev) => {
                try {
                    const target = ev.target;
                    // si el scroll ocurrió dentro de un contenedor .result-area (o un hijo), lo consideramos manual
                    if (target && target.closest && (target.classList && target.classList.contains('result-area') || target.closest('.result-area'))) {
                        __lastManualScrollAt = Date.now();
                    }
                } catch (e) { /* ignore */ }
            }, true);

            function q(sel) { return document.querySelector(sel); }
            function qa(sel) { return Array.from(document.querySelectorAll(sel)); }

            function escapeHtml(value) {
                return (value ?? '').toString().replace(/[&<>"']/g, ch => ({
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#39;'
                })[ch]);
            }

            function decodeHtmlEntities(value) {
                const textarea = document.createElement('textarea');
                textarea.innerHTML = (value ?? '').toString();
                return textarea.value;
            }

            function encodeBase64Utf8(value) {
                try {
                    const source = (value ?? '').toString();
                    const bytes = new TextEncoder().encode(source);
                    let binary = '';
                    bytes.forEach(byte => binary += String.fromCharCode(byte));
                    return btoa(binary);
                } catch (e) {
                    return '';
                }
            }

            function decodeBase64Utf8(value) {
                try {
                    if (!value) return '';
                    const binary = atob(value);
                    const bytes = Uint8Array.from(binary, ch => ch.charCodeAt(0));
                    return new TextDecoder().decode(bytes);
                } catch (e) {
                    return '';
                }
            }

            function tryFormatJsonBlock(value) {
                const trimmed = (value ?? '').toString().trim();
                if (!trimmed || trimmed.includes('```')) return null;
                if (!(trimmed.startsWith('{') || trimmed.startsWith('['))) return null;

                try {
                    return JSON.stringify(JSON.parse(trimmed), null, 2);
                } catch (e) {
                    return null;
                }
            }

            function sanitizeRichHtml(root) {
                if (!root) return;

                root.querySelectorAll('script,style,iframe,object,embed,textarea,input,select,button,form').forEach(node => node.remove());

                root.querySelectorAll('*').forEach(node => {
                    Array.from(node.attributes).forEach(attr => {
                        const attrName = attr.name.toLowerCase();
                        const attrValue = (attr.value || '').trim();

                        if (attrName.startsWith('on')) {
                            node.removeAttribute(attr.name);
                            return;
                        }

                        if ((attrName === 'href' || attrName === 'src') && /^javascript:/i.test(attrValue)) {
                            node.setAttribute(attr.name, '#');
                        }
                    });
                });
            }

            function normalizeCodeLanguage(lang) {
                const raw = (lang || '').toString().trim().toLowerCase();
                if (!raw) return '';

                const aliases = {
                    cs: 'csharp',
                    'c#': 'csharp',
                    csharp: 'csharp',
                    js: 'javascript',
                    ts: 'typescript',
                    yml: 'yaml',
                    ps1: 'powershell',
                    shell: 'bash',
                    sh: 'bash',
                    text: 'plaintext',
                    txt: 'plaintext'
                };

                return aliases[raw] || raw;
            }

            function codeLanguageLabel(lang) {
                const normalized = normalizeCodeLanguage(lang);
                if (!normalized) return 'CODE';

                const labels = {
                    csharp: 'C#',
                    javascript: 'JavaScript',
                    typescript: 'TypeScript',
                    json: 'JSON',
                    sql: 'SQL',
                    html: 'HTML',
                    xml: 'XML',
                    css: 'CSS',
                    bash: 'Bash',
                    powershell: 'PowerShell',
                    yaml: 'YAML',
                    plaintext: 'Texto'
                };

                return labels[normalized] || normalized.toUpperCase();
            }

            function enhanceMarkdownContent(root) {
                if (!root) return;

                root.querySelectorAll('pre > code').forEach(code => {
                    const pre = code.parentElement;
                    if (!pre) return;

                    const languageClass = (code.className || '')
                        .split(/\s+/)
                        .find(cls => cls.startsWith('language-') || cls.startsWith('lang-'));

                    const lang = normalizeCodeLanguage(
                        languageClass
                            ? languageClass.replace(/^language-/, '').replace(/^lang-/, '')
                            : code.dataset.lang || pre.dataset.codeLanguage || ''
                    );

                    pre.dataset.codeLanguage = codeLanguageLabel(lang);
                    pre.classList.add('chat-code-block');
                    code.classList.add('chat-code');
                });

                root.querySelectorAll('table').forEach(table => {
                    table.classList.add('table', 'table-sm', 'table-striped', 'markdown-table');
                });

                root.querySelectorAll('a[href]').forEach(link => {
                    link.setAttribute('target', '_blank');
                    link.setAttribute('rel', 'noopener noreferrer');
                });
            }

            function renderMarkdownHtml(source) {
                let raw = decodeHtmlEntities(source);
                if (!raw) return '';

                const formattedJson = tryFormatJsonBlock(raw);
                if (formattedJson) {
                    raw = `\`\`\`json\n${formattedJson}\n\`\`\``;
                }

                const parsed = (typeof marked !== 'undefined')
                    ? marked.parse(raw, {
                        gfm: true,
                        breaks: true,
                        mangle: false,
                        headerIds: false
                    })
                    : raw;

                const temp = document.createElement('div');
                temp.innerHTML = parsed;
                sanitizeRichHtml(temp);
                enhanceMarkdownContent(temp);
                return temp.innerHTML;
            }

            function findEmbeddedMarkdownValue(node, depth = 0) {
                if (!node || depth > 10) return '';

                if (typeof node === 'string') {
                    return '';
                }

                if (Array.isArray(node)) {
                    for (const item of node) {
                        const nested = findEmbeddedMarkdownValue(item, depth + 1);
                        if (nested) return nested;
                    }
                    return '';
                }

                if (typeof node === 'object') {
                    for (const [key, value] of Object.entries(node)) {
                        if ((key || '').toLowerCase() === 'markdown' && typeof value === 'string' && value.trim()) {
                            return value.trim();
                        }
                    }

                    for (const value of Object.values(node)) {
                        const nested = findEmbeddedMarkdownValue(value, depth + 1);
                        if (nested) return nested;
                    }
                }

                return '';
            }

            function humanizeJsonKey(key) {
                return (key || '')
                    .toString()
                    .replace(/([a-z0-9])([A-Z])/g, '$1 $2')
                    .replace(/[_-]+/g, ' ')
                    .replace(/\s+/g, ' ')
                    .trim();
            }

            function isComplexJsonValue(value) {
                return Array.isArray(value) || (value !== null && typeof value === 'object');
            }

            function formatJsonScalarForMarkdown(value) {
                if (value === null || value === undefined) return '`null`';
                if (typeof value === 'boolean') return value ? 'Sí' : 'No';
                if (typeof value === 'number') return String(value);

                const text = decodeHtmlEntities((value ?? '').toString()).trim();
                return text || '` `';
            }

            function buildJsonMarkdownDocument(value, depth = 2) {
                if (Array.isArray(value)) {
                    if (!value.length) return '_Sin elementos_';

                    const hasComplexItems = value.some(item => isComplexJsonValue(item));
                    if (!hasComplexItems) {
                        return value.map(item => `- ${formatJsonScalarForMarkdown(item)}`).join('\n');
                    }

                    return value.map((item, index) => {
                        if (!isComplexJsonValue(item)) {
                            return `- ${formatJsonScalarForMarkdown(item)}`;
                        }

                        const heading = `${'#'.repeat(Math.min(depth, 6))} Elemento ${index + 1}`;
                        return `${heading}\n\n${buildJsonMarkdownDocument(item, depth + 1)}`;
                    }).join('\n\n');
                }

                if (value !== null && typeof value === 'object') {
                    const inlineLines = [];
                    const sectionBlocks = [];

                    Object.entries(value).forEach(([key, entryValue]) => {
                        const label = humanizeJsonKey(key) || key;
                        const scalar = !isComplexJsonValue(entryValue);
                        const textValue = scalar ? formatJsonScalarForMarkdown(entryValue) : '';
                        const isMultilineScalar = scalar && /\r|\n/.test(textValue);

                        if (scalar && !isMultilineScalar) {
                            inlineLines.push(`- **${label}:** ${textValue}`);
                            return;
                        }

                        const heading = `${'#'.repeat(Math.min(depth, 6))} ${label}`;
                        const content = scalar
                            ? textValue
                            : buildJsonMarkdownDocument(entryValue, depth + 1);
                        sectionBlocks.push(`${heading}\n\n${content}`);
                    });

                    return [...(inlineLines.length ? [inlineLines.join('\n')] : []), ...sectionBlocks]
                        .filter(Boolean)
                        .join('\n\n');
                }

                return formatJsonScalarForMarkdown(value);
            }

            function resolveMarkdownRenderSource(source) {
                const raw = (source ?? '').toString().trim();
                if (!raw) {
                    return { content: '', extracted: false, fromJson: false };
                }

                const candidates = [raw, decodeHtmlEntities(raw)].filter(Boolean);
                for (const candidate of candidates) {
                    const trimmed = candidate.trim();
                    if (!(trimmed.startsWith('{') || trimmed.startsWith('['))) {
                        continue;
                    }

                    try {
                        const parsed = JSON.parse(trimmed);
                        return {
                            content: buildJsonMarkdownDocument(parsed),
                            extracted: !!findEmbeddedMarkdownValue(parsed),
                            fromJson: true
                        };
                    } catch (e) {
                        // Si no es JSON válido, seguimos con el render normal.
                    }
                }

                return {
                    content: raw,
                    extracted: false,
                    fromJson: false
                };
            }

            function normalizeRequestPayload(source) {
                const raw = decodeHtmlEntities(source || '').trim();
                if (!raw) {
                    return { message: '', attachments: '' };
                }

                const temp = document.createElement('div');
                temp.innerHTML = raw;
                sanitizeRichHtml(temp);

                const attachmentParts = [];
                temp.querySelectorAll('.chat-request-attachments').forEach(node => {
                    const value = (node.textContent || '').trim();
                    if (value) attachmentParts.push(value);
                    node.remove();
                });

                temp.querySelectorAll('br').forEach(node => node.replaceWith('\n'));
                temp.querySelectorAll('div, p, li').forEach(node => {
                    if (node.nextSibling) {
                        node.after(document.createTextNode('\n'));
                    }
                });

                let message = (temp.textContent || '')
                    .replace(/\r/g, '')
                    .replace(/\n{3,}/g, '\n\n')
                    .trim();

                const lines = message
                    .split('\n')
                    .map(line => line.trim())
                    .filter(Boolean);

                const inlineAttachments = lines.filter(line => /^adjuntos?\s+temporales?:/i.test(line));
                if (inlineAttachments.length) {
                    attachmentParts.push(...inlineAttachments);
                    message = lines.filter(line => !/^adjuntos?\s+temporales?:/i.test(line)).join('\n');
                }

                return {
                    message: message.trim(),
                    attachments: attachmentParts.join(' • ').trim()
                };
            }

            function renderRequestHtml(source) {
                const normalized = normalizeRequestPayload(source);
                if (!normalized.message && !normalized.attachments) return '';

                const parts = [];
                if (normalized.message) {
                    parts.push(`<div>${escapeHtml(normalized.message).replace(/\n/g, '<br>')}</div>`);
                }

                if (normalized.attachments) {
                    parts.push(`<div class="chat-request-attachments">${escapeHtml(normalized.attachments)}</div>`);
                }

                return parts.join('');
            }

            function getDocumentType(extension) {
                const ext = (extension || '').toLowerCase().replace(/^\./, '');
                if (ext === 'pdf') return 'pdf';
                if (['jpg', 'jpeg', 'png', 'webp', 'bmp', 'tif', 'tiff'].includes(ext)) return 'img';
                if (['xml', 'html', 'htm'].includes(ext)) return 'markup';
                return 'other';
            }

            function getDocumentIcon(type, extension) {
                const ext = (extension || '').toLowerCase().replace(/^\./, '');
                if (type === 'pdf') return 'fa-file-pdf text-danger';
                if (type === 'markup') return ext === 'xml' ? 'fa-file-code text-primary' : 'fa-file-lines text-primary';
                return 'fa-file-lines text-muted';
            }

            function formatXmlForPreview(xmlText) {
                const normalized = (xmlText || '').replace(/>\s*</g, '><').trim();
                if (!normalized) return '';

                const tokens = normalized.replace(/(>)(<)(\/*)/g, '$1\r\n$2$3').split('\r\n');
                let indent = 0;
                const formatted = [];

                tokens.forEach(token => {
                    if (!token) return;

                    if (/^<\//.test(token)) {
                        indent = Math.max(indent - 1, 0);
                    }

                    formatted.push(`${'  '.repeat(indent)}${token}`);

                    if (/^<[^!?/][^>]*[^/]?>$/.test(token) && !/<\/[^>]+>$/.test(token)) {
                        indent += 1;
                    }
                });

                return formatted.join('\n').trim();
            }

            function formatHtmlForPreview(htmlText) {
                const normalized = decodeHtmlEntities(htmlText || '').replace(/>\s+</g, '><').trim();
                if (!normalized) return '';

                const tokens = normalized.replace(/(>)(<)(\/*)/g, '$1\r\n$2$3').split('\r\n');
                const voidTags = new Set(['area', 'base', 'br', 'col', 'embed', 'hr', 'img', 'input', 'link', 'meta', 'param', 'source', 'track', 'wbr']);
                let indent = 0;
                const formatted = [];

                tokens.forEach(token => {
                    if (!token) return;

                    const trimmed = token.trim();
                    if (!trimmed) return;

                    const tagMatch = trimmed.match(/^<\s*([^\s/>]+)/);
                    const tagName = tagMatch ? tagMatch[1].toLowerCase() : '';
                    const isClosing = /^<\//.test(trimmed);
                    const isSelfClosing = /\/>$/.test(trimmed) || voidTags.has(tagName);
                    const isInlinePair = /^<[^!?/][^>]*>.*<\/[^>]+>$/.test(trimmed);
                    const isDeclaration = /^<!/.test(trimmed) || /^<\?/.test(trimmed);

                    if (isClosing) {
                        indent = Math.max(indent - 1, 0);
                    }

                    formatted.push(`${'  '.repeat(indent)}${trimmed}`);

                    if (!isClosing && !isSelfClosing && !isInlinePair && !isDeclaration && /^<[^!?/]/.test(trimmed)) {
                        indent += 1;
                    }
                });

                return formatted.join('\n').trim();
            }

            function normalizeMarkupSource(value) {
                return decodeHtmlEntities(value || '').replace(/^\uFEFF/, '').trim();
            }

            function sanitizePreviewMarkupRoot(root) {
                if (!root) return;

                root.querySelectorAll('script,iframe,object,embed,noscript').forEach(node => node.remove());

                root.querySelectorAll('*').forEach(node => {
                    Array.from(node.attributes).forEach(attr => {
                        const attrName = attr.name.toLowerCase();
                        const attrValue = (attr.value || '').trim();

                        if (attrName.startsWith('on')) {
                            node.removeAttribute(attr.name);
                            return;
                        }

                        if ((attrName === 'href' || attrName === 'src' || attrName === 'xlink:href') && /^javascript:/i.test(attrValue)) {
                            node.setAttribute(attr.name, '#');
                        }
                    });
                });
            }

            function createDomTreePreview(rootNode, options = {}) {
                const wrapper = document.createElement('div');
                wrapper.className = 'preview-markup-tree';

                const rootLabel = options.rootLabel || '';
                if (rootLabel) {
                    const intro = document.createElement('div');
                    intro.className = 'preview-markup-tree-label';
                    intro.textContent = rootLabel;
                    wrapper.appendChild(intro);
                }

                function renderNode(node, depth = 0) {
                    if (!node) return null;

                    if (node.nodeType === Node.TEXT_NODE || node.nodeType === Node.CDATA_SECTION_NODE) {
                        const text = (node.textContent || '').trim();
                        if (!text) return null;

                        const value = document.createElement('div');
                        value.className = 'xml-tree-value';
                        value.textContent = text;
                        return value;
                    }

                    if (node.nodeType !== Node.ELEMENT_NODE) {
                        return null;
                    }

                    const attrs = Array.from(node.attributes || []);
                    const childNodes = Array.from(node.childNodes || [])
                        .map(child => renderNode(child, depth + 1))
                        .filter(Boolean);

                    const hasChildren = childNodes.length > 0;

                    if (!hasChildren) {
                        const leaf = document.createElement('div');
                        leaf.className = 'xml-tree-leaf';

                        const tag = document.createElement('div');
                        tag.className = 'xml-tree-line';
                        tag.innerHTML = `<span class="xml-tree-tag">&lt;${escapeHtml(node.nodeName)}&gt;</span>`;
                        leaf.appendChild(tag);

                        attrs.forEach(attr => {
                            const attrLine = document.createElement('div');
                            attrLine.className = 'xml-tree-attr';
                            attrLine.innerHTML = `<span class="xml-tree-attr-name">${escapeHtml(attr.name)}</span>="<span class="xml-tree-attr-value">${escapeHtml(attr.value)}</span>"`;
                            leaf.appendChild(attrLine);
                        });

                        return leaf;
                    }

                    const details = document.createElement('details');
                    details.className = 'xml-tree-node';
                    details.open = depth < 2;

                    const summary = document.createElement('summary');
                    summary.className = 'xml-tree-summary';
                    summary.innerHTML = `<span class="xml-tree-tag">&lt;${escapeHtml(node.nodeName)}&gt;</span><span class="xml-tree-count">${childNodes.length} nodo${childNodes.length === 1 ? '' : 's'}</span>`;
                    details.appendChild(summary);

                    const content = document.createElement('div');
                    content.className = 'xml-tree-children';

                    attrs.forEach(attr => {
                        const attrLine = document.createElement('div');
                        attrLine.className = 'xml-tree-attr';
                        attrLine.innerHTML = `<span class="xml-tree-attr-name">${escapeHtml(attr.name)}</span>="<span class="xml-tree-attr-value">${escapeHtml(attr.value)}</span>"`;
                        content.appendChild(attrLine);
                    });

                    childNodes.forEach(child => content.appendChild(child));
                    details.appendChild(content);
                    return details;
                }

                const renderedRoot = renderNode(rootNode);
                if (renderedRoot) {
                    wrapper.appendChild(renderedRoot);
                }

                return wrapper;
            }

            function createMarkupCodeBlock(markupExt, rawText) {
                const pre = document.createElement('pre');
                pre.className = 'preview-markup-code';

                const code = document.createElement('code');
                const isXml = markupExt === 'xml';
                code.className = isXml ? 'language-xml' : 'language-html';
                code.textContent = isXml
                    ? formatXmlForPreview(normalizeMarkupSource(rawText))
                    : formatHtmlForPreview(normalizeMarkupSource(rawText));

                pre.appendChild(code);
                return pre;
            }

            function createRenderedHtmlPreview(rawHtml) {
                const wrapper = document.createElement('div');
                wrapper.className = 'preview-markup-rendered';

                const source = normalizeMarkupSource(rawHtml);
                const body = document.createElement('div');
                body.className = 'preview-markup-rendered-body';
                body.innerHTML = source;
                sanitizeRichHtml(body);
                enhanceMarkdownContent(body);
                wrapper.appendChild(body);
                return wrapper;
            }

            function createXmlTreePreview(rawXml) {
                const source = normalizeMarkupSource(rawXml);
                const parser = new DOMParser();
                const xmlDoc = parser.parseFromString(source || '<root />', 'application/xml');
                const parseError = xmlDoc.querySelector('parsererror') || xmlDoc.getElementsByTagName('parsererror')[0];

                if (parseError) {
                    const wrapper = document.createElement('div');
                    wrapper.className = 'preview-markup-tree';
                    const warning = document.createElement('div');
                    warning.className = 'preview-markup-tree-error';
                    warning.textContent = 'No se pudo estructurar el XML. Mostrando contenido formateado.';
                    wrapper.appendChild(warning);
                    wrapper.appendChild(createMarkupCodeBlock('xml', source));
                    return wrapper;
                }

                const tree = createDomTreePreview(xmlDoc.documentElement, { rootLabel: 'Estructura XML' });

                const declarationMatch = source.match(/^<\?xml[\s\S]*?\?>/i);
                if (declarationMatch) {
                    const declaration = document.createElement('div');
                    declaration.className = 'xml-tree-comment';
                    declaration.textContent = declarationMatch[0];
                    tree.insertBefore(declaration, tree.firstChild);
                }

                return tree;
            }

