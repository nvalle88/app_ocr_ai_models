@model app_tramites.Models.ViewModel.ViewCaseDetails
@using Markdig
@{
    Layout = "_Layout"; // o el layout que uses
    var orderedResults = Model.ProcessCase.FinalResponseResults?
        .OrderBy(r => r.CreatedDate)
        .ToList() ?? [];
    var caseShortCode = ((Model.ProcessCase.CaseCode.ToString() ?? "").Split('-').FirstOrDefault() ?? "");
}


<div class="container-fluid app-container">
    <div class="row g-1 layout-row">
        <!-- LEFT: Tabla de Fuentes / Documentos -->
        <aside class="col-lg-2 left-col" id="colLeft">
            <div class="card card-panel-left rounded-3 h-100">
                <div class="card-header d-flex align-items-center justify-content-between small-header left-header">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa fa-folder-open me-2"></i>
                        <strong id="leftHeaderTitle">Documentos del caso <small class="text-muted" id="leftCount">@((Model.ProcessCase.DataFile?.Count() ?? 0))</small></strong>
                    </div>
                </div>

                <div class="card-body p-2 panel-body panel-height d-flex flex-column">
                    <div class="documents-stack">
                        <section class="documents-surface sources-surface">
                            <div class="surface-toolbar d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="surface-title">Documentos persistentes</div>
                                    <small class="text-muted">Adjunta aquí los archivos que deben quedar guardados en el caso.</small>
                                </div>
                                <div class="surface-toolbar-actions">
                                    <button id="btnAttachPermanent" type="button" class="btn btn-sm btn-light">
                                        <i class="fa fa-plus me-1"></i>Adjuntar al caso
                                    </button>
                                    <input type="file"
                                           id="caseFilesInput"
                                           class="native-file-input"
                                           hidden
                                           aria-hidden="true"
                                           tabindex="-1"
                                           style="display:none !important;"
                                           multiple
                                           accept=".pdf,.jpg,.jpeg,.png,.webp,.bmp,.tif,.tiff,.xml,.html,.htm,image/*,application/pdf,text/xml,application/xml,text/html" />
                                    <button id="btnRefreshSources" class="btn btn-sm btn-outline-secondary" title="Refrescar lista">
                                        <i class="fa fa-sync"></i>
                                    </button>
                                </div>
                            </div>

                            <div id="sourcesWrapper" class="sources-wrapper">
                                <table id="sourcesTable" class="table table-borderless table-hover mb-0" style="width:100%;">
                                    <thead class="d-none"></thead>
                                    <tbody>
                                        @foreach (var file in Model.ProcessCase.DataFile.OrderByDescending(x => x.CreatedDate))
                                        {
                                            var origName = !string.IsNullOrWhiteSpace(file.OriginalName) ? file.OriginalName : file.FileUri;
                                            var ext = System.IO.Path.GetExtension(origName)?.ToLower().TrimStart('.') ?? "";
                                            var url = file.FileUri;
                                            var type = (ext == "pdf") ? "pdf" : (ext == "jpg" || ext == "jpeg" || ext == "png" || ext == "webp" || ext == "bmp" || ext == "tif" || ext == "tiff") ? "img" : (ext == "xml" || ext == "html" || ext == "htm") ? "markup" : "other";
                                            <tr class="source-row" data-id="@file.Id" data-url="@url" data-type="@type" data-ext="@ext" title="@System.IO.Path.GetFileName(origName)" style="cursor:pointer;">
                                                <td style="width:56px; padding:.5rem;">
                                                    <div class="thumb-wrap">
                                                        @if (ext == "pdf")
                                                        {
                                                            <i class="fa fa-file-pdf fa-lg text-danger"></i>
                                                        }
                                                        else if (type == "markup")
                                                        {
                                                            <i class="fa fa-file-code fa-lg text-primary"></i>
                                                        }
                                                        else if (type == "other")
                                                        {
                                                            <i class="fa fa-file-lines fa-lg text-muted"></i>
                                                        }
                                                        else
                                                        {
                                                            <img src="@url" class="thumb-img" onerror="this.style.display='none';" />
                                                        }
                                                    </div>
                                                </td>
                                                <td class="align-middle">
                                                    <div class="fw-semibold text-truncate">@origName</div>
                                                    <small class="text-muted">@ext.ToUpper()</small>
                                                </td>
                                                <td class="text-end align-middle" style="width:36px;">
                                                    <i class="fa fa-chevron-right text-muted"></i>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </section>

                        <section class="documents-surface preview-surface">
                            <div class="surface-toolbar d-flex align-items-center justify-content-between">
                                <div>
                                    <div class="surface-title" id="previewTitle">Vista previa del documento</div>
                                    <small class="text-muted">Selecciona un archivo del expediente para revisarlo aquí.</small>
                                </div>
                                <div class="d-flex gap-1 flex-wrap preview-toolbar-actions">
                                    <button id="btnBackToList" class="btn btn-sm btn-outline-secondary" title="Limpiar selección">
                                        <i class="fa fa-eraser"></i>
                                    </button>
                                    <button id="btnOpenInViewer" class="btn btn-sm btn-light" title="Abrir en otra pestaña">
                                        <i class="fa fa-external-link-alt"></i>
                                    </button>
                                    <button id="btnDownloadPreview" class="btn btn-sm btn-light" title="Descargar">
                                        <i class="fa fa-download"></i>
                                    </button>
                                    <span id="zoomLabel" class="zoom-status">100%</span>
                                    <span class="preview-zoom-hint">Ctrl + rueda</span>
                                    <div class="btn-group ms-2" role="group" aria-label="Zoom controls">
                                        <button id="btnZoomOut" type="button" class="btn btn-sm btn-light" title="Zoom - (tecla '-')"><i class="fa fa-search-minus"></i></button>
                                        <button id="btnZoomReset" type="button" class="btn btn-sm btn-light" title="Reset zoom (tecla 0)"><i class="fa fa-ban"></i></button>
                                        <button id="btnZoomIn" type="button" class="btn btn-sm btn-light" title="Zoom + (tecla '+')"><i class="fa fa-search-plus"></i></button>
                                    </div>
                                </div>
                            </div>

                            <div id="previewWrapper" class="preview-wrapper">
                                <div id="previewEmptyState" class="preview-empty-state">
                                    <i class="fa fa-file-alt"></i>
                                    <div class="fw-semibold">Sin documento seleccionado</div>
                                    <div class="text-muted">Haz clic sobre un archivo del expediente para abrir su vista previa aquí.</div>
                                </div>
                                <div id="previewContent" style="width:100%; min-height:240px;"></div>
                            </div>
                        </section>
                    </div>

                    <div class="mt-2 d-flex justify-content-between align-items-center small documents-footer-meta">
                        <div class="text-muted">Mostrar: <span id="shownCount">@((Model.ProcessCase.DataFile?.Count() ?? 0))</span></div>
                        <div id="sourcesStatus" class="text-muted">Listo para adjuntar nuevos documentos</div>
                    </div>
                </div>
            </div>
        </aside>

        <!-- CENTER: Chat / Resultados -->
        <main class="col-lg-8 center-col" id="colCenter">
            <div class="card card-panel-center rounded-3 h-100">
                <div class="card-header d-flex align-items-center justify-content-between small-header center-header">
                    <div class="d-flex align-items-center gap-2">
                        <div>
                            <h5 class="mb-0 header-title">Resultados del Caso</h5>
                            <small class="case-header-meta">NE-@caseShortCode · @Model.ProcessCase.DefinitionCodeNavigation?.Name</small>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2 panel-header-actions">
                        <a asp-action="Index" onclick="cargando()"
                           class="btn btn-primary btn-lg d-flex align-items-center gap-2"
                           id="btnBackPage" title="Volver">
                            <i class="fa fa-arrow-left"></i>
                            <span>Volver</span>
                        </a>

                        <button id="btnExportPdf" type="button"
                                class="btn btn-primary btn-lg d-flex align-items-center gap-2"
                                title="Exportar resultados a PDF">
                            <i class="fa fa-file-pdf me-1" aria-hidden="true"></i>
                            <span>Exportar PDF</span>
                        </button>
                    </div>
                </div>

                <div class="card-body d-flex flex-column panel-body panel-height">
                    <div class="case-summary-strip mb-3">
                        <div class="case-summary-pill">
                            <span class="label">Caso</span>
                            <strong>NE-@caseShortCode</strong>
                        </div>
                        <div class="case-summary-pill">
                            <span class="label">Documentos</span>
                            <strong>@(Model.ProcessCase.DataFile?.Count() ?? 0)</strong>
                        </div>
                        @if (orderedResults.Any())
                        {
                            var lastDate = orderedResults.LastOrDefault()?.CreatedDate;
                            if (lastDate != null)
                            {
                                <div class="case-summary-pill">
                                    <span class="label">Última respuesta</span>
                                    <strong>@lastDate.Value.ToLocalTime().ToString("dd/MM/yyyy, HH:mm")</strong>
                                </div>
                            }
                        }
                    </div>

                    <div class="flex-grow-1 result-area mb-2">
                        <div class="result-panel p-3 h-100">
                            @if (!orderedResults.Any())
                            {
                                <div class="alert alert-warning text-center mb-0">
                                    <i class="fa fa-info-circle me-2"></i>No hay resultados disponibles para este caso.
                                </div>
                            }
                            else
                            {
                                <div id="chatOutput" class="chat-thread">
                                    @foreach (var entry in orderedResults)
                                    {
                                        var requestHtml = RenderRequestBubble(entry.RequestText);
                                        var responseHtml = string.IsNullOrWhiteSpace(entry.ResponseText) ? string.Empty : RenderMarkdown(entry.ResponseText.Trim());
                                        <article class="chat-turn">
                                            @if (!string.IsNullOrWhiteSpace(requestHtml))
                                            {
                                                <div class="chat-turn-request">
                                                    @Html.Raw(requestHtml)
                                                </div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(responseHtml))
                                            {
                                                <div class="chat-turn-response">
                                                    @Html.Raw(responseHtml)
                                                </div>
                                            }
                                            <div class="chat-turn-meta">@entry.CreatedDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                        </article>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    @{
                        var hasChat = (Model?.HasChat ?? true);
                    }
                    <div class="chat-input-wrapper" id="chatInputWrapper" aria-hidden="false">
                        <div class="chat-input-inner" id="chatInputInner" role="region" aria-label="Chat input area">
                            @if (hasChat)
                            {
                                 <input type="file"
                                        id="chatFilesInput"
                                        class="native-file-input"
                                        hidden
                                        aria-hidden="true"
                                        tabindex="-1"
                                        style="display:none !important;"
                                        multiple
                                        accept=".pdf,.jpg,.jpeg,.png,.webp,.bmp,.tif,.tiff,.xml,.html,.htm,image/*,application/pdf,text/xml,application/xml,text/html" />
                                <button id="btnAttachTransient"
                                        type="button"
                                        class="chat-plus-btn"
                                        title="Adjuntar solo a este mensaje"
                                        aria-label="Adjuntar solo a este mensaje">
                                    <span aria-hidden="true">+</span>
                                </button>
                                <div id="chatAttachments" class="chat-attachments d-none"></div>
                                <textarea id="chatInput" class="chat-input form-control" rows="2"
                                      placeholder="Pregunta, comenta o adjunta archivos temporales..."></textarea>

                                <button id="sendChat" class="chat-send-btn" title="Enviar" aria-label="Enviar" type="button" aria-busy="false">
                                    <span class="send-icon" aria-hidden="true"><i class="fa-solid fa-paper-plane"></i></span>
                                    <span class="spinner-icon visually-hidden" aria-hidden="true"><i class="fa-solid fa-spinner fa-spin"></i></span>
                                </button>
                            }
                            else
                            {
                                <div class="chat-input-toolbar disabled">
                                    <span class="chat-tool-copy">Este caso no tiene chat habilitado.</span>
                                </div>
                                <textarea id="chatInput" class="chat-input form-control" rows="2"
                                      placeholder="Opción no disponible"
                                      disabled="disabled"
                                      readonly="readonly"
                                      aria-disabled="true"
                                      tabindex="-1"></textarea>

                                <button id="sendChat" class="chat-send-btn" title="Enviar" aria-label="Enviar" type="button"
                                        disabled="disabled" aria-disabled="true" style="pointer-events:none; opacity:.6;">
                                    <span class="send-icon" aria-hidden="true"><i class="fa-solid fa-paper-plane"></i></span>
                                    <span class="spinner-icon visually-hidden" aria-hidden="true"><i class="fa-solid fa-spinner fa-spin"></i></span>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <!-- RIGHT: Studio / Acciones -->
        <aside class="col-lg-1 right-col" id="colRight" aria-hidden="false">
            <div class="card card-panel-right rounded-3 h-100">
                <div class="card-header d-flex align-items-center justify-content-between small-header right-header">
                    <div><strong>Studio y notas</strong></div>
                    <small class="text-muted"></small>
                </div>
                <div class="card-body d-flex flex-column panel-body panel-height studio-panel-body">
                    @{
                        var showStudioTiles = (Model?.HasButton ?? false);
                    }
                    <!-- START: Studio tiles Botones dibujar y ocultar-->
                    @* <div class="studio-grid" aria-hidden="@(showStudioTiles ? "false" : "true")" data-studio-visible="@showStudioTiles.ToString().ToLower()" style="@(showStudioTiles ? "" : "display:none;")">
                            <button id="studioAudio" class="studio-tile tile-audio" title="Validación contractual" type="button" aria-label="Validación contractual">
                                <div class="tile-top">
                                    <div class="tile-icon"><i class="fa fa-wave-square"></i></div>
                                    <div class="tile-menu"><i class="fa fa-ellipsis-vertical"></i></div>
                                </div>
                                <div class="tile-body">
                                    <div class="tile-title">Contratos</div>
                                </div>
                            </button>

                            <button id="studioVideo" class="studio-tile tile-video" title="Alertas y Hallazgos" type="button" aria-label="Alertas y Hallazgos">
                                <div class="tile-top">
                                    <div class="tile-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
                                    <div class="tile-menu"><i class="fa fa-ellipsis-vertical"></i></div>
                                </div>
                                <div class="tile-body">
                                    <div class="tile-title">Alertas</div>
                                </div>
                            </button>

                            <button id="studioMind" class="studio-tile tile-mind" title="Facturas" type="button" aria-label="Facturas">
                                <div class="tile-top">
                                    <div class="tile-icon"><i class="fa fa-money-bill-wave"></i></div>
                                    <div class="tile-menu"><i class="fa fa-ellipsis-vertical"></i></div>
                                </div>
                                <div class="tile-body">
                                    <div class="tile-title">Facturas</div>
                                </div>
                            </button>
 
                        </div>*@
                    <!-- START: Studio tiles Botones dibujar y ocultar-->
                    @* Si showStudioTiles == false NO se genera ni HTML ni script *@
                    @if (showStudioTiles && Model?.AgentProccessButtons != null && Model.AgentProccessButtons.Any())
                    {
                        <div class="studio-grid" aria-hidden="false" data-studio-visible="true">
                            @foreach (var b in Model.AgentProccessButtons)
                            {
                                var btnId = !string.IsNullOrWhiteSpace(b.ButtonId) ? b.ButtonId : ("studioBtn_" + (b.AgentProcessId?.ToString() ?? Guid.NewGuid().ToString()));
                                var cssClass = !string.IsNullOrWhiteSpace(b.ClassName) ? b.ClassName : "studio-tile";
                                <button id="@btnId" class="@cssClass" title="@(b.Tittle ?? "")" type="button" aria-label="@(b.AriaLabel ?? b.Name ?? "")" data-agentprocessid="@(b.AgentProcessId)">
                                    <div class="tile-top">
                                        <div class="tile-icon"><i class="@(b.Icon ?? "")"></i></div>
                                        <div class="tile-menu"><i class="@(b.IconMenu ?? "fa fa-ellipsis-vertical")"></i></div>
                                    </div>
                                    <div class="tile-body">
                                        <div class="tile-title">@(b.Name ?? "")</div>
                                    </div>
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        // no se genera HTML
                    }
                    <hr class="my-2" />

                    <!-- START: Notes list (colocar entre .studio-grid y el <hr>) -->
                    @* Notes panel mejorado: coloca este bloque donde quieras en el panel derecho *@
                    <div class="notes-section shadow-sm rounded p-2 bg-white" aria-live="polite" style="border-left:4px solid #0d6efd;">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div class="fw-semibold">Notas del auditor</div>
                            <div class="d-flex gap-2 align-items-center">
                                <button id="btnAddNote" type="button" class="btn btn-sm btn-primary" title="Agregar nota">
                                    <i class="fa fa-plus me-1"></i>Agregar
                                </button>
                                <button id="btnRefreshNotes" type="button" class="btn btn-sm btn-outline-secondary" title="Refrescar">
                                    <i class="fa fa-sync"></i>
                                </button>
                            </div>
                        </div>

                        <div id="notesList" class="notes-list list-group mb-2" role="list" style="max-height:280px; overflow:auto;">
                            <!-- Items se insertan aquí por JS: cada item tendrá clase .list-group-item -->
                            <div class="text-muted small text-center py-3">Cargando notas...</div>
                        </div>

                        <!-- Editor (inicialmente oculto) -->
                        <div id="notesEditor" class="notes-editor card p-2" aria-hidden="true" style="display:none;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="fw-semibold" id="notesEditorTitle">Nueva nota</div>
                                <div>
                                    <button id="notesCancel" type="button" class="btn btn-sm btn-light">Cancelar</button>
                                    <button id="notesSave" type="button" class="btn btn-sm btn-primary ms-2">Guardar</button>
                                </div>
                            </div>

                            <div class="mb-2">
                                <input id="noteTitle" class="form-control form-control-sm" placeholder="Título (opcional)" />
                            </div>

                            <div class="mb-2">
                                <textarea id="noteDetail" rows="5" class="form-control form-control-sm" placeholder="Escribe la nota..."></textarea>
                            </div>

                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted">Notas guardadas en el caso</small>
                                <div id="notesStatus" class="small text-muted"></div>
                            </div>
                        </div>
                    </div>
                    <!-- END: Notes list -->

                    <div class="mt-auto">
                        <div id="cfTopPanel" class="cf-top-panel mt-2" data-case="@Model.ProcessCase.CaseCode">
                            <div class="cf-question fw-semibold mb-2">¿Nexus facilitó tu auditoría de este caso?</div>
                            <div class="cf-toggle d-flex gap-2 mb-3" role="radiogroup" aria-label="¿Nexus facilitó tu auditoría de este caso?">
                                <br />
                                <button type="button" class="cf-toggle-btn" data-value="true" aria-pressed="false" title="Sí — Nexus facilitó">
                                    <div class="tile-top">
                                        <div class="tile-icon"><i class="fa fa-thumbs-up"></i></div>
                                    </div>
                                    <div class="tile-body">
                                        <div class="tile-title">Sí</div>
                                    </div>
                                </button>
                                <button type="button" class="cf-toggle-btn" data-value="false" aria-pressed="false" title="No — No facilitó">
                                    <div class="tile-top">
                                        <div class="tile-icon"><i class="fa fa-thumbs-down"></i></div>
                                    </div>
                                    <div class="tile-body">
                                        <div class="tile-title">No</div>
                                    </div>
                                </button>
                            </div>

                            <div class="cf-comment mb-2">
                                <label class="form-label small mb-1">¿Quieres dejar algún comentario? (opcional)</label>
                                <textarea id="cfComment" class="form-control form-control-sm" rows="3" placeholder="Ej. Lo que más ayudó fue..., o mejorar..."></textarea>
                            </div>

                            <div class="d-flex justify-content-between align-items-center">
                                <div id="cfStatus" class="small text-muted"></div>
                                <div>
                                    <button id="cfSend" type="button" class="btn btn-sm btn-primary">Enviar reseña</button>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </aside>
    </div>
</div>
<footer id="nexusFooter" class="nexus-notice site-footer" role="contentinfo" aria-hidden="false">
    <div class="nexus-inner">
        <strong>Nexus puede cometer errores.</strong> Comprueba la información importante antes de tomar decisiones.
    </div>
</footer>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.3/html2pdf.bundle.min.js"></script>
    <script>
        // Reemplaza sólo el listener / lógica de export por este bloque
        document.addEventListener('DOMContentLoaded', () => {
          const exportBtn = document.getElementById('btnExportPdf');
          if (!exportBtn) return;

          const caseCode = '@Model.ProcessCase.CaseCode';
          const caseDateStr = '@((Model.ProcessCase.FinalResponseResults != null && Model.ProcessCase.FinalResponseResults.Any()) ? Model.ProcessCase.FinalResponseResults.OrderByDescending(r => r.CreatedDate).FirstOrDefault()?.CreatedDate.ToLocalTime().ToString("dd/MM/yyyy, HH:mm") : "")';
          const filesCount = @(Model.ProcessCase.DataFile?.Count() ?? 0);

          function pad(n){ return String(n).padStart(2,'0'); }
          function formatDate(d){ try { return `${pad(d.getDate())}/${pad(d.getMonth()+1)}/${d.getFullYear()} ${pad(d.getHours())}:${pad(d.getMinutes())}`; } catch(e){ return d.toString(); } }
          function escapeHtml(s){ if(!s) return ''; return String(s).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[m]); }

          exportBtn.addEventListener('click', async (ev) => {
            ev.preventDefault();
            exportBtn.disabled = true;
            const orig = exportBtn.innerHTML;
            exportBtn.innerHTML = '<i class="fa fa-spinner fa-spin me-1"></i> Generando...';

            try {
              // esperar fuentes para que iconos se rendericen
              if (document.fonts && document.fonts.ready) {
                try { await document.fonts.ready; } catch(_) {}
              }

              const chatOut = document.getElementById('chatOutput');
              if (!chatOut) throw new Error('No se encontró #chatOutput');

              // Contenedor a rasterizar: NO incluimos cabecera ni "Resumen"
              const docWrap = document.createElement('div');
              docWrap.style.boxSizing = 'border-box';
              docWrap.style.padding = '8px 12px';
              docWrap.style.fontFamily = getComputedStyle(document.body).fontFamily || 'Arial, sans-serif';
              docWrap.style.color = getComputedStyle(document.body).color || '#222';
              docWrap.style.background = '#fff';
              docWrap.style.width = '100%';

              // CSS para evitar cortes internos
              const avoidBreakCss = `
                .chat-turn, .chat-turn-request, .chat-turn-response, .chat-response, .chat-response-final, .chat-divider, .note-detail, .pdf-page-box {
                  page-break-inside: avoid;
                  break-inside: avoid;
                  -webkit-column-break-inside: avoid;
                  -ms-break-inside: avoid;
                }
                img { page-break-inside: avoid; break-inside: avoid; max-width:100%; }
                p, div, li, pre { widows: 3; orphans: 3; }
                * { -webkit-hyphens: none; -ms-hyphens: none; hyphens: none; }
              `;
              const styleEl = document.createElement('style');
              styleEl.innerHTML = avoidBreakCss;
              docWrap.appendChild(styleEl);

              // Clonar sólo el contenido del chat (sin encabezado ni resumen)
              const contentClone = chatOut.cloneNode(true);
              contentClone.querySelectorAll('textarea, input, button, .chat-input, .chat-send-btn').forEach(n => n.remove());
              contentClone.style.marginTop = '0';
              contentClone.style.width = '100%';
              docWrap.appendChild(contentClone);

              // Opciones: reservamos espacio superior (margin top) para la cabecera
              // Ajusta top (en mm) según el tamaño de la cabecera. Aquí uso 26 mm.
              const now = new Date();
              const filename = `NE-${caseCode || 'case'}_report_${now.getFullYear()}${pad(now.getMonth()+1)}${pad(now.getDate())}.pdf`;
              const opt = {
                margin: [26, 10, 14, 10], // top, left, bottom, right (mm) -> top aumentado para espacio cabecera
                filename: filename,
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: {
                  scale: 2,
                  useCORS: true,
                  allowTaint: false,
                  logging: false,
                  windowWidth: docWrap.scrollWidth || document.documentElement.clientWidth
                },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
                pagebreak: { mode: ['css', 'legacy'] }
              };

              // Generar PDF y luego dibujar la cabecera en cada página
              const worker = html2pdf().set(opt).from(docWrap).toPdf();
              worker.get('pdf').then(function(pdf) {
                try {
                  const total = pdf.internal.getNumberOfPages();
                  const pageW = pdf.internal.pageSize.getWidth();
                  const marginLeft = 10;
                  const marginRight = 10;
                  const genDateStr = formatDate(now);

                  for (let i = 1; i <= total; i++) {
                    pdf.setPage(i);

                    // Dibujar cabecera (texto a ~12-16 mm desde el borde superior)
                    pdf.setFontSize(10);
                    pdf.setTextColor(34,34,34);
                    pdf.text(`Caso: ${String(caseCode)}`, marginLeft, 12);

                    pdf.setFontSize(8);
                    pdf.setTextColor(100,100,100);
                    pdf.text(`Fecha del caso: ${String(caseDateStr)}`, marginLeft, 16);

                    // Derechos (alineado a la derecha)
                    pdf.setFontSize(8);
                    pdf.text(`Generado: ${genDateStr}`, pageW - marginRight, 12, { align: 'right' });
                    pdf.text(`Ficheros: ${filesCount}`, pageW - marginRight, 16, { align: 'right' });

                    // Línea separadora bajo cabecera
                    pdf.setDrawColor(220);
                    pdf.setLineWidth(0.4);
                    pdf.line(marginLeft, 19, pageW - marginRight, 19);
                  }
                } catch (errHead) {
                  console.warn('No se pudo añadir cabecera por página:', errHead);
                }
                pdf.save(filename);
              }).catch(err => {
                console.error('html2pdf get(pdf) error:', err);
                // fallback sin await
                html2pdf().set(opt).from(docWrap).save().catch(e => {
                  console.error('Fallback html2pdf.save error:', e);
                  Swal.fire({
                        icon: 'warning',
                        title: 'Advertencia',
                        text: 'No se pudo generar el PDF automáticamente. Revisa la consola. ',
                    });
                });
              });

            } catch (err) {
              console.error('Export error:', err);
              Swal.fire({
                        icon: 'warning',
                        title: 'Advertencia',
                        text: 'No se pudo generar el PDF: ' + (err && err.message ? err.message : err),
                    });
            } finally {
              exportBtn.disabled = false;
              exportBtn.innerHTML = orig;
            }
          });
        });
    </script>

    <script>


        (function () {
            let __pdfRenderToken = 0;
            let __typeToken = 0;
            let __thinkingToken = 0;
            let __currentThinking = null;
            let __lastManualScrollAt = 0;
            document.addEventListener('scroll', (ev) => {
                try {
                    const target = ev.target;
                    // si el scroll ocurrió dentro de un contenedor .result-area (o un hijo), lo consideramos manual
                    if (target && target.closest && (target.classList && target.classList.contains('result-area') || target.closest('.result-area'))) {
                        __lastManualScrollAt = Date.now();
                    }
                } catch (e) { /* ignore */ }
            }, true);

            function q(sel) { return document.querySelector(sel); }
            function qa(sel) { return Array.from(document.querySelectorAll(sel)); }

            function escapeHtml(value) {
                return (value ?? '').toString().replace(/[&<>"']/g, ch => ({
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#39;'
                })[ch]);
            }

            function decodeHtmlEntities(value) {
                const textarea = document.createElement('textarea');
                textarea.innerHTML = (value ?? '').toString();
                return textarea.value;
            }

            function tryFormatJsonBlock(value) {
                const trimmed = (value ?? '').toString().trim();
                if (!trimmed || trimmed.includes('```')) return null;
                if (!(trimmed.startsWith('{') || trimmed.startsWith('['))) return null;

                try {
                    return JSON.stringify(JSON.parse(trimmed), null, 2);
                } catch (e) {
                    return null;
                }
            }

            function sanitizeRichHtml(root) {
                if (!root) return;

                root.querySelectorAll('script,style,iframe,object,embed').forEach(node => node.remove());

                root.querySelectorAll('*').forEach(node => {
                    Array.from(node.attributes).forEach(attr => {
                        const attrName = attr.name.toLowerCase();
                        const attrValue = (attr.value || '').trim();

                        if (attrName.startsWith('on')) {
                            node.removeAttribute(attr.name);
                            return;
                        }

                        if ((attrName === 'href' || attrName === 'src') && /^javascript:/i.test(attrValue)) {
                            node.setAttribute(attr.name, '#');
                        }
                    });
                });
            }

            function normalizeCodeLanguage(lang) {
                const raw = (lang || '').toString().trim().toLowerCase();
                if (!raw) return '';

                const aliases = {
                    cs: 'csharp',
                    'c#': 'csharp',
                    csharp: 'csharp',
                    js: 'javascript',
                    ts: 'typescript',
                    yml: 'yaml',
                    ps1: 'powershell',
                    shell: 'bash',
                    sh: 'bash',
                    text: 'plaintext',
                    txt: 'plaintext'
                };

                return aliases[raw] || raw;
            }

            function codeLanguageLabel(lang) {
                const normalized = normalizeCodeLanguage(lang);
                if (!normalized) return 'CODE';

                const labels = {
                    csharp: 'C#',
                    javascript: 'JavaScript',
                    typescript: 'TypeScript',
                    json: 'JSON',
                    sql: 'SQL',
                    html: 'HTML',
                    xml: 'XML',
                    css: 'CSS',
                    bash: 'Bash',
                    powershell: 'PowerShell',
                    yaml: 'YAML',
                    plaintext: 'Texto'
                };

                return labels[normalized] || normalized.toUpperCase();
            }

            function enhanceMarkdownContent(root) {
                if (!root) return;

                root.querySelectorAll('pre > code').forEach(code => {
                    const pre = code.parentElement;
                    if (!pre) return;

                    const languageClass = (code.className || '')
                        .split(/\s+/)
                        .find(cls => cls.startsWith('language-') || cls.startsWith('lang-'));

                    const lang = normalizeCodeLanguage(
                        languageClass
                            ? languageClass.replace(/^language-/, '').replace(/^lang-/, '')
                            : code.dataset.lang || pre.dataset.codeLanguage || ''
                    );

                    pre.dataset.codeLanguage = codeLanguageLabel(lang);
                    pre.classList.add('chat-code-block');
                    code.classList.add('chat-code');
                });

                root.querySelectorAll('table').forEach(table => {
                    table.classList.add('table', 'table-sm', 'table-striped', 'markdown-table');
                });

                root.querySelectorAll('a[href]').forEach(link => {
                    link.setAttribute('target', '_blank');
                    link.setAttribute('rel', 'noopener noreferrer');
                });
            }

            function renderMarkdownHtml(source) {
                let raw = decodeHtmlEntities(source);
                if (!raw) return '';

                const formattedJson = tryFormatJsonBlock(raw);
                if (formattedJson) {
                    raw = `\`\`\`json\n${formattedJson}\n\`\`\``;
                }

                const parsed = (typeof marked !== 'undefined')
                    ? marked.parse(raw, {
                        gfm: true,
                        breaks: true,
                        mangle: false,
                        headerIds: false
                    })
                    : raw;

                const temp = document.createElement('div');
                temp.innerHTML = parsed;
                sanitizeRichHtml(temp);
                enhanceMarkdownContent(temp);
                return temp.innerHTML;
            }

            function normalizeRequestPayload(source) {
                const raw = decodeHtmlEntities(source || '').trim();
                if (!raw) {
                    return { message: '', attachments: '' };
                }

                const temp = document.createElement('div');
                temp.innerHTML = raw;
                sanitizeRichHtml(temp);

                const attachmentParts = [];
                temp.querySelectorAll('.chat-request-attachments').forEach(node => {
                    const value = (node.textContent || '').trim();
                    if (value) attachmentParts.push(value);
                    node.remove();
                });

                temp.querySelectorAll('br').forEach(node => node.replaceWith('\n'));
                temp.querySelectorAll('div, p, li').forEach(node => {
                    if (node.nextSibling) {
                        node.after(document.createTextNode('\n'));
                    }
                });

                let message = (temp.textContent || '')
                    .replace(/\r/g, '')
                    .replace(/\n{3,}/g, '\n\n')
                    .trim();

                const lines = message
                    .split('\n')
                    .map(line => line.trim())
                    .filter(Boolean);

                const inlineAttachments = lines.filter(line => /^adjuntos?\s+temporales?:/i.test(line));
                if (inlineAttachments.length) {
                    attachmentParts.push(...inlineAttachments);
                    message = lines.filter(line => !/^adjuntos?\s+temporales?:/i.test(line)).join('\n');
                }

                return {
                    message: message.trim(),
                    attachments: attachmentParts.join(' • ').trim()
                };
            }

            function renderRequestHtml(source) {
                const normalized = normalizeRequestPayload(source);
                if (!normalized.message && !normalized.attachments) return '';

                const parts = [];
                if (normalized.message) {
                    parts.push(`<div>${escapeHtml(normalized.message).replace(/\n/g, '<br>')}</div>`);
                }

                if (normalized.attachments) {
                    parts.push(`<div class="chat-request-attachments">${escapeHtml(normalized.attachments)}</div>`);
                }

                return parts.join('');
            }

            function getDocumentType(extension) {
                const ext = (extension || '').toLowerCase().replace(/^\./, '');
                if (ext === 'pdf') return 'pdf';
                if (['jpg', 'jpeg', 'png', 'webp', 'bmp', 'tif', 'tiff'].includes(ext)) return 'img';
                if (['xml', 'html', 'htm'].includes(ext)) return 'markup';
                return 'other';
            }

            function getDocumentIcon(type, extension) {
                const ext = (extension || '').toLowerCase().replace(/^\./, '');
                if (type === 'pdf') return 'fa-file-pdf text-danger';
                if (type === 'markup') return ext === 'xml' ? 'fa-file-code text-primary' : 'fa-file-lines text-primary';
                return 'fa-file-lines text-muted';
            }

            function formatXmlForPreview(xmlText) {
                const normalized = (xmlText || '').replace(/>\s*</g, '><').trim();
                if (!normalized) return '';

                const tokens = normalized.replace(/(>)(<)(\/*)/g, '$1\r\n$2$3').split('\r\n');
                let indent = 0;
                const formatted = [];

                tokens.forEach(token => {
                    if (!token) return;

                    if (/^<\//.test(token)) {
                        indent = Math.max(indent - 1, 0);
                    }

                    formatted.push(`${'  '.repeat(indent)}${token}`);

                    if (/^<[^!?/][^>]*[^/]?>$/.test(token) && !/<\/[^>]+>$/.test(token)) {
                        indent += 1;
                    }
                });

                return formatted.join('\n').trim();
            }

            function formatHtmlForPreview(htmlText) {
                const normalized = decodeHtmlEntities(htmlText || '').replace(/>\s+</g, '><').trim();
                if (!normalized) return '';

                const tokens = normalized.replace(/(>)(<)(\/*)/g, '$1\r\n$2$3').split('\r\n');
                const voidTags = new Set(['area', 'base', 'br', 'col', 'embed', 'hr', 'img', 'input', 'link', 'meta', 'param', 'source', 'track', 'wbr']);
                let indent = 0;
                const formatted = [];

                tokens.forEach(token => {
                    if (!token) return;

                    const trimmed = token.trim();
                    if (!trimmed) return;

                    const tagMatch = trimmed.match(/^<\s*([^\s/>]+)/);
                    const tagName = tagMatch ? tagMatch[1].toLowerCase() : '';
                    const isClosing = /^<\//.test(trimmed);
                    const isSelfClosing = /\/>$/.test(trimmed) || voidTags.has(tagName);
                    const isInlinePair = /^<[^!?/][^>]*>.*<\/[^>]+>$/.test(trimmed);
                    const isDeclaration = /^<!/.test(trimmed) || /^<\?/.test(trimmed);

                    if (isClosing) {
                        indent = Math.max(indent - 1, 0);
                    }

                    formatted.push(`${'  '.repeat(indent)}${trimmed}`);

                    if (!isClosing && !isSelfClosing && !isInlinePair && !isDeclaration && /^<[^!?/]/.test(trimmed)) {
                        indent += 1;
                    }
                });

                return formatted.join('\n').trim();
            }

            function combineRequestResponseMd(data) {
                if (!data) return '';
                const req = (data.request ?? data.requestText ?? data.RequestText ?? '').toString().trim();
                const resp = (data.response ?? data.responseText ?? data.ResponseText ?? '').toString().trim();
                // mantener orden: primero request (si existe), luego response en nueva línea
                return [req, resp].filter(Boolean).join('\n\n');
            }


            function setBtnLoading(on) {
                const btn = q('#sendChat'); if (!btn) return;
                const sendIcon = btn.querySelector('.send-icon');
                const spinner = btn.querySelector('.spinner-icon');
                if (on) {
                    btn.classList.add('loading');
                    btn.setAttribute('aria-busy', 'true');
                    if (sendIcon) sendIcon.classList.add('visually-hidden');
                    if (spinner) spinner.classList.remove('visually-hidden');
                } else {
                    btn.classList.remove('loading');
                    btn.setAttribute('aria-busy', 'false');
                    if (sendIcon) sendIcon.classList.remove('visually-hidden');
                    if (spinner) spinner.classList.add('visually-hidden');
                }
            }

            function ensureThinkingOverlay() {
                let overlay = document.getElementById('thinkingOverlay');
                if (!overlay) {
                    overlay = document.createElement('div');
                    overlay.id = 'thinkingOverlay';
                    overlay.className = 'thinking-overlay';
                    overlay.setAttribute('aria-hidden', 'true');
                    overlay.innerHTML = '<div class="thinking-icon"><i class="fa-solid fa-brain" aria-hidden="true"></i></div><div class="thinking-text" id="thinkingText">Pensando...</div>';
                    document.body.appendChild(overlay);
                }
                return overlay;
            }

            function startThinking() {
                if (__currentThinking && typeof __currentThinking.cleanup === 'function') {
                    try { __currentThinking.cleanup(); } catch (e) {}
                    __currentThinking = null;
                }

                __thinkingToken++;
                const myToken = __thinkingToken;

                const phrases = [
                    'Pensando',
                    'Analizando',
                    'Revisando fuentes',
                    'Formulando respuesta',
                    'Preparando',
                    'Comprobando',
                    'Sintetizando'
                ];

                const overlay = ensureThinkingOverlay();
                const textEl = overlay.querySelector('#thinkingText');

                overlay.classList.add('visible');
                overlay.setAttribute('aria-hidden', 'false');

                const dotIntervalMs = 420;
                const changePhraseMs = 2200;
                const changeEveryTicks = Math.max(1, Math.round(changePhraseMs / dotIntervalMs));

                let currentPhrase = phrases[Math.floor(Math.random() * phrases.length)];
                let dots = 0;
                let tick = 0;
                if (textEl) textEl.textContent = currentPhrase + '...';

                const interval = setInterval(() => {
                    if (myToken !== __thinkingToken) return;
                    tick++;
                    dots = (dots + 1) % 4;
                    if (tick % changeEveryTicks === 0) {
                        let next = currentPhrase;
                        if (phrases.length > 1) {
                            while (next === currentPhrase) {
                                next = phrases[Math.floor(Math.random() * phrases.length)];
                            }
                        } else {
                            next = phrases[0];
                        }
                        currentPhrase = next;
                    }
                    if (textEl) textEl.textContent = currentPhrase + (dots ? '.'.repeat(dots) : '');
                }, dotIntervalMs);

                const fallbackTimeout = setTimeout(() => {
                    try { cleanup(); } catch (e) {}
                }, 900000);

                function cleanup() {
                    try { clearInterval(interval); } catch (e) {}
                    try { clearTimeout(fallbackTimeout); } catch (e) {}
                    try { overlay.classList.remove('visible'); overlay.setAttribute('aria-hidden', 'true'); } catch (e) {}
                    if (__currentThinking && __currentThinking.token === myToken) __currentThinking = null;
                }

                __currentThinking = {
                    token: myToken,
                    cleanup,
                    interval,
                    fallbackTimeout
                };

                return __currentThinking;
            }

            function stopThinking(tokenObj) {
                if (tokenObj && typeof tokenObj.cleanup === 'function') {
                    try { tokenObj.cleanup(); } catch (e) {}
                    if (__currentThinking && __currentThinking.token === tokenObj.token) __currentThinking = null;
                    return;
                }
                if (__currentThinking && typeof __currentThinking.cleanup === 'function') {
                    try { __currentThinking.cleanup(); } catch (e) {}
                    __currentThinking = null;
                    return;
                }
                const overlay = document.getElementById('thinkingOverlay');
                if (overlay) {
                    try { overlay.classList.remove('visible'); overlay.setAttribute('aria-hidden', 'true'); } catch (e) {}
                }
                __currentThinking = null;
            }

            function positionChatInput() {
                const chatInner = q('#chatInputInner');
                if (!chatInner) return;

                chatInner.style.position = 'sticky';
                chatInner.style.left = '0';
                chatInner.style.bottom = '0';
                chatInner.style.width = '100%';
                chatInner.style.maxWidth = '100%';
                chatInner.style.zIndex = '5';

                const computedH = chatInner.getBoundingClientRect().height || 72;
                document.documentElement.style.setProperty('--chat-input-height', computedH + 'px');
                qa('.result-area').forEach(el => el.style.paddingBottom = '18px');
            }

            function stabilizePositionDuringTransition() {
                positionChatInput();
                return Promise.resolve(true);
            }

            document.addEventListener('DOMContentLoaded', () => {
                const textarea = q('#chatInput');
                const chatInner = q('#chatInputInner');
                const sendBtn = q('#sendChat');
                let chatOutputEl = q('#chatOutput');
                const caseCode = '@Model.ProcessCase.CaseCode';
                const chatFilesInput = q('#chatFilesInput');
                const caseFilesInput = q('#caseFilesInput');
                const attachTransientBtn = q('#btnAttachTransient');
                const attachPermanentBtn = q('#btnAttachPermanent');
                const chatAttachmentsEl = q('#chatAttachments');
                const sourcesStatusEl = q('#sourcesStatus');
                const previewEmptyState = q('#previewEmptyState');
                const colRight = q('#colRight');
                let transientAttachments = [];

                sanitizeRichHtml(chatOutputEl);
                enhanceMarkdownContent(chatOutputEl);

                function ensureChatOutput() {
                    if (chatOutputEl) return chatOutputEl;

                    const resultPanel = q('.result-panel');
                    if (!resultPanel) return null;

                    resultPanel.innerHTML = '<div id="chatOutput" class="chat-thread"></div>';
                    chatOutputEl = q('#chatOutput');
                    enhanceMarkdownContent(chatOutputEl);
                    return chatOutputEl;
                }

                function setDocumentFocus(enabled) {
                    document.documentElement.classList.toggle('document-focus', !!enabled);
                    document.documentElement.classList.toggle('right-hidden', !!enabled);
                    if (colRight) {
                        colRight.setAttribute('aria-hidden', enabled ? 'true' : 'false');
                    }
                    positionChatInput();
                }

                function setSourcesStatus(text, tone = 'muted') {
                    if (!sourcesStatusEl) return;
                    sourcesStatusEl.textContent = text || '';
                    sourcesStatusEl.className = tone === 'error' ? 'text-danger' : tone === 'success' ? 'text-success' : 'text-muted';
                }

                function makeCaseFilePayload(file) {
                    return new Promise((resolve, reject) => {
                        const reader = new FileReader();
                        reader.onload = () => resolve({
                            FileName: file.name,
                            Content: (reader.result || '').toString().split(',')[1] || '',
                            Extension: '.' + (file.name.split('.').pop() || '').toLowerCase()
                        });
                        reader.onerror = () => reject(new Error(`No se pudo leer ${file.name}.`));
                        reader.readAsDataURL(file);
                    });
                }

                async function filesToPayload(fileList) {
                    return Promise.all(Array.from(fileList || []).map(makeCaseFilePayload));
                }

                function renderTransientAttachments() {
                    if (!chatAttachmentsEl) return;

                    chatAttachmentsEl.innerHTML = '';
                    if (!transientAttachments.length) {
                        chatAttachmentsEl.classList.add('d-none');
                        return;
                    }

                    transientAttachments.forEach((file, index) => {
                        const attachmentType = getDocumentType(file.extension);
                        const chip = document.createElement('button');
                        chip.type = 'button';
                        chip.className = 'attachment-chip';
                        chip.innerHTML = `
                            <span class="attachment-chip-name">
                                <i class="fa ${getDocumentIcon(attachmentType, file.extension)}"></i>
                                ${file.fileName}
                            </span>
                            <span class="attachment-chip-remove" aria-hidden="true"><i class="fa fa-times"></i></span>`;
                        chip.addEventListener('click', () => {
                            transientAttachments = transientAttachments.filter((_, currentIndex) => currentIndex !== index);
                            renderTransientAttachments();
                            positionChatInput();
                        });
                        chatAttachmentsEl.appendChild(chip);
                    });

                    chatAttachmentsEl.classList.remove('d-none');
                }

                function clearTransientAttachments() {
                    transientAttachments = [];
                    if (chatFilesInput) chatFilesInput.value = '';
                    renderTransientAttachments();
                }

                function createSourceRow(file) {
                    const tr = document.createElement('tr');
                    const type = (file.type || getDocumentType(file.extension)).toLowerCase();
                    const ext = ((file.extension || '').replace('.', '') || 'DOC').toUpperCase();
                    const iconClass = getDocumentIcon(type, file.extension);

                    tr.className = 'source-row';
                    tr.dataset.id = file.id ?? '';
                    tr.dataset.url = file.url ?? '';
                    tr.dataset.type = type;
                    tr.dataset.ext = (file.extension ?? '').replace('.', '');
                    tr.title = file.originalName || file.url || 'Documento';
                    tr.style.cursor = 'pointer';
                    tr.innerHTML = `
                        <td style="width:56px; padding:.5rem;">
                            <div class="thumb-wrap">
                                ${type === 'img'
                                    ? `<img src="${file.url || ''}" class="thumb-img" onerror="this.style.display='none'; this.parentElement.innerHTML='<i class=&quot;fa ${iconClass}&quot;></i>';" />`
                                    : `<i class="fa ${iconClass} fa-lg"></i>`}
                            </div>
                        </td>
                        <td class="align-middle">
                            <div class="fw-semibold text-truncate">${file.originalName || file.url || 'Documento'}</div>
                            <small class="text-muted">${ext}</small>
                        </td>
                        <td class="text-end align-middle" style="width:36px;">
                            <i class="fa fa-chevron-right text-muted"></i>
                        </td>`;

                    return tr;
                }

                async function loadCaseDocuments(preferredId = null) {
                    const tbody = document.querySelector('#sourcesTable tbody');
                    if (!tbody) return;

                    const activeRow = q('.source-row.selected');
                    const preserveId = preferredId ?? activeRow?.dataset.id ?? null;

                    try {
                        setSourcesStatus('Actualizando documentos...');
                        const resp = await fetch(`@Url.Action("GetCaseDocuments", "Nexus")?caseCode=${caseCode}`);
                        if (!resp.ok) throw new Error(resp.statusText || 'No se pudo obtener el expediente.');

                        const items = await resp.json();
                        tbody.innerHTML = '';

                        if (!Array.isArray(items) || items.length === 0) {
                            tbody.innerHTML = `<tr><td colspan="3" class="text-muted text-center py-4">No hay documentos en este caso.</td></tr>`;
                            updateShownCount();
                            backToList();
                            setSourcesStatus('Sin documentos disponibles.');
                            return;
                        }

                        items.forEach(item => tbody.appendChild(createSourceRow(item)));
                        bindTableRows();
                        setSourcesStatus('Expediente actualizado.', 'success');

                        if (preserveId) {
                            const rowToSelect = q(`.source-row[data-id="${preserveId}"]`);
                            if (rowToSelect) {
                                await onSelectRow(rowToSelect);
                                return;
                            }
                        }

                    } catch (err) {
                        console.error('documents load error', err);
                        setSourcesStatus('No se pudo actualizar la lista de documentos.', 'error');
                    }
                }
                // Seleccionamos todas las tiles dinámicas (si no hay, no rompemos)
                const studioTiles = qa('.studio-tile');
                // Bind genérico para tiles (si existen)
                if (studioTiles && studioTiles.length > 0) {
                    studioTiles.forEach(tile => {
                        tile.addEventListener('click', async (ev) => {
                            ev.preventDefault();
                            const btn = tile;
                            btn.disabled = true;
                            btn.classList.add('loading');
                            const message  = textarea?.value?.trim();
                            const thinking = startThinking();
                            setBtnLoading(true);
                            try {
                                await stabilizePositionDuringTransition(900);
                                const resp = await fetch('@Url.Action("EjecutarPrompt", "Nexus")', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify(buildPromptPayload('BUTTON', message, { id: btn.dataset.agentprocessid }))
                                });
                                setBtnLoading(false);
                                stopThinking(thinking);
                                if (!resp.ok) throw new Error(resp.statusText || 'Error en la petición');
                                const data = await resp.json();
                                await appendConversationTurn(data, 4);

                                const ta = q('#chatInput');
                                if (ta) {
                                    ta.value = '';
                                    clearTransientAttachments();
                                    try { autoResize(ta); } catch (e) {}
                                    try { ta.focus({ preventScroll: true }); } catch (e) { ta.focus(); }
                                }
                            } catch (err) {
                                console.error('studio tile error', err);
                                stopThinking();
                                setBtnLoading(false);
                                Swal.fire({
                                    icon: 'warning',
                                    title: 'Advertencia',
                                    text: 'Error al generar la respuesta: ' + (err && err.message ? err.message : 'Error en la petición'),
                                });
                            } finally {
                                btn.disabled = false;
                                btn.classList.remove('loading');
                                stopThinking();
                                positionChatInput();
                            }
                        });
                    });
                }
