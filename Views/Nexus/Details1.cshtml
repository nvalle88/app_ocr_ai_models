                    attachPermanentBtn.addEventListener('click', () => caseFilesInput.click());
                    caseFilesInput.addEventListener('change', async () => {
                        if (!caseFilesInput.files?.length) return;

                        const selectedFiles = Array.from(caseFilesInput.files);
                        try {
                            setSourcesStatus('Adjuntando documentos al caso...');
                            attachPermanentBtn.disabled = true;
                            beginPersistentUploadPreview(selectedFiles);
                            const payloads = await filesToPayload(selectedFiles);
                            const resp = await fetch('@Url.Action("AddCaseDocuments", "Nexus")', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ caseCode, files: payloads })
                            });

                            if (!resp.ok) throw new Error(resp.statusText || 'No se pudieron adjuntar los documentos.');
                            const data = await resp.json();
                            const latestId = Array.isArray(data.items) && data.items.length ? data.items[0].id : null;
                            await loadCaseDocuments(latestId);
                            finishPersistentUploadPreview(true);
                            setSourcesStatus('Documentos agregados al expediente.', 'success');
                        } catch (err) {
                            console.error('permanent attachments error', err);
                            finishPersistentUploadPreview(false);
                            setSourcesStatus('No se pudieron adjuntar los documentos.', 'error');
                            Swal.fire({
                                icon: 'warning',
                                title: 'Advertencia',
                                text: err.message || 'No se pudieron adjuntar los documentos al caso.'
                            });
                        } finally {
                            attachPermanentBtn.disabled = false;
                            caseFilesInput.value = '';
                        }
                    });
                }

                async function typeWriteInto(el, html, speed = 3) {
                    if (!el) return;
                    __typeToken++;
                    const myToken = __typeToken;
                    const parentScroll = el.closest('.result-area') || el.parentElement;
                    const temp = document.createElement('div');
                    temp.innerHTML = html || '';

                    el.innerHTML = '';
                    el.classList.add('is-streaming');
                    el.setAttribute('aria-busy', 'true');

                    try {
                        for (const node of Array.from(temp.childNodes)) {
                            if (myToken !== __typeToken) return;
                            await revealNodeInto(el, node, myToken, speed, parentScroll);
                        }

                        enhanceMarkdownContent(el);
                        el.classList.remove('chat-response-enter');
                        void el.offsetWidth;
                        el.classList.add('chat-response-enter');
                        scrollResultAreaToBottom(parentScroll);
                    } finally {
                        el.classList.remove('is-streaming');
                        el.setAttribute('aria-busy', 'false');
                    }
                }

                function sleep(ms) { return new Promise(res => setTimeout(res, ms)); }

                function buildPromptPayload(origin, message, extra = {}) {
                    return {
                        caseCode,
                        message,
                        origin,
                        files: transientAttachments.map(item => item.payload),
                        ...extra
                    };
                }

                async function appendConversationTurn(data, speed = 4, existingTurn = null) {
                    const thread = ensureChatOutput();
                    if (!thread) return;

                    thread.closest('.result-panel')?.querySelector('.alert')?.remove();

                    const turn = existingTurn || createPendingConversationTurn((data.request ?? data.requestText ?? data.RequestText ?? '').toString().trim());
                    if (!turn) return;

                    const responseText = (data.response ?? data.responseText ?? data.ResponseText ?? '').toString();
                    turn.liveState?.stop?.();
                    turn.article?.classList.remove('chat-turn-pending');
                    turn.responseEl.classList.remove('is-pending');
                    turn.actionsEl.hidden = false;

                    const copyButton = turn.actionsEl.querySelector('.chat-copy-btn');
                    if (copyButton) {
                        copyButton.dataset.copySource = encodeBase64Utf8(responseText);
                    }
                    const renderButton = turn.actionsEl.querySelector('.chat-render-btn');
                    if (renderButton) {
                        renderButton.dataset.renderSource = encodeBase64Utf8(responseText);
                    }

                    turn.metaEl.textContent = new Date().toLocaleString('es-EC', {
                        day: '2-digit',
                        month: '2-digit',
                        year: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                    });

                    const html = renderMarkdownHtml(responseText);
                    await typeWriteInto(turn.responseBodyEl, html, speed);
                }

                async function sendMessage() {
                    await dispatchComposerRequest();
                }
                if (sendBtn) sendBtn.addEventListener('click', sendMessage);

                function bindTableRows() {
                    qa('.source-row').forEach(row => {
                        const clone = row.cloneNode(true);
                        row.parentNode.replaceChild(clone, row);
                    });
                    qa('.source-row').forEach(row => {
                        row.addEventListener('click', (ev) => { ev.stopPropagation(); onSelectRow(row); });
                        row.addEventListener('dblclick', (ev) => { ev.stopPropagation(); onSelectRow(row); const url = row.dataset.url; if (url) window.open(url, '_blank'); });
                    });
                    updateShownCount();
                }

                function updateShownCount() {
                    const visible = qa('#sourcesTable .source-row').length;
                    const shownEl = q('#shownCount');
                    const leftCountEl = q('#leftCount');
                    if (shownEl) shownEl.textContent = visible;
                    if (leftCountEl) leftCountEl.textContent = visible;
                }

                const sourcesWrapper = q('#sourcesWrapper');
                const previewWrapper = q('#previewWrapper');
                const previewContent = q('#previewContent');
                const previewTitle = q('#previewTitle');
                const btnBackToList = q('#btnBackToList');
                const btnOpenInViewer = q('#btnOpenInViewer');
                const btnDownloadPreview = q('#btnDownloadPreview');
                const btnRotateLeft = q('#btnRotateLeft');
                const btnRotateRight = q('#btnRotateRight');
                let currentPreview = { url: '', type: '', ext: '', id: '', rotation: 0 };
                window.addEventListener('resize', () => setDocumentFocus(!!currentPreview.url));

                function normalizePreviewRotation(value) {
                    const numeric = Number.isFinite(Number(value)) ? Number(value) : 0;
                    return ((numeric % 360) + 360) % 360;
                }

                function canRotatePreview() {
                    const previewType = (currentPreview?.type || '').toLowerCase();
                    return !!currentPreview?.url && (previewType === 'img' || previewType === 'pdf');
                }

                function updatePreviewRotationControls() {
                    const enabled = canRotatePreview();
                    const rotationLabel = normalizePreviewRotation(currentPreview?.rotation || 0);
                    [btnRotateLeft, btnRotateRight].forEach(button => {
                        if (!button) return;
                        button.disabled = !enabled;
                        button.setAttribute('aria-disabled', enabled ? 'false' : 'true');
                        button.classList.toggle('disabled', !enabled);
                    });

                    if (btnRotateLeft) {
                        btnRotateLeft.title = enabled
                            ? `Girar a la izquierda (${rotationLabel}°)`
                            : 'La rotación está disponible para imágenes y PDF';
                    }
                    if (btnRotateRight) {
                        btnRotateRight.title = enabled
                            ? `Girar a la derecha (${rotationLabel}°)`
                            : 'La rotación está disponible para imágenes y PDF';
                    }
                }

                async function rotateCurrentPreview(delta) {
                    if (!canRotatePreview()) return;
                    currentPreview.rotation = normalizePreviewRotation((currentPreview.rotation || 0) + delta);
                    updatePreviewRotationControls();
                    await renderPreview(currentPreview.url, currentPreview.type, currentPreview.ext, currentPreview.id);
                }

                function readRootCssPx(variableName, fallback) {
                    const value = parseFloat(getComputedStyle(document.documentElement).getPropertyValue(variableName));
                    return Number.isFinite(value) ? value : fallback;
                }

                function isDesktopResizableLayout() {
                    return window.matchMedia('(min-width: 992px)').matches && !document.documentElement.classList.contains('document-focus');
                }

                function getResizableMetrics() {
                    if (!layoutRow) return null;
                    const rect = layoutRow.getBoundingClientRect();
                    const gap = readRootCssPx('--columns-gap', 14);
                    const splitterSize = readRootCssPx('--splitter-size', 12);
                    const availableWidth = Math.max(0, rect.width - (gap * 4) - (splitterSize * 2));
                    const leftWidth = Math.round(colLeft?.getBoundingClientRect().width || readRootCssPx('--left-panel-width', 272));
                    const rightWidth = Math.round(colRight?.getBoundingClientRect().width || readRootCssPx('--right-panel-width', 286));
                    return { rect, availableWidth, leftWidth, rightWidth };
                }

                function applyPanelWidths(nextLeftWidth = null, nextRightWidth = null) {
                    if (nextLeftWidth != null) {
                        document.documentElement.style.setProperty('--left-panel-width', `${Math.round(nextLeftWidth)}px`);
                    }
                    if (nextRightWidth != null) {
                        document.documentElement.style.setProperty('--right-panel-width', `${Math.round(nextRightWidth)}px`);
                    }
                    positionChatInput();
                }

                function syncSplitterAccessibility() {
                    const metrics = getResizableMetrics();
                    if (!metrics) return;
                    const centerMin = 460;
                    const minLeft = 220;
                    const minRight = 240;
                    const maxLeft = Math.max(minLeft, metrics.availableWidth - metrics.rightWidth - centerMin);
                    const maxRight = Math.max(minRight, metrics.availableWidth - metrics.leftWidth - centerMin);

                    if (splitterLeft) {
                        splitterLeft.setAttribute('aria-valuemin', String(minLeft));
                        splitterLeft.setAttribute('aria-valuemax', String(Math.round(maxLeft)));
                        splitterLeft.setAttribute('aria-valuenow', String(Math.round(metrics.leftWidth)));
                    }

                    if (splitterRight) {
                        splitterRight.setAttribute('aria-valuemin', String(minRight));
                        splitterRight.setAttribute('aria-valuemax', String(Math.round(maxRight)));
                        splitterRight.setAttribute('aria-valuenow', String(Math.round(metrics.rightWidth)));
                    }
                }

                function initPanelSplitters() {
                    if (!layoutRow || !splitterLeft || !splitterRight) return;

                    const centerMin = 460;
                    const minLeft = 220;
                    const minRight = 240;
                    let activeResize = null;

                    function endResize() {
                        if (!activeResize) return;
                        layoutRow.classList.remove('is-resizing');
                        activeResize = null;
                        syncSplitterAccessibility();
                    }

                    function onPointerMove(event) {
                        if (!activeResize || !isDesktopResizableLayout()) return;
                        const metrics = getResizableMetrics();
                        if (!metrics) return;

                        if (activeResize.side === 'left') {
                            const maxLeft = Math.max(minLeft, metrics.availableWidth - metrics.rightWidth - centerMin);
                            const delta = event.clientX - activeResize.startX;
                            const nextLeft = Math.min(maxLeft, Math.max(minLeft, activeResize.startWidth + delta));
                            applyPanelWidths(nextLeft, null);
                        } else {
                            const maxRight = Math.max(minRight, metrics.availableWidth - metrics.leftWidth - centerMin);
                            const delta = activeResize.startX - event.clientX;
                            const nextRight = Math.min(maxRight, Math.max(minRight, activeResize.startWidth + delta));
                            applyPanelWidths(null, nextRight);
                        }

                        syncSplitterAccessibility();
                    }

                    function startResize(side, event) {
                        if (!isDesktopResizableLayout()) return;
                        const metrics = getResizableMetrics();
                        if (!metrics) return;

                        activeResize = {
                            side,
                            startX: event.clientX,
                            startWidth: side === 'left' ? metrics.leftWidth : metrics.rightWidth
                        };

                        layoutRow.classList.add('is-resizing');
                        try { event.target?.setPointerCapture?.(event.pointerId); } catch (e) { /* ignore */ }
                        event.preventDefault();
                    }

                    function onSplitterKeyDown(side, event) {
                        if (!isDesktopResizableLayout()) return;
                        const step = event.shiftKey ? 36 : 18;
                        const metrics = getResizableMetrics();
                        if (!metrics) return;

                        if (side === 'left' && (event.key === 'ArrowLeft' || event.key === 'ArrowRight')) {
                            const maxLeft = Math.max(minLeft, metrics.availableWidth - metrics.rightWidth - centerMin);
                            const direction = event.key === 'ArrowRight' ? 1 : -1;
                            const nextLeft = Math.min(maxLeft, Math.max(minLeft, metrics.leftWidth + (direction * step)));
                            applyPanelWidths(nextLeft, null);
                            syncSplitterAccessibility();
                            event.preventDefault();
                        }

                        if (side === 'right' && (event.key === 'ArrowLeft' || event.key === 'ArrowRight')) {
                            const maxRight = Math.max(minRight, metrics.availableWidth - metrics.leftWidth - centerMin);
                            const direction = event.key === 'ArrowLeft' ? 1 : -1;
                            const nextRight = Math.min(maxRight, Math.max(minRight, metrics.rightWidth + (direction * step)));
                            applyPanelWidths(null, nextRight);
                            syncSplitterAccessibility();
                            event.preventDefault();
                        }
                    }

                    splitterLeft.addEventListener('pointerdown', event => startResize('left', event));
                    splitterRight.addEventListener('pointerdown', event => startResize('right', event));
                    splitterLeft.addEventListener('keydown', event => onSplitterKeyDown('left', event));
                    splitterRight.addEventListener('keydown', event => onSplitterKeyDown('right', event));
                    window.addEventListener('pointermove', onPointerMove);
                    window.addEventListener('pointerup', endResize);
                    window.addEventListener('pointercancel', endResize);
                    window.addEventListener('resize', syncSplitterAccessibility);
                    syncSplitterAccessibility();
                }

                async function getMarkupPreviewPayload(fileId) {
                    const response = await fetch(`@Url.Action("GetCaseDocumentPreview", "Nexus")?caseCode=${caseCode}&fileId=${fileId}`);
                    if (!response.ok) {
                        throw new Error(response.statusText || 'No se pudo obtener el contenido del documento.');
                    }

                    return response.json();
                }

                async function onSelectRow(row) {
                    qa('.source-row.selected').forEach(r => r.classList.remove('selected'));
                    row.classList.add('selected');

                    const url = row.dataset.url;
                    const type = (row.dataset.type || '').toLowerCase();
                    const ext = (row.dataset.ext || '').toLowerCase();
                    const title = row.title || (row.querySelector('td:nth-child(2)')?.innerText) || 'Documento';
                    if (previewTitle) previewTitle.textContent = title;
                    if (previewEmptyState) previewEmptyState.style.display = 'none';

                    currentPreview = { url: url, type: type, ext: ext, id: row.dataset.id || '', rotation: 0 };
                    updatePreviewRotationControls();
                    const requiresLayoutExpand = !document.documentElement.classList.contains('document-focus');
                    setDocumentFocus(true);
                    await stabilizePositionDuringTransition(requiresLayoutExpand ? 190 : 0);
                    await renderPreview(url, type, ext, row.dataset.id || '');
                    positionChatInput();
                }

                function backToList() {
                    __pdfRenderToken++;
                    if (previewContent) previewContent.innerHTML = '';
                    if (previewContent) previewContent.dataset.zoomKind = 'none';
                    currentPreview = { url: '', type: '', ext: '', id: '', rotation: 0 };
                    qa('.source-row.selected').forEach(r => r.classList.remove('selected'));
                    if (previewTitle) previewTitle.textContent = 'Vista previa del documento';
                    if (previewEmptyState) previewEmptyState.style.display = '';
                    updatePreviewRotationControls();
                    setDocumentFocus(false);
                    positionChatInput();
                }

                if (btnBackToList) btnBackToList.addEventListener('click', backToList);
                if (btnOpenInViewer) btnOpenInViewer.addEventListener('click', () => { if (!currentPreview.url) return Swal.fire({icon: 'error',title: 'Advertencia',text: 'No hay documento en vista previa.',}); window.open(currentPreview.url, '_blank'); });
                if (btnDownloadPreview) btnDownloadPreview.addEventListener('click', () => {
                    if (!currentPreview.url) {
                        return Swal.fire({ icon: 'error', title: 'Advertencia', text: 'No hay documento seleccionado.' });
                    }

                    const a = document.createElement('a');
                    a.style.display = 'none';
                    a.href = currentPreview.id
                        ? `@Url.Action("DownloadCaseDocument", "Nexus")?caseCode=${caseCode}&fileId=${currentPreview.id}`
                        : currentPreview.url;
                    document.body.appendChild(a);
                    a.click();
                    a.remove();
                });
                btnRotateLeft?.addEventListener('click', async event => {
                    event.preventDefault();
                    event.stopPropagation();
                    await rotateCurrentPreview(-90);
                });
                btnRotateRight?.addEventListener('click', async event => {
                    event.preventDefault();
                    event.stopPropagation();
                    await rotateCurrentPreview(90);
                });

                async function renderPreview(url, type, ext = '', fileId = '') {
                    __pdfRenderToken++;
                    const myToken = __pdfRenderToken;
                    const previewRotation = normalizePreviewRotation(currentPreview?.rotation || 0);

                    try {
                        window.NexusPreviewZoom?.reset?.();
                    } catch (e) { /* ignore */ }

                    const previewContent = document.getElementById('previewContent');
                    if (!previewContent) return;
                    previewContent.innerHTML = '';
                    previewContent.scrollTop = 0;
                    previewContent.classList.remove('is-dragging');
                    previewContent.dataset.zoomKind = 'none';
                    previewContent.style.overflow = 'auto';
                    previewContent.style.webkitOverflowScrolling = 'touch';
                    previewContent.style.boxSizing = 'border-box';
                    if (previewEmptyState) previewEmptyState.style.display = 'none';
                    updatePreviewRotationControls();

                    if (!url) {
                        if (previewEmptyState) previewEmptyState.style.display = '';
                        return;
                    }

                    if (type === 'markup') {
                        previewContent.dataset.zoomKind = 'static';
                        try {
                            const markupPayload = await getMarkupPreviewPayload(fileId);
                            if (myToken !== __pdfRenderToken) return;

                            const markupExt = ((markupPayload.extension || ext || '').toString()).toLowerCase().replace(/^\./, '');
                            const rawText = (markupPayload.text || '').toString();

                            const zoomWrapper = document.createElement('div');
                            zoomWrapper.className = 'preview-zoom-wrapper preview-markup-wrapper';
                            zoomWrapper.style.width = '100%';
                            zoomWrapper.style.height = '100%';
                            zoomWrapper.style.overflow = 'auto';

                            const stage = document.createElement('div');
                            stage.className = 'preview-markup-stage';

                            const shell = document.createElement('div');
                            shell.className = 'preview-markup-shell';

                            const meta = document.createElement('div');
                            meta.className = 'preview-markup-meta';
                            const metaText = document.createElement('div');
                            metaText.className = 'preview-markup-copy';
                            metaText.textContent = markupExt === 'xml'
                                ? 'XML guardado directo, sin OCR.'
                                : 'HTML guardado directo, sin OCR. Puedes alternar entre código y render.';

                            const metaActions = document.createElement('div');
                            metaActions.className = 'preview-markup-actions';

                            const viewerHost = document.createElement('div');
                            viewerHost.className = 'preview-markup-viewer';

                            const modes = markupExt === 'xml'
                                ? [
                                    { key: 'code', label: 'Código' },
                                    { key: 'tree', label: 'Estructura' }
                                ]
                                : [
                                    { key: 'code', label: 'Código' },
                                    { key: 'render', label: 'Render' }
                                ];

                            function paintMarkupMode(mode) {
                                viewerHost.innerHTML = '';

                                if (mode === 'render') {
                                    viewerHost.appendChild(createRenderedHtmlPreview(rawText));
                                } else if (mode === 'tree') {
                                    viewerHost.appendChild(createXmlTreePreview(rawText));
                                } else {
                                    viewerHost.appendChild(createMarkupCodeBlock(markupExt, rawText));
                                }

                                Array.from(metaActions.querySelectorAll('.preview-markup-mode')).forEach(button => {
                                    button.classList.toggle('is-active', button.dataset.mode === mode);
                                });
                            }

                            modes.forEach((mode, index) => {
                                const button = document.createElement('button');
                                button.type = 'button';
                                button.className = 'preview-markup-mode';
                                button.dataset.mode = mode.key;
                                button.textContent = mode.label;
                                button.addEventListener('click', () => paintMarkupMode(mode.key));
                                metaActions.appendChild(button);

                                if (index === 0) {
                                    button.classList.add('is-active');
                                }
                            });

                            meta.appendChild(metaText);
                            meta.appendChild(metaActions);
                            shell.appendChild(meta);
                            paintMarkupMode(modes[0].key);
                            shell.appendChild(viewerHost);

                            stage.appendChild(shell);
                            zoomWrapper.appendChild(stage);
                            previewContent.appendChild(zoomWrapper);
                            stabilizePositionDuringTransition(320).then(() => positionChatInput());
                        } catch (err) {
                            console.error('markup preview error', err);
                            previewContent.innerHTML = '<p class="text-danger">No se pudo cargar la vista previa del documento markup.</p>';
                            stabilizePositionDuringTransition(320).then(() => positionChatInput());
                        }
                        return;
                    }

                    if (type === 'img') {
                        previewContent.dataset.zoomKind = 'img';
                        const zoomWrapper = document.createElement('div');
                        zoomWrapper.className = 'preview-zoom-wrapper preview-image-scroll';
                        zoomWrapper.style.width = '100%';
                        zoomWrapper.style.height = '100%';
                        zoomWrapper.style.overflow = 'auto';
                        zoomWrapper.style.touchAction = 'auto';

                        const stage = document.createElement('div');
                        stage.className = 'preview-image-stage';

                        const img = document.createElement('img');
                        img.src = url;
                        img.className = 'img-fluid rounded preview-image';
                        img.style.maxHeight = 'none';
                        img.style.objectFit = 'contain';
                        img.onerror = () => {
                            previewContent.innerHTML = '<p class="text-danger">Error al cargar la imagen.</p>';
                            if (previewEmptyState) previewEmptyState.style.display = 'none';
                        };
                        img.onload = () => {
                            const availableWidth = Math.max(160, (zoomWrapper.clientWidth || previewContent.clientWidth || img.naturalWidth || 0) - 18);
                            const availableHeight = Math.max(160, (zoomWrapper.clientHeight || previewContent.clientHeight || img.naturalHeight || 0) - 18);
                            const naturalWidth = img.naturalWidth || availableWidth;
                            const naturalHeight = img.naturalHeight || availableHeight;
                            const isQuarterTurn = previewRotation === 90 || previewRotation === 270;
                            const rotatedWidth = isQuarterTurn ? naturalHeight : naturalWidth;
                            const rotatedHeight = isQuarterTurn ? naturalWidth : naturalHeight;
                            const fitScale = Math.min(availableWidth / rotatedWidth, availableHeight / rotatedHeight, 1);
                            const baseWidth = Math.max(140, Math.round(rotatedWidth * fitScale));
                            const baseHeight = Math.max(140, Math.round(rotatedHeight * fitScale));
                            const innerBaseWidth = Math.max(140, Math.round(naturalWidth * fitScale));
                            const innerBaseHeight = Math.max(140, Math.round(naturalHeight * fitScale));

                            stage.dataset.baseWidth = baseWidth.toString();
                            stage.dataset.baseHeight = baseHeight.toString();
                            stage.dataset.rotation = previewRotation.toString();
                            img.dataset.baseWidth = baseWidth.toString();
                            img.dataset.baseHeight = baseHeight.toString();
                            img.dataset.innerBaseWidth = innerBaseWidth.toString();
                            img.dataset.innerBaseHeight = innerBaseHeight.toString();
                            img.dataset.rotation = previewRotation.toString();

                            stage.style.width = `${baseWidth}px`;
                            stage.style.height = `${baseHeight}px`;
                            img.style.width = `${innerBaseWidth}px`;
                            img.style.height = `${innerBaseHeight}px`;
                            img.style.maxWidth = 'none';
                            img.style.maxHeight = 'none';
                            img.style.transform = `translate(-50%, -50%) rotate(${previewRotation}deg)`;
                            img.style.position = 'absolute';
                            img.style.top = '50%';
                            img.style.left = '50%';

                            zoomWrapper.scrollLeft = 0;
                            zoomWrapper.scrollTop = 0;
                            updatePreviewRotationControls();
                            stabilizePositionDuringTransition(400).then(() => positionChatInput());
                        };

                        stage.appendChild(img);
                        zoomWrapper.appendChild(stage);
                        previewContent.appendChild(zoomWrapper);
                        return;
                    }

                    if (type !== 'pdf') {
                        previewContent.dataset.zoomKind = 'static';
                        previewContent.innerHTML = '<div class="preview-empty-state"><i class="fa fa-file-lines"></i><div class="fw-semibold">Vista previa no disponible</div><div class="text-muted">Puedes abrir o descargar este archivo desde la barra superior.</div></div>';
                        stabilizePositionDuringTransition(260).then(() => positionChatInput());
                        return;
                    }

                    const progressWrap = document.createElement('div');
                    previewContent.dataset.zoomKind = 'pdf';
                    progressWrap.className = 'pdf-progress-wrap mb-2';
                    progressWrap.innerHTML = `<div class="pdf-progress-label">Cargando PDF…</div>
                                                <div class="progress"><div class="progress-bar" role="progressbar" style="width:0%"></div></div>`;
                    previewContent.appendChild(progressWrap);

                    try {
                        const loadingTask = pdfjsLib.getDocument(url);
                        const pdf = await loadingTask.promise;

                        if (myToken !== __pdfRenderToken) { try { pdf.destroy?.(); } catch (e) {} return; }

                        const total = pdf.numPages;
                        const progressBar = progressWrap.querySelector('.progress-bar');

                        const zoomWrapper = document.createElement('div');
                        zoomWrapper.className = 'preview-zoom-wrapper';
                        zoomWrapper.style.width = '100%';
                        zoomWrapper.style.height = '100%';
                        zoomWrapper.style.overflow = 'auto';
                        zoomWrapper.style.touchAction = 'auto';
                        previewContent.appendChild(zoomWrapper);

                        const pagesContainer = document.createElement('div');
                        pagesContainer.className = 'pdf-pages-container';
                        pagesContainer.style.display = 'flex';
                        pagesContainer.style.flexDirection = 'column';
                        pagesContainer.style.gap = '12px';
                        pagesContainer.style.alignItems = 'center';
                        pagesContainer.style.minHeight = '100%';
                        zoomWrapper.appendChild(pagesContainer);

                        for (let p = 1; p <= total; p++) {
                            if (myToken !== __pdfRenderToken) { try { pdf.destroy?.(); } catch (e) {} return; }

                            const pageBox = document.createElement('div');
                            pageBox.className = 'pdf-page-box mb-3';
                            pageBox.setAttribute('data-page', p);
                            pageBox.style.display = 'flex';
                            pageBox.style.flexDirection = 'column';    // importante: caption debajo
                            pageBox.style.justifyContent = 'center';
                            pageBox.style.alignItems = 'center';
                            pageBox.style.padding = '8px';
                            pageBox.style.boxSizing = 'border-box';

                            const loader = document.createElement('div');
                            loader.className = 'pdf-page-loader';
                            loader.innerText = `Cargando página ${p} de ${total}...`;
                            pageBox.appendChild(loader);
                            pagesContainer.appendChild(pageBox);

                            const page = await pdf.getPage(p);

                            const cs = getComputedStyle(previewContent);
                            const paddingX = (parseFloat(cs.paddingLeft || 0) || 0) + (parseFloat(cs.paddingRight || 0) || 0);
                            const availableWidth = Math.max(300, (previewContent.clientWidth || 800) - paddingX - 24);

                            const unscaledViewport = page.getViewport({ scale: 1, rotation: previewRotation });
                            const scale = Math.max(0.5, (availableWidth) / unscaledViewport.width);
                            const cssViewport = page.getViewport({ scale, rotation: previewRotation });
                            const outputScale = Math.max(1, window.devicePixelRatio || 1);
                            const pixelViewport = page.getViewport({ scale: scale * outputScale, rotation: previewRotation });
                            pageBox.style.width = Math.floor(cssViewport.width + 18) + 'px';
                            pageBox.dataset.baseWidth = Math.floor(cssViewport.width).toString();
                            const canvas = document.createElement('canvas');
                            canvas.width = Math.floor(pixelViewport.width);
                            canvas.height = Math.floor(pixelViewport.height);
                            canvas.style.width = Math.floor(cssViewport.width) + 'px';
                            canvas.style.height = 'auto';
                            canvas.style.display = 'block';
                            canvas.style.margin = '0 auto';
                            canvas.style.maxWidth = '100%';
                            canvas.className = 'pdf-page-canvas rounded';
                            canvas.dataset.baseWidth = Math.floor(cssViewport.width).toString();

                            const ctx = canvas.getContext('2d', { alpha: false });
                            if (myToken !== __pdfRenderToken) { try { page.cleanup?.(); } catch (e) {} return; }

                            try {
                                await page.render({ canvasContext: ctx, viewport: pixelViewport }).promise;
                            } catch (errRender) {
                                console.error('Error renderizando página', p, errRender);
                                pageBox.innerHTML = `<div class="text-danger">Error al renderizar página ${p}</div>`;
                                continue;
                            }

                            pageBox.removeChild(loader);
                            pageBox.appendChild(canvas);

                            const caption = document.createElement('div');
                            caption.className = 'pdf-page-caption small text-muted mt-1';
                            caption.innerText = `Página ${p} / ${total}`;
                            caption.style.textAlign = 'center';
                            caption.style.width = '100%';
                            caption.style.marginTop = '8px';
                            pageBox.appendChild(caption);

                            const percent = Math.round((p / total) * 100);
                            if (progressBar) progressBar.style.width = percent + '%';
                            await new Promise(res => setTimeout(res, 20));
                        }

                        const firstCanvas = pagesContainer.querySelector('.pdf-page-canvas');
                        if (firstCanvas) {
                            pagesContainer.dataset.baseWidth = firstCanvas.dataset.baseWidth || '';
                        }

                        if (progressWrap && progressWrap.parentNode) progressWrap.parentNode.removeChild(progressWrap);

                        updatePreviewRotationControls();
                        if (previewContent) { stabilizePositionDuringTransition(500).then(() => positionChatInput()); }
                    } catch (err) {
                        console.error('Error al cargar PDF completo', err);
                        previewContent.innerHTML = '<p class="text-danger">Error al cargar el PDF. Revisa CORS o la URL.</p>';
                        stabilizePositionDuringTransition(400).then(() => positionChatInput());
                    }
                }


                const btnRefresh = q('#btnRefreshSources');
                if (btnRefresh) btnRefresh.addEventListener('click', () => loadCaseDocuments(currentPreview.id || null));
                bindTableRows();
                updatePreviewRotationControls();
                updateProcessPickerButton();
                renderProcessMenuOptions('loading');
                ensureComposerProcesses();
                renderTransientAttachments();
                setDocumentFocus(false);
                initPanelSplitters();

                window.addEventListener('resize', () => { positionChatInput(); stabilizePositionDuringTransition(); });
                const mo = new MutationObserver(() => { positionChatInput(); stabilizePositionDuringTransition(); });
                mo.observe(document.body, { childList: true, subtree: true });

                setTimeout(() => { positionChatInput(); stabilizePositionDuringTransition(); }, 160);
            });

            (function () {
                let __panelsTO = null;
                function detectHeaderFooter() {
                    const headerSelectors = ['header', '.navbar', '.topbar', '.site-header', '.main-header'];
                    const footerSelectors = ['#nexusFooter', 'footer.site-footer', '.site-footer', '.nexus-notice'];
                    function firstMatch(list) { for (const s of list) { const el = document.querySelector(s); if (el) return el; } return null; }
                    const explicitFooter = firstMatch(footerSelectors);
                    const explicitHeader = firstMatch(headerSelectors);

                    const fixedBottomCandidates = [];
                    Array.from(document.body.children).forEach(el => {
                        try {
                            const cs = getComputedStyle(el);
                            if ((cs.position === 'fixed' || cs.position === 'sticky') && cs.display !== 'none') {
                                const rect = el.getBoundingClientRect();
                                if (rect.bottom >= window.innerHeight - 2 || rect.bottom >= window.innerHeight - 80) {
                                    fixedBottomCandidates.push(el);
                                }
                            }
                        } catch (e) { }
                    });

                    return { header: explicitHeader, footer: explicitFooter, fixedBottoms: fixedBottomCandidates };
                }

                function applyHeights() {
                    try {
                        const det = detectHeaderFooter();
                        const headerH = det.header ? Math.ceil(det.header.getBoundingClientRect().height) : 0;

                        let footerH = 0;
                        if (det.footer) { try { footerH = Math.max(footerH, Math.ceil(det.footer.getBoundingClientRect().height)); } catch (e) {} }
                        det.fixedBottoms.forEach(e => { try { footerH = Math.max(footerH, Math.ceil(e.getBoundingClientRect().height)); } catch (e) {} });

                        const nexus = document.getElementById('nexusFooter');
                        if (nexus) {
                            nexus.style.position = 'fixed';
                            nexus.style.left = '0';
                            nexus.style.right = '0';
                            nexus.style.bottom = '0';
                            nexus.style.zIndex = '1200';
                            nexus.style.width = '100%';
                            try { footerH = Math.max(footerH, Math.ceil(nexus.getBoundingClientRect().height)); } catch (e) {}
                        }

                        document.documentElement.style.setProperty('--footer-height', (footerH || 72) + 'px');
                        document.body.style.paddingBottom = (footerH || 72) + 'px';
                        const extra = 6;
                        const available = Math.max(180, Math.floor(window.innerHeight - headerH - (footerH || 72) - extra));
                        const container = document.querySelector('.app-container');
                        if (container) container.style.minHeight = (window.innerHeight - headerH - (footerH || 72)) + 'px';
                        qa('.col-lg-3, .col-lg-6, .col-lg-3').forEach(col => {
                            col.style.display = 'flex';
                            col.style.flexDirection = 'column';
                            col.style.paddingBottom = '0';
                            col.style.marginBottom = '0';
                            col.style.minHeight = '0';
                        });
                        qa('.card.card-panel-left, .card.card-panel-center, .card.card-panel-right').forEach(card => {
                            card.style.display = 'flex';
                            card.style.flexDirection = 'column';
                            card.style.height = available + 'px';
                            card.style.maxHeight = available + 'px';
                            card.style.minHeight = '0';
                            card.style.marginBottom = '0';
                        });
                        qa('.card.card-panel-center, .card.card-panel-right').forEach(card => {
                            const body = card.querySelector('.card-body.panel-body');
                            if (body) {
                                body.style.flex = '1 1 auto';
                                body.style.minHeight = '0';
                                const result = body.querySelector('.result-area');
                                if (result) {
                                    result.style.flex = '1 1 auto';
                                    result.style.minHeight = '0';
                                    result.style.overflowY = 'auto';
                                }
                            }
                        });

                        qa('.card.card-panel-left .card-body.panel-body').forEach(body => {
                            body.style.flex = '1 1 auto';
                            body.style.minHeight = '0';
                            body.style.overflow = 'hidden';
                        });

                        const previewContent = document.querySelector('#previewContent');
                        if (previewContent) {
                            const panel = previewContent.closest('.panel-height') || previewContent.closest('.card-body.panel-body');
                            if (panel) {
                                const panelRect = panel.getBoundingClientRect();
                                const previewHeader = panel.querySelector('.d-flex.align-items-center') || panel.querySelector('.card-header');
                                const headerInnerH = previewHeader ? Math.ceil(previewHeader.getBoundingClientRect().height) : 48;
                                const footerCompact = panel.querySelector('.mt-2.d-flex') || panel.querySelector('.card-footer');
                                const footerInnerH = footerCompact ? Math.ceil(footerCompact.getBoundingClientRect().height) : 40;
                                const innerAvailable = Math.max(120, Math.floor(panelRect.height - headerInnerH - footerInnerH - 16));
                                previewContent.style.height = innerAvailable + 'px';
                                previewContent.style.maxHeight = innerAvailable + 'px';
                                previewContent.style.minHeight = '0';
                                previewContent.style.overflowY = 'auto';
                                previewContent.style.boxSizing = 'border-box';
                            }
                        }

                        qa('.pdf-pages-container, .pdf-page-box').forEach(el => { el.style.overflow = 'visible'; });

                        // RIGHT PANEL: ensure studio panel children scroll independently
                        qa('.card.card-panel-right').forEach(card => {
                            const body = card.querySelector('.card-body.panel-body');
                            if (!body) return;
                            const studioInner = body.querySelector('.studio-panel-body');
                            if (!studioInner) return;
                            // studioInner already flex column in CSS; ensure children have correct flex/scroll
                            const grid = studioInner.querySelector('.studio-grid');
                            if (grid) {
                                grid.style.flex = '1 1 auto';
                                grid.style.minHeight = '0';
                                grid.style.overflowY = 'auto';
                                grid.style.paddingRight = '8px';
                            }
                            const feedback = studioInner.querySelector('#cfTopPanel');
                            if (feedback) {
                                // keep feedback visible at bottom; don't let it stretch
                                feedback.style.flex = '0 0 auto';
                                feedback.style.marginTop = '12px';
                            }
                        });

                        document.documentElement.style.setProperty('--available-panel-height', available + 'px');
                    } catch (err) {
                        console.warn('applyHeights error', err);
                    }
                }

                function scheduleApply() {
                    clearTimeout(__panelsTO);
                    __panelsTO = setTimeout(applyHeights, 80);
                }

                window.addEventListener('load', scheduleApply);
                window.addEventListener('resize', scheduleApply);
                const mo = new MutationObserver(() => scheduleApply());
                mo.observe(document.body, { childList: true, subtree: true });

                window.__setPanelsHeight = applyHeights;
                scheduleApply();
            })();
        })();
    </script>

    <script>
        (function () {
            const panel = document.getElementById('cfTopPanel');
            if (!panel) return;
            const caseCode = panel.dataset.case || '';
            const buttons = Array.from(panel.querySelectorAll('.cf-toggle-btn'));
            const commentEl = document.getElementById('cfComment');
            const sendBtn = document.getElementById('cfSend');
            const cancelBtn = document.getElementById('cfCancel');
            const statusEl = document.getElementById('cfStatus');

            let state = { helped: null, comment: '' };

            function setStatus(text, tone) {
                statusEl.textContent = text || '';
                statusEl.className = 'small ' + (tone === 'ok' ? 'text-success' : tone === 'err' ? 'text-danger' : 'text-muted');
            }

            function clearSelection() {
                state.helped = null;
                buttons.forEach(b => { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });
            }

            // toggle buttons estilo "tile"
            buttons.forEach(btn => {
                btn.addEventListener('click', () => {
                    const val = btn.dataset.value === 'true';
                    // si hizo click en mismo valor, toggle off
                    if (state.helped === val) {
                        clearSelection();
                    } else {
                        state.helped = val;
                        buttons.forEach(b => {
                            const isActive = (b === btn);
                            b.classList.toggle('active', isActive);
                            b.setAttribute('aria-pressed', isActive ? 'true' : 'false');
                        });
                    }
                    setStatus('', null);
                });
            });
            sendBtn.addEventListener('click', async () => {
                state.comment = (commentEl && commentEl.value || '').trim();
                if (state.helped === null) {
                    setStatus('Selecciona Sí/No o escribe un comentario antes de enviar.', 'err');
                    return;
                }
                sendBtn.disabled = true;
                buttons.forEach(b => b.disabled = true);
                setStatus('Enviando reseña…', 'muted');

                const payload = { caseCode: caseCode, helped: state.helped, comment: state.comment };

                try {
                    const resp = await fetch('@Url.Action("SubmitFeedback", "Nexus")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    if (!resp.ok) throw new Error('Status ' + resp.status);
                    const data = await resp.json();
                    if (data && data.success) {
                        setStatus('Gracias — reseña enviada.', 'ok');
                        sendBtn.classList.remove('btn-primary');
                        sendBtn.classList.add('btn-success');
                        sendBtn.textContent = 'Enviado';
                    } else {
                        throw new Error((data && data.message) ? data.message : 'No fue posible guardar la reseña.');
                    }
                } catch (err) {
                    console.error('Feedback error', err);
                    try {
                        const key = 'nexus_feedback_offline_' + (caseCode || 'unknown') + '_' + new Date().getTime();
                        localStorage.setItem(key, JSON.stringify(Object.assign({}, payload, { ts: new Date().toISOString() })));
                        setStatus('No se pudo enviar ahora. Guardado localmente.', 'err');
                    } catch (e) {
                        setStatus('Error al enviar reseña. Intenta nuevamente más tarde.', 'err');
                    }
                    sendBtn.disabled = false;
                    buttons.forEach(b => b.disabled = false);
                    cancelBtn.disabled = false;
                    return;
                }

                sendBtn.disabled = true;
                buttons.forEach(b => b.disabled = true);
                cancelBtn.disabled = true;
            });
            buttons.forEach(b => {
                b.addEventListener('keydown', (ev) => {
                    if (ev.key === 'Enter' || ev.key === ' ') {
                        ev.preventDefault();
                        b.click();
                    }
                });
            });
        })();
    </script>

    <script>
        (function () {
          'use strict';

          // Si existe window.nexusConfig lo usamos, si no, usamos rutas por defecto (Razor ya las inyectó arriba).
          const cfg = window.nexusConfig || {};
          const notesGetUrl = cfg.notesGetUrl || '@Url.Action("GetNotes", "Nexus")';
          const notesAddUrl = cfg.notesAddUrl || '@Url.Action("AddNote", "Nexus")';
          const notesDeleteUrl = cfg.notesDeleteUrl || '@Url.Action("DeleteNote", "Nexus")';

          function getCaseCode() {
            const panel = document.getElementById('cfTopPanel');
            if (panel && panel.dataset && panel.dataset.case) return panel.dataset.case;
            return (window.nexusConfig && window.nexusConfig.caseCode) || '';
          }

          document.addEventListener('DOMContentLoaded', () => {
            console.debug('[NexusNotes] DOMContentLoaded - inicializando');

            // refs DOM
            let notesListEl = document.getElementById('notesList');
            let notesEditor = document.getElementById('notesEditor');
            let notesCancel = document.getElementById('notesCancel');
            let notesSave = document.getElementById('notesSave');
            let btnAddNote = document.getElementById('btnAddNote');
            let btnRefreshNotes = document.getElementById('btnRefreshNotes');
            let noteTitle = document.getElementById('noteTitle');
            let noteDetail = document.getElementById('noteDetail');
            let notesStatus = document.getElementById('notesStatus');
            let notesEditorTitle = document.getElementById('notesEditorTitle');

            function refreshRefs() {
              notesListEl = document.getElementById('notesList') || notesListEl;
              notesEditor = document.getElementById('notesEditor') || notesEditor;
              notesCancel = document.getElementById('notesCancel') || notesCancel;
              notesSave = document.getElementById('notesSave') || notesSave;
              noteTitle = document.getElementById('noteTitle') || noteTitle;
              noteDetail = document.getElementById('noteDetail') || noteDetail;
              notesStatus = document.getElementById('notesStatus') || notesStatus;
              notesEditorTitle = document.getElementById('notesEditorTitle') || notesEditorTitle;
            }

            // --- Fetch helpers ---
            async function getJson(url) {
              const resp = await fetch(url, { method: 'GET', headers: { 'Accept': 'application/json' } });
              if (!resp.ok) {
                const txt = await resp.text().catch(() => resp.statusText || 'Error GET');
                throw new Error(txt || 'Error GET');
              }
              return resp.json();
            }
            async function postJson(url, payload) {
              const resp = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
              });
              if (!resp.ok) {
                const txt = await resp.text().catch(() => resp.statusText || 'Error POST');
                throw new Error(txt || ('Error POST: ' + txt));
              }
              return resp.json();
            }

            function showStatus(text, isError) {
              if (!notesStatus) return;
              notesStatus.textContent = text || '';
              notesStatus.className = isError ? 'small text-danger' : 'small text-muted';
            }

            // --- Crear item de lista ---
            function createNoteItem(note) {
              const li = document.createElement('div');
              li.className = 'list-group-item d-flex justify-content-between align-items-start';
              li.dataset.noteId = note.id || '';

              const left = document.createElement('div');
              left.className = 'me-2 w-100';

              const h = document.createElement('div');
              h.className = 'fw-semibold text-truncate';
              h.textContent = note.title || '(Sin título)';

              const detailEl = document.createElement('div');
              detailEl.className = 'small text-muted note-detail';
              detailEl.textContent = note.detail || '';

              const meta = document.createElement('div');
              meta.className = 'small text-muted mt-1';
              const d = note.createdAt ? new Date(note.createdAt) : new Date();
              meta.textContent = `${d.toLocaleString()}${note.createdBy ? ' · ' + note.createdBy : ''}`;

              left.appendChild(h);
              left.appendChild(detailEl);
              left.appendChild(meta);

              const actions = document.createElement('div');
              actions.className = 'd-flex gap-1 ms-2 align-items-start';

              const btnEdit = document.createElement('button');
              btnEdit.type = 'button';
              btnEdit.className = 'btn btn-sm btn-light';
              btnEdit.title = 'Editar';
              btnEdit.innerHTML = '<i class="fa fa-pen"></i>';
              btnEdit.addEventListener('click', (e) => {
                e.stopPropagation();
                openEditor('edit', note);
              });

              const btnDel = document.createElement('button');
              btnDel.type = 'button';
              btnDel.className = 'btn btn-sm btn-outline-danger';
              btnDel.title = 'Eliminar';
              btnDel.innerHTML = '<i class="fa fa-trash"></i>';
              btnDel.addEventListener('click', async (e) => {
                e.stopPropagation();
                if (!confirm('¿Eliminar nota?')) return;
                li.remove();
                try {
                  const result = await deleteNote(note.id);
                  if (!result || !result.success) throw new Error(result?.error || 'Error al eliminar');
                  showStatus('Nota eliminada');
                } catch (err) {
                  console.error('delete note err', err);
                  showStatus('No se pudo eliminar la nota', true);
                  await loadNotes();
                }
              });

              actions.appendChild(btnEdit);
              actions.appendChild(btnDel);

              li.appendChild(left);
              li.appendChild(actions);

              li.addEventListener('click', () => {
                const expanded = li.classList.toggle('expanded');
                detailEl.style.display = expanded ? 'block' : (note.detail && note.detail.length > 120 ? 'none' : 'block');
              });

              if (note.detail && note.detail.length > 120) detailEl.style.display = 'none';

              return li;
            }

            // --- API calls ---
            async function loadNotes() {
              refreshRefs();
              if (!notesListEl) return;
              const caseCode = getCaseCode();
              notesListEl.innerHTML = '<div class="text-muted small text-center py-3">Cargando notas...</div>';
              try {
                const url = notesGetUrl + '?caseCode=' + encodeURIComponent(caseCode);
                const data = await getJson(url);
                const notes = Array.isArray(data) ? data : (data.items || []);
                notesListEl.innerHTML = '';
                if (!notes || notes.length === 0) {
                  notesListEl.innerHTML = '<div class="text-muted small text-center py-3">No hay notas para este caso.</div>';
                  showStatus('');
                  return;
                }
                notes.forEach(n => {
                  const item = createNoteItem(n);
                  notesListEl.appendChild(item);
                });
                showStatus('');
              } catch (err) {
                console.error('loadNotes err', err);
                notesListEl.innerHTML = '<div class="text-danger small text-center py-3">Error al cargar notas.</div>';
                showStatus('Error al cargar notas', true);
              }
            }

            async function saveNote(payload) {
              return postJson(notesAddUrl, payload);
            }

            async function deleteNote(id) {
              return postJson(notesDeleteUrl, { id });
            }

            // --- Editor UI ---
            function openEditor(mode = 'new', note = null) {
              refreshRefs();
              if (!notesEditor) return;
              notesEditor.style.display = 'block';
              notesEditor.setAttribute('aria-hidden', 'false');
              if (notesEditorTitle) notesEditorTitle.textContent = mode === 'edit' ? 'Editar nota' : 'Nueva nota';
              if (noteTitle) noteTitle.value = note?.title || '';
              if (noteDetail) noteDetail.value = note?.detail || '';
              if (notesSave) notesSave.dataset.editingId = note?.id ? String(note.id) : '';
              setTimeout(() => noteTitle && noteTitle.focus(), 80);
            }

            function closeEditor() {
              refreshRefs();
              if (!notesEditor) return;
              notesEditor.style.display = 'none';
              notesEditor.setAttribute('aria-hidden', 'true');
              if (noteTitle) noteTitle.value = '';
              if (noteDetail) noteDetail.value = '';
              if (notesSave) delete notesSave.dataset.editingId;
            }

            // --- Guardar: handler robusto ---
            async function handleNotesSaveClick(e) {
              try { e && e.preventDefault && e.preventDefault(); } catch (err) {}
              refreshRefs();
              const title = (noteTitle && noteTitle.value || '').trim();
              const detail = (noteDetail && noteDetail.value || '').trim();
              if (!title && !detail) { if (noteTitle) noteTitle.focus(); return; }
              const editingId = parseInt(notesSave?.dataset?.editingId || '0', 10) || 0;
              const payload = { id: editingId, caseCode: getCaseCode(), title, detail };

              try {
                showStatus('Guardando…');
                const result = await saveNote(payload);
                if (!result || !result.success) throw new Error(result?.error || 'Error al guardar');
                await loadNotes();
                showStatus('Nota guardada');
                closeEditor();
              } catch (err) {
                console.error('save note err', err);
                showStatus('No se pudo guardar la nota: ' + (err.message || ''), true);
              }
            }

            // Attach directo si existe, sino delegation + observer
            function attachSaveHandlerDirect() {
              refreshRefs();
              if (!notesSave) return false;
              try {
                if (!notesSave.getAttribute('type') || notesSave.getAttribute('type') !== 'button') {
                  notesSave.setAttribute('type', 'button');
                }
              } catch (err) {}
              notesSave.removeEventListener('click', handleNotesSaveClick);
              notesSave.addEventListener('click', handleNotesSaveClick);
              console.debug('[NexusNotes] handler directo adjuntado a #notesSave');
              return true;
            }

            if (!attachSaveHandlerDirect()) {
              document.addEventListener('click', function delegatedClick(e) {
                const btn = e.target && e.target.closest ? e.target.closest('#notesSave') : null;
                if (!btn) return;
                handleNotesSaveClick.call(btn, e);
              }, true);

              const mo = new MutationObserver((mutations, observer) => {
                if (attachSaveHandlerDirect()) observer.disconnect();
              });
              mo.observe(document.body, { childList: true, subtree: true });
              console.debug('[NexusNotes] usando delegation + observer para #notesSave');
            }

            // Otros bindings
            if (btnAddNote) btnAddNote.addEventListener('click', (e) => { e.preventDefault(); openEditor('new'); });
            if (btnRefreshNotes) btnRefreshNotes.addEventListener('click', (e) => { e.preventDefault(); loadNotes(); });
            if (notesCancel) notesCancel.addEventListener('click', (e) => { e.preventDefault(); closeEditor(); });

            // carga inicial
            setTimeout(() => loadNotes(), 50);

            // Exponer API mínima
            window.NexusNotes = { loadNotes, openEditor, closeEditor };
          }); // DOMContentLoaded
        })();

    </script>
    <script>

        (function() {
            const previewContent = document.getElementById('previewContent');
            const zoomInBtn      = document.getElementById('btnZoomIn');
            const zoomOutBtn     = document.getElementById('btnZoomOut');
            const zoomResetBtn   = document.getElementById('btnZoomReset');
            const zoomLabel      = document.getElementById('zoomLabel');

            if (!previewContent) return;

            // Constantes
            const MIN_SCALE = 0.35;
            const MAX_SCALE = 4.5;
            const STEP      = 0.15;
            let currentScale = 1.0;

            // helpers
            function findPrimary() {
                const wrapper = previewContent.querySelector('.preview-zoom-wrapper');
                if (wrapper) {
                    const image = wrapper.querySelector('img.preview-image, img');
                    if (image) return { el: image, isImage: true, wrapper };
                    const frame = wrapper.querySelector('iframe, embed, object');
                    if (frame) return { el: frame, isFrame: true, wrapper };
                    const firstChild = wrapper.firstElementChild;
                    if (!firstChild) return { el: wrapper, isWrapper: true, wrapper };
                    return { el: firstChild, isWrapper: true, wrapper };
                }
                const img = previewContent.querySelector('img.preview-image, img');
                if (img) return { el: img, isImage: true };
                const frame = previewContent.querySelector('iframe, embed, object');
                if (frame) return { el: frame, isFrame: true };
                return { el: previewContent.firstElementChild || previewContent, isWrapper: false };
            }

            function ensureWrapperIfNeeded() {
                const first = previewContent.firstElementChild;
                if (!first) return null;

                // Si ya está envuelto, retornamos el wrapper
                if (first.classList && first.classList.contains('preview-zoom-wrapper')) {
                    return first;
                }

                // Crear wrapper y mover el contenido dentro
                const wrapper = document.createElement('div');
                wrapper.className = 'preview-zoom-wrapper';
                // permitimos scroll/pan dentro del wrapper
                wrapper.style.overflow = 'auto';
                wrapper.style.width = '100%';
                wrapper.style.height = '100%';
                wrapper.style.boxSizing = 'border-box';
                wrapper.style.touchAction = 'auto';

                // mover hijos dentro del wrapper (manteniendo el orden)
                while (previewContent.firstChild) {
                    wrapper.appendChild(previewContent.firstChild);
                }
                previewContent.appendChild(wrapper);

                // keep consistent defaults for images
                const img = wrapper.querySelector('img');
                if (img) {
                    img.style.width = '100%';
                    img.style.height = 'auto';
                    img.style.maxWidth = '100%';
                    img.style.display = 'block';
                    img.style.transformOrigin = 'top left';
                }

                return wrapper;
            }

            function updateZoomLabel() {
                if (zoomLabel) zoomLabel.textContent = Math.round(currentScale * 100) + '%';
            }

            function canPanPreview() {
                const zoomKind = previewContent.dataset.zoomKind || '';
                return currentScale > 1 && zoomKind !== 'static' && zoomKind !== 'none';
            }

            function syncPanAvailability(wrapper) {
                if (!wrapper) return;

                const enabled = canPanPreview();
                wrapper.classList.toggle('is-pan-enabled', enabled);
                wrapper.classList.toggle('is-grab', enabled && !wrapper.classList.contains('is-grabbing'));
                wrapper.style.touchAction = enabled ? 'none' : 'auto';

                if (!enabled) {
                    wrapper.classList.remove('is-grab');
                    wrapper.classList.remove('is-grabbing');
                    previewContent.classList.remove('is-dragging');
                    isDown = false;
                    if (panWrapper === wrapper) {
                        panWrapper = null;
                    }
                }
            }

            function preserveWrapperScroll(wrapper, applyChanges) {
                const prevScrollLeft = wrapper.scrollLeft || 0;
                const prevScrollTop = wrapper.scrollTop || 0;
                const prevScrollWidth = wrapper.scrollWidth || 1;
                const prevScrollHeight = wrapper.scrollHeight || 1;
                const visibleW = wrapper.clientWidth || previewContent.clientWidth || 1;
                const visibleH = wrapper.clientHeight || previewContent.clientHeight || 1;

                applyChanges();

                try {
                    const prevMaxX = Math.max(0, prevScrollWidth - visibleW);
                    const newMaxX  = Math.max(0, wrapper.scrollWidth - visibleW);
                    const ratioX = prevMaxX > 0 ? (prevScrollLeft / prevMaxX) : 0;
                    wrapper.scrollLeft = Math.round(ratioX * newMaxX);

                    const prevMaxY = Math.max(0, prevScrollHeight - visibleH);
                    const newMaxY  = Math.max(0, wrapper.scrollHeight - visibleH);
                    const ratioY = prevMaxY > 0 ? (prevScrollTop / prevMaxY) : 0;
                    wrapper.scrollTop = Math.round(ratioY * newMaxY);
                } catch (e) { /* ignore */ }
            }

            function syncPdfScale(wrapper) {
                const pagesContainer = wrapper.querySelector('.pdf-pages-container');
                const pdfCanvases = Array.from(wrapper.querySelectorAll('.pdf-page-canvas'));
                if (!pagesContainer || !pdfCanvases.length) return false;

                preserveWrapperScroll(wrapper, () => {
                    let maxScaledWidth = 0;

                    pdfCanvases.forEach(canvas => {
                        const baseWidth = parseFloat(canvas.dataset.baseWidth || canvas.width || 0) || canvas.width || 0;
                        const scaledWidth = Math.max(180, Math.round(baseWidth * currentScale));
                        canvas.dataset.baseWidth = baseWidth.toString();
                        canvas.style.width = `${scaledWidth}px`;
                        canvas.style.height = 'auto';
                        canvas.style.maxWidth = 'none';

                        const pageBox = canvas.closest('.pdf-page-box');
                        if (pageBox) {
                            const boxBaseWidth = parseFloat(pageBox.dataset.baseWidth || baseWidth) || baseWidth;
                            const scaledBoxWidth = Math.round(boxBaseWidth * currentScale + 18);
                            pageBox.style.width = `${scaledBoxWidth}px`;
                            maxScaledWidth = Math.max(maxScaledWidth, scaledBoxWidth);
                        } else {
                            maxScaledWidth = Math.max(maxScaledWidth, scaledWidth);
                        }
                    });

                    pagesContainer.style.width = currentScale <= 1 ? '100%' : `${maxScaledWidth}px`;
                    pagesContainer.style.minWidth = currentScale <= 1 ? '100%' : `${maxScaledWidth}px`;
                    pagesContainer.style.alignItems = 'center';
                    wrapper.style.width = '100%';
                    wrapper.style.height = '100%';
                    wrapper.style.overflow = 'auto';
                });

                return true;
            }

            // Aplicar escala (mantiene comportamiento previo para frames/otros y mejora imágenes)
            function applyScale(scale) {
                const zoomKind = previewContent.dataset.zoomKind || '';
                if (zoomKind === 'static' || zoomKind === 'none') {
                    currentScale = 1.0;
                    updateZoomLabel();
                    syncPanAvailability(previewContent.querySelector('.preview-zoom-wrapper'));
                    return;
                }

                currentScale = Math.max(MIN_SCALE, Math.min(MAX_SCALE, scale));
                updateZoomLabel();
                syncPanAvailability(previewContent.querySelector('.preview-zoom-wrapper'));

                const primary = findPrimary();
                if (!primary || !primary.el) return;

                // --- Imagenes: aplicamos transform scale y ajustamos wrapper para permitir panning ---


                // --- Imágenes: escalamos cambiando el width (no transform) para que el layout genere scroll natural ---
                if (primary.isImage) {
                    let img = primary.el;
                    const wrapper = primary.wrapper || (img && img.parentElement && img.parentElement.classList && img.parentElement.classList.contains('preview-zoom-wrapper')
                        ? img.parentElement
                        : ensureWrapperIfNeeded());
                    const stage = wrapper ? (wrapper.querySelector('.preview-image-stage') || img.parentElement) : null;

                    if (!img || !wrapper || !stage) return;

                    const baseW = parseFloat(stage.dataset.baseWidth || img.dataset.baseWidth || img.naturalWidth || img.clientWidth || 0) || 1;
                    const baseH = parseFloat(stage.dataset.baseHeight || img.dataset.baseHeight || img.naturalHeight || img.clientHeight || 0) || 1;
                    const innerBaseW = parseFloat(img.dataset.innerBaseWidth || baseW) || baseW;
                    const innerBaseH = parseFloat(img.dataset.innerBaseHeight || baseH) || baseH;
                    const rotation = (((parseFloat(img.dataset.rotation || stage.dataset.rotation || '0') || 0) % 360) + 360) % 360;
                    img.dataset.baseWidth = baseW.toString();
                    img.dataset.baseHeight = baseH.toString();
                    img.dataset.innerBaseWidth = innerBaseW.toString();
                    img.dataset.innerBaseHeight = innerBaseH.toString();
                    stage.dataset.baseWidth = baseW.toString();
                    stage.dataset.baseHeight = baseH.toString();
                    stage.dataset.rotation = rotation.toString();

                    preserveWrapperScroll(wrapper, () => {
                        const scaledW = Math.max(120, Math.round(baseW * currentScale));
                        const scaledH = Math.max(120, Math.round(baseH * currentScale));
                        const innerScaledW = Math.max(120, Math.round(innerBaseW * currentScale));
                        const innerScaledH = Math.max(120, Math.round(innerBaseH * currentScale));

                        stage.style.width = `${scaledW}px`;
                        stage.style.height = `${scaledH}px`;
                        stage.style.minWidth = currentScale <= 1 ? '' : `${scaledW}px`;
                        stage.style.minHeight = `${scaledH}px`;
                        stage.style.position = 'relative';

                        img.style.transition = 'none';
                        img.style.transform = `translate(-50%, -50%) rotate(${rotation}deg)`;
                        img.style.display = 'block';
                        img.style.boxSizing = 'border-box';
                        img.style.position = 'absolute';
                        img.style.top = '50%';
                        img.style.left = '50%';
                        img.style.width = `${innerScaledW}px`;
                        img.style.height = `${innerScaledH}px`;
                        img.style.maxWidth = 'none';
                        img.style.maxHeight = 'none';
                        img.style.objectFit = 'contain';

                        wrapper.style.width = '100%';
                        wrapper.style.height = '100%';
                        wrapper.style.overflow = 'auto';
                        wrapper.style.boxSizing = 'border-box';
                    });

                    if (currentScale === 1) {
                        wrapper.scrollLeft = 0;
                        wrapper.scrollTop = 0;
                    }
                    syncPanAvailability(wrapper);
                    return;
                }


                // --- Iframes / objetos: mantén la lógica previa (escalado del wrapper) ---
                if (primary.isFrame || primary.isWrapper) {
                    let wrapper = primary.wrapper || previewContent.querySelector('.preview-zoom-wrapper');
                    if (!wrapper) wrapper = ensureWrapperIfNeeded();
                    if (!wrapper) return;

                    if (syncPdfScale(wrapper)) {
                        syncPanAvailability(wrapper);
                        return;
                    }

                    // Para iframes/embeds, escalamos el wrapper (no usar transform en el iframe)
                    wrapper.style.width  = '100%';
                    wrapper.style.height = '100%';

                    const inner = wrapper.firstElementChild;
                    if (inner && (inner.tagName === 'IFRAME' || inner.tagName === 'EMBED' || inner.tagName === 'OBJECT')) {
                        inner.style.width  = '100%';
                        inner.style.height = '100%';
                        inner.style.transform = 'none';
                    } else if (inner) {
                        // si el inner es contenido HTML, aplicamos transform para que escale proporcionalmente
                        inner.style.transform      = `scale(${currentScale})`;
                        inner.style.transformOrigin = 'top left';
                        const rect = inner.getBoundingClientRect();
                        wrapper.style.width  = (rect.width * currentScale) + 'px';
                        wrapper.style.height = (rect.height * currentScale) + 'px';
                    }
                    syncPanAvailability(wrapper);
                    return;
                }

                // --- Fallback: si no encaja, intentamos escalar wrapper si existe ---
                let wrapper = previewContent.querySelector('.preview-zoom-wrapper');
                if (!wrapper) wrapper = ensureWrapperIfNeeded();
                if (!wrapper) return;
                wrapper.style.width  = (currentScale * 100) + '%';
                wrapper.style.height = 'auto';
                syncPanAvailability(wrapper);
            }

            // Acciones de zoom
            function zoomIn()    { applyScale(currentScale + STEP); }
            function zoomOut()   { applyScale(currentScale - STEP); }
            function zoomReset() { applyScale(1.0); }

            // Handlers para rueda+Ctrl y teclas
            function wheelHandler(e) {
                if (!e.ctrlKey && !e.metaKey) return;
                e.preventDefault();
                e.stopPropagation();
                (e.deltaY < 0) ? zoomIn() : zoomOut();
            }

            function keyHandler(e) {
                const tag = (document.activeElement && document.activeElement.tagName) || '';
                if (['INPUT','TEXTAREA','SELECT'].includes(tag)) return;
                const zoomModifier = e.ctrlKey || e.metaKey;
                const isZoomIn = e.key === '+' || e.code === 'NumpadAdd' || (zoomModifier && e.key === '=');
                const isZoomOut = e.key === '-' || e.code === 'NumpadSubtract';
                const isZoomReset = e.key === '0';
                if (isZoomIn) { e.preventDefault(); zoomIn(); }
                else if (isZoomOut) { e.preventDefault(); zoomOut(); }
                else if (isZoomReset) { e.preventDefault(); zoomReset(); }
            }

            // Panning (drag) — funciona con wrapper (overflow: auto)
                   let isDown = false, startX = 0, startY = 0, scrollLeft = 0, scrollTop = 0, previewScrollTop = 0, panWrapper = null;

            function startPan(e) {
                const wrapper = previewContent.querySelector('.preview-zoom-wrapper');
                if (!wrapper || !wrapper.classList.contains('is-pan-enabled')) return;
                panWrapper = wrapper;
                isDown = true;
                previewContent.classList.add('is-dragging');
                wrapper.classList.remove('is-grab');
                wrapper.classList.add('is-grabbing');

                startX = (e.pageX || (e.touches && e.touches[0] && e.touches[0].pageX)) || 0;
                startY = (e.pageY || (e.touches && e.touches[0] && e.touches[0].pageY)) || 0;
                scrollLeft = panWrapper.scrollLeft;
                scrollTop  = panWrapper.scrollTop;
                previewScrollTop = previewContent.scrollTop;

                e.preventDefault && e.preventDefault();
            }

            function movePan(e) {
                if (!isDown || !panWrapper) return;
                const x = (e.pageX || (e.touches && e.touches[0] && e.touches[0].pageX)) || 0;
                const y = (e.pageY || (e.touches && e.touches[0] && e.touches[0].pageY)) || 0;
                panWrapper.scrollLeft = scrollLeft - (x - startX);
                if (panWrapper.scrollHeight > panWrapper.clientHeight) {
                    panWrapper.scrollTop = scrollTop - (y - startY);
                } else {
                    previewContent.scrollTop = previewScrollTop - (y - startY);
                }
            }

            function endPan() {
                if (!isDown) return;
                isDown = false;
                const wrapper = panWrapper || previewContent.querySelector('.preview-zoom-wrapper');
                if (wrapper) {
                    wrapper.classList.remove('is-grabbing');
                    syncPanAvailability(wrapper);
                }
                previewContent.classList.remove('is-dragging');
                panWrapper = null;
            }

            // Listeners
            if (zoomInBtn)    zoomInBtn.addEventListener('click', (e) => { e.preventDefault(); zoomIn(); });
            if (zoomOutBtn)   zoomOutBtn.addEventListener('click', (e) => { e.preventDefault(); zoomOut(); });
            if (zoomResetBtn) zoomResetBtn.addEventListener('click', (e) => { e.preventDefault(); zoomReset(); });

            previewContent.addEventListener('wheel', wheelHandler, { passive: false });
            window.addEventListener('keydown', keyHandler, false);

            // Mouse panning
            previewContent.addEventListener('mousedown', (e) => { if (e.button === 0) startPan(e); });
            previewContent.addEventListener('mousemove', movePan);
            window.addEventListener('mouseup', endPan);

            // Touch panning
            previewContent.addEventListener('touchstart', (e) => startPan(e), { passive: false });
            previewContent.addEventListener('touchmove',  (e) => movePan(e), { passive: false });
            previewContent.addEventListener('touchend',   endPan);

            // API pública (conservadora: si ya existe la dejamos)
            window.NexusPreviewZoom = window.NexusPreviewZoom || {};
            window.NexusPreviewZoom.setScale = (s) => applyScale(s);
            window.NexusPreviewZoom.zoomIn = zoomIn;
            window.NexusPreviewZoom.zoomOut = zoomOut;
            window.NexusPreviewZoom.reset = zoomReset;
            window.NexusPreviewZoom.getScale = () => currentScale;

            updateZoomLabel();
        })();
    </script>

    <script>
        // Protecciones extra en cliente para evitar que listeners existentes activen acciones
        (function () {
            const hasChat = @(hasChat.ToString().ToLower());
            if (!hasChat) {
                const ta = document.getElementById('chatInput');
                const btn = document.getElementById('sendChat');

                if (ta) {
                    // asegurar que no se pueda editar por ningún medio y que no reciba eventos útiles
                    ta.readOnly = true;
                    ta.disabled = true;
                    ta.setAttribute('aria-disabled', 'true');
                    ta.placeholder = 'Opción no disponible';
                    // bloquear eventos que intenten insertar texto o enviar
                    const stopAll = e => { e.preventDefault(); e.stopImmediatePropagation(); };
                    ta.addEventListener('input', e => { e.target.value = ''; }, true);
                    ta.addEventListener('keydown', stopAll, true);
                    ta.addEventListener('paste', stopAll, true);
                    ta.addEventListener('cut', stopAll, true);
                    ta.addEventListener('drop', stopAll, true);
                    ta.addEventListener('focus', () => ta.blur(), true);
                }

                if (btn) {
                    btn.disabled = true;
                    btn.setAttribute('aria-disabled', 'true');
                    btn.style.pointerEvents = 'none';
                    // Capturamos clicks en fase de captura para evitar que cualquier listener posterior se ejecute
                    const stopClick = e => { e.preventDefault(); e.stopImmediatePropagation(); };
                    btn.addEventListener('click', stopClick, true);
                    btn.addEventListener('mousedown', stopClick, true);
                    btn.addEventListener('keydown', stopClick, true);
                }
            }
        })();
    </script>


}

@functions {
    private static (string Message, string Attachments) SplitRequestText(string? requestText)
    {
        if (string.IsNullOrWhiteSpace(requestText))
            return (string.Empty, string.Empty);

        var decoded = System.Net.WebUtility.HtmlDecode(requestText);

        var attachmentMatches = System.Text.RegularExpressions.Regex.Matches(
            decoded,
            @"<div[^>]*class\s*=\s*[""'][^""']*chat-request-attachments[^""']*[""'][^>]*>(.*?)</div>",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.Singleline);

        var attachments = attachmentMatches
            .Select(match => match.Groups[1].Value)
            .Select(value => System.Text.RegularExpressions.Regex.Replace(value, @"<br\s*/?>", "\n", System.Text.RegularExpressions.RegexOptions.IgnoreCase))
            .Select(value => System.Text.RegularExpressions.Regex.Replace(value, @"<[^>]+>", string.Empty, System.Text.RegularExpressions.RegexOptions.IgnoreCase))
            .Select(value => System.Net.WebUtility.HtmlDecode(value).Trim())
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .ToList();

        var cleaned = System.Text.RegularExpressions.Regex.Replace(decoded, @"<br\s*/?>", "\n", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        cleaned = System.Text.RegularExpressions.Regex.Replace(cleaned, @"</(div|p|li|tr|h\d)>", "\n", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        cleaned = System.Text.RegularExpressions.Regex.Replace(cleaned, @"<[^>]+>", string.Empty, System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        cleaned = System.Net.WebUtility.HtmlDecode(cleaned);

        var lines = cleaned
            .Replace("\r", string.Empty)
            .Split('\n', StringSplitOptions.RemoveEmptyEntries)
            .Select(line => line.Trim())
            .Where(line => !string.IsNullOrWhiteSpace(line))
            .ToList();

        var inlineAttachmentLines = lines
            .Where(line => System.Text.RegularExpressions.Regex.IsMatch(line, @"^adjuntos?\s+temporales?:", System.Text.RegularExpressions.RegexOptions.IgnoreCase))
            .ToList();

        if (inlineAttachmentLines.Count > 0)
            attachments.AddRange(inlineAttachmentLines);

        var message = string.Join("\n", lines.Where(line =>
            !System.Text.RegularExpressions.Regex.IsMatch(line, @"^adjuntos?\s+temporales?:", System.Text.RegularExpressions.RegexOptions.IgnoreCase)));

        return (message.Trim(), string.Join(" • ", attachments.Distinct(StringComparer.OrdinalIgnoreCase)));
    }

    public static string RenderRequestBubble(string? requestText)
    {
        var (message, attachments) = SplitRequestText(requestText);
        if (string.IsNullOrWhiteSpace(message) && string.IsNullOrWhiteSpace(attachments))
            return string.Empty;

        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(message))
        {
            parts.Add($"<div>{System.Net.WebUtility.HtmlEncode(message).Replace("\n", "<br>")}</div>");
        }

        if (!string.IsNullOrWhiteSpace(attachments))
        {
            parts.Add($"<div class=\"chat-request-attachments\">{System.Net.WebUtility.HtmlEncode(attachments)}</div>");
        }

        return string.Join(string.Empty, parts);
    }

    private static string NormalizeResponseMarkdown(string markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown)) return string.Empty;

        var decodedMarkdown = System.Net.WebUtility.HtmlDecode(markdown).Trim();
        if (decodedMarkdown.Contains("```")) return decodedMarkdown;

        if (TryFormatJsonMarkdown(decodedMarkdown, out var formattedJson))
        {
            return $"```json\n{formattedJson}\n```";
        }

        return decodedMarkdown;
    }

    private static bool TryFormatJsonMarkdown(string content, out string formattedJson)
    {
        formattedJson = string.Empty;
        var trimmed = (content ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(trimmed)) return false;
        if (!(trimmed.StartsWith("{") || trimmed.StartsWith("["))) return false;

        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(trimmed);
            formattedJson = System.Text.Json.JsonSerializer.Serialize(
                document.RootElement,
                new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
            return true;
        }
        catch
        {
            return false;
        }
    }

    private static string ResolveRenderPreviewSource(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return string.Empty;

        var raw = text.Trim();
        var decoded = System.Net.WebUtility.HtmlDecode(raw).Trim();

        foreach (var candidate in new[] { raw, decoded }.Where(value => !string.IsNullOrWhiteSpace(value)))
        {
            if (TryExtractEmbeddedMarkdown(candidate!, out var extracted) && !string.IsNullOrWhiteSpace(extracted))
            {
                return extracted;
            }
        }

        return decoded;
    }

    private static bool TryExtractEmbeddedMarkdown(string content, out string extractedMarkdown)
    {
        extractedMarkdown = string.Empty;
        var trimmed = (content ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(trimmed)) return false;
        if (!(trimmed.StartsWith("{") || trimmed.StartsWith("["))) return false;

        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(trimmed);
            extractedMarkdown = FindEmbeddedMarkdown(document.RootElement) ?? string.Empty;
            return !string.IsNullOrWhiteSpace(extractedMarkdown);
        }
        catch
        {
            return false;
        }
    }

    private static string? FindEmbeddedMarkdown(System.Text.Json.JsonElement element)
    {
        switch (element.ValueKind)
        {
            case System.Text.Json.JsonValueKind.Object:
                foreach (var property in element.EnumerateObject())
                {
                    if (string.Equals(property.Name, "Markdown", StringComparison.OrdinalIgnoreCase) &&
                        property.Value.ValueKind == System.Text.Json.JsonValueKind.String)
                    {
                        var value = property.Value.GetString()?.Trim();
                        if (!string.IsNullOrWhiteSpace(value))
                            return value;
                    }
                }

                foreach (var property in element.EnumerateObject())
                {
                    var nested = FindEmbeddedMarkdown(property.Value);
                    if (!string.IsNullOrWhiteSpace(nested))
                        return nested;
                }
                break;

            case System.Text.Json.JsonValueKind.Array:
                foreach (var item in element.EnumerateArray())
                {
                    var nested = FindEmbeddedMarkdown(item);
                    if (!string.IsNullOrWhiteSpace(nested))
                        return nested;
                }
                break;
        }

        return null;
    }

    private static string EncodeCopyPayload(string? text)
    {
        if (string.IsNullOrEmpty(text))
            return string.Empty;

        return Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(text));
    }

    public string RenderMarkdown(string markdown)
    {
        if (string.IsNullOrEmpty(markdown)) return string.Empty;
        var pipeline = new MarkdownPipelineBuilder()
            .UseAdvancedExtensions()
            .UseSoftlineBreakAsHardlineBreak()
            .Build();

        var normalizedMarkdown = NormalizeResponseMarkdown(markdown);
        var html = Markdig.Markdown.ToHtml(normalizedMarkdown, pipeline);

        // 1. Eliminar pares completos <script>...</script>, <style>...</style>, etc.
        html = System.Text.RegularExpressions.Regex.Replace(
            html,
            @"<\s*(script|style|iframe|object|embed|textarea|button|select|form)[^>]*>.*?<\s*/\s*\1\s*>",
            string.Empty,
            System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.Singleline);

        html = System.Text.RegularExpressions.Regex.Replace(
            html,
            @"<\s*input\b[^>]*\/?>",
            string.Empty,
            System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.Singleline);

        // 2. Eliminar etiquetas <script> o </script> sueltas que el parser del browser
        //    interpreta como inicio/fin de un script element, corrompiendo toda la página.
        html = System.Text.RegularExpressions.Regex.Replace(
            html,
            @"<\s*/?\s*script[^>]*>",
            string.Empty,
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        // 3. Eliminar atributos de evento on*
        html = System.Text.RegularExpressions.Regex.Replace(
            html,
            @"\son\w+\s*=\s*(""[^""]*""|'[^']*'|[^\s>]+)",
            string.Empty,
            System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.Singleline);

        // 4. Eliminar href/src con javascript:
        html = System.Text.RegularExpressions.Regex.Replace(
            html,
            @"\b(href|src)\s*=\s*(""|')\s*javascript:[^""']*\2",
            "$1=\"#\"",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        return html;
    }
}
