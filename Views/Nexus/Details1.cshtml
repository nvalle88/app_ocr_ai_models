                        }

                        downloadTextFile(`${buildConversationFileBaseName()}.md`, markdown);
                    });
                }

                async function downloadCurrentModalPdf(button = null) {
                    const markdown = (currentMarkdownDownload.content || '').trim();
                    if (!markdown) {
                        throw new Error('No hay contenido renderizado para exportar.');
                    }

                    const pdfFilename = (currentMarkdownDownload.filename || buildRenderDownloadFileName()).replace(/\.md$/i, '.pdf');
                    return exportMarkdownPdfDocument({
                        button,
                        busyHtml: '<i class="fa-solid fa-spinner fa-spin me-1"></i> Generando PDF...',
                        filename: pdfFilename,
                        title: 'Respuesta renderizada del chat',
                        subtitle: 'Versión exportada del contenido interpretado desde la respuesta original.',
                        markdown,
                        metaItems: buildExportMetaItems()
                    });
                }

                function areSameProcessCodes(left, right) {
                    return (left || '').toString().trim().toLowerCase() === (right || '').toString().trim().toLowerCase();
                }

                function getBaseComposerProcess() {
                    return {
                        code: baseProcessCode,
                        name: baseProcessName,
                        description: 'Proceso con el que se está trabajando actualmente en este caso.',
                        isCurrent: true
                    };
                }

                function normalizeComposerProcessEntry(entry) {
                    const code = (entry?.code ?? entry?.Code ?? entry?.processId ?? entry?.ProcessId ?? '').toString().trim();
                    if (!code) return null;

                    return {
                        code,
                        name: (entry?.name ?? entry?.Name ?? entry?.processName ?? entry?.ProcessName ?? code).toString().trim(),
                        description: (entry?.description ?? entry?.Description ?? entry?.processDescription ?? entry?.ProcessDescription ?? 'Proceso disponible para esta conversación.').toString().trim(),
                        agentProcessId: (entry?.agentProcessId ?? entry?.AgentProcessId ?? entry?.processAgentId ?? entry?.ProcessAgentId ?? '').toString().trim(),
                        isCurrent: typeof entry?.isCurrent === 'boolean'
                            ? entry.isCurrent
                            : areSameProcessCodes(code, baseProcessCode)
                    };
                }

                function getComposerProcessCatalog() {
                    const baseProcess = getBaseComposerProcess();
                    const seen = new Set();
                    const items = [baseProcess];
                    seen.add((baseProcess.code || '').toString().trim().toLowerCase());

                    composerProcesses.forEach(process => {
                        const normalized = normalizeComposerProcessEntry(process);
                        if (!normalized) return;
                        const key = normalized.code.toLowerCase();
                        if (seen.has(key)) return;
                        seen.add(key);
                        items.push(normalized);
                    });

                    return items;
                }

                function updateProcessPickerButton() {
                    if (!processPickerBtn || !processPickerLabel) return;

                    const activeProcess = getActiveComposerProcess();
                    const label = (activeProcess.name || baseProcessName || 'Proceso actual').toString().trim();
                    processPickerLabel.textContent = label;
                    processCombo?.classList.toggle('is-override', !!selectedComposerProcess);
                    processPickerBtn.classList.toggle('is-override', !!selectedComposerProcess);
                    processPickerBtn.title = activeProcess.description || label;
                    if (processExecuteBtn) {
                        processExecuteBtn.title = `Ejecutar este caso con ${label}`;
                        processExecuteBtn.setAttribute('aria-label', `Ejecutar este caso con ${label}`);
                        processExecuteBtn.classList.toggle('is-override', !!selectedComposerProcess);
                    }
                }

                function renderProcessMenuOptions(state = 'ready') {
                    if (!chatProcessMenuList) return;

                    const activeProcess = getActiveComposerProcess();
                    const isLoading = state === 'loading';
                    const hasError = state === 'error';

                    if (isLoading) {
                        if (chatProcessMenuHint) {
                            chatProcessMenuHint.textContent = 'Cargando procesos autorizados...';
                        }
                        chatProcessMenuList.innerHTML = `
                            <div class="chat-process-menu-state">
                                <i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i>
                                <span>Cargando procesos autorizados...</span>
                            </div>`;
                        return;
                    }

                    if (hasError) {
                        if (chatProcessMenuHint) {
                            chatProcessMenuHint.textContent = 'No se pudieron cargar los procesos. Seguimos con el actual.';
                        }
                        chatProcessMenuList.innerHTML = `
                            <div class="chat-process-menu-state is-error">
                                <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                                <span>${escapeHtml(composerProcessLoadError || 'No se pudieron cargar los procesos autorizados.')}</span>
                            </div>`;
                        return;
                    }

                    const catalog = getComposerProcessCatalog();
                    const alternativeCount = Math.max(0, catalog.filter(process => !process.isCurrent).length);

                    if (chatProcessMenuHint) {
                        chatProcessMenuHint.textContent = selectedComposerProcess
                            ? `Proceso listo. Pulsa ejecutar para correr este caso con ${activeProcess.name}.`
                            : alternativeCount > 0
                                ? `Selecciona un proceso y luego pulsa ejecutar. Hay ${alternativeCount} alternativa${alternativeCount === 1 ? '' : 's'} disponible${alternativeCount === 1 ? '' : 's'}.`
                                : 'Solo está disponible el proceso actual del caso.';
                    }

                    if (!catalog.length) {
                        chatProcessMenuList.innerHTML = `
                            <div class="chat-process-menu-state is-empty">
                                <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                                <span>No hay procesos configurados para este usuario.</span>
                            </div>`;
                        return;
                    }

                    chatProcessMenuList.innerHTML = catalog.map(process => {
                        const isActive = process.isCurrent
                            ? !selectedComposerProcess
                            : areSameProcessCodes(activeProcess.code, process.code);
                        const badge = isActive
                            ? 'Activo'
                            : 'Elegir';
                        const description = process.description || (process.isCurrent
                            ? 'Proceso actual del caso.'
                            : 'Proceso disponible para esta conversación.');

                        return `
                            <button type="button"
                                    class="chat-process-option${isActive ? ' is-active' : ''}${process.isCurrent ? ' is-current' : ''}"
                                    data-process-code="${escapeHtml(process.code)}"
                                    data-process-name="${escapeHtml(process.name)}"
                                    data-process-description="${escapeHtml(description)}"
                                    data-process-agent-id="${escapeHtml(process.agentProcessId || '')}"
                                    data-process-current="${process.isCurrent ? 'true' : 'false'}"
                                    aria-pressed="${isActive ? 'true' : 'false'}">
                                <span class="chat-process-option-copy">
                                    <strong>${escapeHtml(process.name)}</strong>
                                    <small>${escapeHtml(description)}</small>
                                </span>
                                <span class="chat-process-option-meta">
                                    <span class="chat-process-option-badge">${escapeHtml(badge)}</span>
                                    ${isActive ? '<i class="fa-solid fa-check" aria-hidden="true"></i>' : '<i class="fa-solid fa-chevron-right" aria-hidden="true"></i>'}
                                </span>
                            </button>`;
                    }).join('');
                }

                function ensureComposerProcesses(force = false) {
                    if (!chatProcessMenuList) {
                        return Promise.resolve([]);
                    }

                    if (composerProcessesLoaded && !force) {
                        renderProcessMenuOptions();
                        return Promise.resolve(composerProcesses);
                    }

                    if (composerProcessLoadPromise && !force) {
                        return composerProcessLoadPromise;
                    }

                    composerProcessLoadError = '';
                    renderProcessMenuOptions('loading');

                    composerProcessLoadPromise = fetch(getProcessesUrl, {
                        method: 'GET',
                        headers: { 'Accept': 'application/json' }
                    })
                        .then(async response => {
                            if (!response.ok) {
                                throw new Error(response.statusText || 'No se pudieron consultar los procesos.');
                            }

                            return response.json();
                        })
                        .then(payload => {
                            const rows = Array.isArray(payload)
                                ? payload
                                : (Array.isArray(payload?.processes) ? payload.processes : (Array.isArray(payload?.Processes) ? payload.Processes : []));

                            composerProcesses = rows
                                .map(normalizeComposerProcessEntry)
                                .filter(Boolean)
                                .sort((left, right) => (left?.name || '').localeCompare((right?.name || '').toString(), 'es', { sensitivity: 'base' }));
                            composerProcessesLoaded = true;
                            composerProcessLoadError = '';
                            renderProcessMenuOptions();
                            return composerProcesses;
                        })
                        .catch(error => {
                            console.error('composer processes load error', error);
                            composerProcesses = [];
                            composerProcessesLoaded = false;
                            composerProcessLoadError = error?.message || 'No se pudieron cargar los procesos autorizados.';
                            renderProcessMenuOptions('error');
                            return [];
                        })
                        .finally(() => {
                            composerProcessLoadPromise = null;
                        });

                    return composerProcessLoadPromise;
                }

                function setAttachMenu(open) {
                    if (!attachTransientBtn || !chatAttachMenu) return;

                    const shouldOpen = !!open;
                    if (shouldOpen) {
                        setProcessMenu(false);
                    }

                    attachTransientBtn.classList.toggle('is-open', shouldOpen);
                    attachTransientBtn.setAttribute('aria-expanded', shouldOpen ? 'true' : 'false');
                    chatAttachMenu.hidden = !shouldOpen;
                }

                function setProcessMenu(open) {
                    if (!processPickerBtn || !chatProcessMenu) return;

                    const shouldOpen = !!open;
                    if (shouldOpen) {
                        setAttachMenu(false);
                    }

                    processCombo?.classList.toggle('is-open', shouldOpen);
                    processPickerBtn.classList.toggle('is-open', shouldOpen);
                    processPickerBtn.setAttribute('aria-expanded', shouldOpen ? 'true' : 'false');
                    chatProcessMenu.hidden = !shouldOpen;

                    if (shouldOpen) {
                        renderProcessMenuOptions(composerProcessesLoaded ? 'ready' : 'loading');
                        ensureComposerProcesses();
                    }
                }

                function openTransientFilePicker(mode = 'file') {
                    if (!chatFilesInput) return;

                    chatFilesInput.accept = mode === 'image' ? transientImageAccept : transientFileAccept;
                    chatFilesInput.click();
                }

                function buildAgentProcessPreview(agentName, message) {
                    const cleanAgent = (agentName || '').toString().trim();
                    const cleanMessage = (message || '').toString().trim();

                    if (cleanMessage) {
                        return cleanAgent
                            ? `Procesar con ${cleanAgent}\n\n${cleanMessage}`
                            : cleanMessage;
                    }

                    return cleanAgent
                        ? `Procesar con ${cleanAgent}`
                        : 'Procesar con un flujo puntual';
                }

                function getActiveComposerProcess() {
                    return selectedComposerProcess || getBaseComposerProcess();
                }

                function setSelectedComposerProcess(processInfo = null) {
                    if (processInfo?.code && !areSameProcessCodes(processInfo.code, baseProcessCode)) {
                        selectedComposerProcess = {
                            code: (processInfo.code || '').toString().trim(),
                            name: (processInfo.name || processInfo.processName || 'Otro proceso').toString().trim(),
                            description: (processInfo.description || processInfo.processDescription || 'Proceso seleccionado para esta conversación.').toString().trim(),
                            agentProcessId: (processInfo.agentProcessId || processInfo.processAgentId || '').toString().trim()
                        };
                    } else {
                        selectedComposerProcess = null;
                    }

                    updateProcessPickerButton();
                    renderProcessMenuOptions(composerProcessLoadError ? 'error' : (composerProcessesLoaded ? 'ready' : 'loading'));
                }

                function buildChatSendPayload(message) {
                    if (selectedComposerProcess?.code && !areSameProcessCodes(selectedComposerProcess.code, baseProcessCode)) {
                        return buildPromptPayload('CHAT', message, {
                            processCode: selectedComposerProcess.code,
                            id: parseInt(selectedComposerProcess.agentProcessId || '0', 10) || 0
                        });
                    }

                    return buildPromptPayload('CHAT', message);
                }

                function buildImplicitProcessExecutionPrompt(processName) {
                    const cleanName = (processName || 'proceso actual').toString().trim();
                    return `Ejecuta el analisis completo de este caso usando ${cleanName} y genera la respuesta final.`;
                }

                function isComposerBusy() {
                    return !!sendBtn?.classList.contains('loading');
                }

                async function dispatchComposerRequest(options = {}) {
                    const forceProcessExecution = !!options.forceProcessExecution;
                    const text = textarea?.value?.trim() || '';
                    if (!text && transientAttachments.length === 0 && !forceProcessExecution) return;
                    if (isComposerBusy()) return;

                    let pendingTurn = null;
                    try {
                        setBtnLoading(true);
                        const activeProcess = getActiveComposerProcess();
                        const requestPreview = (selectedComposerProcess || forceProcessExecution)
                            ? buildAgentProcessPreview(activeProcess.name, text || '')
                            : (text || '');
                        const payloadText = text || (forceProcessExecution
                            ? buildImplicitProcessExecutionPrompt(activeProcess.name)
                            : '');

                        pendingTurn = createPendingConversationTurn(requestPreview);
                        const minDelay = 700, maxDelay = 1600;
                        const randomDelay = Math.floor(Math.random() * (maxDelay - minDelay + 1)) + minDelay;
                        await sleep(randomDelay);

                        await stabilizePositionDuringTransition(900);
                        const resp = await fetch('@Url.Action("EjecutarPrompt", "Nexus")', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(buildChatSendPayload(payloadText))
                        });

                        setBtnLoading(false);

                        if (!resp.ok) throw new Error(resp.statusText);
                        const data = await resp.json();
                        const normalizedRequestText = ((data.request ?? data.requestText ?? data.RequestText ?? payloadText) || '').toString();
                        const normalizedDisplayText = text ? normalizedRequestText : '';
                        const normalizedData = (selectedComposerProcess || forceProcessExecution)
                            ? {
                                ...data,
                                request: buildAgentProcessPreview(activeProcess.name, normalizedDisplayText),
                                requestText: buildAgentProcessPreview(activeProcess.name, normalizedDisplayText),
                                RequestText: buildAgentProcessPreview(activeProcess.name, normalizedDisplayText)
                            }
                            : data;

                        await appendConversationTurn(normalizedData, 7, pendingTurn);

                        textarea.value = '';
                        clearTransientAttachments();
                        autoResize(textarea);
                        try { textarea.focus({ preventScroll: true }); } catch (e) { textarea.focus(); }
                    } catch (err) {
                        console.error(err);
                        setBtnLoading(false);
                        setConversationTurnError(pendingTurn, err && err.message ? err.message : 'Error en la petición');
                        Swal.fire({
                            icon: 'warning',
                            title: 'Advertencia',
                            text: 'Error: ' + (err && err.message ? err.message : 'Error en la petición'),
                        });
                    } finally {
                        stopThinking();
                        positionChatInput();
                    }
                }

                async function executeSelectedProcessNow() {
                    await dispatchComposerRequest({ forceProcessExecution: true });
                }

                async function runAgentProcess(trigger) {
                    if (!trigger?.dataset?.agentprocessid) return;

                    const message = textarea?.value?.trim() || '';
                    const agentName = (
                        trigger.dataset.agentName ||
                        trigger.getAttribute('aria-label') ||
                        trigger.title ||
                        'otro agente'
                    ).trim();
                    const thinking = startThinking();
                    let pendingTurn = null;

                    try {
                        setAttachMenu(false);
                        setProcessMenu(false);
                        setBtnLoading(true);
                        trigger.disabled = true;
                        trigger.classList.add('loading', 'is-loading');
                        trigger.setAttribute('aria-busy', 'true');

                        pendingTurn = createPendingConversationTurn(buildAgentProcessPreview(agentName, message));

                        await stabilizePositionDuringTransition(900);
                        const resp = await fetch('@Url.Action("EjecutarPrompt", "Nexus")', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(buildPromptPayload('BUTTON', message, { id: trigger.dataset.agentprocessid }))
                        });

                        if (!resp.ok) throw new Error(resp.statusText || 'Error en la petición');
                        const data = await resp.json();
                        await appendConversationTurn(data, 4, pendingTurn);

                        const ta = q('#chatInput');
                        if (ta) {
                            ta.value = '';
                            clearTransientAttachments();
                            try { autoResize(ta); } catch (e) {}
                            try { ta.focus({ preventScroll: true }); } catch (e) { ta.focus(); }
                        }
                    } catch (err) {
                        console.error('agent process error', err);
                        setConversationTurnError(pendingTurn, err && err.message ? err.message : 'Error en la petición');
                        Swal.fire({
                            icon: 'warning',
                            title: 'Advertencia',
                            text: 'Error al procesar el caso: ' + (err && err.message ? err.message : 'Error en la petición'),
                        });
                    } finally {
                        trigger.disabled = false;
                        trigger.classList.remove('loading', 'is-loading');
                        trigger.setAttribute('aria-busy', 'false');
                        setBtnLoading(false);
                        stopThinking(thinking);
                        positionChatInput();
                    }
                }

                function openChatMarkdownModal(responseSource, preferredMarkdownSource = '') {
                    const resolved = resolveMarkdownRenderSource(responseSource);
                    const preferred = decodeHtmlEntities(preferredMarkdownSource || '').trim();
                    const markdown = (preferred || resolved.content || '').trim();
                    if (!chatMarkdownModal || !chatMarkdownModalContent || !markdown) return;

                    setMarkdownDownloadState(markdown);
                    chatMarkdownModalContent.innerHTML = renderMarkdownHtml(markdown);
                    chatMarkdownModalMeta.textContent = resolved.fromJson
                        ? 'Se construyó una vista markdown a partir del JSON completo de la respuesta.'
                        : 'Vista interpretada directamente desde la respuesta original del chat.';
                    chatMarkdownModal.classList.remove('d-none');
                    chatMarkdownModal.setAttribute('aria-hidden', 'false');
                    document.body.classList.add('chat-markdown-modal-open');
                }

                function closeChatMarkdownModal() {
                    if (!chatMarkdownModal) return;
                    chatMarkdownModal.classList.add('d-none');
                    chatMarkdownModal.setAttribute('aria-hidden', 'true');
                    document.body.classList.remove('chat-markdown-modal-open');
                    setMarkdownDownloadState('');
                    if (chatMarkdownModalContent) {
                        chatMarkdownModalContent.innerHTML = '';
                    }
                }

                function ensureChatOutput() {
                    if (chatOutputEl) return chatOutputEl;

                    const resultPanel = q('.result-panel');
                    if (!resultPanel) return null;

                    resultPanel.innerHTML = '<div id="chatOutput" class="chat-thread"></div>';
                    chatOutputEl = q('#chatOutput');
                    enhanceMarkdownContent(chatOutputEl);
                    return chatOutputEl;
                }

                window.NexusDetails1Exports = {
                    downloadConversationPdf,
                    downloadConversationMarkdown
                };

                closeChatMarkdownModal();
                window.addEventListener('pageshow', () => closeChatMarkdownModal());

                document.addEventListener('click', async (event) => {
                    const renderBtn = event.target.closest('.chat-render-btn');
                    if (renderBtn) {
                        const responseWrap = renderBtn.closest('.chat-turn-response');
                        const copyBtn = responseWrap?.querySelector('.chat-copy-btn');
                        const responseBody = responseWrap?.querySelector('.chat-turn-response-body');
                        const responseSource = (
                            decodeBase64Utf8(renderBtn.dataset.renderSource) ||
                            decodeBase64Utf8(copyBtn?.dataset.copySource) ||
                            responseBody?.innerText ||
                            ''
                        ).trim();
                        openChatMarkdownModal(responseSource);
                        return;
                    }

                    const copyBtn = event.target.closest('.chat-copy-btn');
                    if (!copyBtn) return;

                    const responseWrap = copyBtn.closest('.chat-turn-response');
                    const responseBody = responseWrap?.querySelector('.chat-turn-response-body');
                    const textToCopy = (decodeBase64Utf8(copyBtn.dataset.copySource) || responseBody?.innerText || '').trim();

                    if (!textToCopy) {
                        return;
                    }

                    await copyTextToClipboard(copyBtn, textToCopy);
                });

                chatMarkdownModalClose?.addEventListener('click', closeChatMarkdownModal);
                chatMarkdownModalDownloadPdf?.addEventListener('click', async () => {
                    try {
                        await downloadCurrentModalPdf(chatMarkdownModalDownloadPdf);
                    } catch (err) {
                        console.error('modal pdf export error', err);
                        Swal.fire({
                            icon: 'warning',
                            title: 'Advertencia',
                            text: 'No se pudo descargar el PDF renderizado: ' + (err && err.message ? err.message : err),
                        });
                    }
                });
                chatMarkdownModalDownload?.addEventListener('click', () => {
                    if (!currentMarkdownDownload.content) return;
                    downloadTextFile(currentMarkdownDownload.filename, currentMarkdownDownload.content);
                });
                chatMarkdownModalDismiss?.addEventListener('click', closeChatMarkdownModal);
                chatMarkdownModal?.addEventListener('click', event => {
                    if (!event.target.classList.contains('chat-markdown-modal-backdrop')) return;
                    closeChatMarkdownModal();
                });
                attachTransientBtn?.addEventListener('click', event => {
                    event.preventDefault();
                    event.stopPropagation();
                    setAttachMenu(chatAttachMenu?.hidden);
                });

                chatAttachAnyOption?.addEventListener('click', event => {
                    event.preventDefault();
                    setAttachMenu(false);
                    openTransientFilePicker('file');
                });

                processPickerBtn?.addEventListener('click', event => {
                    event.preventDefault();
                    event.stopPropagation();
                    setProcessMenu(chatProcessMenu?.hidden);
                });

                chatProcessMenu?.addEventListener('click', event => {
                    const option = event.target.closest('.chat-process-option');
                    if (!option) return;

                    event.preventDefault();

                    if (option.dataset.processCurrent === 'true' || areSameProcessCodes(option.dataset.processCode, baseProcessCode)) {
                        setSelectedComposerProcess(null);
                    } else {
                        setSelectedComposerProcess({
                            code: option.dataset.processCode,
                            name: option.dataset.processName,
                            description: option.dataset.processDescription,
                            agentProcessId: option.dataset.processAgentId
                        });
                    }

                    setProcessMenu(false);
                    try { textarea?.focus({ preventScroll: true }); } catch (e) { textarea?.focus(); }
                });

                processExecuteBtn?.addEventListener('click', async event => {
                    event.preventDefault();
                    event.stopPropagation();
                    setProcessMenu(false);
                    setAttachMenu(false);
                    await executeSelectedProcessNow();
                });

                document.addEventListener('click', event => {
                    const target = event.target;

                    if (!chatAttachMenu?.hidden) {
                        if (!(chatAttachMenu.contains(target) || attachTransientBtn?.contains(target))) {
                            setAttachMenu(false);
                        }
                    }

                    if (!chatProcessMenu?.hidden) {
                        if (!(chatProcessMenu.contains(target) || processPickerBtn?.contains(target))) {
                            setProcessMenu(false);
                        }
                    }
                });
                window.addEventListener('keydown', event => {
                    if (event.key !== 'Escape') return;
                    if (!chatAttachMenu?.hidden) setAttachMenu(false);
                    if (!chatProcessMenu?.hidden) setProcessMenu(false);
                    if (chatMarkdownModal?.classList.contains('d-none')) return;
                    closeChatMarkdownModal();
                });

                function setDocumentFocus(enabled) {
                    const applyDesktopFocus = !!enabled && !window.matchMedia('(max-width: 991px)').matches;
                    document.documentElement.classList.toggle('document-focus', applyDesktopFocus);
                    document.documentElement.classList.toggle('right-hidden', applyDesktopFocus);
                    if (colRight) {
                        colRight.setAttribute('aria-hidden', applyDesktopFocus ? 'true' : 'false');
                    }
                    positionChatInput();
                    syncSplitterAccessibility();
                }

                function setSourcesStatus(text, tone = 'muted') {
                    if (!sourcesStatusEl) return;
                    sourcesStatusEl.textContent = text || '';
                    sourcesStatusEl.className = tone === 'error' ? 'text-danger' : tone === 'success' ? 'text-success' : 'text-muted';
                }

                function getPersistentUploadStages(file) {
                    const type = getDocumentType(file.name?.split('.').pop() || '');
                    if (type === 'markup') {
                        return ['Validando formato', 'Guardando contenido', 'Actualizando expediente'];
                    }
                    return ['Preparando archivo', 'Subiendo archivo', 'Extrayendo texto', 'Actualizando expediente'];
                }

                function clearPersistentUploadTicker() {
                    if (persistentUploadTicker) {
                        clearInterval(persistentUploadTicker);
                        persistentUploadTicker = null;
                    }
                }

                function cleanupPersistentUploadDrafts() {
                    persistentUploadDrafts.forEach(item => {
                        if (item.previewUrl) {
                            try { URL.revokeObjectURL(item.previewUrl); } catch (e) { /* ignore */ }
                        }
                    });
                    persistentUploadDrafts = [];
                    clearPersistentUploadTicker();
                    renderPersistentUploadQueue();
                }

                function renderPersistentUploadQueue() {
                    if (!persistentUploadQueueEl) return;

                    persistentUploadQueueEl.innerHTML = '';
                    if (!persistentUploadDrafts.length) {
                        persistentUploadQueueEl.classList.add('d-none');
                        return;
                    }

                    persistentUploadDrafts.forEach(item => {
                        const article = document.createElement('article');
                        article.className = `upload-draft-card is-${item.state}`;

                        const thumb = item.previewUrl
                            ? `<img src="${item.previewUrl}" alt="${escapeHtml(item.fileName)}" class="upload-draft-thumb-image" />`
                            : `<span class="upload-draft-thumb-icon"><i class="fa ${getDocumentIcon(item.type, item.extension)}"></i></span>`;

                        article.innerHTML = `
                            <div class="upload-draft-thumb">${thumb}</div>
                            <div class="upload-draft-copy">
                                <div class="upload-draft-name">${escapeHtml(item.fileName)}</div>
                                <div class="upload-draft-status-row">
                                    <span class="upload-draft-status">${escapeHtml(item.status)}</span>
                                    <span class="upload-draft-badge">${escapeHtml(item.badge)}</span>
                                </div>
                                <div class="upload-draft-progress">
                                    <span class="upload-draft-progress-bar"></span>
                                </div>
                            </div>`;

                        persistentUploadQueueEl.appendChild(article);
                    });

                    persistentUploadQueueEl.classList.remove('d-none');
                }

                function startPersistentUploadTicker() {
                    clearPersistentUploadTicker();
                    persistentUploadTicker = setInterval(() => {
                        let hasActive = false;
                        persistentUploadDrafts = persistentUploadDrafts.map(item => {
                            if (item.state !== 'uploading') return item;
                            hasActive = true;
                            const nextIndex = (item.stageIndex + 1) % item.stages.length;
                            return {
                                ...item,
                                stageIndex: nextIndex,
                                status: item.stages[nextIndex]
                            };
                        });
                        renderPersistentUploadQueue();
                        if (!hasActive) clearPersistentUploadTicker();
                    }, 1600);
                }

                function beginPersistentUploadPreview(files) {
                    cleanupPersistentUploadDrafts();
                    persistentUploadDrafts = Array.from(files || []).map((file, index) => {
                        const extension = '.' + (file.name.split('.').pop() || '').toLowerCase();
                        const type = getDocumentType(extension);
                        const stages = getPersistentUploadStages(file);
                        return {
                            id: `${Date.now()}-${index}`,
                            fileName: file.name,
                            extension,
                            type,
                            previewUrl: type === 'img' ? URL.createObjectURL(file) : '',
                            stages,
                            stageIndex: 0,
                            status: stages[0],
                            badge: type === 'markup' ? 'Sin OCR' : 'OCR',
                            state: 'uploading'
                        };
                    });
                    renderPersistentUploadQueue();
                    startPersistentUploadTicker();
                }

                function finishPersistentUploadPreview(success = true) {
                    clearPersistentUploadTicker();
                    persistentUploadDrafts = persistentUploadDrafts.map(item => ({
                        ...item,
                        state: success ? 'done' : 'error',
                        status: success ? 'Documento integrado al caso' : 'No se pudo integrar',
                        badge: success ? 'Listo' : 'Error'
                    }));
                    renderPersistentUploadQueue();
                    setTimeout(() => cleanupPersistentUploadDrafts(), success ? 1800 : 2600);
                }

                async function writeTextToClipboard(text) {
                    if (navigator.clipboard?.writeText) {
                        try {
                            await navigator.clipboard.writeText(text);
                            return true;
                        } catch (err) {
                            console.warn('clipboard api unavailable, trying fallback', err);
                        }
                    }

                    const helper = document.createElement('textarea');
                    helper.value = text;
                    helper.setAttribute('readonly', 'readonly');
                    helper.style.position = 'fixed';
                    helper.style.top = '-9999px';
                    helper.style.opacity = '0';
                    document.body.appendChild(helper);
                    helper.focus();
                    helper.select();

                    try {
                        return document.execCommand('copy');
                    } finally {
                        helper.remove();
                    }
                }

                async function copyTextToClipboard(button, text) {
                    if (!text) return;

                    const original = button.innerHTML;
                    try {
                        const copied = await writeTextToClipboard(text);
                        if (!copied) {
                            throw new Error('No fue posible copiar el contenido.');
                        }
                        button.classList.add('is-copied');
                        button.innerHTML = '<i class="fa-solid fa-check"></i><span>Copiado</span>';
                    } catch (err) {
                        console.error('copy error', err);
                        button.classList.add('is-copied');
                        button.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i><span>Error</span>';
                    } finally {
                        window.setTimeout(() => {
                            button.classList.remove('is-copied');
                            button.innerHTML = original;
                        }, 1600);
                    }
                }

                function scrollResultAreaToBottom(container) {
                    try {
                        if (container) {
                            container.scrollTop = container.scrollHeight;
                        }
                    } catch (e) { /* ignore */ }
                }

                function buildPendingRequestText(message) {
                    const parts = [];
                    const cleanMessage = (message || '').trim();
                    if (cleanMessage) {
                        parts.push(cleanMessage);
                    }

                    const attachedNames = transientAttachments
                        .map(item => item?.fileName)
                        .filter(Boolean);

                    if (attachedNames.length) {
                        parts.push(`Adjuntos temporales: ${attachedNames.join(', ')}`);
                    }

                    return parts.join('\n\n').trim();
                }

                function mountInlineThinkingState(container) {
                    if (!container) return null;

                    const phases = [
                        {
                            label: 'Analizando expediente',
                            detail: 'Leyendo el contexto del caso y la consulta enviada.',
                            activeStep: 0
                        },
                        {
                            label: 'Contrastando documentos',
                            detail: 'Buscando señales relevantes dentro del material disponible.',
                            activeStep: 1
                        },
                        {
                            label: 'Organizando hallazgos',
                            detail: 'Priorizando lo importante para responder con claridad.',
                            activeStep: 2
                        },
                        {
                            label: 'Redactando respuesta',
                            detail: 'Preparando una salida breve, precisa y utilizable.',
                            activeStep: 3
                        }
                    ];

                    container.innerHTML = `
                        <div class="chat-live-state" aria-live="polite" aria-atomic="true">
                            <div class="chat-live-state-head">
                                <span class="chat-live-state-badge">
                                    <i class="fa-solid fa-brain" aria-hidden="true"></i>
                                    <span>Nexus</span>
                                </span>
                                <span class="chat-live-state-status">Analizando expediente...</span>
                            </div>
                            <div class="chat-live-state-detail">Leyendo el contexto del caso y la consulta enviada.</div>
                            <div class="chat-live-state-steps" role="list" aria-label="Progreso de respuesta">
                                <span class="chat-live-state-step is-active" role="listitem">Contexto</span>
                                <span class="chat-live-state-step" role="listitem">Documentos</span>
                                <span class="chat-live-state-step" role="listitem">Hallazgos</span>
                                <span class="chat-live-state-step" role="listitem">Respuesta</span>
                            </div>
                            <div class="chat-live-state-lines" aria-hidden="true">
                                <span></span>
                                <span></span>
                                <span></span>
                            </div>
                        </div>`;

                    const statusEl = container.querySelector('.chat-live-state-status');
                    const detailEl = container.querySelector('.chat-live-state-detail');
                    const steps = Array.from(container.querySelectorAll('.chat-live-state-step'));
                    let phaseIndex = 0;

                    function paintPhase(index) {
                        const phase = phases[index] || phases[0];
                        if (statusEl) statusEl.textContent = `${phase.label}...`;
                        if (detailEl) detailEl.textContent = phase.detail;
                        steps.forEach((step, currentIndex) => {
                            step.classList.toggle('is-active', currentIndex === phase.activeStep);
                            step.classList.toggle('is-complete', currentIndex < phase.activeStep);
                        });
                    }

                    paintPhase(phaseIndex);
                    const interval = window.setInterval(() => {
                        phaseIndex = (phaseIndex + 1) % phases.length;
                        paintPhase(phaseIndex);
                    }, 1450);

                    return {
                        stop() {
                            try { clearInterval(interval); } catch (e) { /* ignore */ }
                        }
                    };
                }

                function isStaticRevealNode(node) {
                    if (!node || node.nodeType !== Node.ELEMENT_NODE) return false;
                    return node.matches('pre, table, img, video, audio, iframe, object, embed, svg, canvas, hr')
                        || !!node.querySelector('pre, table, img, video, audio, iframe, object, embed, svg, canvas, hr');
                }

                async function typeTextNodeInto(parent, text, token, speed, scrollHost) {
                    const source = (text || '').toString();
                    if (!source) return;

                    const textNode = document.createTextNode('');
                    parent.appendChild(textNode);

                    const tokens = source.match(/\S+\s*|\s+/g) || [source];
                    const chunkSize = speed >= 7 ? 8 : speed >= 6 ? 6 : speed >= 5 ? 5 : speed >= 4 ? 4 : 3;
                    const delay = Math.max(10, 44 - (speed * 4));

                    for (let index = 0; index < tokens.length; index += chunkSize) {
                        if (token !== __typeToken) return;
                        textNode.textContent += tokens.slice(index, index + chunkSize).join('');
                        scrollResultAreaToBottom(scrollHost);
                        if (index + chunkSize < tokens.length) {
                            await sleep(delay);
                        }
                    }
                }

                async function revealNodeInto(parent, node, token, speed, scrollHost) {
                    if (!node || token !== __typeToken) return;

                    if (node.nodeType === Node.TEXT_NODE) {
                        await typeTextNodeInto(parent, node.textContent || '', token, speed, scrollHost);
                        return;
                    }

                    if (node.nodeType !== Node.ELEMENT_NODE) return;

                    if (isStaticRevealNode(node)) {
                        const clone = node.cloneNode(true);
                        clone.classList?.add('chat-stream-block');
                        parent.appendChild(clone);
                        scrollResultAreaToBottom(scrollHost);
                        await sleep(Math.max(24, 68 - (speed * 4)));
                        return;
                    }

                    const clone = node.cloneNode(false);
                    clone.classList?.add('chat-stream-fragment');
                    parent.appendChild(clone);

                    for (const child of Array.from(node.childNodes)) {
                        if (token !== __typeToken) return;
                        await revealNodeInto(clone, child, token, speed, scrollHost);
                    }
                }

                function createPendingConversationTurn(message) {
                    const thread = ensureChatOutput();
                    if (!thread) return null;

                    thread.closest('.result-panel')?.querySelector('.alert')?.remove();

                    const article = document.createElement('article');
                    article.className = 'chat-turn chat-turn-live chat-turn-pending';

                    const requestPreview = buildPendingRequestText(message);
                    if (requestPreview) {
                        const requestEl = document.createElement('div');
                        requestEl.className = 'chat-turn-request';
                        requestEl.innerHTML = renderRequestHtml(requestPreview);
                        article.appendChild(requestEl);
                    }

                    const responseEl = document.createElement('div');
                    responseEl.className = 'chat-turn-response is-pending';

                    const actionsEl = document.createElement('div');
                    actionsEl.className = 'chat-turn-response-actions';
                    actionsEl.hidden = true;
                    actionsEl.innerHTML = `
                        <button type="button" class="chat-copy-btn" title="Copiar respuesta" aria-label="Copiar respuesta">
                            <i class="fa-regular fa-copy"></i><span>Copiar</span>
                        </button>
                        <button type="button" class="chat-render-btn" title="Renderizar markdown" aria-label="Renderizar markdown">
                            <i class="fa-solid fa-wand-magic-sparkles"></i><span>Renderizar</span>
                        </button>`;

                    const responseBodyEl = document.createElement('div');
                    responseBodyEl.className = 'chat-turn-response-body';
                    const liveState = mountInlineThinkingState(responseBodyEl);

                    responseEl.appendChild(actionsEl);
                    responseEl.appendChild(responseBodyEl);
                    article.appendChild(responseEl);

                    const metaEl = document.createElement('div');
                    metaEl.className = 'chat-turn-meta';
                    metaEl.textContent = 'Nexus está preparando la respuesta...';
                    article.appendChild(metaEl);

                    thread.appendChild(article);
                    scrollResultAreaToBottom(thread.closest('.result-area'));

                    return {
                        article,
                        responseEl,
                        responseBodyEl,
                        actionsEl,
                        metaEl,
                        liveState
                    };
                }

                function setConversationTurnError(turn, message) {
                    if (!turn) return;
                    turn.liveState?.stop?.();
                    turn.article?.classList.remove('chat-turn-pending');
                    turn.responseEl.classList.remove('is-pending');
                    turn.responseEl.classList.add('is-error');
                    turn.actionsEl.hidden = true;
                    turn.responseBodyEl.innerHTML = `
                        <div class="chat-response-error">
                            <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
                            <span>${escapeHtml(message || 'No se pudo completar la respuesta.')}</span>
                        </div>`;
                    turn.metaEl.textContent = 'No se pudo completar la respuesta';
                }

                function makeCaseFilePayload(file) {
                    return new Promise((resolve, reject) => {
                        const reader = new FileReader();
                        reader.onload = () => resolve({
                            FileName: file.name,
                            Content: (reader.result || '').toString().split(',')[1] || '',
                            Extension: '.' + (file.name.split('.').pop() || '').toLowerCase()
                        });
                        reader.onerror = () => reject(new Error(`No se pudo leer ${file.name}.`));
                        reader.readAsDataURL(file);
                    });
                }

                async function filesToPayload(fileList) {
                    return Promise.all(Array.from(fileList || []).map(makeCaseFilePayload));
                }

                function renderTransientAttachments() {
                    if (!chatAttachmentsEl) return;

                    chatAttachmentsEl.innerHTML = '';
                    if (!transientAttachments.length) {
                        chatAttachmentsEl.classList.add('d-none');
                        return;
                    }

                    transientAttachments.forEach((file, index) => {
                        const attachmentType = getDocumentType(file.extension);
                        const chip = document.createElement('button');
                        chip.type = 'button';
                        chip.className = 'attachment-chip';
                        chip.innerHTML = `
                            <span class="attachment-chip-name">
                                <i class="fa ${getDocumentIcon(attachmentType, file.extension)}"></i>
                                ${file.fileName}
                            </span>
                            <span class="attachment-chip-remove" aria-hidden="true"><i class="fa fa-times"></i></span>`;
                        chip.addEventListener('click', () => {
                            transientAttachments = transientAttachments.filter((_, currentIndex) => currentIndex !== index);
                            renderTransientAttachments();
                            positionChatInput();
                        });
                        chatAttachmentsEl.appendChild(chip);
                    });

                    chatAttachmentsEl.classList.remove('d-none');
                }

                function clearTransientAttachments() {
                    transientAttachments = [];
                    if (chatFilesInput) chatFilesInput.value = '';
                    renderTransientAttachments();
                }

                function createSourceRow(file) {
                    const tr = document.createElement('tr');
                    const type = (file.type || getDocumentType(file.extension)).toLowerCase();
                    const ext = ((file.extension || '').replace('.', '') || 'DOC').toUpperCase();
                    const iconClass = getDocumentIcon(type, file.extension);

                    tr.className = 'source-row';
                    tr.dataset.id = file.id ?? '';
                    tr.dataset.url = file.url ?? '';
                    tr.dataset.type = type;
                    tr.dataset.ext = (file.extension ?? '').replace('.', '');
                    tr.title = file.originalName || file.url || 'Documento';
                    tr.style.cursor = 'pointer';
                    tr.innerHTML = `
                        <td style="width:56px; padding:.5rem;">
                            <div class="thumb-wrap">
                                ${type === 'img'
                                    ? `<img src="${file.url || ''}" class="thumb-img" onerror="this.style.display='none'; this.parentElement.innerHTML='<i class=&quot;fa ${iconClass}&quot;></i>';" />`
                                    : `<i class="fa ${iconClass} fa-lg"></i>`}
                            </div>
                        </td>
                        <td class="align-middle">
                            <div class="fw-semibold text-truncate">${file.originalName || file.url || 'Documento'}</div>
                            <small class="text-muted">${ext}</small>
                        </td>
                        <td class="text-end align-middle" style="width:36px;">
                            <i class="fa fa-chevron-right text-muted"></i>
                        </td>`;

                    return tr;
