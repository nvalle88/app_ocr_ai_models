@model app_tramites.Models.ViewModel.QueryInput
@using app_tramites.Models.ModelAi
@using app_tramites.Models.ViewModel

@{
    ViewData["Title"] = "Nexus";

    var casePage = ViewBag.ProcessCasePage as ViewPagedProcessCases ?? new ViewPagedProcessCases();
    var processCases = casePage.Items ?? [];

    bool IsEvaluated(ProcessCase currentCase) => currentCase.FinalResponseResults?.Any() ?? false;

    string BuildShortCaseCode(Guid caseCode)
    {
        var raw = caseCode.ToString() ?? string.Empty;
        var shortCode = raw.Split('-').FirstOrDefault() ?? raw;
        return $"NE-{shortCode}";
    }

    string ResolveCaseCategory(ProcessCase currentCase)
    {
        if (!IsEvaluated(currentCase))
        {
            return "No Evaluado";
        }

        var text = string.Join(" ", currentCase.FinalResponseResults.Select(r => r.ResponseText?.ToLowerInvariant() ?? string.Empty));

        if (text.Contains("**hospital del dia**") || text.Contains("**hospital del día**"))
            return "Hospital del dia";
        if (text.Contains("**hospitalario**"))
            return "Hospitalario";
        if (text.Contains("**ambulatorio**"))
            return "Ambulatorio";
        return "No Definido";
    }

    (string Icon, string Tone) ResolveTypeVisual(string category) => category switch
    {
        "Hospital del dia" => ("fa-hospital", "primary"),
        "Hospitalario" => ("fa-briefcase-medical", "info"),
        "Ambulatorio" => ("fa-stethoscope", "warning"),
        "No Definido" => ("fa-circle-question", "danger"),
        _ => ("fa-wave-square", "muted")
    };

    var totalCases = casePage.TotalCount;
    var evaluatedCases = casePage.EvaluatedCount;
    var pendingCases = casePage.PendingCount;
    var totalProcesses = casePage.ProcessCount;
    var pageNumber = casePage.PageNumber;
    var pageSize = casePage.PageSize;
    var totalPages = casePage.TotalPages;
    var pageItemStart = casePage.PageItemStart;
    var pageItemEnd = casePage.PageItemEnd;
    var pageSizeOptions = new[] { 8, 10, 15, 20, 30 };
    var pagerStart = Math.Max(1, pageNumber - 2);
    var pagerEnd = Math.Min(totalPages, pagerStart + 4);
    if (pagerEnd - pagerStart < 4)
    {
        pagerStart = Math.Max(1, pagerEnd - 4);
    }

    var processOptions = casePage.AvailableProcesses?.Count > 0
        ? casePage.AvailableProcesses
        : processCases
            .Select(x => x.DefinitionCodeNavigation?.Name?.Trim())
            .OfType<string>()
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .OrderBy(x => x)
            .ToList();
    var currentSearch = casePage.SearchTerm ?? string.Empty;
    var currentStatus = casePage.StatusFilter ?? string.Empty;
    var currentType = casePage.TypeFilter ?? string.Empty;
    var currentProcess = casePage.ProcessFilter ?? string.Empty;
    var currentPeriod = casePage.PeriodFilter ?? string.Empty;
}

<section id="widget-grid" class="nexus-index-page">
    <div class="nexus-index-grid">
        <article class="nexus-card nexus-create-card">
            <div class="nexus-card-head">
                <div>
                    <span class="section-kicker">Crear caso</span>
                    <h2>Ingreso inteligente de expedientes</h2>
                    <p>Selecciona un proceso, adjunta documentos y monitorea la preparacion del caso paso a paso.</p>
                    <div class="creation-signal-bar" aria-label="Capacidades del flujo">
                        <span class="creation-signal-pill">
                            <i class="fa-solid fa-cloud-arrow-up"></i>
                            Carga segura
                        </span>
                        <span class="creation-signal-pill">
                            <i class="fa-solid fa-file-waveform"></i>
                            OCR guiado
                        </span>
                        <span class="creation-signal-pill">
                            <i class="fa-solid fa-list-check"></i>
                            Trazabilidad inmediata
                        </span>
                    </div>
                </div>
                <div id="processSelectedIndicator" class="process-selected-indicator d-none" aria-live="polite">
                    <i class="fa-solid fa-circle-check"></i>
                    <span>Proceso activo: <strong id="processSelectedName"></strong></span>
                </div>
            </div>

            <div class="create-case-layout">
                <section class="nexus-subpanel process-panel">
                    <div class="subpanel-head">
                        <div>
                            <span class="subpanel-step">Paso 1</span>
                            <h3>Proceso de auditoria</h3>
                        </div>
                        <span class="subpanel-caption">Seleccion dinamica por usuario</span>
                    </div>
                    <p class="subpanel-description">
                        Cada proceso define el criterio del OCR y la evaluacion posterior del caso.
                    </p>
                    <div id="processContainer" class="process-chip-grid" aria-live="polite">
                        <div class="process-loading-card">
                            <i class="fa-solid fa-atom fa-spin"></i>
                            <span>Cargando procesos autorizados...</span>
                        </div>
                    </div>
                </section>

                <section class="nexus-subpanel upload-panel">
                    <div class="subpanel-head">
                        <div>
                            <span class="subpanel-step">Paso 2</span>
                            <h3>Documentos del expediente</h3>
                        </div>
                        <span id="uploadMeta" class="subpanel-caption">Agrega archivos para habilitar la creacion del caso</span>
                    </div>

                    <form id="ocrForm" novalidate autocomplete="off" class="create-case-form">
                        <input type="hidden" asp-for="ProcessCode" value="" />

                        <div class="upload-stage-grid">
                            <button type="button"
                                    id="uploadArea"
                                    class="upload-dropzone"
                                    aria-label="Arrastra o haz clic aqui para subir archivos">
                                <div class="upload-dropzone-icon">
                                    <i class="fa-solid fa-cloud-arrow-up"></i>
                                </div>
                                <div class="upload-dropzone-copy">
                                    <strong>Arrastra documentos o haz clic para seleccionar</strong>
                                    <span>PDF, JPG, JPEG, PNG, XML y HTML. Preparamos el expediente, enviamos al OCR cuando aplica y registramos el caso al terminar.</span>
                                </div>
                                <span id="fileCountBadge" class="upload-count-badge d-none"></span>
                            </button>

                            <div class="preview-stage">
                                <div class="preview-stage-head">
                                    <div>
                                        <strong>Vista previa de carga</strong>
                                        <small>Confirma rapidamente lo que entrara al caso.</small>
                                    </div>
                                    <button id="btnClearUpload" type="button" class="btn btn-outline-secondary btn-sm">
                                        <i class="fa-solid fa-rotate-left me-1"></i>
                                        Limpiar
                                    </button>
                                </div>
                                <div id="previewGallery" class="preview-gallery" aria-live="polite">
                                    <div class="preview-gallery-empty">
                                        <i class="fa-solid fa-inbox"></i>
                                        <span>Aun no hay archivos listos para procesar.</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <input type="file"
                               id="files"
                               class="nexus-hidden-file-input"
                               multiple
                               accept=".pdf,.jpg,.jpeg,.png,.webp,.bmp,.tif,.tiff,.xml,.html,.htm"
                               tabindex="-1"
                               aria-hidden="true"
                               hidden />

                        <div class="create-case-actions">
                            <div class="create-case-hint">
                                <i class="fa-solid fa-shield-heart"></i>
                                <span>La creacion del expediente organiza los archivos, registra el caso y deja el procesamiento listo para auditar.</span>
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg create-case-btn" id="btnCrearCaso" disabled>
                                <i class="fa-solid fa-wand-magic-sparkles me-2"></i>
                                Crear caso
                            </button>
                        </div>
                    </form>
                </section>
            </div>
        </article>

        <article id="casesSection" class="nexus-card nexus-table-card">
            <div class="nexus-card-head">
                <div>
                    <span class="section-kicker">Casos existentes</span>
                    <h2>Monitoreo del backlog</h2>
                    <p>Filtra, procesa y entra al detalle de cada expediente desde una tabla optimizada para trabajo operativo.</p>
                </div>
                <div class="table-head-meta">
                    <span class="results-meta-pill" id="casesResultsMeta">
                        @(totalCases > 0 ? $"{processCases.Count} casos en esta página" : "Aun no hay casos cargados")
                    </span>
                    <label class="page-size-field" for="pageSizeSelect">
                        <span>Por página</span>
                        <select id="pageSizeSelect">
                            @foreach (var sizeOption in pageSizeOptions)
                            {
                                <option value="@sizeOption" selected="@(sizeOption == pageSize ? "selected" : null)">@sizeOption</option>
                            }
                        </select>
                    </label>
                </div>
            </div>

            <div class="table-toolbar">
                <label class="filter-field filter-search-field">
                    <span class="filter-field-icon"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input id="filterSearch" type="search" placeholder="Buscar por codigo, proceso, estado o tipo" value="@currentSearch" />
                </label>

                <div class="filter-group">
                    <label class="filter-field">
                        <span>Estado</span>
                        <select id="filterStatus">
                            <option value="" selected="@(string.IsNullOrWhiteSpace(currentStatus) ? "selected" : null)">Todos</option>
                            <option value="evaluado" selected="@(currentStatus == "evaluado" ? "selected" : null)">Evaluado</option>
                            <option value="pendiente" selected="@(currentStatus == "pendiente" ? "selected" : null)">Pendiente</option>
                            <option value="error" selected="@(currentStatus == "error" ? "selected" : null)">Error</option>
                        </select>
                    </label>

                    <label class="filter-field">
                        <span>Tipo</span>
                        <select id="filterType">
                            <option value="" selected="@(string.IsNullOrWhiteSpace(currentType) ? "selected" : null)">Todos</option>
                            <option value="ambulatorio" selected="@(currentType == "ambulatorio" ? "selected" : null)">Ambulatorio</option>
                            <option value="hospitalario" selected="@(currentType == "hospitalario" ? "selected" : null)">Hospitalario</option>
                            <option value="hospital del dia" selected="@(currentType == "hospital del dia" ? "selected" : null)">Hospital del dia</option>
                            <option value="no definido" selected="@(currentType == "no definido" ? "selected" : null)">No Definido</option>
                            <option value="no evaluado" selected="@(currentType == "no evaluado" ? "selected" : null)">No Evaluado</option>
                        </select>
                    </label>

                    <label class="filter-field">
                        <span>Proceso</span>
                        <select id="filterProcess">
                            <option value="" selected="@(string.IsNullOrWhiteSpace(currentProcess) ? "selected" : null)">Todos los procesos</option>
                            @foreach (var processName in processOptions)
                            {
                                <option value="@processName" selected="@(currentProcess == processName ? "selected" : null)">@processName</option>
                            }
                        </select>
                    </label>

                    <label class="filter-field">
                        <span>Periodo</span>
                        <select id="filterPeriod">
                            <option value="" selected="@(string.IsNullOrWhiteSpace(currentPeriod) ? "selected" : null)">Todo el historial visible</option>
                            <option value="today" selected="@(currentPeriod == "today" ? "selected" : null)">Hoy</option>
                            <option value="48h" selected="@(currentPeriod == "48h" ? "selected" : null)">Ultimas 48 horas</option>
                            <option value="7d" selected="@(currentPeriod == "7d" ? "selected" : null)">Ultimos 7 dias</option>
                        </select>
                    </label>

                    <button type="button" id="btnResetFilters" class="btn btn-outline-secondary filter-reset-btn">
                        <i class="fa-solid fa-filter-circle-xmark me-1"></i>
                        Limpiar filtros
                    </button>
                </div>
            </div>

            <div id="activeFiltersShell" class="active-filters-shell d-none" aria-live="polite">
                <div class="active-filters-head">
                    <span>Filtros activos</span>
                    <button type="button" id="btnResetFiltersInline" class="active-filters-reset">
                        Restablecer
                    </button>
                </div>
                <div id="activeFilterChips" class="active-filter-chips"></div>
            </div>

            <div class="table-shell">
                <div class="table-responsive">
                    <table id="casesTable" class="table nexus-cases-table mb-0">
                        <thead>
                            <tr>
                                <th>Caso</th>
                                <th>Recepcion</th>
                                <th>Proceso</th>
                                <th>Estado</th>
                                <th>Tipo</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="casesTableBody">
                            @foreach (var currentCase in processCases.OrderByDescending(x => x.StartDate))
                            {
                                var isDone = IsEvaluated(currentCase);
                                var category = ResolveCaseCategory(currentCase);
                                var typeVisual = ResolveTypeVisual(category);
                                var processName = currentCase.DefinitionCodeNavigation?.Name?.Trim() ?? "Proceso sin nombre";
                                var shortCaseCode = BuildShortCaseCode(currentCase.CaseCode);
                                var dateText = currentCase.StartDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
                                var rowStatus = isDone ? "evaluado" : "pendiente";
                                var rowSearch = $"{shortCaseCode} {processName} {category} {dateText}";

                                <tr class="case-row"
                                    data-case-code="@currentCase.CaseCode"
                                    data-case-label="@shortCaseCode"
                                    data-process-name="@processName"
                                    data-status="@rowStatus"
                                    data-type-label="@category"
                                    data-start-iso="@currentCase.StartDate.ToUniversalTime().ToString("o")"
                                    data-search="@rowSearch">
                                    <td data-label="Caso">
                                        <div class="case-identity">
                                            <strong class="case-code">@shortCaseCode</strong>
                                            <span class="case-support">Expediente OCR</span>
                                        </div>
                                    </td>
                                    <td data-label="Recepcion">
                                        <div class="case-date">@dateText</div>
                                        <span class="case-support">Ingreso local</span>
                                    </td>
                                    <td data-label="Proceso">
                                        <span class="table-process-pill">
                                            <i class="fa-solid fa-diagram-project"></i>
                                            <span>@processName</span>
                                        </span>
                                    </td>
                                    <td data-label="Estado" data-cell="status">
                                        @if (isDone)
                                        {
                                            <span class="status-pill is-evaluated">
                                                <i class="fa-solid fa-circle-check"></i>
                                                Evaluado
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-pill is-pending">
                                                <i class="fa-solid fa-hourglass-half"></i>
                                                Pendiente
                                            </span>
                                        }
                                    </td>
                                    <td data-label="Tipo" data-cell="type">
                                        <span class="type-pill tone-@typeVisual.Tone">
                                            <i class="fa-solid @typeVisual.Icon"></i>
                                            @category
                                        </span>
                                    </td>
                                    <td data-label="Acciones" data-cell="actions">
                                        <div class="table-actions">
                                            @if (isDone)
                                            {
                                                <button type="button"
                                                        class="btn btn-outline-primary btn-sm icon-action btnViewDetails"
                                                        data-nameproccess="@shortCaseCode"
                                                        data-casecode="@currentCase.CaseCode"
                                                        data-processcode=""
                                                        title="Ver detalles">
                                                    <i class="fa-solid fa-eye"></i>
                                                </button>
                                                <button type="button"
                                                        class="btn btn-success btn-sm icon-action btnProcessRow"
                                                        data-nameproccess="@shortCaseCode"
                                                        data-casecode="@currentCase.CaseCode"
                                                        data-processcode=""
                                                        title="Reprocesar">
                                                    <i class="fa-solid fa-rotate-right"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="btn btn-success btn-sm icon-action btnProcessRow"
                                                        data-nameproccess="@shortCaseCode"
                                                        data-casecode="@currentCase.CaseCode"
                                                        data-processcode=""
                                                        title="Procesar">
                                                    <i class="fa-solid fa-play"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }

                            <tr id="emptyCasesRow" class="table-empty-row @(totalCases > 0 ? "d-none" : "")">
                                <td colspan="6">
                                    <div class="table-empty-state">
                                        <i class="fa-solid fa-folder-open"></i>
                                        <div>
                                            <strong>No hay casos disponibles todavia</strong>
                                            <span>Crea el primer expediente desde el panel superior para comenzar a trabajar.</span>
                                        </div>
                                    </div>
                                </td>
                            </tr>

                            <tr id="filterEmptyRow" class="table-empty-row d-none">
                                <td colspan="6">
                                    <div class="table-empty-state">
                                        <i class="fa-solid fa-filter-circle-xmark"></i>
                                        <div>
                                            <strong>No hay coincidencias con los filtros actuales</strong>
                                            <span>Ajusta la busqueda o limpia los filtros para recuperar resultados.</span>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            @if (totalCases > 0)
            {
                <div class="table-pagination-shell">
                    <div class="table-pagination-meta">
                        <strong>Página @pageNumber de @totalPages</strong>
                        <span>@totalCases casos en los últimos @casePage.WindowDays días</span>
                    </div>

                    <nav class="table-pagination-nav" aria-label="Paginación de casos">
                        <a class="pagination-link @(casePage.HasPreviousPage ? string.Empty : "is-disabled")"
                           href="@(casePage.HasPreviousPage ? Url.Action("Index", "Nexus", new { page = pageNumber - 1, pageSize, windowDays = casePage.IsWindowed ? (int?)casePage.WindowDays : null, search = currentSearch, status = currentStatus, type = currentType, process = currentProcess, period = currentPeriod }) : "#")"
                           aria-disabled="@(!casePage.HasPreviousPage)">
                            <i class="fa-solid fa-chevron-left"></i>
                            Anterior
                        </a>

                        <div class="pagination-number-group">
                            @for (var pager = pagerStart; pager <= pagerEnd; pager++)
                            {
                                <a class="pagination-link pagination-number @(pager == pageNumber ? "is-current" : string.Empty)"
                                   href="@Url.Action("Index", "Nexus", new { page = pager, pageSize, windowDays = casePage.IsWindowed ? (int?)casePage.WindowDays : null, search = currentSearch, status = currentStatus, type = currentType, process = currentProcess, period = currentPeriod })">
                                    @pager
                                </a>
                            }
                        </div>

                        <a class="pagination-link @(casePage.HasNextPage ? string.Empty : "is-disabled")"
                           href="@(casePage.HasNextPage ? Url.Action("Index", "Nexus", new { page = pageNumber + 1, pageSize, windowDays = casePage.IsWindowed ? (int?)casePage.WindowDays : null, search = currentSearch, status = currentStatus, type = currentType, process = currentProcess, period = currentPeriod }) : "#")"
                           aria-disabled="@(!casePage.HasNextPage)">
                            Siguiente
                            <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    </nav>
                </div>
            }
        </article>
    </div>
</section>

<div id="creationWorkflowModal" class="creation-workflow-modal d-none" aria-hidden="true">
    <div class="creation-workflow-modal-backdrop"></div>
    <div class="creation-workflow-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="creationStageTitle">
        <div id="caseCreationWorkflow" class="creation-workflow d-none" aria-live="polite">
            <div class="creation-workflow-head">
                <div>
                    <span class="workflow-kicker">Seguimiento en vivo</span>
                    <h3 id="creationStageTitle">Preparando caso</h3>
                    <p id="creationStageDetail">Validando el proceso y los documentos seleccionados.</p>
                </div>
                <div class="creation-workflow-head-actions">
                    <span id="creationStageBadge" class="workflow-badge">En progreso</span>
                    <button id="btnCloseWorkflowModal" type="button" class="btn btn-outline-secondary btn-sm d-none">
                        <i class="fa-solid fa-xmark me-1"></i>
                        Cerrar
                    </button>
                </div>
            </div>

            <div class="creation-workflow-body">
                <div id="workflowProgressCard" class="row-processing-card" aria-live="polite">
                    <strong id="workflowCardTitle">Validando informacion de entrada</strong>
                    <span id="workflowCardDetail">Comprobando proceso, cantidad de archivos y formatos permitidos.</span>
                    <div class="row-processing-bar"><span id="workflowCardBar"></span></div>
                </div>

                <div id="creationWorkflowLog" class="creation-workflow-log"></div>
            </div>

            <div id="creationSuccessActions" class="creation-success-actions d-none" aria-live="polite">
                <div class="creation-success-copy">
                    <span class="workflow-kicker">Caso creado</span>
                    <h3 id="creationSuccessTitle">Expediente listo para auditoria</h3>
                    <p id="creationSuccessDetail">Puedes entrar al caso recien creado o seguir trabajando desde el listado.</p>
                </div>
                <div class="creation-success-buttons">
                    <a id="btnGoCreatedCase" href="#" class="btn btn-primary btn-lg">
                        <i class="fa-solid fa-arrow-up-right-from-square me-2"></i>
                        Ir al caso
                    </a>
                    <button id="btnStayOnIndex" type="button" class="btn btn-outline-secondary btn-lg">
                        <i class="fa-solid fa-table-list me-2"></i>
                        Seguir en Nexus
                    </button>
                </div>
            </div>

            <div id="aiAnalysisPanel" class="d-none" aria-live="polite">
                <div id="aiProgressCard" class="row-processing-card">
                    <strong id="aiCardTitle">Procesando expediente</strong>
                    <span id="aiCardDetail">Iniciando análisis del caso...</span>
                    <div class="row-processing-bar"><span id="aiCardBar"></span></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/app/nexus.index.css" />
}

@section Scripts {
    <script>
        window.nexusIndexConfig = {
            createCaseUrl: '@Url.Action("CreateCaseProcess", "Nexus")',
            processCaseUrl: '@Url.Action("ProcessCaseAjax", "Nexus")',
            processesUrl: '@Url.Action("GetProcessesByUser", "Nexus")',
            detailsUrlTemplate: '@Url.Action("Details1", "Nexus")?caseCode=__CASE__',
            indexUrl: '@Url.Action("Index", "Nexus")',
            currentPage: @pageNumber,
            pageSize: @pageSize,
            windowDays: @casePage.WindowDays,
            currentSearch: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(currentSearch)),
            currentStatus: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(currentStatus)),
            currentType: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(currentType)),
            currentProcess: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(currentProcess)),
            currentPeriod: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(currentPeriod)),
            totalCases: @totalCases,
            evaluatedCases: @evaluatedCases,
            pendingCases: @pendingCases,
            processCount: @totalProcesses
        };
    </script>
    <script src="~/js/app/nexus.index.js"></script>
}
