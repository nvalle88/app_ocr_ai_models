@model app_tramites.Models.ViewModel.QueryInput

@{
    ViewData["Title"] = "Demo OCR: Crear y Listar Casos";
}

<section id="widget-grid">
    <div class="row">
        <!-- Widget Subida OCR -->
        <article class="col-lg-12">
            <div class="jarviswidget jarviswidget-color-darken border-0 shadow rounded-4" id="wid-id-upload" data-widget-editbutton="false" data-widget-deletebutton="false">
                <header class="bg-primary text-white px-4 py-3 d-flex justify-content-between align-items-center rounded-top-4 shadow-sm">
                    <div class="d-flex align-items-center">
                        <i class="fa-solid fa-file-circle-plus fs-2 me-2"></i>
                        <h2 class="h5 mb-0 fw-bold">Crear caso</h2>
                    </div>
                    <div class="d-flex align-items-center">
                        <i class="fa-solid fa-robot fs-5 me-1"></i>
                        <span class="fw-semibold">Nexus AI Auditor</span>
                    </div>
                </header>

                <div>
                    <div class="widget-body p-4">
                        <!-- Selección de proceso -->
                        <div id="process-buttons" class="mb-4">
                            <h3 class="text-primary mb-3">Selecciona un Proceso</h3>
                            <div id="processContainer" class="d-flex flex-wrap gap-3">
                                <!-- Botones dinámicos se renderizan aquí -->
                            </div>
                            <!-- Indicador de proceso activo -->
                            <div id="processSelectedIndicator" class="process-selected-indicator d-none mt-3">
                                <i class="fa-solid fa-circle-check me-1"></i>
                                Proceso: <strong id="processSelectedName"></strong>
                            </div>
                        </div>

                        <form id="ocrForm" novalidate autocomplete="off">
                            <input type="hidden" asp-for="ProcessCode" value="" />
                            <div class="row g-4">
                                <div class="col-12 col-md-4 position-relative">
                                    <div id="uploadArea"
                                         class="border border-2 border-dashed border-secondary rounded-4 p-4 text-center bg-light"
                                         style="min-height:200px; transition: box-shadow .3s; cursor:pointer;"
                                         aria-label="Arrastra o haz clic aquí para subir archivos">
                                        <i class="fa fa-cloud-upload-alt fa-3x text-secondary mb-3"></i>
                                        <h6 class="fw-bold mb-2">Arrastra o haz clic aquí</h6>
                                        <small class="text-muted d-block mb-2">PDF, JPG, PNG • Hasta 10MB</small>
                                        <span id="fileCountBadge" class="badge bg-primary d-none"></span>
                                        <input type="file"
                                               id="files"
                                               multiple
                                               accept=".pdf,.jpg,.jpeg,.png"
                                               style="
                                              position: absolute;
                                              top: 0; left: 0;
                                              width: 100%; height: 100%;
                                              opacity: 0;
                                              cursor: pointer;
                                            " />
                                    </div>
                                </div>
                                <div class="col-12 col-md-8">
                                    <label class="form-label fw-semibold mb-2">Previsualizaciones</label>
                                    <div id="previewGallery"
                                         class="d-flex flex-row flex-nowrap gap-3 border p-2 rounded-4 bg-white overflow-auto"
                                         style="min-height:120px; max-height:140px;"></div>
                                </div>
                            </div>
                            <div class="form-actions mt-4">
                                <button type="submit" class="btn btn-primary btn-lg icon-action" id="btnCrearCaso" disabled>
                                    <i class="fas fa-plus-circle me-2"></i> Crear caso
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </article>

        <!-- Widget Tabla Casos -->
        <article class="col-lg-12">
            <div class="jarviswidget jarviswidget-color-darken border-0 shadow rounded-4" id="wid-id-table" data-widget-editbutton="false" data-widget-deletebutton="false">
                <header class="bg-primary text-white rounded-top-4 px-4 py-3">
                    <span class="widget-icon"><i class="fa fa-history"></i></span>
                    <h2 class="d-inline ms-2">Casos Existentes</h2>
                </header>
                <div>
                    <div class="widget-body p-0">
                        <div class="table-responsive rounded-bottom-4">
                            <table id="casesTable" class="table table-hover mb-0">
                                <thead class="table-light text-uppercase text-primary">
                                    <tr>
                                        <th>Código</th>
                                        <th>Fecha de recepción</th>
                                        <th>Proceso</th>
                                        <th>Estado</th>
                                        <th>Tipo</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (ViewBag.ProcessCases != null && ((List<app_tramites.Models.ModelAi.ProcessCase>)ViewBag.ProcessCases).Any())
                                    {
                                        foreach (var c in (List<app_tramites.Models.ModelAi.ProcessCase>)ViewBag.ProcessCases)
                                        {
                                            bool done = c.FinalResponseResults?.Any() ?? false;
                                            string resumenCategoria = "No Evaluado";
                                            if (done)
                                            {
                                                var txt = string.Join(" ", c.FinalResponseResults.Select(r => r.ResponseText?.ToLower() ?? ""));
                                                if (txt.Contains("**desconocido**")) resumenCategoria = "No Definido";
                                                else if (txt.Contains("**ambulatorio**")) resumenCategoria = "Ambulatorio";
                                                else if (txt.Contains("**hospitalario**")) resumenCategoria = "Hospitalario";
                                                else if (txt.Contains("**hospital del día**")) resumenCategoria = "Hospital del Día";
                                                else resumenCategoria = "No Definido";
                                            }
                                            var date = c.StartDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
                                            <tr>
                                                <td class="fw-bold text-primary">NE-@(((c.CaseCode.ToString() ?? "").Split('-').FirstOrDefault() ?? ""))</td>
                                                <td>@date</td>
                                                <td>@c.DefinitionCodeNavigation?.Name</td>
                                                <td>
                                                    @if (done)
                                                    {
                                                        <span class="badge badge-estado bg-success"><i class="fa fa-check-circle me-1"></i>Evaluado</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-estado bg-warning text-dark"><i class="fa fa-hourglass-start me-1"></i>Pendiente</span>
                                                    }
                                                </td>
                                                <td>
                                                    @{
                                                        var (tipoIcon, tipoCss, tipoBg) = resumenCategoria switch {
                                                            "No Definido"     => ("fa-question",          "text-white", "bg-danger"),
                                                            "Hospital del Día"=> ("fa-hospital",          "text-white", "bg-primary"),
                                                            "Hospitalario"    => ("fa-briefcase-medical", "text-white", "bg-info"),
                                                            "Ambulatorio"     => ("fa-stethoscope",       "text-dark",  "bg-warning"),
                                                            _                 => ("fa-clock",             "text-white", "bg-secondary")
                                                        };
                                                    }
                                                    <span class="badge badge-tipo @tipoBg @tipoCss">
                                                        <i class="fa @tipoIcon me-1"></i>@resumenCategoria
                                                    </span>
                                                </td>
                                                <td>
                                                    @if (done)
                                                    {
                                                        <button type="button" class="btn btn-outline-primary btn-sm icon-action rounded-circle btnViewDetails"
                                                                data-nameproccess="NE-@(((c.CaseCode.ToString() ?? "").Split('-').FirstOrDefault() ?? ""))"
                                                                data-casecode="@c.CaseCode" data-processcode=""
                                                                onclick="handleViewDetails(this)"
                                                                title="Ver detalles">
                                                            <i class="fa fa-eye"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-success btn-sm rounded-circle btnProcessRow ms-1"
                                                                data-nameproccess="NE-@(((c.CaseCode.ToString() ?? "").Split('-').FirstOrDefault() ?? ""))"
                                                                data-casecode="@c.CaseCode" data-processcode=""
                                                                title="Reprocesar">
                                                            <i class="fa fa-play"></i>
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="btn btn-success btn-sm rounded-circle btnProcessRow"
                                                                data-nameproccess="NE-@(((c.CaseCode.ToString() ?? "").Split('-').FirstOrDefault() ?? ""))"
                                                                data-casecode="@c.CaseCode" data-processcode=""
                                                                title="Procesar">
                                                            <i class="fa fa-play"></i>
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center py-5">
                                                <i class="fa fa-folder-open fa-2x text-muted mb-2 d-block"></i>
                                                <span class="text-muted">No hay casos disponibles</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </article>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/app/nexus.index.css" />
}
@section Scripts {
    <script>
        // Loading
        function mostrarLoadingPanel() {
            if (typeof $ !== 'undefined' && $.fn.waitMe) {
                $('#widget-grid').waitMe({ effect: 'bounce', text: 'Cargando...', bg: 'rgba(255,255,255,0.7)', color: '#224abe' });
            }
        }
        function ocultarLoadingPanel() {
            if (typeof $ !== 'undefined' && $.fn.waitMe) {
                $('#widget-grid').waitMe('hide');
            }
        }

        // Estado del formulario
        let hasProcess = false;
        let hasFiles   = false;

        function actualizarBotonCrear() {
            document.getElementById('btnCrearCaso').disabled = !(hasProcess && hasFiles);
        }

        // Drag & Drop y preview
        const uploadArea     = document.getElementById('uploadArea');
        const filesInput     = document.getElementById('files');
        const previewGallery = document.getElementById('previewGallery');
        const fileCountBadge = document.getElementById('fileCountBadge');

        uploadArea.addEventListener('dragover', e => {
            e.preventDefault();
            uploadArea.classList.add('shadow-lg', 'border-primary');
        });
        uploadArea.addEventListener('dragleave', e => {
            e.preventDefault();
            uploadArea.classList.remove('shadow-lg', 'border-primary');
        });
        uploadArea.addEventListener('drop', e => {
            e.preventDefault();
            uploadArea.classList.remove('shadow-lg', 'border-primary');
            const dt = new DataTransfer();
            Array.from(e.dataTransfer.files).forEach(f => dt.items.add(f));
            filesInput.files = dt.files;
            filesInput.dispatchEvent(new Event('change'));
        });

        filesInput.addEventListener('change', () => {
            previewGallery.innerHTML = '';
            previewGallery.classList.toggle('d-none', !filesInput.files.length);

            const count = filesInput.files.length;
            hasFiles = count > 0;
            if (count > 0) {
                fileCountBadge.textContent = count === 1 ? '1 archivo' : `${count} archivos`;
                fileCountBadge.classList.remove('d-none');
            } else {
                fileCountBadge.classList.add('d-none');
            }
            actualizarBotonCrear();

            Array.from(filesInput.files).forEach(f => {
                const ext = f.name.split('.').pop().toLowerCase();
                const container = document.createElement('div');
                container.className = 'preview-item';

                if (['jpg', 'jpeg', 'png'].includes(ext)) {
                    const reader = new FileReader();
                    reader.onload = e => {
                        const img = document.createElement('img');
                        img.src = e.target.result;
                        img.alt = f.name;
                        img.className = 'd-block';
                        container.appendChild(img);
                        const nameEl = document.createElement('small');
                        nameEl.className = 'filename';
                        nameEl.textContent = f.name;
                        container.appendChild(nameEl);
                    };
                    reader.onerror = () => {
                        container.innerHTML = '<i class="fa-solid fa-triangle-exclamation file-icon"></i>';
                    };
                    reader.readAsDataURL(f);
                } else if (ext === 'pdf') {
                    container.innerHTML = '<i class="fa-solid fa-file-pdf file-icon"></i><small class="filename"></small>';
                } else {
                    container.innerHTML = '<i class="fa-solid fa-file file-icon"></i><small class="filename"></small>';
                }
                previewGallery.appendChild(container);
            });
        });

        // Envío OCR
        document.getElementById('ocrForm').addEventListener('submit', async e => {
            e.preventDefault();

            const processCode = document.querySelector('input[name="ProcessCode"]').value;

            mostrarLoadingPanel();

            const filesToSend = await Promise.all(Array.from(filesInput.files).map(f => new Promise(res => {
                const reader = new FileReader();
                reader.onload = () => res({
                    FileName: f.name,
                    Content: reader.result.split(',')[1],
                    Extension: '.' + f.name.split('.').pop().toLowerCase()
                });
                reader.readAsDataURL(f);
            })));

            try {
                const resp = await fetch('/Nexus/CreateCaseProcess', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ProcessCode: processCode, Query: '', Files: filesToSend })
                });

                if (!resp.ok) throw new Error(resp.statusText);
                const data = await resp.json();
                ocultarLoadingPanel();

                const dateStr = new Date(data.startDate).toLocaleString('es-EC', {
                    day: '2-digit', month: '2-digit', year: 'numeric',
                    hour: '2-digit', minute: '2-digit'
                });

                const caseShort = 'NE-' + ((data.caseCode || '').split('-')[0].replace(/^NE/i, ''));
                const tbody = document.querySelector('#casesTable tbody');

                // Quitar fila de "no hay casos" si existe
                const emptyRow = tbody.querySelector('td[colspan]');
                if (emptyRow) emptyRow.closest('tr').remove();

                tbody.insertAdjacentHTML('afterbegin', `
                    <tr>
                        <td class="fw-bold text-primary">${caseShort}</td>
                        <td>${dateStr}</td>
                        <td>${data.nameProccess}</td>
                        <td><span class="badge badge-estado bg-warning text-dark"><i class="fa fa-hourglass-start me-1"></i>Pendiente</span></td>
                        <td><span class="badge badge-tipo bg-secondary text-white"><i class="fa fa-clock me-1"></i>No Evaluado</span></td>
                        <td>
                            <button class='btn btn-success btn-sm rounded-circle btnProcessRow'
                                    data-casecode='${data.caseCode}'
                                    data-processcode=""
                                    data-nameproccess='${caseShort}'
                                    title="Procesar">
                                <i class='fa fa-play'></i>
                            </button>
                        </td>
                    </tr>
                `);

                filesInput.value = null;
                previewGallery.innerHTML = '';
                previewGallery.classList.add('d-none');
                fileCountBadge.classList.add('d-none');
                hasFiles = false;
                actualizarBotonCrear();

            } catch (err) {
                ocultarLoadingPanel();
                Swal.fire({ icon: 'warning', title: 'Advertencia', text: 'Error al crear el caso: ' + err.message });
            }
        });

        // Procesar caso
        let animacionInterval = null;

        async function processCase(btn) {
            btn.disabled = true;
            const proccessName = btn.dataset.nameproccess || 'el proceso seleccionado';
            const orig = btn.innerHTML;
            btn.innerHTML = `<i class='fa fa-spinner fa-spin'></i>`;

            const row = btn.closest('tr');
            if (!row) {
                btn.disabled = false;
                return;
            }
            const estadoEl = row.children[3].querySelector('i, span');
            const tipoCell = row.children[4];
            if (!estadoEl || !tipoCell) {
                btn.disabled = false;
                return;
            }

            row.children[3].innerHTML = `<span class="badge badge-estado bg-info text-white"><i class="fa fa-spinner fa-spin me-1"></i>Procesando</span>`;

            const mensajes = ["Extrayendo...", "Resumiendo...", "Verificando...", "Leyendo...", "Analizando..."];
            let indice = 0;
            tipoCell.innerHTML = `<span class="typing-animation">${mensajes[0]}</span>`;

            if (animacionInterval) clearInterval(animacionInterval);
            animacionInterval = setInterval(() => {
                const span = tipoCell.querySelector('.typing-animation');
                if (span) {
                    indice = (indice + 1) % mensajes.length;
                    span.textContent = mensajes[indice];
                }
            }, 2000);

            try {
                const form = new FormData();
                form.append('caseCode', btn.dataset.casecode);

                const res = await fetch('/Nexus/ProcessCaseAjax', { method: 'POST', body: form });
                if (!res.ok) throw new Error('Error en la solicitud.');
                const json = await res.json();

                clearInterval(animacionInterval);

                const cat = (json.typeCase || 'Generado').trim().toLowerCase();

                row.children[3].innerHTML = `<span class="badge badge-estado bg-success"><i class="fa fa-check-circle me-1"></i>Evaluado</span>`;

                let tipoIconClass = 'fa-file-medical', tipoBg = 'bg-secondary', tipoCss = 'text-white', tipoNombre = 'Generado';
                if (cat.includes('no definido'))        { tipoIconClass = 'fa-question';          tipoBg = 'bg-danger';    tipoNombre = 'No Definido'; }
                else if (cat.includes('hospital del día')) { tipoIconClass = 'fa-hospital';       tipoBg = 'bg-primary';   tipoNombre = 'Hospital del Día'; }
                else if (cat.includes('hospitalario'))  { tipoIconClass = 'fa-briefcase-medical'; tipoBg = 'bg-info';      tipoNombre = 'Hospitalario'; }
                else if (cat.includes('ambulatorio'))   { tipoIconClass = 'fa-stethoscope';       tipoBg = 'bg-warning';   tipoCss = 'text-dark'; tipoNombre = 'Ambulatorio'; }

                tipoCell.innerHTML = `<span class="badge badge-tipo ${tipoBg} ${tipoCss}"><i class="fas ${tipoIconClass} me-1"></i>${tipoNombre}</span>`;

                row.children[5].innerHTML =
                    `<button type="button" class="btn btn-outline-primary btn-sm icon-action rounded-circle btnViewDetails"
                              data-casecode="${btn.dataset.casecode}"
                              data-processcode="${btn.dataset.processcode}"
                              data-nameproccess="${proccessName}"
                              onclick="handleViewDetails(this)"
                              title="Ver detalles">
                          <i class="fa fa-eye"></i>
                     </button>
                     <button type="button" class="btn btn-success btn-sm rounded-circle btnProcessRow ms-1"
                              data-casecode="${btn.dataset.casecode}"
                              data-processcode="${btn.dataset.processcode}"
                              data-nameproccess="${proccessName}"
                              title="Reprocesar">
                          <i class="fa fa-play"></i>
                     </button>`;

            } catch {
                clearInterval(animacionInterval);
                row.children[3].innerHTML = `<span class="badge badge-estado bg-danger"><i class="fa fa-times-circle me-1"></i>Error</span>`;
                tipoCell.innerHTML = `<span class="badge badge-tipo bg-secondary text-white"><i class="fas fa-exclamation-circle me-1"></i>Error</span>`;
                btn.innerHTML = orig;
                btn.disabled = false;
            }
        }

        // Cargar botones de proceso
        async function loadProcessButtons() {
            try {
                const response = await fetch(`/Nexus/GetProcessesByUser`);
                if (!response.ok) throw new Error("Error al cargar los procesos.");
                const processes = await response.json();

                const container = document.getElementById('processContainer');
                container.innerHTML = '';

                processes.processes.forEach(process => {
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.className = 'btn btn-outline-primary btn-lg rounded-pill d-flex align-items-center gap-2 btnProcessAgent';
                    button.innerHTML = `<i class="fa-solid fa-layer-group"></i> ${process.processName}`;
                    button.dataset.processId = process.processId;
                    button.dataset.agentId   = process.processAgentId;

                    button.addEventListener('click', () => {
                        document.querySelector('input[name="ProcessCode"]').value = process.processId;

                        document.querySelectorAll('.btnProcessRow').forEach(b => b.setAttribute('data-processcode', process.processId));
                        document.querySelectorAll('.btnViewDetails').forEach(b => b.setAttribute('data-processcode', process.processId));

                        document.querySelectorAll('.btnProcessAgent').forEach(b => {
                            b.classList.remove('btn-primary', 'btn-success');
                            b.classList.add('btn-outline-primary');
                        });
                        button.classList.remove('btn-outline-primary');
                        button.classList.add('btn-primary');

                        // Indicador visible de proceso activo
                        document.getElementById('processSelectedName').textContent = process.processName;
                        document.getElementById('processSelectedIndicator').classList.remove('d-none');

                        hasProcess = true;
                        actualizarBotonCrear();
                    });

                    container.appendChild(button);
                });
            } catch (error) {
                console.error(error);
                Swal.fire({ icon: 'error', title: 'Error', text: 'No se pudieron cargar los procesos.' });
            }
        }

        function handleViewDetails(button) {
            const caseCode = button.dataset.casecode;
            if (!caseCode) {
                Swal.fire({ icon: 'error', title: 'Error', text: 'No se encontró un código de caso válido.' });
                return;
            }
            cargando();
            window.location.href = `/Nexus/Details1?caseCode=${caseCode}`;
        }

        document.addEventListener('DOMContentLoaded', () => {
            loadProcessButtons();
        });

        document.addEventListener('click', e => {
            const b = e.target.closest('.btnProcessRow');
            if (b) processCase(b);
        });
    </script>
}
