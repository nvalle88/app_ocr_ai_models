@model app_tramites.Models.ModelAi.AccessAgentPolicy

@section Migas {
    <li><a asp-action="Index" onclick="cargando()">Políticas de Acceso</a></li>
    <li class="active">@ViewData["accion"]</li>
}

<div class="row">
    <div class="col-xs-12 col-sm-5 col-md-5 col-lg-3 margin-top-0">
        <ul id="sparks">
            <li class="sparks-info">
                <a class="btn btn-primary" onclick="cargando()" asp-action="Index">
                    <i class="fa fa-arrow-left"></i> Volver
                </a>
            </li>
        </ul>
    </div>
    <div class="col-xs-12">
        <div id="content" class="well no-padding">
            <form asp-action="Manage" method="post" novalidate="novalidate" class="smart-form client-form">
                <input type="hidden" asp-for="Id" />
                <header>
                    <i class="fa fa-shield"></i> &nbsp;<b>@ViewData["accion"] Política de Acceso</b>
                </header>
                <fieldset>
                    <section>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    </section>
                    <section class="col col-sm-6">
                        <label class="label">Política <span class="text-danger">*</span></label>
                        <label class="select">
                            <select asp-for="PolicyCode" asp-items="ViewBag.Politicas" class="select2">
                                <option value="">-- Seleccionar Política --</option>
                            </select>
                            <i></i>
                            <span asp-validation-for="PolicyCode" class="text-danger"></span>
                        </label>
                    </section>
                    <section class="col col-sm-6">
                        <label class="label">Agente — Proceso <span class="text-danger">*</span></label>
                        <label class="select">
                            <select asp-for="AgentProcessId" asp-items="ViewBag.AgentProcesses" class="select2">
                                <option value="">-- Seleccionar Agente-Proceso --</option>
                            </select>
                            <i></i>
                            <span asp-validation-for="AgentProcessId" class="text-danger"></span>
                        </label>
                    </section>
                    <section class="col col-sm-12">
                        <label class="label"><i class="fa fa-toggle-on"></i> Estado</label>
                        <label class="toggle">
                            <span class="onoffswitch">
                                <input type="checkbox" asp-for="Status" class="onoffswitch-checkbox" id="swStatus">
                                <label class="onoffswitch-label" for="swStatus">
                                    <span class="onoffswitch-inner" data-swchon-text="Activo" data-swchoff-text="Inactivo"></span>
                                    <span class="onoffswitch-switch"></span>
                                </label>
                            </span>
                        </label>
                    </section>
                </fieldset>
                <footer>
                    <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Guardar</button>
                    <a asp-action="Index" onclick="cargando()" class="btn btn-default"><i class="fa fa-times"></i> Cancelar</a>
                </footer>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
