@model List<app_tramites.Models.ModelAi.AccessAgentPolicy>
@section Migas {
    <li><a asp-action="Index" onclick="cargando()">Políticas de Acceso</a></li>
    <li class="active">Lista</li>
}

<div class="row">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
        <a asp-action="Manage" onclick="cargando()" class="btn btn-primary"><strong><i class="fa fa-plus"></i> Nueva Política</strong></a>
    </div>
    <div class="col-xs-12 col-sm-5 col-md-5 col-lg-12"><br /></div>
</div>

<section id="widget-grid" class="">
    <div class="row">
        <article class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
            <div class="jarviswidget jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false">
                <header>
                    <span class="widget-icon"><i class="fa fa-shield"></i></span>
                    <h2>Políticas de Acceso a Agentes</h2>
                </header>
                <div>
                    <div class="widget-body no-padding">
                        <table id="dt_basic" class="table table-striped table-bordered table-hover" width="100%">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th data-class="expand">Política</th>
                                    <th>Agente</th>
                                    <th>Proceso</th>
                                    <th data-hide="phone,tablet">Estado</th>
                                    <th data-hide="phone,tablet">Opciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.Id</td>
                                        <td>
                                            <i class="fa fa-tag"></i>
                                            <strong>@(item.Policy?.PolicyName ?? item.PolicyCode)</strong>
                                            <br /><small class="text-muted">@item.PolicyCode</small>
                                        </td>
                                        <td>
                                            <span class="label label-info">@(item.AgentProcess?.Agent?.Name ?? "")</span>
                                        </td>
                                        <td>
                                            <span class="label label-primary">@(item.AgentProcess?.Process?.Name ?? "")</span>
                                        </td>
                                        <td>
                                            @if (item.Status)
                                            {
                                                <span class="badge" style="background-color:#5cb85c">Activo</span>
                                            }
                                            else
                                            {
                                                <span class="badge" style="background-color:#d9534f">Inactivo</span>
                                            }
                                        </td>
                                        <td align="center">
                                            <a asp-action="Manage" asp-route-id="@item.Id" onclick="cargando()"
                                               class="fa fa-edit txt-color-blue" title="Editar"></a>
                                            &nbsp;|&nbsp;
                                            <a href="javascript:void(0);" class="fa fa-trash-o txt-color-red"
                                               onclick="Delete(this)"
                                               id="@item.Id"
                                               data-descripcion="¿Desea eliminar la política '@(item.Policy?.PolicyName ?? item.PolicyCode)'?"></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </article>
    </div>
</section>

@section Scripts {
    @{ await Html.RenderPartialAsync("_BootboxPartial"); }
    @{ await Html.RenderPartialAsync("_DateTablePartial"); }
    <script>
        function Delete(e) {
            var btn = $(e);
            bootbox.confirm({
                title: "¿ Eliminar ?",
                message: btn.data("descripcion"),
                buttons: {
                    cancel: { label: '<i class="fa fa-times"></i> Cancelar' },
                    confirm: { label: '<i class="fa fa-check"></i> OK' }
                },
                callback: function (result) {
                    if (result) {
                        mostrarLoadingPanel("content", "");
                        $.ajax({
                            type: "GET",
                            url: '@Url.Action("Delete", "AccessAgentPolicy")' + '?id=' + btn.prop("id"),
                            contentType: "application/json; charset=utf-8",
                            datatype: "json",
                            timeout: 500000,
                            success: function (data) {
                                if (data.estado == 'Error') {
                                    mostrarNotificacion("Error", data.mensaje);
                                    $("#content").waitMe("hide");
                                } else {
                                    window.location = '@Url.Action("Index", "AccessAgentPolicy")';
                                }
                            },
                            error: function () {
                                $("#content").waitMe("hide");
                                mostrarNotificacion("Error", "No se pudo eliminar el registro.");
                            }
                        });
                    }
                }
            });
        }
    </script>
}
