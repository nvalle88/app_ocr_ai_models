@model ChatClienteVm
@{
    ViewData["Title"] = "Consulta del afiliado";
    var embed = ViewData["Embed"] as bool? ?? false;
    Layout = embed ? null : "~/Areas/Studio/Views/Shared/_Layout.cshtml";
}

@* ══════════════════════════════════════════════════════════════════════════
   El chat del afiliado.

   No es el Chat de /Studio/Chat: ese es del operador, habla en jerga y puede
   buscar por nombre. Este habla con la persona, así que se parece a un chat de
   verdad —burbujas, escribir abajo, Enter para enviar— y no a un formulario.

   La conversación vive en el navegador. En el servidor no se acumula historial:
   no hace falta para contestar «cuánto me falta del deducible», y una
   conversación guardada de temas médicos es un dato sensible más que custodiar.
   ══════════════════════════════════════════════════════════════════════════ *@

<style>
    .cc-caja { display:flex; flex-direction:column; height:@(embed ? "calc(100vh - 40px)" : "72vh");
               max-width:860px; margin:0 auto; background:#fff;
               border:1px solid #dde3ec; border-radius:12px; overflow:hidden; }

    .cc-cab { padding:14px 18px; border-bottom:1px solid #eef1f6; background:#fafbfd; }
    .cc-cab h2 { margin:0 0 3px; font-size:15.5px; font-weight:700; color:#002F87; }
    .cc-cab p  { margin:0; font-size:12.5px; color:#6b7684; }

    .cc-hilo { flex:1 1 auto; overflow-y:auto; padding:18px; display:flex;
               flex-direction:column; gap:14px; }

    .cc-msg { max-width:78%; padding:11px 14px; border-radius:12px; font-size:14px;
              line-height:1.55; white-space:pre-wrap; word-wrap:break-word; }
    .cc-msg.es-yo   { align-self:flex-end; background:#002F87; color:#fff; border-bottom-right-radius:3px; }
    .cc-msg.es-ella { align-self:flex-start; background:#f1f4f9; color:#1f2733; border-bottom-left-radius:3px; }
    .cc-msg.es-mal  { align-self:flex-start; background:#fff4f2; color:#b42318; border:1px solid #f3d3cd; }

    /* Lo que consultó para contestar. Que se vea el trabajo hace la respuesta
       creíble, pero va discreto: es respaldo, no el mensaje. */
    .cc-consulto { align-self:flex-start; max-width:78%; margin-top:-6px; }
    .cc-consulto summary { font-size:11.5px; color:#8792a2; cursor:pointer; list-style:none; }
    .cc-consulto summary::-webkit-details-marker { display:none; }
    .cc-consulto summary:hover { color:#002F87; }
    .cc-consulto ul { list-style:none; margin:7px 0 0; padding:0;
                      border-left:2px solid #e8ecf3; }
    .cc-consulto li { display:flex; gap:8px; align-items:baseline;
                      padding:3px 0 3px 10px; font-size:12px; }
    .cc-consulto .q { color:#4a5568; }
    .cc-consulto .r { font-weight:600; margin-left:auto; }
    .cc-consulto li.ok .r       { color:#1a7f4b; }
    .cc-consulto li.atencion .r { color:#8a6100; }
    .cc-consulto li.fallo .r    { color:#b42318; }

    .cc-pie { border-top:1px solid #eef1f6; padding:12px; background:#fafbfd; }
    .cc-fila { display:flex; gap:9px; align-items:flex-end; }
    .cc-fila textarea { flex:1 1 auto; resize:none; min-height:42px; max-height:120px;
                        padding:11px 13px; font-size:14px; font-family:inherit;
                        border:1px solid #d5dbe6; border-radius:9px; }
    .cc-fila textarea:focus { outline:none; border-color:#002F87; }
    .cc-enviar { flex:0 0 auto; padding:11px 17px; border:0; border-radius:9px;
                 background:#002F87; color:#fff; font-size:14px; font-weight:600;
                 cursor:pointer; }
    .cc-enviar:disabled { background:#a9b4c6; cursor:default; }

    /* Ejemplos: sin ellos, el afiliado mira un campo en blanco y no pregunta. */
    .cc-ideas { display:flex; flex-wrap:wrap; gap:7px; margin-bottom:11px; }
    .cc-idea { border:1px solid #d5dbe6; background:#fff; border-radius:999px;
               padding:5px 12px; font-size:12.5px; color:#3d4757; cursor:pointer; }
    .cc-idea:hover { border-color:#002F87; color:#002F87; }

    .cc-puntos span { display:inline-block; width:6px; height:6px; margin-right:3px;
                      border-radius:50%; background:#8792a2; animation:cc-lat 1.1s infinite; }
    .cc-puntos span:nth-child(2) { animation-delay:.15s; }
    .cc-puntos span:nth-child(3) { animation-delay:.30s; }
    @@keyframes cc-lat { 0%,60%,100%{opacity:.25} 30%{opacity:1} }

    @@media (prefers-reduced-motion: reduce) { .cc-puntos span { animation:none; } }
</style>

@if (!Model.Listo)
{
    <div class="alert alert-warning" style="max-width:640px;margin:20px auto;">
        <i class="fa fa-info-circle"></i>
        @(Model.Error ?? "No se puede abrir la consulta para este caso.")
    </div>
}
else
{
<div class="cc-caja">
    <div class="cc-cab">
        <h2><i class="fa fa-comments"></i> Consulta sobre su cobertura</h2>
        <p>
            @Model.NombrePaciente
            @if (!string.IsNullOrWhiteSpace(Model.NombrePlan)) { <text> · @Model.NombrePlan</text> }
            @if (!string.IsNullOrWhiteSpace(Model.NumeroContrato)) { <text> · contrato @Model.NumeroContrato</text> }
        </p>
    </div>

    <div class="cc-hilo" id="ccHilo">
        <div class="cc-msg es-ella">Buenos días. Puedo consultarle lo de su contrato: qué le cubre su plan, cuánto le falta del deducible, en qué va un reembolso o hasta cuándo puede presentar una factura. ¿Qué necesita saber?</div>
    </div>

    <div class="cc-pie">
        <div class="cc-ideas" id="ccIdeas">
            <button type="button" class="cc-idea">¿Hasta cuándo puedo presentar una factura?</button>
            <button type="button" class="cc-idea">¿Cuánto me falta del deducible?</button>
            <button type="button" class="cc-idea">¿En qué va mi reembolso?</button>
            <button type="button" class="cc-idea">¿Me cubren si me pasa algo de viaje?</button>
        </div>
        <div class="cc-fila">
            <textarea id="ccTexto" rows="1" maxlength="600"
                      placeholder="Escriba su pregunta…" aria-label="Su pregunta"></textarea>
            <button type="button" class="cc-enviar" id="ccEnviar">Enviar</button>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

<script>
(function () {
    'use strict';
    var hilo   = document.getElementById('ccHilo');
    var texto  = document.getElementById('ccTexto');
    var boton  = document.getElementById('ccEnviar');
    var caso   = '@Model.CaseCode';
    var url    = '@Url.Action("Preguntar", "ChatCliente", new { area = "Studio" })';
    var ocupado = false;

    function token() {
        var i = document.querySelector('input[name="__RequestVerificationToken"]');
        return i ? i.value : '';
    }

    function esc(s) {
        var d = document.createElement('div');
        d.textContent = s == null ? '' : s;
        return d.innerHTML;
    }

    function burbuja(clase, contenido) {
        var d = document.createElement('div');
        d.className = 'cc-msg ' + clase;
        d.textContent = contenido;
        hilo.appendChild(d);
        hilo.scrollTop = hilo.scrollHeight;
        return d;
    }

    /* Lo que consultó, plegado: respalda la respuesta sin robarle la atención. */
    function consultas(pasos) {
        if (!pasos || !pasos.length) return;
        var d = document.createElement('details');
        d.className = 'cc-consulto';
        var lis = pasos.map(function (p) {
            var tono = p.tono || 'neutro';
            return '<li class="' + tono + '"><span class="q">' + esc(p.que) + '</span>'
                 + (p.resultado ? '<span class="r">' + esc(p.resultado) + '</span>' : '')
                 + '</li>';
        }).join('');
        d.innerHTML = '<summary>Qué consulté para responderle (' + pasos.length + ')</summary>'
                    + '<ul>' + lis + '</ul>';
        hilo.appendChild(d);
        hilo.scrollTop = hilo.scrollHeight;
    }

    async function preguntar(q) {
        if (ocupado || !q) return;
        ocupado = true;
        boton.disabled = true;
        burbuja('es-yo', q);
        texto.value = '';
        texto.style.height = 'auto';

        var esperando = document.createElement('div');
        esperando.className = 'cc-msg es-ella cc-puntos';
        esperando.innerHTML = '<span></span><span></span><span></span>';
        hilo.appendChild(esperando);
        hilo.scrollTop = hilo.scrollHeight;

        try {
            var fd = new FormData();
            fd.append('caseCode', caso);
            fd.append('pregunta', q);
            fd.append('__RequestVerificationToken', token());

            var resp = await fetch(url, {
                method: 'POST', credentials: 'same-origin',
                headers: { 'RequestVerificationToken': token() }, body: fd
            });

            esperando.remove();

            if (!resp.ok) {
                burbuja('es-mal', 'No pude consultarlo ahora. Vuelva a intentarlo en un minuto.');
            } else {
                var d = await resp.json();
                burbuja(d.ok ? 'es-ella' : 'es-mal', d.texto || 'No obtuve respuesta.');
                if (d.ok) consultas(d.consulto);
            }
        } catch (e) {
            esperando.remove();
            burbuja('es-mal', 'Se perdió la conexión. Vuelva a intentarlo.');
        } finally {
            ocupado = false;
            boton.disabled = false;
            texto.focus();
        }
    }

    boton.addEventListener('click', function () { preguntar(texto.value.trim()); });

    /* Enter envía, Mayús+Enter hace salto de línea: es lo que la gente espera. */
    texto.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); preguntar(texto.value.trim()); }
    });

    /* Crece con lo que se escribe, hasta el tope del CSS. */
    texto.addEventListener('input', function () {
        texto.style.height = 'auto';
        texto.style.height = Math.min(texto.scrollHeight, 120) + 'px';
    });

    document.getElementById('ccIdeas').addEventListener('click', function (e) {
        if (e.target.classList.contains('cc-idea')) preguntar(e.target.textContent.trim());
    });

    texto.focus();
})();
</script>
}
