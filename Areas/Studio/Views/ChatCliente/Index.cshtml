@model ChatClienteVm
@{
    ViewData["Title"] = "Consulta del afiliado";
    var embed = ViewData["Embed"] as bool? ?? false;
    Layout = embed ? null : "~/Areas/Studio/Views/Shared/_Layout.cshtml";
}

@* ══════════════════════════════════════════════════════════════════════════
   El chat del afiliado.

   No es el Chat de /Studio/Chat: ese es del operador, habla en jerga y puede
   buscar por nombre. Este habla con la persona, así que se parece a un chat de
   verdad —burbujas, escribir abajo, Enter para enviar— y no a un formulario.

   La conversación vive en el navegador. En el servidor no se acumula historial:
   no hace falta para contestar «cuánto me falta del deducible», y una
   conversación guardada de temas médicos es un dato sensible más que custodiar.
   ══════════════════════════════════════════════════════════════════════════ *@

<style>
    .cc-caja { display:flex; flex-direction:column; height:@(embed ? "calc(100vh - 40px)" : "72vh");
               max-width:860px; margin:0 auto; background:#fff;
               border:1px solid #dde3ec; border-radius:12px; overflow:hidden; }

    .cc-cab { padding:14px 18px; border-bottom:1px solid #eef1f6; background:#fafbfd; }
    .cc-cab h2 { margin:0 0 3px; font-size:15.5px; font-weight:700; color:#002F87; }
    .cc-cab p  { margin:0; font-size:12.5px; color:#6b7684; }

    .cc-hilo { flex:1 1 auto; overflow-y:auto; padding:18px; display:flex;
               flex-direction:column; gap:14px; }

    .cc-msg { max-width:78%; padding:11px 14px; border-radius:12px; font-size:14px;
              line-height:1.55; white-space:pre-wrap; word-wrap:break-word; }
    .cc-msg.es-yo   { align-self:flex-end; background:#002F87; color:#fff; border-bottom-right-radius:3px; }
    /* El globo de la respuesta va BLANCO, no gris.
       Con una tabla dentro, un globo gris sobre fondo gris deja todo del mismo
       color: la tabla no se despega del globo ni el globo de la pagina, y se lee
       como una mancha. En blanco, cada cosa tiene su plano. */
    .cc-msg.es-ella { align-self:flex-start; background:#fff; color:#1f2733;
                      border:1px solid #e4e9f2; border-bottom-left-radius:3px;
                      box-shadow:0 1px 2px rgba(16,24,40,.04); }

    /* Una respuesta con TABLA necesita ancho. El 78% esta pensado para texto
       -una linea larga cansa de leer-, pero a una tabla de cinco columnas la
       estrangula: cada celda parte en dos y se pierde justo la comparacion que
       la tabla venia a dar. Solo se ensancha cuando hay tabla. */
    .cc-msg.es-ella:has(.md-tabla) { max-width:97%; }
    .cc-msg.es-mal  { align-self:flex-start; background:#fff4f2; color:#b42318; border:1px solid #f3d3cd; }

    /* Lo que consultó para contestar. Que se vea el trabajo hace la respuesta
       creíble, pero va discreto: es respaldo, no el mensaje. */
    .cc-consulto { align-self:flex-start; max-width:78%; margin-top:-6px; }
    .cc-consulto summary { font-size:11.5px; color:#8792a2; cursor:pointer; list-style:none; }
    .cc-consulto summary::-webkit-details-marker { display:none; }
    .cc-consulto summary:hover { color:#002F87; }
    .cc-consulto ul { list-style:none; margin:7px 0 0; padding:0;
                      border-left:2px solid #e8ecf3; }
    .cc-consulto li { display:flex; gap:8px; align-items:baseline;
                      padding:3px 0 3px 10px; font-size:12px; }
    .cc-consulto .q { color:#4a5568; }
    .cc-consulto .r { font-weight:600; margin-left:auto; }
    .cc-consulto li.ok .r       { color:#1a7f4b; }
    .cc-consulto li.atencion .r { color:#8a6100; }
    .cc-consulto li.fallo .r    { color:#b42318; }

    .cc-pie { border-top:1px solid #eef1f6; padding:12px; background:#fafbfd; }
    .cc-fila { display:flex; gap:9px; align-items:flex-end; }
    .cc-fila textarea { flex:1 1 auto; resize:none; min-height:42px; max-height:120px;
                        padding:11px 13px; font-size:14px; font-family:inherit;
                        border:1px solid #d5dbe6; border-radius:9px; }
    .cc-fila textarea:focus { outline:none; border-color:#002F87; }
    .cc-enviar { flex:0 0 auto; padding:11px 17px; border:0; border-radius:9px;
                 background:#002F87; color:#fff; font-size:14px; font-weight:600;
                 cursor:pointer; }
    .cc-enviar:disabled { background:#a9b4c6; cursor:default; }

    /* Ejemplos: sin ellos, el afiliado mira un campo en blanco y no pregunta. */
    .cc-ideas { display:flex; flex-wrap:wrap; gap:7px; margin-bottom:11px; }
    .cc-idea { border:1px solid #d5dbe6; background:#fff; border-radius:999px;
               padding:5px 12px; font-size:12.5px; color:#3d4757; cursor:pointer; }
    .cc-idea:hover { border-color:#002F87; color:#002F87; }

    /* ── Lo que esta consultando, mientras lo consulta ──────────────────
       Antes solo latian tres puntos. Con varias tools por pregunta eso es
       medio minuto mirando una animacion sin saber si avanza o se colgo. */
    .cc-espera { align-self:flex-start; max-width:78%; background:#f1f4f9;
                 border-radius:12px; border-bottom-left-radius:3px;
                 padding:10px 13px; font-size:13px; color:#3d4757; }
    .cc-espera .cc-pasos { list-style:none; margin:8px 0 0; padding:0; }
    .cc-espera .cc-pasos li { display:flex; align-items:baseline; gap:8px;
                              padding:2px 0; font-size:12.5px;
                              animation:cc-entra .2s ease; }
    .cc-espera .cc-pasos li .ic { width:13px; text-align:center; flex:0 0 13px; }
    .cc-espera .cc-pasos li.corriendo    { color:#4a5568; }
    .cc-espera .cc-pasos li.ok       .ic { color:#1a7f4b; }
    .cc-espera .cc-pasos li.atencion .ic { color:#8a6100; }
    .cc-espera .cc-pasos li.fallo    .ic { color:#b42318; }
    .cc-espera .cc-pasos li .seg { margin-left:auto; color:#98a2b3; font-size:11px; }
    @@keyframes cc-entra { from { opacity:0; transform:translateY(-2px); } to { opacity:1; } }
    @@media (prefers-reduced-motion: reduce) { .cc-espera .cc-pasos li { animation:none; } }

    .cc-puntos span { display:inline-block; width:6px; height:6px; margin-right:3px;
                      border-radius:50%; background:#8792a2; animation:cc-lat 1.1s infinite; }
    .cc-puntos span:nth-child(2) { animation-delay:.15s; }
    .cc-puntos span:nth-child(3) { animation-delay:.30s; }
    @@keyframes cc-lat { 0%,60%,100%{opacity:.25} 30%{opacity:1} }

    @@media (prefers-reduced-motion: reduce) { .cc-puntos span { animation:none; } }

    /* ── El formato de la respuesta ──────────────────────────────────────────
       El agente escribe tablas e importes. Sin esto llegaba el pipe en crudo,
       que es peor que no haber hecho la tabla. */
    .cc-msg .md-p     { margin:0 0 8px; }
    .cc-msg .md-p:last-child { margin-bottom:0; }
    .cc-msg .md-h     { margin:12px 0 6px; font-size:13.5px; font-weight:700; color:#002F87; }
    .cc-msg .md-h:first-child { margin-top:0; }
    .cc-msg .md-lista { margin:0 0 8px; padding-left:20px; }
    .cc-msg .md-lista li { margin-bottom:3px; }
    .cc-msg code      { background:#e7ebf2; padding:1px 5px; border-radius:4px; font-size:12.5px; }
    .cc-msg strong    { color:#002F87; }
    .cc-msg.es-yo strong, .cc-msg.es-yo code { color:#fff; background:rgba(255,255,255,.18); }

    /* La cita es el texto literal del contrato: se distingue a propósito. */
    .cc-msg .md-cita  { margin:10px 0; padding:10px 14px; border-left:3px solid #002F87;
                        background:#f4f7fd; border-radius:0 8px 8px 0;
                        font-size:13px; color:#33415c; font-style:normal; }

    .cc-msg .md-tabla-wrap { overflow-x:auto; margin:10px 0; }
    .cc-msg .md-tabla { width:100%; border-collapse:separate; border-spacing:0;
                        font-size:13px; background:#fff;
                        border:1px solid #dde3ec; border-radius:9px; overflow:hidden; }
    /* Cabecera con peso: es lo que ancla la lectura de una tabla. Antes era un
       azul palido que se confundia con las filas y la tabla parecia un bloque
       unico de un solo color. */
    .cc-msg .md-tabla th { background:#002F87; color:#fff; font-weight:700; font-size:11px;
                           text-transform:uppercase; letter-spacing:.4px;
                           padding:9px 11px; text-align:left; white-space:nowrap; }
    .cc-msg .md-tabla td { padding:9px 11px; border-top:1px solid #edf0f6;
                           vertical-align:top; line-height:1.45; }
    .cc-msg .md-tabla tbody tr:first-child td { border-top:0; }
    /* La fila bajo el cursor: en una tabla de varias columnas, saber en cual
       esta uno evita leer el precio de la fila de al lado. */
    .cc-msg .md-tabla tbody tr:hover td { background:#f4f8ff; }
    .cc-msg .md-tabla td.num { text-align:right; font-variant-numeric:tabular-nums; white-space:nowrap; }
    /* Sin zebra: con cabecera solida, separadores y hover, las bandas solo
       añaden un tercer gris. */

    /* ── Que se lea una tabla de precios ──────────────────────────────────
       Los importes en columna solo se comparan de un vistazo si van alineados
       a la derecha y con cifras de ancho fijo. Y la primera columna -el nombre
       del prestador, el numero de la autorizacion- es la que se busca con el
       ojo, asi que va destacada. */
    .cc-msg .md-tabla td:first-child { font-weight:600; color:#1f2733; }
    .cc-msg .md-tabla td.num, .cc-msg .md-tabla th.num {
        text-align:right; font-variant-numeric:tabular-nums; white-space:nowrap; }
    .cc-msg .md-tabla .md-plata { font-weight:700; color:#00224f; }
    /* Un dato que NO consta se dice, no se deja en blanco: una celda vacia en
       una columna de precios se lee como gratis. */
    .cc-msg .md-tabla .md-nada { color:#98a2b3; font-style:italic; font-weight:400;
                                 white-space:nowrap; }

    /* ── Distintivos ──────────────────────────────────────────────────────
       Para lo que se responde de un vistazo: si el prestador esta en su red,
       si la autorizacion salio o no. El color no va solo: lleva texto, porque
       un tercio de los hombres distingue mal el rojo del verde y porque en un
       correo reenviado o impreso el color se pierde. */
    .cc-msg .md-marca {
        display:inline-block; padding:2px 9px; border-radius:999px;
        font-size:11.5px; font-weight:700; letter-spacing:.2px;
        border:1px solid transparent; white-space:nowrap; }
    .cc-msg .md-marca.ok    { background:#e7f6ee; color:#1a7f4b; border-color:#bfe5d0; }
    .cc-msg .md-marca.aviso { background:#fff6e0; color:#8a6100; border-color:#f0dfae; }
    .cc-msg .md-marca.mal   { background:#fdeceb; color:#b42318; border-color:#f3d3cd; }

    /* ── Ficha ────────────────────────────────────────────────────────────
       Cuando es UN prestador y no una lista, una tabla de una fila se lee
       peor que una ficha. */
    .cc-msg .md-ficha { border:1px solid #dde3ec; border-radius:9px; padding:11px 13px;
                        margin:10px 0; background:#fff; }
    .cc-msg .md-ficha .md-h { margin-top:0; }

    /* Pares dato/valor: 'Usted paga … 20,00'. En dos columnas se leen; en una
       lista con guiones, no. */
    .cc-msg .md-datos { display:grid; grid-template-columns:auto 1fr; gap:3px 14px;
                        margin:8px 0; font-size:13px; }
    .cc-msg .md-datos dt { color:#6b7684; }
    .cc-msg .md-datos dd { margin:0; font-weight:600; color:#1f2733; }

    /* Lo que hay que entender aunque se lea en diagonal. */
    .cc-msg .md-clave { margin:10px 0; padding:9px 12px; border-radius:8px;
                        background:#f4f7fd; border-left:3px solid #002F87;
                        font-size:13px; color:#1f2733; }
    .cc-msg .md-clave.aviso { background:#fff6e0; border-left-color:#c99a00; color:#6b4d00; }

    .cc-msg .md-tabla caption { caption-side:top; text-align:left; padding:0 0 6px;
                                font-size:11.5px; color:#6b7684; }

    /* .cc-msg lleva white-space:pre-wrap para el texto suelto, donde los saltos
       del modelo SI son parte del mensaje. Pero dentro de HTML estructurado eso
       convierte la sangria del codigo en espacios de verdad: un parrafo
       indentado sale con la segunda linea metida hacia dentro y la tabla con
       celdas descuadradas. Dentro de cada bloque, el salto vuelve a ser lo que
       es en HTML: nada. */
    .cc-msg .md-p, .cc-msg .md-h, .cc-msg .md-clave, .cc-msg .md-cita,
    .cc-msg .md-lista li, .cc-msg .md-ficha,
    .cc-msg .md-datos dt, .cc-msg .md-datos dd,
    .cc-msg .md-tabla th, .cc-msg .md-tabla td,
    .cc-msg .md-tabla caption { white-space:normal; }

    /* Descargar: la conversación entera, para llevársela o adjuntarla. */
    .cc-bajar { background:none; border:0; color:#6b7684; font-size:11.5px;
                cursor:pointer; padding:0; }
    .cc-bajar:hover { color:#002F87; text-decoration:underline; }
    .cc-cab-fila { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; }

    /* ── El visor de la carta ─────────────────────────────────────────────
       La carta se VE aqui, al lado de la conversacion. Bajarla sacaba al
       afiliado del chat -a la carpeta de descargas, a otro programa- y para
       seguir preguntando tenia que rehacer el camino. Asi la mira, la contrasta
       con lo que acaba de leer y sigue escribiendo.

       Va fija a la derecha y por encima: la caja del chat esta centrada con
       max-width, y meterla en el flujo obligaria a rehacer ese centrado. En
       pantalla ancha el chat se corre a la izquierda para que se vean los dos. */
    .cc-visor { position:fixed; top:0; right:0; bottom:0; width:min(620px, 100%);
                background:#fff; border-left:1px solid #dde3ec;
                box-shadow:-8px 0 24px rgba(16,24,40,.10);
                display:flex; flex-direction:column; z-index:1050;
                transform:translateX(101%); transition:transform .22s ease;
                visibility:hidden; }
    .cc-visor.abierto { transform:none; visibility:visible; }

    .cc-visor-cab { display:flex; align-items:center; gap:10px;
                    padding:12px 14px; border-bottom:1px solid #eef1f6; background:#fafbfd; }
    .cc-visor-cab h3 { margin:0; font-size:14px; font-weight:700; color:#002F87;
                       white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .cc-visor-cab .sep { margin-left:auto; }
    .cc-visor-cab a, .cc-visor-cab button {
        border:1px solid #d5dbe6; background:#fff; border-radius:7px;
        padding:5px 11px; font-size:12.5px; color:#3d4757; cursor:pointer;
        text-decoration:none; white-space:nowrap; }
    .cc-visor-cab a:hover, .cc-visor-cab button:hover { border-color:#002F87; color:#002F87; }

    .cc-visor-cuerpo { flex:1 1 auto; position:relative; background:#f1f4f9; }
    .cc-visor-cuerpo iframe { width:100%; height:100%; border:0; display:block; }

    /* Mientras Armonix genera el PDF. Tarda: se avisa en vez de dejar un
       rectangulo gris que parece que se rompio. */
    .cc-visor-esperando { position:absolute; inset:0; display:flex; gap:9px;
                          align-items:center; justify-content:center;
                          font-size:13px; color:#6b7684; background:#f1f4f9; }
    .cc-visor-esperando.oculto { display:none; }

    /* En pantalla ancha el chat se aparta; en estrecha el visor lo tapa entero,
       que es lo unico que cabe. */
    @@media (min-width: 1180px) {
        body.cc-con-visor .cc-caja { margin-left:24px; margin-right:660px; transition:margin .22s ease; }
    }

    /* Reintentar. Un error sin salida obliga a volver a escribir la pregunta,
       y quien ya la escribio una vez no deberia tener que teclearla otra. */
    .cc-msg.es-mal .cc-reintentar {
        display:inline-flex; align-items:center; gap:6px; margin-top:9px;
        padding:5px 12px; border:1px solid #e0b4ac; border-radius:7px;
        background:#fff; color:#b42318; font-size:12.5px; font-weight:600;
        cursor:pointer;
    }
    .cc-msg.es-mal .cc-reintentar:hover { background:#fff0ec; }

    /* Consultar otro plan. El aviso es permanente a propósito. */
    .cc-otroplan { margin-top:9px; padding:7px 11px; border-radius:7px;
                   background:#fff6e0; border:1px solid #f0dfae; color:#8a6100;
                   font-size:12.5px; }
    .cc-otroplan a { color:#8a6100; text-decoration:underline; margin-left:6px; }

    .cc-cambiar { margin-top:8px; }
    .cc-cambiar summary { font-size:11.5px; color:#8792a2; cursor:pointer; list-style:none; }
    .cc-cambiar summary::-webkit-details-marker { display:none; }
    .cc-cambiar summary:hover { color:#002F87; }
    .cc-cambiar form { display:flex; gap:7px; align-items:center; flex-wrap:wrap; margin-top:8px; }
    .cc-cambiar input { padding:6px 10px; font-size:12.5px; border:1px solid #d5dbe6; border-radius:7px; }
    .cc-cambiar button { padding:6px 12px; font-size:12.5px; border:0; border-radius:7px;
                         background:#002F87; color:#fff; cursor:pointer; }
    .cc-cambiar span { font-size:11.5px; color:#8792a2; }
</style>

@* Sin caso: se entro por la pildora de rol. Lo primero es elegir a quien se
   atiende — un error ahi seria absurdo, porque es justo lo que viene a hacer. *@
@if (!Model.Listo)
{
    <div style="max-width:860px;margin:0 auto;">
        <div class="st-head">
            <div class="st-head-main">
                <div class="st-crumbs">Studio / Consulta del afiliado</div>
                <h1 class="st-title"><i class="fa fa-comments"></i>¿A quién atiende?</h1>
                <p class="st-sub">Busque por cédula, contrato o nombre. Después podrá consultarle
                   lo de su contrato: coberturas, deducible, el estado de sus reembolsos o qué
                   dice su póliza.</p>
            </div>
        </div>

        @* El buscador va SIEMPRE que no haya chat abierto, tambien cuando la
           busqueda no encontro nada: es justo cuando hace falta volver a
           buscar, y esconderlo obligaria a recargar a mano. *@
        <div class="st-card is-principal" style="margin-bottom:16px">
            <div class="st-card-cuerpo">
                <form method="get" asp-area="Studio" asp-controller="ChatCliente" asp-action="Index">
                    <div class="st-buscador">
                        <input name="buscar" type="text" value="@Model.Buscar"
                               placeholder="Cédula, número de contrato o nombre del afiliado" autofocus />
                        <button type="submit" class="st-btn"><i class="fa fa-search"></i> Buscar</button>
                    </div>
                    <div class="st-pistas">
                        Por ejemplo:
                        <code class="st-pista">0911002475</code>
                        <code class="st-pista">549616</code>
                        <code class="st-pista">Cume Ortiz</code>
                    </div>
                </form>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Error))
        {
            <div class="alert alert-warning"><i class="fa fa-info-circle"></i> @Model.Error</div>
        }

        @if (Model.Elegir.Count > 0)
        {
        <div class="st-card">
            <div class="st-card-cuerpo" style="padding:0">
                <table class="table" style="margin:0">
                    @* Producto y región van SIEMPRE: una persona con dos
                       contratos sale dos veces, y sin ellos las dos filas son
                       idénticas y no se sabe cuál abrir. *@
                    <thead>
                        <tr>
                            <th>Afiliado</th><th>Cédula</th>
                            <th>Producto</th><th>Plan</th><th>Región</th>
                            <th>N.&ordm; de contrato</th>
                            <th>Solicitudes</th><th>Última consulta</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var a in Model.Elegir)
                    {
                        <tr>
                            <td><strong>@a.Nombre</strong></td>
                            <td>@a.Cedula</td>
                            <td><strong>@a.Producto</strong></td>
                            <td>@a.PlanVisible</td>
                            <td>@a.Region</td>
                            <td>@a.Contrato</td>
                            @* Dos fechas distintas que antes iban con una sola
                               etiqueta: cuantas solicitudes ha presentado, y
                               cuando se le consulto por el chat. Si nunca se le
                               consulto se dice, en vez de rellenar con la fecha
                               de la solicitud y hacerla pasar por otra cosa. *@
                            <td>@a.Solicitudes<span style="color:#8792a2;font-size:11.5px">
                                @(a.UltimaSolicitud.HasValue ? $" · última {a.UltimaSolicitud:dd/MM/yy}" : "")</span></td>
                            <td>@(a.UltimaConsulta?.ToString("dd/MM/yyyy HH:mm") ?? "nunca")</td>
                            <td class="text-right">
                                <a class="st-btn is-bajo"
                                   asp-area="Studio" asp-controller="ChatCliente" asp-action="Index"
                                   asp-route-caseCode="@a.CaseCode">
                                    <i class="fa fa-comments"></i> Consultar
                                </a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
        }
    </div>
}
else
{
<div class="cc-caja">
    <div class="cc-cab">
      <div class="cc-cab-fila">
        <div>
        <h2><i class="fa fa-comments"></i> Consulta sobre su cobertura</h2>
        <p>
            @Model.NombrePaciente
            @* El PRODUCTO es lo que decide de qué contrato se le habla: un IND y
               un TRK no tienen ni las mismas coberturas ni el mismo anexo. Sin
               verlo, quien atiende no sabe sobre qué está respondiendo. *@
            @if (!string.IsNullOrWhiteSpace(Model.CodigoProducto))
            {
                <text> · <strong>@Model.CodigoProducto</strong></text>
            }
            @if (!string.IsNullOrWhiteSpace(Model.NombrePlan))
            {
                <text> · @Model.NombrePlan</text>
                @if (!string.IsNullOrWhiteSpace(Model.CodigoPlan))
                {
                    <text> (@Model.CodigoPlan@(Model.VersionPlan.HasValue ? $" v{Model.VersionPlan}" : ""))</text>
                }
            }
            @* Es el NUMERO de contrato, no el codigo. Verificado contra
               ContratoJson: las 30 filas coinciden con $.Numero y ninguna con
               $.Codigo -que para este afiliado es 1642570, otro numero-. La
               etiqueta lo dice para que no haya que volver a comprobarlo. *@
            @if (!string.IsNullOrWhiteSpace(Model.NumeroContrato)) { <text> · contrato n.º @Model.NumeroContrato</text> }
        </p>

        @* Consultar sobre OTRO plan, para comparar. Va con aviso permanente: una
           respuesta de otro plan que parezca la suya es peor que no tenerla. *@
        @if (!string.IsNullOrWhiteSpace(Model.PlanConsultado))
        {
            <div class="cc-otroplan">
                <i class="fa fa-exchange"></i>
                Está consultando el plan <strong>@Model.PlanConsultado</strong>, que
                <strong>no es el suyo</strong> (@Model.CodigoPlan).
                <a asp-area="Studio" asp-controller="ChatCliente" asp-action="Index"
                   asp-route-caseCode="@Model.CaseCode">volver a su plan</a>
            </div>
        }
        else
        {
            <details class="cc-cambiar">
                <summary>Consultar sobre otro plan</summary>
                <form method="get" asp-area="Studio" asp-controller="ChatCliente" asp-action="Index">
                    <input type="hidden" name="caseCode" value="@Model.CaseCode" />
                    <input name="plan" type="text" placeholder="Código de plan, p. ej. N4-D-C" />
                    <button type="submit">Consultar ese plan</button>
                    <span>Para comparar. Se avisa en pantalla de que no es el suyo.</span>
                </form>
            </details>
        }
        </div>
        <button type="button" class="cc-bajar" id="ccBajar" title="Guardar esta consulta">
            <i class="fa fa-download"></i> Descargar la consulta
        </button>
      </div>
    </div>

    <div class="cc-hilo" id="ccHilo">
        @if (Model.Hilo.Count == 0)
        {
            <div class="cc-msg es-ella">Buenos días. Puedo consultarle lo de su contrato: qué le cubre su plan, cuánto le falta del deducible, en qué va un reembolso o hasta cuándo puede presentar una factura. ¿Qué necesita saber?</div>
        }
        else
        {
            @* La conversación de antes. Sale de StepExecution, donde ya se
               guardaba cada turno: al volver, sigue donde la dejó. *@
            foreach (var t in Model.Hilo)
            {
                <div class="cc-msg es-yo">@t.Pregunta</div>
                <div class="cc-msg es-ella" data-md="@t.Respuesta"></div>
            }
        }
    </div>

    <div class="cc-pie">
        <div class="cc-ideas" id="ccIdeas">
            <button type="button" class="cc-idea">¿Hasta cuándo puedo presentar una factura?</button>
            <button type="button" class="cc-idea">¿Cuánto me falta del deducible?</button>
            <button type="button" class="cc-idea">¿En qué va mi reembolso?</button>
            <button type="button" class="cc-idea">¿Me cubren si me pasa algo de viaje?</button>
        </div>
        <div class="cc-fila">
            <textarea id="ccTexto" rows="1" maxlength="600"
                      placeholder="Escriba su pregunta…" aria-label="Su pregunta"></textarea>
            <button type="button" class="cc-enviar" id="ccEnviar">Enviar</button>
        </div>
    </div>
</div>

@* El visor de la carta. Vacio hasta que se pide una: el iframe se rellena al
   abrirlo para no pedirle a Armonix un PDF que nadie ha mirado. *@
<aside class="cc-visor" id="ccVisor" aria-hidden="true" aria-label="Carta de autorización">
    <div class="cc-visor-cab">
        <h3 id="ccVisorTitulo">Carta de autorización</h3>
        <span class="sep"></span>
        <a id="ccVisorBajar" href="#" target="_blank" rel="noopener">
            <i class="fa fa-download"></i> Descargar
        </a>
        <button type="button" id="ccVisorCerrar" title="Cerrar (Esc)">
            <i class="fa fa-times"></i> Cerrar
        </button>
    </div>
    <div class="cc-visor-cuerpo">
        <div class="cc-visor-esperando" id="ccVisorEsperando">
            <span class="cc-puntos"><span></span><span></span><span></span></span>
            Trayendo la carta…
        </div>
        <iframe id="ccVisorMarco" title="Carta de autorización"></iframe>
    </div>
</aside>

@Html.AntiForgeryToken()

<script src="~/js/app/st-markdown.js" asp-append-version="true"></script>
<script>
(function () {
    'use strict';
    var hilo   = document.getElementById('ccHilo');
    var texto  = document.getElementById('ccTexto');
    var boton  = document.getElementById('ccEnviar');
    var caso   = '@Model.CaseCode';

    // El enlace de la carta lo arma el renderizador, y necesita saber de quien
    // es el caso: la identidad la pone la pantalla, nunca el texto del modelo.
    if (window.StMarkdown) StMarkdown.caso = caso;

    /* ── Abrir la carta en el visor ───────────────────────────────────────
       Los enlaces los escribe el modelo dentro de su respuesta, asi que no se
       les puede poner un manejador al crearlos: se escucha en el hilo entero y
       se mira si lo pulsado es un enlace de carta. Asi vale igual para los
       mensajes de ahora y para los que se pinten despues. */
    var visor      = document.getElementById('ccVisor');
    var marco      = document.getElementById('ccVisorMarco');
    var esperando  = document.getElementById('ccVisorEsperando');
    var visorTit   = document.getElementById('ccVisorTitulo');
    var visorBajar = document.getElementById('ccVisorBajar');

    function abrirCarta(href, numero) {
        visorTit.textContent = numero ? ('Carta de la autorización ' + numero)
                                      : 'Carta de autorización';
        visorBajar.href = href + '&descargar=1';
        esperando.classList.remove('oculto');
        // El visor del navegador abre con el panel de miniaturas y al 40%: en
        // 620 px la carta se queda ilegible, que es justo lo que se venia a
        // resolver. Se le pide sin miniaturas y ajustada al ancho. Si algun
        // navegador ignora estos parametros, los ignora y ya: no rompe nada.
        marco.src = href + '#toolbar=1&navpanes=0&view=FitH';
        visor.classList.add('abierto');
        visor.setAttribute('aria-hidden', 'false');
        document.body.classList.add('cc-con-visor');
    }

    function cerrarCarta() {
        visor.classList.remove('abierto');
        visor.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('cc-con-visor');
        // Se vacia al cerrar: un PDF de 80 KB por carta abierta se queda en
        // memoria si no, y al reabrir conviene que vuelva a pedirse.
        marco.src = 'about:blank';
    }

    marco.addEventListener('load', function () {
        if (marco.src && marco.src !== 'about:blank') esperando.classList.add('oculto');
    });

    hilo.addEventListener('click', function (ev) {
        var a = ev.target.closest ? ev.target.closest('a') : null;
        if (!a || !a.getAttribute('href')) return;
        var href = a.getAttribute('href');
        if (href.indexOf('/Studio/ChatCliente/Carta?id=') !== 0) return;   // otro enlace
        ev.preventDefault();

        // El numero del titulo sale de la FILA, no del enlace. El enlace lleva
        // el Id interno de la autorizacion -4879459-, y el afiliado conoce el
        // numero -6399932-, que es el que tiene delante en la tabla y el que le
        // piden por telefono. Ensenarle el id interno es ensenarle un dato que
        // no es suyo ni le sirve.
        //
        // El prompt manda poner el numero en la PRIMERA columna. Si aun asi no
        // sale un numero de ahi, el titulo va sin el: mejor generico que
        // equivocado.
        var fila = a.closest ? a.closest('tr') : null;
        var primera = fila && fila.cells.length ? fila.cells[0].textContent.trim() : '';
        abrirCarta(href, /^[0-9]{4,12}$/.test(primera) ? primera : '');
    });

    document.getElementById('ccVisorCerrar').addEventListener('click', cerrarCarta);
    document.addEventListener('keydown', function (ev) {
        if (ev.key === 'Escape' && visor.classList.contains('abierto')) cerrarCarta();
    });
    var url    = '@Url.Action("Preguntar", "ChatCliente", new { area = "Studio" })';
    var urlProgreso = '@Url.Action("Progreso", "ChatCliente", new { area = "Studio" })';
    var ocupado = false;

    function token() {
        var i = document.querySelector('input[name="__RequestVerificationToken"]');
        return i ? i.value : '';
    }

    function esc(s) {
        var d = document.createElement('div');
        d.textContent = s == null ? '' : s;
        return d.innerHTML;
    }

    /* La respuesta se formatea; lo que escribio el afiliado, NO.
       Formatear su texto seria interpretar lo que escribio, y un asterisco suyo
       no es una negrita. */
    /* ── El globo de espera ───────────────────────────────────────────────
       Se sondea Progreso mientras el modelo trabaja. No hace falta streaming:
       el ejecutor escribe una fila en ToolInvocation por cada llamada en cuanto
       empieza, asi que la lista ya existe en la base; aqui solo se mira.

       Cada segundo, que es el ritmo al que aparecen las tools. Mas rapido seria
       machacar la base para ver lo mismo. */
    var ICONOS = { ok: 'fa-check', atencion: 'fa-exclamation', fallo: 'fa-times',
                   neutro: 'fa-circle-o-notch fa-spin' };

    function globoEspera() {
        var d = document.createElement('div');
        d.className = 'cc-espera';
        d.innerHTML = '<span class="cc-puntos"><span></span><span></span><span></span></span> '
                    + 'Consultando sus datos…<ul class="cc-pasos"></ul>';
        hilo.appendChild(d);
        hilo.scrollTop = hilo.scrollHeight;

        var lista = d.querySelector('.cc-pasos');
        var vistos = {};
        var timer = setInterval(function () {
            fetch(urlProgreso + '?caseCode=' + encodeURIComponent(caso), { cache: 'no-store' })
                .then(function (r) { return r.json(); })
                .then(function (p) {
                    if (!p || !p.ok || !p.pasos) return;
                    p.pasos.forEach(function (x) {
                        /* Una fila se repinta cuando termina -entra sin fin y
                           vuelve con veredicto-, asi que se indexa por id. */
                        var li = vistos[x.id];
                        if (!li) {
                            li = document.createElement('li');
                            vistos[x.id] = li;
                            lista.appendChild(li);
                        }
                        var tono = x.tono || 'neutro';
                        li.className = (tono === 'neutro') ? 'corriendo' : tono;
                        li.innerHTML =
                            '<i class="ic fa ' + (ICONOS[tono] || ICONOS.neutro) + '"></i>'
                          + '<span></span>'
                          + (x.segundos != null ? '<span class="seg">' + x.segundos + 's</span>' : '');
                        li.querySelector('span').textContent =
                            x.resultado ? (x.que + ' · ' + x.resultado) : x.que;
                    });
                    hilo.scrollTop = hilo.scrollHeight;
                })
                .catch(function () { /* un sondeo fallido no rompe la espera */ });
        }, 1000);

        d.parar = function () { clearInterval(timer); d.remove(); };
        return d;
    }

    function burbuja(clase, contenido, reintentar) {
        var d = document.createElement('div');
        d.className = 'cc-msg ' + clase;
        if (clase === 'es-ella' && window.StMarkdown) d.innerHTML = StMarkdown.render(contenido);
        else d.textContent = contenido;

        /* Un error sin salida obliga a volver a teclear la pregunta. El boton
           la recuerda: se pulsa y se reintenta la MISMA, sin escribirla otra
           vez. Al reintentar se borra el error, para que no queden dos globos
           rojos de la misma pregunta. */
        if (clase === 'es-mal' && reintentar) {
            var b = document.createElement('button');
            b.type = 'button';
            b.className = 'cc-reintentar';
            b.innerHTML = '<i class="fa fa-refresh"></i> Volver a intentarlo';
            b.addEventListener('click', function () {
                d.remove();
                preguntar(reintentar);
            });
            d.appendChild(document.createElement('br'));
            d.appendChild(b);
        }

        hilo.appendChild(d);
        hilo.scrollTop = hilo.scrollHeight;
        return d;
    }

    /* El hilo que vino del servidor: se guarda en data-md para no meter HTML
       desde Razor, y se formatea aqui con las mismas reglas. */
    Array.prototype.forEach.call(hilo.querySelectorAll('[data-md]'), function (el) {
        el.innerHTML = window.StMarkdown
            ? StMarkdown.render(el.getAttribute('data-md'))
            : StMarkdown.escapar(el.getAttribute('data-md'));
        el.removeAttribute('data-md');
    });
    hilo.scrollTop = hilo.scrollHeight;

    /* Descargar la consulta.
       El afiliado quiere poder guardarla o adjuntarla a un correo. Va en texto
       plano y con fecha: es lo que se abre en cualquier sitio y lo que se puede
       reenviar sin depender de esta pantalla. */
    document.getElementById('ccBajar').addEventListener('click', function () {
        var lineas = ['Consulta sobre su cobertura - Salud S.A.',
                      '@Model.NombrePaciente' + '  ·  @Model.NombrePlan',
                      'Contrato @Model.NumeroContrato',
                      new Date().toLocaleString('es-EC'),
                      '', '─'.repeat(60), ''];

        Array.prototype.forEach.call(hilo.children, function (el) {
            if (!el.classList || !el.classList.contains('cc-msg')) return;
            var quien = el.classList.contains('es-yo') ? 'USTED PREGUNTO' : 'SALUD S.A.';
            lineas.push(quien + ':', (el.innerText || el.textContent || '').trim(), '');
        });

        lineas.push('─'.repeat(60));
        lineas.push('Esta consulta es informativa. El valor final de un reembolso');
        lineas.push('lo determina la liquidacion formal en Salud S.A.');

        var blob = new Blob([lineas.join(String.fromCharCode(10))],
                            { type: 'text/plain;charset=utf-8' });
        var a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'consulta-cobertura-' + new Date().toISOString().slice(0, 10) + '.txt';
        document.body.appendChild(a); a.click(); a.remove();
        setTimeout(function () { URL.revokeObjectURL(a.href); }, 1000);
    });

    /* Lo que consultó, plegado: respalda la respuesta sin robarle la atención. */
    function consultas(pasos) {
        if (!pasos || !pasos.length) return;
        var d = document.createElement('details');
        d.className = 'cc-consulto';
        var lis = pasos.map(function (p) {
            var tono = p.tono || 'neutro';
            return '<li class="' + tono + '"><span class="q">' + esc(p.que) + '</span>'
                 + (p.resultado ? '<span class="r">' + esc(p.resultado) + '</span>' : '')
                 + '</li>';
        }).join('');
        d.innerHTML = '<summary>Qué consulté para responderle (' + pasos.length + ')</summary>'
                    + '<ul>' + lis + '</ul>';
        hilo.appendChild(d);
        hilo.scrollTop = hilo.scrollHeight;
    }

    async function preguntar(q) {
        if (ocupado || !q) return;
        ocupado = true;
        boton.disabled = true;
        burbuja('es-yo', q);
        texto.value = '';
        texto.style.height = 'auto';

        // El globo que va contando lo que consulta, en vez de tres puntos mudos.
        var esperando = globoEspera();

        try {
            var fd = new FormData();
            fd.append('caseCode', caso);
            fd.append('pregunta', q);
            fd.append('plan', '@Model.PlanConsultado');
            fd.append('__RequestVerificationToken', token());

            var resp = await fetch(url, {
                method: 'POST', credentials: 'same-origin',
                headers: { 'RequestVerificationToken': token() }, body: fd
            });

            esperando.parar();

            if (!resp.ok) {
                burbuja('es-mal', 'No pude consultarlo ahora.', q);
            } else {
                var d = await resp.json();
                burbuja(d.ok ? 'es-ella' : 'es-mal', d.texto || 'No obtuve respuesta.', d.ok ? null : q);
                if (d.ok) consultas(d.consulto);
            }
        } catch (e) {
            esperando.parar();
            burbuja('es-mal', 'Se perdió la conexión.', q);
        } finally {
            ocupado = false;
            boton.disabled = false;
            texto.focus();
        }
    }

    boton.addEventListener('click', function () { preguntar(texto.value.trim()); });

    /* Enter envía, Mayús+Enter hace salto de línea: es lo que la gente espera. */
    texto.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); preguntar(texto.value.trim()); }
    });

    /* Crece con lo que se escribe, hasta el tope del CSS. */
    texto.addEventListener('input', function () {
        texto.style.height = 'auto';
        texto.style.height = Math.min(texto.scrollHeight, 120) + 'px';
    });

    document.getElementById('ccIdeas').addEventListener('click', function (e) {
        if (e.target.classList.contains('cc-idea')) preguntar(e.target.textContent.trim());
    });

    texto.focus();
})();
</script>
}
