@using app_ocr_ai_models.Areas.Studio.Models
@using app_tramites.Services.Ai
@model AnalizarResultadoViewModel
@{
    ViewData["Title"] = "Analizar Caso — Motor IA";
    // ¿Llegamos con un caso ya elegido (enlace desde la vista Caso)? Entonces
    // NO se pide teclear el GUID: se muestra como contexto de solo lectura.
    var tieneCaso = Model.Request.CaseCode != Guid.Empty;
    var shortCode = tieneCaso ? Model.Request.CaseCode.ToString().Split('-')[0] : null;
    var _embed = (ViewData["Embed"] as bool?) == true;   // dentro del workspace (iframe) se oculta la cabecera
}

<div class="st-head" style="@(_embed ? "display:none" : "")">
    <div class="st-head-main">
        <div class="st-crumbs">
            Studio /
            <a asp-area="Studio" asp-controller="Sobres" asp-action="Index">Sobres</a> /
            Analizar
        </div>
        <h1 class="st-title"><i class="fa fa-cogs"></i>Analizar con IA</h1>
        <p class="st-sub">El clasificador determina el proceso y luego se ejecutan los pasos en orden.</p>
    </div>
    @if (tieneCaso)
    {
        <div class="st-actions">
            <a class="btn btn-default" asp-area="Studio" asp-controller="Sobres" asp-action="Caso"
               asp-route-caseCode="@Model.Request.CaseCode">
                <i class="fa fa-arrow-left"></i> Volver al caso
            </a>
            <a class="btn btn-default" asp-area="Studio" asp-controller="Chat" asp-action="Index"
               asp-route-caseCode="@Model.Request.CaseCode">
                <i class="fa fa-comments-o"></i> Abrir chat
            </a>
            <a class="btn btn-default" asp-area="Studio" asp-controller="Analizar" asp-action="Informe"
               asp-route-caseCode="@Model.Request.CaseCode" target="_blank"
               title="Informe imprimible del análisis (Descargar PDF)">
                <i class="fa fa-file-pdf-o"></i> Informe PDF
            </a>
        </div>
    }
</div>

<div class="jarviswidget jarviswidget-color-darken" data-widget-editbutton="false" data-widget-deletebutton="false">
    <header>
        <span class="widget-icon"><i class="fa fa-bolt"></i></span>
        <h2>Disparar análisis</h2>
    </header>
    <div>
        <div class="widget-body">
            <form asp-area="Studio" asp-controller="Analizar" asp-action="Ejecutar" method="post" data-st-progreso data-st-titulo="Resolviendo el reembolso" data-st-etapas="Leyendo la auditoria y el expediente|Consultando el plan, el deducible y las coberturas|Aplicando las reglas una por una|Calculando la liquidacion propuesta|Guardando la resolucion" data-st-nota="Es el paso que mas consulta: plan, convenio, topes y carencias." data-st-segundos="20">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label class="control-label">Caso</label>
                    @if (tieneCaso)
                    {
                        @* Caso ya seleccionado: contexto de solo lectura + hidden con el GUID. *@
                        <input type="hidden" name="CaseCode" value="@Model.Request.CaseCode" />
                        <p class="form-control-static">
                            <i class="fa fa-folder-open text-muted"></i>
                            <strong>Caso @shortCode</strong>
                            <small class="text-muted" style="margin-left:8px; font-family:monospace;">@Model.Request.CaseCode</small>
                        </p>
                    }
                    else
                    {
                        @* Acceso directo sin caso: se permite pegar el CaseCode. *@
                        <input type="text" name="CaseCode" value="@Model.Request.CaseCode"
                               class="form-control" style="max-width:420px; font-family:monospace;"
                               placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" />
                        <small class="text-muted">Normalmente llegas aquí desde un caso; entonces este dato ya viene resuelto.</small>
                    }
                </div>

                <div class="form-group">
                    <label class="control-label">Proceso (opcional)</label>
                    <input type="text" name="ProcessCodeOverride" value="@Model.Request.ProcessCodeOverride"
                           class="form-control" style="max-width:280px;" placeholder="Ej: PROCESO_001" />
                    <small class="text-muted">Déjalo vacío para que el clasificador elija el proceso automáticamente.</small>
                </div>

                <button type="submit" class="btn btn-ia">
                    <i class="fa fa-play"></i> Ejecutar análisis IA
                </button>
            </form>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger"><strong><i class="fa fa-times-circle"></i> Error:</strong> @Model.Error</div>
}

@if (Model.Resultado != null)
{
    var r = Model.Resultado;

    <div class="jarviswidget jarviswidget-color-darken" data-widget-editbutton="false" data-widget-deletebutton="false">
        <header>
            <span class="widget-icon"><i class="fa fa-list-alt"></i></span>
            <h2>Resultado de la orquestación</h2>
        </header>
        <div>
            <div class="widget-body">
                <table class="st-meta">
                    <tr><th>CaseCode</th><td><code>@r.CaseCode</code></td></tr>
                    <tr><th>Proceso aplicado</th><td><code>@r.ProcessCode</code></td></tr>
                    <tr>
                        <th>Estado</th>
                        <td>
                            @if (r.Success)
                            {
                                <span class="label label-success">OK</span>
                            }
                            else
                            {
                                <span class="label label-danger">Error</span>
                            }
                        </td>
                    </tr>
                    <tr><th>Pasos ejecutados</th><td>@r.Steps.Count</td></tr>
                </table>

                @if (!string.IsNullOrWhiteSpace(r.ErrorMessage))
                {
                    <div class="alert alert-danger" style="margin-top:10px;">@r.ErrorMessage</div>
                }
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(r.ClassificationText))
    {
        <div class="jarviswidget jarviswidget-color-darken" data-widget-editbutton="false" data-widget-deletebutton="false">
            <header><span class="widget-icon"><i class="fa fa-random"></i></span><h2>Clasificador</h2></header>
            <div><div class="widget-body"><div class="st-response">@r.ClassificationText</div></div></div>
        </div>
    }

    @if (r.Steps.Count > 0)
    {
        <div class="jarviswidget jarviswidget-color-darken" data-widget-editbutton="false" data-widget-deletebutton="false">
            <header><span class="widget-icon"><i class="fa fa-list-ol"></i></span><h2>Pasos (@r.Steps.Count)</h2></header>
            <div>
                <div class="widget-body">
                    @foreach (var step in r.Steps)
                    {
                        <div class="st-step-card">
                            <h5>
                                Paso @step.StepOrder
                                @if (!string.IsNullOrWhiteSpace(step.StepName))
                                {
                                    <span class="text-muted" style="font-weight:400;"> — @step.StepName</span>
                                }
                            </h5>
                            <div class="st-step-meta">
                                Agente: <code>@step.ModelCode</code> ·
                                ExecutionId: <code>@step.ExecutionId</code> ·
                                Estado: <strong>@step.Status</strong> ·
                                Tokens: @step.PromptTokens entrada / @step.CompletionTokens salida
                            </div>
                            <details style="margin-bottom:8px;">
                                <summary style="cursor:pointer; color:var(--st-accent); font-size:12.5px;">Ver petición enviada</summary>
                                <pre class="st-req-pre">@step.RequestText</pre>
                            </details>
                            <div class="st-response">@step.ResponseText</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(r.FinalText) && r.Steps.Count > 0)
    {
        <div class="jarviswidget jarviswidget-color-darken" data-widget-editbutton="false" data-widget-deletebutton="false">
            <header><span class="widget-icon"><i class="fa fa-flag-checkered"></i></span><h2>Resultado final</h2></header>
            <div><div class="widget-body"><div class="st-response st-response--final">@r.FinalText</div></div></div>
        </div>
    }
}
@await Component.InvokeAsync("ToolsUsadas", new { caseCode = ViewContext.RouteData.Values["caseCode"] != null ? Guid.Parse(ViewContext.RouteData.Values["caseCode"]!.ToString()!) : (Context.Request.Query["caseCode"].Count > 0 ? Guid.Parse(Context.Request.Query["caseCode"]!) : Guid.Empty) })

@section Scripts {
    <script src="~/js/app/st-progreso.js" asp-append-version="true"></script>
}
