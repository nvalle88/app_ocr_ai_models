@Html.AntiForgeryToken()

@section Styles {
    <link rel="stylesheet" href="~/css/app/st-pdf-viewer.css" asp-append-version="true" />
}

@section Scripts {
    @* El modulo vive tambien en el padre para que las pestanas
       (que van en iframe) puedan delegar su overlay aqui y cubrir
       el area de trabajo entera. *@
    <script src="~/js/app/st-progreso.js" asp-append-version="true"></script>
    @* PDF.js servido desde el propio sitio (sin CDN) *@
    <script src="~/lib/pdfjs/pdf.min.js"></script>
    <script src="~/js/app/st-pdf-viewer.js" asp-append-version="true"></script>
    <script src="~/js/app/st-json.js" asp-append-version="true"></script>
    <script>
        // ================================================================
        // EL PROCESO COMO UNO SOLO
        // ----------------------------------------------------------------
        // Antes cada pestana tenia su propio boton "Generar" y el operador
        // tenia que ir de una en otra sin saber que faltaba. Aqui el paso se
        // pulsa para verlo, y un solo boton ejecuta EN ORDEN lo pendiente,
        // marcando cada paso al terminar y recargando su pestana.
        // ================================================================

        // Pulsar un paso del proceso lleva a su pestana.
        document.querySelectorAll('.st-flow-step').forEach(function (li) {
            li.addEventListener('click', function () { irTab(li.dataset.tab); });
        });

        function flowToken() {
            var i = document.querySelector('#stFlow, .st-flow-acc')
                        .parentNode.querySelector('input[name="__RequestVerificationToken"]');
            return i ? i.value : '';
        }

        function flowRecargarTab(tab) {
            var f = document.querySelector('#' + tab + ' iframe.st-tabframe');
            if (f && f.dataset.src) { f.setAttribute('src', f.dataset.src); }
        }

        var flowCorriendo = false;

        async function ejecutarProceso(rehacer) {
            if (flowCorriendo) return;

            var pasos = Array.prototype.slice.call(document.querySelectorAll('.st-flow-step'))
                .filter(function (li) {
                    if (!li.dataset.url) return false;                       // paso no automatizable
                    return rehacer ? true : li.classList.contains('is-pend');
                });

            if (!pasos.length) { return; }

            flowCorriendo = true;
            var btn = document.getElementById('btnProceso');
            var est = document.getElementById('flowEstado');
            var btnHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Ejecutando el proceso...';

            var hechos = 0, fallos = 0;
            for (var i = 0; i < pasos.length; i++) {
                var li = pasos[i];
                var titulo = li.querySelector('.st-flow-tit').textContent.trim();

                li.classList.remove('is-pend');
                li.classList.add('is-run');
                li.querySelector('.st-flow-num').innerHTML = '<i class="fa fa-spinner fa-spin"></i>';
                est.innerHTML = '<i class="fa fa-clock-o"></i> Paso ' + (i + 1) + ' de ' + pasos.length +
                                ': <strong>' + titulo + '</strong> - cada paso tarda 1-2 minutos';
                irTab(li.dataset.tab);

                try {
                    var fd = new FormData();
                    fd.append('caseCode', '@Model.Caso.CaseCode');
                    fd.append('embed', 'true');
                    fd.append('__RequestVerificationToken', flowToken());

                    var r = await fetch(li.dataset.url, {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: { 'RequestVerificationToken': flowToken() },
                        body: fd
                    });

                    li.classList.remove('is-run');
                    if (r.ok) {
                        li.classList.add('is-done');
                        li.querySelector('.st-flow-num').innerHTML = '<i class="fa fa-check"></i>';
                        flowRecargarTab(li.dataset.tab);
                        hechos++;
                    } else {
                        li.classList.add('is-error');
                        li.querySelector('.st-flow-num').innerHTML = '<i class="fa fa-exclamation"></i>';
                        fallos++;
                    }
                } catch (e) {
                    li.classList.remove('is-run');
                    li.classList.add('is-error');
                    li.querySelector('.st-flow-num').innerHTML = '<i class="fa fa-exclamation"></i>';
                    fallos++;
                }
            }

            btn.disabled = false;
            btn.innerHTML = btnHtml;
            flowCorriendo = false;

            est.innerHTML = fallos === 0
                ? '<span class="ok"><i class="fa fa-check-circle"></i> Proceso completo: ' + hechos + ' paso(s) ejecutado(s).</span>'
                : '<span class="err"><i class="fa fa-exclamation-triangle"></i> ' + hechos +
                  ' paso(s) ejecutado(s), ' + fallos + ' con error. Abre el paso marcado para ver el detalle.</span>';
        }
    </script>
    <script>
        // ============================================================
        // REQ-019 — Interactividad de la vista Caso.
        // ============================================================

        // URL objeto del visor actual (se libera al abrir otro / cerrar).

        // ── Visor embebido: descarga el documento por el PROXY autenticado
        //    (NexusController.DownloadCaseDocument) y lo muestra en pantalla.
        //    Se usa fetch→Blob→objectURL para evitar el Content-Disposition
        //    "attachment" del endpoint (que si no forzaría una descarga).
        document.querySelectorAll('.st-ver').forEach(function (btn) {
            btn.addEventListener('click', function () {
                verDocumento(btn.dataset.url, btn.dataset.name,
                             btn.dataset.image === '1', btn.dataset.pdf === '1');
            });
        });

        // ── Preguntar a la IA sobre un documento: abre la pestaña Chat con la
        //    pregunta precargada (recarga el iframe con &doc=...). ──
        document.querySelectorAll('.st-ask').forEach(function (b) {
            b.addEventListener('click', function () {
                var f = document.querySelector('#tab-chat iframe.st-tabframe');
                if (f && f.dataset.src) { f.setAttribute('src', f.dataset.src + '&doc=' + encodeURIComponent(b.dataset.name)); }
                irTab('tab-chat');
            });
        });

        // ── Visor: pinta el documento con PDF.js (wwwroot/js/app/st-pdf-viewer.js)
        //    en vez de delegar en el visor nativo del navegador. Motivo: con
        //    "descargar los PDF en lugar de abrirlos" activado, el <iframe>
        //    quedaba en blanco y el archivo se iba a Descargas.
        var stVisor = null;

        function verDocumento(url, nombre, esImagen, esPdf) {
            var panel = document.getElementById('stViewer');
            panel.style.display = 'block';
            document.getElementById('stViewerFile').textContent = nombre || 'Documento';
            document.getElementById('stViewerDownload').href = url;

            // Tipos que no se pueden pintar (docx, xlsx…): solo descarga.
            if (!esPdf && !esImagen) {
                document.getElementById('stViewerHost').innerHTML =
                    '<div class="stpdf-aviso">La vista previa no está disponible para este tipo de archivo. ' +
                    'Usa el botón Descargar.</div>';
                panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
                return;
            }

            if (!stVisor) {
                stVisor = StPdfViewer.create(document.getElementById('stViewerHost'), {});
            }
            stVisor.abrir({
                url: url + (url.indexOf('?') >= 0 ? '&' : '?') + 'inline=true',
                nombre: nombre,
                pagina: 1
            });
            panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        function cerrarVisor() {
            document.getElementById('stViewer').style.display = 'none';
        }

        // ── Copiar el texto OCR al portapapeles ──
        function copiarOcr(btn) {
            const box = btn.closest('details').querySelector('.st-ocr');
            if (!box) return;
            navigator.clipboard.writeText(box.textContent).then(function () {
                const orig = btn.innerHTML;
                btn.innerHTML = '<i class="fa fa-check"></i> Copiado';
                setTimeout(function () { btn.innerHTML = orig; }, 1500);
            });
        }

        // ── Adjuntar documentos (base64 → API JSON con antiforgery) ──
        async function adjuntarDocumentos() {
            const input = document.getElementById('archivosInput');
            if (!input.files.length) {
                alert('Selecciona al menos un archivo.');
                return;
            }

            const archivos = [];
            for (const f of input.files) {
                const base64 = await toBase64(f);
                const ext = '.' + f.name.split('.').pop().toLowerCase();
                archivos.push({ fileName: f.name, contentBase64: base64, extension: ext });
            }

            const antiforgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

            const res = await fetch('@Url.Action("AdjuntarDocumentos", "Sobres", new { area = "Studio" })', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': antiforgeryToken },
                body: JSON.stringify({ caseCode: '@Model.Caso.CaseCode', archivos: archivos })
            });

            const data = await res.json();
            const zona = document.getElementById('adjuntarResultado');
            if (data.ok) {
                zona.innerHTML = '<div class="alert alert-success">Adjuntados: ' + data.dataFileIds.length + ' archivo(s).' +
                    (data.advertencias.length ? '<br/>Advertencias: ' + data.advertencias.join(', ') : '') + '</div>';
                setTimeout(function () { location.reload(); }, 1600);
            } else {
                zona.innerHTML = '<div class="alert alert-danger">Error: ' + (data.error || 'Sin detalle') + '</div>';
            }
        }

        function toBase64(file) {
            return new Promise(function (resolve, reject) {
                const reader = new FileReader();
                reader.onload = function () { resolve(reader.result.split(',')[1]); };
                reader.onerror = reject;
                reader.readAsDataURL(file);
            });
        }

        // ── Pestañas del workspace: carga perezosa de iframes + deep-link por hash ──
        function irTab(id) { if (window.$) $('#casoTabs a[href="#' + id + '"]').tab('show'); }
        $(function () {
            $('#casoTabs a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
                var pane = document.querySelector(e.target.getAttribute('href'));
                var f = pane && pane.querySelector('iframe.st-tabframe');
                if (f && !f.getAttribute('src') && f.dataset.src) f.setAttribute('src', f.dataset.src);
            });
            var map = { '#analisis': 'tab-analisis', '#chat': 'tab-chat', '#reso': 'tab-reso', '#docs': 'tab-docs', '#expediente': 'tab-expediente', '#auditoria': 'tab-auditoria', '#tipificacion': 'tab-tipificacion' };
            if (map[location.hash]) irTab(map[location.hash]);
        });
    </script>
}
