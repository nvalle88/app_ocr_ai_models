@model CasoImportadoViewModel
@{
    ViewData["Title"] = $"Caso importado — {Model.Caso.CaseCode}";
    // Código corto del caso para mostrar en la cabecera (el GUID completo va en metadatos).
    var shortCode = Model.Caso.CaseCode.ToString().Split('-')[0];

    // Extensiones que el visor embebido puede mostrar como imagen.
    var imageExts = new HashSet<string> { ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".tiff", ".webp" };
}

@* ================================================================== *@
@* UN SOLO PROCESO, no siete pestanas sueltas.                        *@
@*   1) Barra de cliente FIJA: el operador nunca pierde de quien es   *@
@*      el sobre, en ningun paso.                                     *@
@*   2) El proceso como PASOS con estado real (hecho / pendiente),    *@
@*      que se pulsan para ir a ese paso.                             *@
@*   3) Un solo boton que ejecuta de corrido lo que falte.            *@
@*   4) Chat / Analisis IA quedan aparte: son herramientas, no pasos. *@
@* ================================================================== *@
@{
    var cli = Model.Cliente;
    string Money(decimal v) => v.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("es-EC"));
}

<div class="st-crumbs" style="margin-bottom:8px;">
    Studio /
    <a asp-area="Studio" asp-controller="Sobres" asp-action="Bandeja">Bandeja</a> /
    Caso @shortCode
</div>

@* -- 1) Identidad del cliente, pegada arriba mientras se trabaja ------- *@
<div class="st-cliente" id="clienteBar">
    <span class="st-cliente-av">@cli.Iniciales</span>
    <div class="st-cliente-id">
        <strong>@(string.IsNullOrWhiteSpace(cli.Titular) ? "Titular no identificado" : cli.Titular)</strong>
        <span>
            @if (!string.IsNullOrWhiteSpace(cli.Cedula)) { <text>C&eacute;d. @cli.Cedula</text> }
            @if (!string.IsNullOrWhiteSpace(cli.Contrato)) { <text> &middot; Contrato @cli.Contrato</text> }
            @if (!string.IsNullOrWhiteSpace(cli.Producto)) { <text> &middot; @cli.Producto</text> }
        </span>
    </div>
    <div class="st-cliente-datos">
        @if (!string.IsNullOrWhiteSpace(cli.NumeroSobre))
        {
            <span><i>Sobre</i>@cli.NumeroSobre</span>
        }
        @if (!string.IsNullOrWhiteSpace(cli.Prestador))
        {
            <span><i>Prestador</i>@cli.Prestador</span>
        }
        @if (!string.IsNullOrWhiteSpace(cli.FechaAtencion))
        {
            <span><i>Atenci&oacute;n</i>@cli.FechaAtencion</span>
        }
        @if (cli.TotalFacturado is > 0)
        {
            <span class="is-money"><i>Facturado</i>@Money(cli.TotalFacturado.Value)</span>
        }
        <span><i>Documentos</i>@Model.Archivos.Count</span>
    </div>
    <div class="st-cliente-acc">
        <a class="btn btn-xs btn-default"
           asp-area="Studio" asp-controller="Analizar" asp-action="Informe"
           asp-route-caseCode="@Model.Caso.CaseCode" target="_blank" title="Informe imprimible del caso">
            <i class="fa fa-file-pdf-o"></i> Informe
        </a>
        @if (Model.Archivos.Count > 0)
        {
            <a class="btn btn-xs btn-default"
               href="@Url.Action("DownloadCaseDocumentsZip", "Nexus", new { area = "", caseCode = Model.Caso.CaseCode })"
               title="Descargar todos los documentos del caso">
                <i class="fa fa-file-archive-o"></i> ZIP
            </a>
        }
    </div>
</div>

@* -- 2) El proceso: pasos con su estado real --------------------------- *@
<div class="st-flow-wrap">
    <ol class="st-flow" id="stFlow">
        @foreach (var paso in Model.Pasos)
        {
            <li class="st-flow-step @(paso.Hecho ? "is-done" : "is-pend")"
                data-tab="@paso.Tab" data-num="@paso.Numero"
                data-url="@paso.UrlGenerar" title="@paso.Entrega">
                <span class="st-flow-num">
                    @if (paso.Hecho) { <i class="fa fa-check"></i> } else { @paso.Numero }
                </span>
                <span class="st-flow-txt">
                    <span class="st-flow-tit"><i class="fa @paso.Icono"></i> @paso.Titulo</span>
                    <span class="st-flow-sub">@paso.Entrega</span>
                </span>
            </li>
        }
    </ol>

    <div class="st-flow-acc">
        @if (Model.PasosPendientes > 0)
        {
            <button type="button" class="btn btn-ia btn-lg" id="btnProceso"
                    onclick="ejecutarProceso()"
                    title="Ejecuta de corrido los pasos que faltan, en orden">
                <i class="fa fa-play-circle"></i>
                Ejecutar el proceso (@Model.PasosPendientes paso@(Model.PasosPendientes == 1 ? "" : "s") pendiente@(Model.PasosPendientes == 1 ? "" : "s"))
            </button>
        }
        else
        {
            <button type="button" class="btn btn-default btn-lg" id="btnProceso"
                    onclick="ejecutarProceso(true)"
                    title="Vuelve a ejecutar todo el proceso desde el paso 2">
                <i class="fa fa-refresh"></i> Rehacer el proceso completo
            </button>
        }
        @Html.AntiForgeryToken()
        <span class="st-flow-estado" id="flowEstado"></span>
        <span class="st-flow-tools">
            <a class="btn btn-default" href="#tab-chat" onclick="irTab('tab-chat');return false;">
                <i class="fa fa-comments-o"></i> Preguntar al caso
            </a>
            <a class="btn btn-default" href="#tab-analisis" onclick="irTab('tab-analisis');return false;">
                <i class="fa fa-cogs"></i> An&aacute;lisis libre IA
            </a>
        </span>
    </div>
    <div class="st-flow-meta">
        Proceso <code>@Model.ProcessCode</code> &middot; caso @shortCode &middot;
        importado @Model.Caso.StartDate.ToString("dd/MM/yyyy HH:mm")
        @if (!string.IsNullOrWhiteSpace(cli.Origen)) { <text> &middot; origen @cli.Origen</text> }
        @if (Model.Notas.Count > 0) { <text> &middot; @Model.Notas.Count nota(s)</text> }
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-info"><i class="fa fa-info-circle"></i>&nbsp; @Model.Mensaje</div>
}

@if (Model.AdvertenciasOcr.Count > 0)
{
    <div class="alert alert-warning">
        <strong><i class="fa fa-exclamation-triangle"></i> Advertencias OCR:</strong>
        <ul style="margin:6px 0 0; padding-left:18px;">
            @foreach (var adv in Model.AdvertenciasOcr)
            {
                <li>@adv</li>
            }
        </ul>
    </div>
}

@* -- Las pestanas siguen el MISMO orden del proceso -------------------- *@
<ul class="nav nav-tabs st-tabs-flow" id="casoTabs">
    @{ var primero = true; }
    @foreach (var paso in Model.Pasos)
    {
        <li class="@(primero ? "active" : "")">
            <a href="#@paso.Tab" data-toggle="tab">
                <span class="st-tab-num @(paso.Hecho ? "is-done" : "")">
                    @if (paso.Hecho) { <i class="fa fa-check"></i> } else { @paso.Numero }
                </span>
                @paso.Titulo
            </a>
        </li>
        primero = false;
    }
    <li class="st-tab-sep"><span>herramientas</span></li>
    @* El chat DEL AFILIADO, distinto del Chat del operador: habla con la persona,
       con su contrato delante y sin herramientas que busquen por nombre. *@
    <li><a href="#tab-chatcliente" data-toggle="tab"><i class="fa fa-comments"></i> Consulta del afiliado</a></li>
    <li><a href="#tab-chat" data-toggle="tab"><i class="fa fa-comments-o"></i> Chat</a></li>
    <li><a href="#tab-analisis" data-toggle="tab"><i class="fa fa-cogs"></i> An&aacute;lisis IA</a></li>
</ul>
<div class="tab-content" style="padding-top:16px;">
<div class="tab-pane active" id="tab-docs">

@* ── Visor embebido (oculto hasta pulsar "Ver" en un documento) ── *@
<div id="stViewer" class="st-viewer" style="display:none; margin-bottom:20px;">
    <div class="st-viewer-head">
        <span class="st-viewer-file" id="stViewerFile"></span>
        <span>
            <a id="stViewerDownload" href="#" class="btn btn-xs btn-default" target="_blank" rel="noopener">
                <i class="fa fa-download"></i> Descargar
            </a>
            <button type="button" class="btn btn-xs btn-default" onclick="cerrarVisor()">
                <i class="fa fa-times"></i> Cerrar
            </button>
        </span>
    </div>
    @* El componente StPdfViewer monta aquí su barra (hojas, zoom, búsqueda) y el lienzo *@
    <div id="stViewerHost"></div>
</div>

@* ── Documentos OCR ── *@
<div class="jarviswidget jarviswidget-color-darken" data-widget-editbutton="false" data-widget-deletebutton="false">
    <header>
        <span class="widget-icon"><i class="fa fa-file-text-o"></i></span>
        <h2>Documentos OCR (@Model.Archivos.Count)</h2>
    </header>
    <div>
        <div class="widget-body">
            @if (Model.Archivos.Count == 0)
            {
                <div class="st-empty">
                    <i class="fa fa-inbox"></i>
                    Este caso aún no tiene documentos. Puedes adjuntarlos abajo.
                </div>
            }
            else
            {
                <table class="table table-striped table-bordered table-hover" width="100%">
                    <thead>
                        <tr>
                            <th style="width:36px;">#</th>
                            <th>Documento</th>
                            <th>Texto OCR</th>
                            <th style="width:150px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var idx = 1; }
                        @foreach (var archivo in Model.Archivos)
                        {
                            var ext = System.IO.Path.GetExtension(archivo.OriginalName ?? string.Empty).ToLowerInvariant();
                            var esImagen = imageExts.Contains(ext);
                            var proxyUrl = Url.Action("DownloadCaseDocument", "Nexus",
                                new { area = "", caseCode = Model.Caso.CaseCode, fileId = archivo.Id });
                            var texto = archivo.Text ?? string.Empty;
                            <tr>
                                <td>@(idx++)</td>
                                <td>
                                    <div class="st-doc-name">@archivo.OriginalName</div>
                                    <small class="text-muted">@archivo.CreatedDate.ToString("dd/MM/yyyy HH:mm")</small>
                                </td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(texto))
                                    {
                                        <span class="st-ocr is-empty">(sin texto OCR)</span>
                                    }
                                    else
                                    {
                                        <details>
                                            <summary style="cursor:pointer; color:var(--st-accent); font-size:12.5px;">
                                                Ver texto (@texto.Length caracteres)
                                            </summary>
                                            <div class="st-ocr" style="margin-top:6px;">@texto</div>
                                            <div class="st-ocr-tools">
                                                <button type="button" class="btn btn-xs btn-default"
                                                        onclick="copiarOcr(this)">
                                                    <i class="fa fa-copy"></i> Copiar
                                                </button>
                                            </div>
                                        </details>
                                    }
                                </td>
                                <td>
                                    <div class="st-doc-actions">
                                        <button type="button" class="btn btn-xs btn-ia st-ver"
                                                data-url="@proxyUrl"
                                                data-name="@archivo.OriginalName"
                                                data-image="@(esImagen ? "1" : "0")"
                                                data-pdf="@(ext == ".pdf" ? "1" : "0")"
                                                title="Ver el documento en pantalla">
                                            <i class="fa fa-eye"></i> Ver
                                        </button>
                                        <a class="btn btn-xs btn-default" href="@proxyUrl"
                                           title="Descargar el archivo original">
                                            <i class="fa fa-download"></i>
                                        </a>
                                        <button type="button" class="btn btn-xs btn-default st-ask"
                                                data-name="@archivo.OriginalName"
                                                title="Preguntar a la IA sobre este documento">
                                            <i class="fa fa-question-circle"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

@* ── Notas del ticket ── *@
@if (Model.Notas.Count > 0)
{
    <div class="jarviswidget jarviswidget-color-darken" data-widget-editbutton="false" data-widget-deletebutton="false">
        <header>
            <span class="widget-icon"><i class="fa fa-sticky-note-o"></i></span>
            <h2>Datos del caso (@Model.Notas.Count)</h2>
        </header>
        <div>
            <div class="widget-body">
                @foreach (var nota in Model.Notas)
                {
                    @* El Detail de estas notas es JSON (ContextoSobre, ResolucionReembolso,
                       ExpedienteDocumental, AuditoriaMedicina). data-st-json hace que se
                       pinte como ficha legible y deje el original plegado. *@
                    var _titulo = nota.Title switch
                    {
                        "ContextoSobre"        => "Contexto del sobre",
                        "ResolucionReembolso"  => "Resolución de reembolso",
                        "ExpedienteDocumental" => "Expediente documental",
                        "AuditoriaMedicina"    => "Auditoría médica",
                        _                      => nota.Title
                    };
                    var _icono = nota.Title switch
                    {
                        "ContextoSobre"        => "fa-id-card-o",
                        "ResolucionReembolso"  => "fa-gavel",
                        "ExpedienteDocumental" => "fa-sitemap",
                        "AuditoriaMedicina"    => "fa-user-md",
                        _                      => "fa-sticky-note-o"
                    };

                    <div class="st-nota">
                        <div class="st-nota-head">
                            <span class="st-nota-tit"><i class="fa @_icono"></i> @_titulo</span>
                            <span class="st-nota-fecha">@nota.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="st-nota-cuerpo" data-st-json>@nota.Detail</div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@* ── Adjuntar documentos adicionales ── *@
<div class="jarviswidget jarviswidget-color-darken" data-widget-editbutton="false" data-widget-deletebutton="false">
    <header>
        <span class="widget-icon"><i class="fa fa-plus-circle"></i></span>
        <h2>Adjuntar documentos adicionales</h2>
    </header>
    <div>
        <div class="widget-body">
            <p class="text-muted" style="font-size:13px;">
                Sube documentos adicionales al caso. Cada archivo se procesa con OCR
                y queda disponible en el contexto del análisis IA.
            </p>
            <div class="form-inline">
                <input type="file" id="archivosInput" class="form-control" multiple
                       accept=".pdf,.jpg,.jpeg,.png,.tiff,.docx,.doc" style="max-width:420px;" />
                <button type="button" onclick="adjuntarDocumentos()" class="btn btn-primary">
                    <i class="fa fa-upload"></i> Adjuntar y procesar OCR
                </button>
            </div>
            <div id="adjuntarResultado" style="margin-top:12px;"></div>
        </div>
    </div>
</div>

</div>@* /tab-docs *@

<div class="tab-pane" id="tab-tipificacion">
    <iframe class="st-tabframe" data-src="@Url.Action("Index", "Clasificacion", new { area = "Studio", caseCode = Model.Caso.CaseCode, embed = true })"></iframe>
</div>
<div class="tab-pane" id="tab-expediente">
    <iframe class="st-tabframe" data-src="@Url.Action("Index", "Expediente", new { area = "Studio", caseCode = Model.Caso.CaseCode, embed = true })"></iframe>
