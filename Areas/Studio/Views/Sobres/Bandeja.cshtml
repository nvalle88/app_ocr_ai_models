@model BandejaViewModel
@{
    ViewData["Title"] = "Bandeja de casos";
}

<div class="st-head">
    <div class="st-head-main">
        <div class="st-crumbs">Studio / Bandeja</div>
        <h1 class="st-title"><i class="fa fa-inbox"></i>Bandeja de casos</h1>
        <p class="st-sub">Los sobres ya importados y analizados, con su estado y resolución.</p>
    </div>
    <div class="st-actions">
        <a class="btn btn-ia" asp-area="Studio" asp-controller="Sobres" asp-action="Index">
            <i class="fa fa-plus"></i> Nuevo caso / importar
        </a>
    </div>
</div>

<div class="st-kpis">
    <div class="st-kpi"><div class="st-kpi-value">@Model.TotalCasos</div><div class="st-kpi-label">Casos totales</div></div>
    <div class="st-kpi"><div class="st-kpi-value money-ok">@Model.ConResolucion</div><div class="st-kpi-label">Con resolución</div></div>
    <div class="st-kpi st-kpi--soft"><div class="st-kpi-value">@Model.Total</div><div class="st-kpi-label">En este filtro</div></div>
</div>

<div class="jarviswidget jarviswidget-color-darken" data-widget-editbutton="false" data-widget-deletebutton="false">
    <header><span class="widget-icon"><i class="fa fa-filter"></i></span><h2>Casos</h2></header>
    <div>
        <div class="widget-body">
            <form method="get" asp-area="Studio" asp-controller="Sobres" asp-action="Bandeja" class="form-inline" style="margin-bottom:14px;">
                <div class="form-group" style="margin-right:8px;">
                    <input type="text" name="search" value="@Model.Search" class="form-control" style="min-width:280px;"
                           placeholder="Buscar por sobre, cliente o proceso" />
                </div>
                <div class="form-group" style="margin-right:8px;">
                    <select name="estado" class="form-control">
                        <option value="">Todos los estados</option>
                        @foreach (var e in Model.EstadosDisponibles)
                        {
                            <option value="@e" selected="@(e == Model.Estado)">@e</option>
                        }
                    </select>
                </div>
                <button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> Filtrar</button>
                @if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Estado))
                {
                    <a class="btn btn-default" asp-area="Studio" asp-controller="Sobres" asp-action="Bandeja">Limpiar</a>
                }
            </form>

            @if (Model.Casos.Count == 0)
            {
                <div class="st-empty"><i class="fa fa-inbox"></i> No hay casos que coincidan. Importa un sobre para empezar.</div>
            }
            else
            {
                <table class="table table-striped table-bordered table-hover" width="100%">
                    <thead>
                        <tr>
                            <th>Caso / Sobre</th>
                            <th>Cliente</th>
                            <th>Origen</th>
                            <th>Proceso</th>
                            <th>Estado</th>
                            <th style="text-align:center;">Docs</th>
                            <th>Resolución</th>
                            <th>Fecha</th>
                            <th style="width:170px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Casos)
                        {
                            <tr>
                                <td>
                                    <a asp-area="Studio" asp-controller="Sobres" asp-action="Caso" asp-route-caseCode="@c.CaseCode">
                                        <strong>@(string.IsNullOrWhiteSpace(c.NumeroSobre) ? c.ShortCode : c.NumeroSobre)</strong>
                                    </a>
                                    @if (!string.IsNullOrWhiteSpace(c.NumeroSobre)) { <br /><small class="text-muted">@c.ShortCode</small> }
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(c.Cliente) ? "—" : c.Cliente)</td>
                                <td>@(string.IsNullOrWhiteSpace(c.Origen) ? "—" : c.Origen)</td>
                                <td><small>@(c.ProcesoNombre ?? c.DefinitionCode)</small></td>
                                <td><span class="label label-default">@c.Estado</span></td>
                                <td style="text-align:center;">@c.NumDocumentos</td>
                                <td>
                                    @if (c.TieneResolucion)
                                    {
                                        <span class="label @c.ResolucionCss">@c.ResolucionLabel</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td><small>@c.StartDate.ToString("dd/MM/yyyy HH:mm")</small></td>
                                <td>
                                    <a class="btn btn-xs btn-default" asp-area="Studio" asp-controller="Sobres" asp-action="Caso" asp-route-caseCode="@c.CaseCode" title="Abrir caso"><i class="fa fa-folder-open"></i></a>
                                    <a class="btn btn-xs btn-default" asp-area="Studio" asp-controller="Chat" asp-action="Index" asp-route-caseCode="@c.CaseCode" title="Chat"><i class="fa fa-comments-o"></i></a>
                                    <a class="btn btn-xs btn-ia" asp-area="Studio" asp-controller="Resolucion" asp-action="Index" asp-route-caseCode="@c.CaseCode" title="Resolución"><i class="fa fa-gavel"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (Model.TotalPages > 1)
                {
                    <nav style="text-align:center; margin-top:8px;">
                        <ul class="pagination" style="margin:0;">
                            @for (var i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="@(i == Model.Page ? "active" : "")">
                                    <a asp-area="Studio" asp-controller="Sobres" asp-action="Bandeja"
                                       asp-route-search="@Model.Search" asp-route-estado="@Model.Estado" asp-route-page="@i">@i</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/app/st-portal.css" asp-append-version="true" />
}
