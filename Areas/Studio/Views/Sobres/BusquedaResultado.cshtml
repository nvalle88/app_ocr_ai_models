@model BusquedaSobreResultViewModel
@{
    ViewData["Title"] = "Resultados de búsqueda";
}

<div class="st-head">
    <div class="st-head-main">
        <div class="st-crumbs">
            Studio / <a asp-area="Studio" asp-controller="Sobres" asp-action="Index">Sobres</a> / Resultados
        </div>
        <h1 class="st-title"><i class="fa fa-search"></i>Resultados</h1>
        <p class="st-sub">Búsqueda: <strong>@Model.NumeroSobreBuscado</strong></p>
    </div>
    <div class="st-actions">
        <a asp-area="Studio" asp-controller="Sobres" asp-action="Index" class="btn btn-default">
            <i class="fa fa-search"></i> Nueva búsqueda
        </a>
    </div>
</div>

<div class="jarviswidget jarviswidget-color-darken" data-widget-editbutton="false" data-widget-deletebutton="false">
    <header><span class="widget-icon"><i class="fa fa-life-ring"></i></span><h2>Tickets encontrados</h2></header>
    <div>
        <div class="widget-body">
            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <div class="alert alert-danger">@Model.Error</div>
            }
            else if (Model.Resultados.Count == 0 || Model.Resultados.All(r => r.Items.Count == 0))
            {
                <div class="st-empty">
                    <i class="fa fa-inbox"></i>
                    No se encontraron tickets con el número de sobre <strong>@Model.NumeroSobreBuscado</strong>.
                </div>
            }
            else
            {
                foreach (var grupo in Model.Resultados.Where(r => r.Items.Count > 0))
                {
                    <h5 style="margin-top:6px;">
                        Cuenta: <span class="label label-info">@grupo.Cuenta</span>
                        <small class="text-muted">(@grupo.TotalCount resultados)</small>
                    </h5>
                    <table class="table table-striped table-bordered table-hover" width="100%">
                        <thead>
                            <tr>
                                <th>Ticket #</th>
                                <th>Asunto</th>
                                <th>Estado</th>
                                <th>Nro. Sobre</th>
                                <th>Cédula</th>
                                <th>Creado</th>
                                <th style="width:130px;">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in grupo.Items)
                            {
                                <tr>
                                    <td><strong>#@item.Id</strong></td>
                                    <td>@item.Subject</td>
                                    <td><span class="label label-default">@item.Status</span></td>
                                    <td>@item.NumeroSobre</td>
                                    <td>@item.CedulaBeneficiario</td>
                                    <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <a class="btn btn-xs btn-primary"
                                           asp-area="Studio" asp-controller="Sobres" asp-action="Confirmar"
                                           asp-route-ticketId="@item.Id"
                                           asp-route-cuenta="@item.Cuenta"
                                           asp-route-processCode="@Model.ProcessCode">
                                            <i class="fa fa-eye"></i> Ver / Importar
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }
        </div>
    </div>
</div>
