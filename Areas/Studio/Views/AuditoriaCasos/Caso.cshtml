@model AuditoriaCasoViewModel
@{
    ViewData["Title"] = "Auditoría — " + (Model.NumeroSobre ?? "caso");
    string RiesgoClass(string? n) => (n ?? "").ToLower() switch { "alto" => "danger", "medio" => "warning", "bajo" => "success", _ => "default" };
    string ResoClass(string? r) => (r ?? "").ToLower() switch {
        var s when s.Contains("aprob") => "success",
        var s when s.Contains("negad") => "danger",
        var s when s.Contains("parcial") => "warning",
        var s when s.Contains("escal") => "info",
        _ => "default" };
    var d = Model.Dictamen;
}

<div class="st-head">
    <div class="st-head-main">
        <div class="st-crumbs">
            Studio / <a asp-area="Studio" asp-controller="AuditoriaCasos" asp-action="Index">Auditoría Casos</a> / @Model.NumeroSobre
        </div>
        <h1 class="st-title"><i class="fa fa-stethoscope"></i>Auditoría del sobre @Model.NumeroSobre</h1>
        <p class="st-sub">
            Titular: <strong>@(Model.NombreTitular ?? "—")</strong> ·
            Producto: <strong>@(Model.Producto ?? "—")</strong> ·
            Contrato: <strong>@(Model.NumeroContrato ?? "—")</strong> ·
            Documentos: <strong>@Model.Documentos.Count</strong>
        </p>
    </div>
    <div class="st-head-actions">
        <form asp-area="Studio" asp-controller="AuditoriaCasos" asp-action="Generar" method="post"
              onsubmit="mostrarLoadingPanel('content', 'El auditor IA está analizando el caso…');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="caseCode" value="@Model.CaseCode" />
            <button type="submit" class="btn btn-lg @(Model.Generada ? "btn-default" : "btn-primary")">
                <i class="fa fa-magic"></i> @(Model.Generada ? "Regenerar dictamen" : "Generar dictamen")
            </button>
        </form>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-warning"><i class="fa fa-exclamation-triangle"></i> @Model.Error</div>
}

@* ── Documentos del sobre ─────────────────────────────────────────── *@
<div class="jarviswidget" data-widget-editbutton="false" data-widget-deletebutton="false">
    <header><span class="widget-icon"><i class="fa fa-files-o"></i></span><h2>Documentos del sobre (@Model.Documentos.Count)</h2></header>
    <div><div class="widget-body no-padding">
        @if (!Model.Documentos.Any())
        {
            <p class="text-muted" style="padding:16px;">No se trajeron documentos (revisa la conexión con Armonix/M-Files).</p>
        }
        else
        {
            <table class="table table-striped table-sm">
                <thead><tr><th>Documento</th><th>OCR</th><th></th></tr></thead>
                <tbody>
                @foreach (var f in Model.Documentos)
                {
                    <tr>
                        <td><i class="fa fa-file-pdf-o"></i> @f.OriginalName</td>
                        <td>@(string.IsNullOrWhiteSpace(f.Text) ? "—" : (f.Text.Length + " car."))</td>
                        <td class="text-right">
                            @if (f.IsFileUri && !string.IsNullOrEmpty(f.FileUri))
                            { <a class="btn btn-xs btn-default" href="@f.FileUri" target="_blank"><i class="fa fa-external-link"></i> Ver</a> }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div></div>
</div>

@if (!Model.Generada)
{
    <div class="well text-center" style="padding:28px;">
        <p class="text-muted" style="font-size:15px;">
            <i class="fa fa-info-circle"></i>
            Pulsa <strong>Generar dictamen</strong> para que el auditor IA analice pertinencia médica,
            cobertura contractual (biblioteca de anexos), preexistencias, carencias, exclusiones y alertas de fraude.
        </p>
    </div>
}
else if (d != null)
{
    <div class="alert alert-info" style="margin-bottom:12px;">
        <i class="fa fa-robot"></i> Dictamen generado el @Model.GeneradoEn?.ToLocalTime().ToString("dd/MM/yyyy HH:mm").
        <strong>Recomendación, no resolución</strong>: el auditor decide.
    </div>

    @* ── 4. Recomendación (arriba, es lo primero que el auditor quiere ver) ── *@
    @if (d.Recomendacion != null)
    {
        <div class="jarviswidget jarviswidget-color-darken" data-widget-editbutton="false" data-widget-deletebutton="false">
            <header><span class="widget-icon"><i class="fa fa-gavel"></i></span><h2>Recomendación</h2></header>
            <div><div class="widget-body">
                <h3 style="margin-top:0;">
                    <span class="label label-@ResoClass(d.Recomendacion.Resolucion)" style="font-size:16px;">@d.Recomendacion.Resolucion</span>
                </h3>
                <p style="font-size:15px;">@d.Recomendacion.MotivoPrincipal</p>
                <p>
                    <strong>Confianza:</strong> @d.Recomendacion.NivelConfianza &nbsp;·&nbsp;
                    <strong>Riesgo legal:</strong>
                    <span class="label label-@RiesgoClass(d.Recomendacion.RiesgoLegal?.Nivel)">@(d.Recomendacion.RiesgoLegal?.Nivel ?? "—")</span>
                    @if (!string.IsNullOrEmpty(d.Recomendacion.RiesgoLegal?.Razon)) { <small class="text-muted"> — @d.Recomendacion.RiesgoLegal!.Razon</small> }
                </p>
            </div></div>
        </div>
    }

    @* ── 0. Datos del caso ── *@
    @if (d.DatosCaso != null)
    {
        <div class="jarviswidget" data-widget-editbutton="false" data-widget-deletebutton="false">
            <header><span class="widget-icon"><i class="fa fa-id-card-o"></i></span><h2>Datos del caso</h2></header>
            <div><div class="widget-body">
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Contrato / plan:</strong> @d.DatosCaso.ContratoPlan</p>
                        <p><strong>Inicio cobertura:</strong> @d.DatosCaso.FechaInicioCobertura</p>
                        <p><strong>Fecha atención:</strong> @d.DatosCaso.FechaAtencion</p>
                        <p><strong>Monto solicitado:</strong> @d.DatosCaso.MontoSolicitado</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Diagnóstico:</strong> @d.DatosCaso.Diagnostico</p>
                        <p><strong>Procedimiento:</strong> @d.DatosCaso.Procedimiento</p>
                    </div>
                </div>
                @if (d.DatosCaso.InformacionFaltante.Any())
                {
                    <div class="alert alert-warning" style="margin-bottom:0;">
                        <strong><i class="fa fa-exclamation-circle"></i> Información faltante:</strong>
                        <ul style="margin:6px 0 0;">@foreach (var x in d.DatosCaso.InformacionFaltante) { <li>@x</li> }</ul>
                    </div>
                }
            </div></div>
        </div>
    }

    <div class="row">
        @* ── 1. Análisis clínico ── *@
        <div class="col-md-6">
            <div class="jarviswidget" data-widget-editbutton="false" data-widget-deletebutton="false">
                <header><span class="widget-icon"><i class="fa fa-heartbeat"></i></span><h2>1 · Análisis clínico</h2></header>
                <div><div class="widget-body">
                    @if (d.AnalisisClinico != null)
                    {
                        <p><strong>Pertinencia:</strong> <span class="label label-info">@d.AnalisisClinico.Pertinencia</span></p>
                        <p>@d.AnalisisClinico.Justificacion</p>
                        @if (d.AnalisisClinico.Fuente != null && !string.IsNullOrEmpty(d.AnalisisClinico.Fuente.Guia))
                        {
                            <p class="text-muted"><small><i class="fa fa-book"></i>
                                @d.AnalisisClinico.Fuente.Guia — @d.AnalisisClinico.Fuente.Organizacion @d.AnalisisClinico.Fuente.Anio.
                                @d.AnalisisClinico.Fuente.Resumen</small></p>
                        }
                    }
                    else { <p class="text-muted">—</p> }
                </div></div>
            </div>
        </div>

        @* ── 2. Análisis contractual ── *@
        <div class="col-md-6">
            <div class="jarviswidget" data-widget-editbutton="false" data-widget-deletebutton="false">
                <header><span class="widget-icon"><i class="fa fa-file-text"></i></span><h2>2 · Análisis contractual</h2></header>
                <div><div class="widget-body">
                    @if (d.AnalisisContractual != null)
                    {
                        var ac = d.AnalisisContractual;
                        @if (ac.Cobertura != null)
                        {
                            <p><strong>Cobertura:</strong>
                                @if (ac.Cobertura.Incluido == true) { <span class="label label-success">Incluido</span> }
                                else if (ac.Cobertura.Incluido == false) { <span class="label label-danger">No incluido</span> }
                                @if (!string.IsNullOrEmpty(ac.Cobertura.Porcentaje)) { <text> · @ac.Cobertura.Porcentaje</text> }
                                @if (!string.IsNullOrEmpty(ac.Cobertura.Tope)) { <text> · tope @ac.Cobertura.Tope</text> }
                                @if (!string.IsNullOrEmpty(ac.Cobertura.Deducible)) { <text> · deducible @ac.Cobertura.Deducible</text> }
                            </p>
                            @if (!string.IsNullOrEmpty(ac.Cobertura.Notas)) { <p class="text-muted"><small>@ac.Cobertura.Notas</small></p> }
                        }
                        @if (ac.Preexistencias != null && !string.IsNullOrEmpty(ac.Preexistencias.Hallazgo))
                        {
                            <p><strong>Preexistencias:</strong> @ac.Preexistencias.Hallazgo
                                @if (!string.IsNullOrEmpty(ac.Preexistencias.TipoNexo)) { <em>(@ac.Preexistencias.TipoNexo)</em> }</p>
                        }
                        @if (ac.Carencias != null && ac.Carencias.Aplica == true)
                        { <p><strong>Carencia:</strong> <span class="label label-warning">Aplica</span> @ac.Carencias.Detalle</p> }
                        @if (ac.Exclusiones != null && ac.Exclusiones.Aplica == true)
                        {
                            <p><strong>Exclusión:</strong> <span class="label label-danger">Aplica</span> @ac.Exclusiones.TextoCitado
                                @if (!string.IsNullOrEmpty(ac.Exclusiones.Clausula)) { <small class="text-muted">(@ac.Exclusiones.Clausula)</small> }</p>
                        }
                    }
                    else { <p class="text-muted">—</p> }
                </div></div>
            </div>
        </div>
    </div>

    @* ── 3. Alertas de fraude ── *@
    <div class="jarviswidget @(d.AlertasFraude.Any() ? "jarviswidget-color-red" : "")" data-widget-editbutton="false" data-widget-deletebutton="false">
        <header><span class="widget-icon"><i class="fa fa-exclamation-triangle"></i></span><h2>3 · Alertas de fraude o inconsistencia (@d.AlertasFraude.Count)</h2></header>
        <div><div class="widget-body">
            @if (!d.AlertasFraude.Any())
            {
                <p class="text-success"><i class="fa fa-check-circle"></i> Sin alertas identificadas.</p>
            }
            else
            {
                foreach (var a in d.AlertasFraude)
                {
                    <div class="alert alert-danger" style="margin-bottom:8px;">
                        <strong>@a.Hallazgo</strong>
                        @if (!string.IsNullOrEmpty(a.Documento)) { <span class="text-muted"> — @a.Documento</span> }
                        @if (!string.IsNullOrEmpty(a.PorQue)) { <div><small>@a.PorQue</small></div> }
                    </div>
                }
            }
        </div></div>
    </div>

    @* ── 5. Bloque para redactor ── *@
    @if (d.BloqueRedactor != null)
    {
        <div class="jarviswidget" data-widget-editbutton="false" data-widget-deletebutton="false">
            <header><span class="widget-icon"><i class="fa fa-pencil"></i></span><h2>5 · Bloque para redactor (uso interno)</h2></header>
            <div><div class="widget-body">
                <p><strong>Tipo de resolución:</strong> @d.BloqueRedactor.TipoResolucion</p>
                <p><strong>Motivo principal:</strong> @d.BloqueRedactor.MotivoPrincipal</p>
                @if (d.BloqueRedactor.ElementosClave.Any())
                {
                    <p><strong>Elementos clave para la carta:</strong></p>
                    <ul>@foreach (var e in d.BloqueRedactor.ElementosClave) { <li>@e</li> }</ul>
                }
                @if (d.BloqueRedactor.Alertas.Any())
                {
                    <p><strong>Banderas de riesgo:</strong></p>
                    <ul>@foreach (var e in d.BloqueRedactor.Alertas) { <li>@e</li> }</ul>
                }
            </div></div>
        </div>
    }
}
else if (!string.IsNullOrEmpty(Model.RawText))
{
    <div class="jarviswidget" data-widget-editbutton="false" data-widget-deletebutton="false">
        <header><span class="widget-icon"><i class="fa fa-file-text-o"></i></span><h2>Dictamen (texto)</h2></header>
        <div><div class="widget-body"><pre style="white-space:pre-wrap;">@Model.RawText</pre></div></div>
    </div>
}

<a class="btn btn-default" asp-area="Studio" asp-controller="AuditoriaCasos" asp-action="Index"><i class="fa fa-arrow-left"></i> Volver a Auditoría Casos</a>
