@model AnexosIndexViewModel
@{
    ViewData["Title"] = "Biblioteca de anexos";
}

<div class="st-head">
    <div class="st-head-main">
        <div class="st-crumbs">
            Studio / Auditoría / Biblioteca de anexos
        </div>
        <h1 class="st-title"><i class="fa fa-book"></i>Biblioteca de anexos</h1>
        <p class="st-sub">
            Sube el contrato base o el anexo de un plan: el sistema lo lee con OCR, lo
            <strong>estructura con IA</strong> (coberturas, topes, deducibles, carencias, exclusiones, cláusulas)
            y lo guarda aquí. El agente auditor consulta estas condiciones directamente de esta base.
        </p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-success"><i class="fa fa-check-circle"></i> @Model.Mensaje</div>
}
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger"><i class="fa fa-exclamation-triangle"></i> @Model.Error</div>
}

<div class="row">
    <div class="col-md-5">
        <div class="jarviswidget jarviswidget-color-darken" data-widget-editbutton="false" data-widget-deletebutton="false">
            <header><span class="widget-icon"><i class="fa fa-upload"></i></span><h2>Cargar contrato / anexo</h2></header>
            <div>
                <div class="widget-body">
                    <form asp-area="Studio" asp-controller="Anexos" asp-action="Cargar" method="post"
                          enctype="multipart/form-data"
                          onsubmit="mostrarLoadingPanel('content', 'Leyendo y estructurando el anexo…');">
                        @Html.AntiForgeryToken()

                        <div class="form-group">
                            <label class="control-label">Archivo (PDF o imagen) <span class="text-danger">*</span></label>
                            <input type="file" name="archivo" class="form-control" accept=".pdf,.png,.jpg,.jpeg,.tif,.tiff" required />
                        </div>

                        <div class="form-group">
                            <label class="control-label">Tipo de contrato base</label>
                            <select name="tipo" class="form-control">
                                <option value="Individual">Individual</option>
                                <option value="Tradicional">Tradicional</option>
                                <option value="OptimusPlus">Optimus Plus</option>
                                <option value="Oncologico">Oncológico</option>
                                <option value="Corporativo">Corporativo</option>
                            </select>
                            <small class="text-muted">Se usa si el documento no lo indica.</small>
                        </div>

                        <div class="form-group">
                            <label class="control-label">Código de plan (opcional)</label>
                            <input type="text" name="codigoPlan" class="form-control" placeholder="p. ej. N7-D-C, Pro150K…" />
                            <small class="text-muted">Enlaza el anexo con el plan del cliente. Si el documento lo trae, se detecta solo.</small>
                        </div>

                        <button type="submit" class="btn btn-primary btn-block">
                            <i class="fa fa-magic"></i> Procesar con OCR + IA
                        </button>
                    </form>
                </div>
            </div>
        </div>

        @if (Model.UltimasIngestas.Any())
        {
            <div class="jarviswidget" data-widget-editbutton="false" data-widget-deletebutton="false">
                <header><span class="widget-icon"><i class="fa fa-history"></i></span><h2>Últimas cargas</h2></header>
                <div><div class="widget-body no-padding">
                    <table class="table table-sm table-striped">
                        <thead><tr><th>Archivo</th><th>Estado</th><th>Fecha</th></tr></thead>
                        <tbody>
                        @foreach (var i in Model.UltimasIngestas)
                        {
                            <tr>
                                <td class="text-truncate" style="max-width:180px;" title="@i.Archivo">@i.Archivo</td>
                                <td>
                                    @if (i.Estado == "GUARDADO")
                                    { <span class="label label-success">@i.Estado</span> }
                                    else if (i.Estado == "ERROR")
                                    { <span class="label label-danger" title="@i.Mensaje">@i.Estado</span> }
                                    else
                                    { <span class="label label-default">@i.Estado</span> }
                                </td>
                                <td><small>@i.CreatedDate.ToLocalTime().ToString("dd/MM HH:mm")</small></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div></div>
            </div>
        }
    </div>

    <div class="col-md-7">
        <div class="jarviswidget jarviswidget-color-darken" data-widget-editbutton="false" data-widget-deletebutton="false">
            <header><span class="widget-icon"><i class="fa fa-list"></i></span><h2>Anexos estructurados (@Model.Anexos.Count)</h2></header>
            <div><div class="widget-body no-padding">
                @if (!Model.Anexos.Any())
                {
                    <p class="text-muted" style="padding:16px;">Todavía no hay anexos. Carga el primero con el formulario de la izquierda.</p>
                }
                else
                {
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Plan</th><th>Producto</th><th>Tipo</th>
                                <th class="text-center">Cob.</th><th class="text-center">Car.</th><th class="text-center">Excl.</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var a in Model.Anexos)
                        {
                            <tr>
                                <td>
                                    <a asp-area="Studio" asp-controller="Anexos" asp-action="Detalle" asp-route-id="@a.Id">
                                        <strong>@a.CodigoPlan</strong>
                                    </a>
                                    @if (!string.IsNullOrEmpty(a.NombrePlan)) { <br /><small class="text-muted">@a.NombrePlan</small> }
                                </td>
                                <td>@a.CodigoProducto</td>
                                <td>@(a.TipoContrato ?? "—")</td>
                                <td class="text-center"><span class="badge">@a.Coberturas</span></td>
                                <td class="text-center"><span class="badge">@a.Carencias</span></td>
                                <td class="text-center"><span class="badge">@a.Exclusiones</span></td>
                                <td class="text-right">
                                    <a class="btn btn-xs btn-default" asp-area="Studio" asp-controller="Anexos" asp-action="Detalle" asp-route-id="@a.Id">
                                        <i class="fa fa-eye"></i>
                                    </a>
                                    <form asp-area="Studio" asp-controller="Anexos" asp-action="Eliminar" asp-route-id="@a.Id"
                                          method="post" style="display:inline;" onsubmit="return confirm('¿Eliminar el anexo @a.CodigoPlan?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-xs btn-danger"><i class="fa fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </div></div>
        </div>

        @if (Model.Contratos.Any())
        {
            <div class="jarviswidget" data-widget-editbutton="false" data-widget-deletebutton="false">
                <header><span class="widget-icon"><i class="fa fa-file-text-o"></i></span><h2>Contratos base (@Model.Contratos.Count)</h2></header>
                <div><div class="widget-body no-padding">
                    <table class="table table-striped">
                        <thead><tr><th>Tipo</th><th>Nombre</th><th>ACESS</th><th>Versión</th></tr></thead>
                        <tbody>
                        @foreach (var c in Model.Contratos)
                        {
                            <tr>
                                <td><strong>@c.Tipo</strong></td>
                                <td>@c.Nombre</td>
                                <td>@(c.CodigoAcess ?? "—")</td>
                                <td>@(c.Version ?? "—")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div></div>
            </div>
        }
    </div>
</div>
