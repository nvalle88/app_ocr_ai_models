@*
    REQ-019 — Layout del Área Studio (Nexus IA).
    -------------------------------------------------------------------
    Antes: este archivo era un layout completo (<html>/<head>/<body>) con
    un <style> ad-hoc, por lo que Studio perdía el "chrome" de Nexus
    (header con logo, skin, menú) y se veía como otra aplicación pegada.

    Ahora: es un WRAPPER delgado sobre el layout base de Nexus. Así el
    Área hereda el header/logo Saludsa, el skin smart-style-4 y los
    scripts globales, y se ve como el resto del producto.

    - Carga studio.css (el sistema de diseño propio del Área) en TODAS
      las vistas del Área, más lo que cada vista defina en @@section Styles.
    - Muestra de forma centralizada TempData["Error"] (errores de flujo
      que llegan por RedirectToAction).
    - Reenvía @@section Scripts de la vista hija al layout base
      (necesario para el chat SSE y el "adjuntar documentos" del Caso).
*@
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Alerta compartida del Área: errores de flujo propagados por TempData. *@
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger studio-alert">
        <i class="fa fa-exclamation-triangle"></i>&nbsp; @TempData["Error"]
    </div>
}

@*
    REQ-020 — Los dos roles del Studio, en todas las pantallas del Area.

    El auditor de Saludsa revisa lo que llega; el afiliado presenta lo suyo. Es
    la misma maquinaria contada en dos idiomas y desde aqui se pasa de una a
    otra. Vive en el layout y no en cada vista porque, repetido en ocho sitios,
    dentro de un mes habria pantallas sin el — que es exactamente lo que paso
    cuando solo estaba en la bandeja.

    Dentro de los iframes del caso no se pinta: saldria repetido en cada pestana.
*@
@{
    var _rolEmbed = (ViewData["Embed"] as bool?) == true;
    var _rolCtrl  = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    // Tres sitios, no dos. La consulta del afiliado es un rol propio: no es la
    // bandeja del auditor ni el flujo de presentar un reembolso, es preguntar.
    var _rolActivo = string.Equals(_rolCtrl, "Cliente", StringComparison.OrdinalIgnoreCase) ? "cli"
                   : string.Equals(_rolCtrl, "ChatCliente", StringComparison.OrdinalIgnoreCase) ? "chat"
                   : "aud";
}
@if (!_rolEmbed)
{
    <div class="st-rol">
        @if (_rolActivo == "aud")
        {
            <span class="st-rol-op is-activa"><i class="fa fa-user-md"></i> Auditor Saludsa</span>
        }
        else
        {
            <a class="st-rol-op" asp-area="Studio" asp-controller="Sobres" asp-action="Index">
                <i class="fa fa-user-md"></i> Auditor Saludsa
            </a>
        }

        @if (_rolActivo == "cli")
        {
            <span class="st-rol-op is-activa"><i class="fa fa-user"></i> Cliente</span>
        }
        else
        {
            <a class="st-rol-op" asp-area="Studio" asp-controller="Cliente" asp-action="Index">
                <i class="fa fa-user"></i> Cliente
            </a>
        }

        @if (_rolActivo == "chat")
        {
            <span class="st-rol-op is-activa"><i class="fa fa-comments"></i> Consulta del afiliado</span>
        }
        else
        {
            <a class="st-rol-op" asp-area="Studio" asp-controller="ChatCliente" asp-action="Index">
                <i class="fa fa-comments"></i> Consulta del afiliado
            </a>
        }
    </div>
}

@RenderBody()

@* studio.css siempre, + reenvío de la sección Styles que defina la vista. *@
@section Styles {
    <link rel="stylesheet" href="~/css/app/studio.css" asp-append-version="true" />
    @* st-portal.css trae el conmutador de rol y las pantallas del afiliado. *@
    <link rel="stylesheet" href="~/css/app/st-portal.css" asp-append-version="true" />
    @* El overlay de progreso: sirve a las dos caras, auditor y cliente. *@
    <link rel="stylesheet" href="~/css/app/st-progreso.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
}

@* Reenvía la sección Scripts de la vista hija (Chat SSE, Caso adjuntar/visor). *@
@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        // ── REQ-019: apagar el overlay de carga DEL PADRE ──────────────────
        // Las pestañas del workspace viven en un iframe y muestran el spinner
        // sobre la página padre (window.parent.mostrarLoadingPanel). Al terminar
        // el POST el iframe se recarga, pero el padre NO: sin esto el "Cargando…"
        // se queda pegado para siempre. Se apaga cuando la vista embebida termina.
        (function () {
            try {
                if (window.parent && window.parent !== window && window.parent.jQuery) {
                    window.parent.jQuery('#content').waitMe('hide');
                }
            } catch (e) { /* distinto origen: no hay nada que apagar */ }
        })();
    </script>
}
